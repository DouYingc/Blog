{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'MessageBoard',\n  data() {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: ''\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    isAdmin() {\n      return this.currentUser.role === 'admin';\n    }\n  },\n  created() {\n    this.initForm();\n    this.fetchMessages();\n  },\n  methods: {\n    initForm() {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username;\n        this.messageForm.avatar = this.currentUser.avatar || '';\n      } else {\n        this.messageForm.nickname = '';\n        this.messageForm.avatar = '';\n      }\n    },\n    async fetchMessages() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages');\n        this.messages = response.data;\n      } catch (error) {\n        this.$message.error('获取留言失败');\n      }\n    },\n    async submitMessage() {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称');\n        return;\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm);\n        this.$message.success('发布成功');\n        this.messageForm.content = '';\n        this.fetchMessages();\n      } catch (error) {\n        this.$message.error('发布失败');\n      } finally {\n        this.submitting = false;\n      }\n    },\n    replyTo(msg) {\n      this.messageForm.content = `@${msg.nickname} `;\n      // 自动滚动到输入框\n      document.querySelector('.input-card').scrollIntoView({\n        behavior: 'smooth'\n      });\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n      location.reload();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","messages","messageForm","nickname","content","avatar","submitting","currentUser","JSON","parse","localStorage","getItem","computed","isLoggedIn","isAdmin","role","created","initForm","fetchMessages","methods","username","response","get","error","$message","submitMessage","warning","post","success","replyTo","msg","document","querySelector","scrollIntoView","behavior","formatDate","dateStr","date","Date","isNaN","getTime","getFullYear","getMonth","getDate","getHours","toString","padStart","getMinutes","handleLogout","removeItem","$router","push","location","reload"],"sources":["src/views/MessageBoard.vue"],"sourcesContent":["<template>\n  <div class=\"message-board\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/messages\">留言板</el-menu-item>\n            <el-menu-item v-if=\"!isLoggedIn\" index=\"/login\">登录/注册</el-menu-item>\n            <el-submenu v-else index=\"user-menu\">\n              <template slot=\"title\">\n                <div class=\"user-nav\">\n                  <el-avatar v-if=\"currentUser.avatar\" :size=\"30\" :src=\"currentUser.avatar\"\n                    style=\"margin-right: 8px; vertical-align: middle\"></el-avatar>\n                  <i v-else class=\"el-icon-user\" style=\"margin-right: 8px\"></i>\n                  {{ currentUser.username }}\n                </div>\n              </template>\n              <el-menu-item index=\"/user/center\">个人中心</el-menu-item>\n              <el-menu-item v-if=\"isAdmin\" index=\"/admin\">系统后台</el-menu-item>\n              <el-menu-item @click=\"handleLogout\">退出登录</el-menu-item>\n            </el-submenu>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <div class=\"board-header\">\n          <h1>社区留言板</h1>\n          <p>欢迎在这里分享你的想法、建议或单纯打个招呼！</p>\n        </div>\n\n        <el-card class=\"input-card\" shadow=\"never\">\n          <div class=\"input-wrapper\">\n            <el-avatar :size=\"50\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\" class=\"user-avatar\"></el-avatar>\n            <div class=\"form-content\">\n              <el-form :model=\"messageForm\" label-width=\"0\">\n                <el-form-item v-if=\"!isLoggedIn\">\n                  <el-input v-model=\"messageForm.nickname\" placeholder=\"昵称 (必填)\" prefix-icon=\"el-icon-user\"></el-input>\n                </el-form-item>\n                <el-form-item v-else>\n                  <span class=\"logged-user\">正在以 <strong>{{ currentUser.username }}</strong> 的身份留言</span>\n                </el-form-item>\n                <el-form-item>\n                  <el-input type=\"textarea\" :rows=\"4\" v-model=\"messageForm.content\"\n                    placeholder=\"在这里写下你的想法... 你的留言将在这里展示\" resize=\"none\"></el-input>\n                </el-form-item>\n                <div class=\"form-footer\">\n                  <span class=\"tip\">文明用语，传递正能量</span>\n                  <el-button type=\"primary\" round icon=\"el-icon-s-promotion\" @click=\"submitMessage\"\n                    :loading=\"submitting\">发布留言</el-button>\n                </div>\n              </el-form>\n            </div>\n          </div>\n        </el-card>\n\n        <div class=\"message-list-container\">\n          <div class=\"list-title\">全部留言 ({{ messages.length }})</div>\n          <div class=\"message-list\">\n            <div v-for=\"msg in messages\" :key=\"msg.id\" class=\"message-item\">\n              <div class=\"msg-avatar\">\n                <el-avatar :size=\"45\" :src=\"msg.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              </div>\n              <div class=\"msg-main\">\n                <div class=\"msg-header\">\n                  <span class=\"nickname\">{{ msg.nickname }}</span>\n                  <span class=\"date\">{{ formatDate(msg.created_at) }}</span>\n                </div>\n                <div class=\"msg-content\">{{ msg.content }}</div>\n                <div class=\"msg-actions\">\n                  <span class=\"action-btn\" @click=\"replyTo(msg)\"><i class=\"el-icon-chat-round\"></i> 回复</span>\n                </div>\n              </div>\n            </div>\n            <el-empty v-if=\"messages.length === 0\" description=\"暂无留言，快来抢沙发吧！\"></el-empty>\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'MessageBoard',\n  data () {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: ''\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    isAdmin () {\n      return this.currentUser.role === 'admin'\n    }\n  },\n  created () {\n    this.initForm()\n    this.fetchMessages()\n  },\n  methods: {\n    initForm () {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username\n        this.messageForm.avatar = this.currentUser.avatar || ''\n      } else {\n        this.messageForm.nickname = ''\n        this.messageForm.avatar = ''\n      }\n    },\n    async fetchMessages () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages')\n        this.messages = response.data\n      } catch (error) {\n        this.$message.error('获取留言失败')\n      }\n    },\n    async submitMessage () {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称')\n        return\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空')\n        return\n      }\n      this.submitting = true\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm)\n        this.$message.success('发布成功')\n        this.messageForm.content = ''\n        this.fetchMessages()\n      } catch (error) {\n        this.$message.error('发布失败')\n      } finally {\n        this.submitting = false\n      }\n    },\n    replyTo (msg) {\n      this.messageForm.content = `@${msg.nickname} `\n      // 自动滚动到输入框\n      document.querySelector('.input-card').scrollIntoView({ behavior: 'smooth' })\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n      location.reload()\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/MessageBoard.css\"></style>\n"],"mappings":"AAqFA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,OAAA;QACAC,MAAA;MACA;MACAC,UAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAH,YAAA,CAAAC,OAAA;IACA;IACAG,QAAA;MACA,YAAAP