{"ast":null,"code":"import UserDashboard from '@/components/UserDashboard.vue';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'UserCenter',\n  components: {\n    UserDashboard,\n    NavBar\n  },\n  data() {\n    return {\n      activeTab: 'dashboard',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      likedArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: '',\n        avatar: '',\n        bio: '',\n        website: '',\n        github: '',\n        twitter: '',\n        linkedin: ''\n      },\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    };\n  },\n  created() {\n    this.userForm.username = this.currentUser.username;\n    this.userForm.email = this.currentUser.email || '';\n    this.userForm.avatar = this.currentUser.avatar || '';\n    this.userForm.bio = this.currentUser.bio || '';\n    this.userForm.website = this.currentUser.website || '';\n    this.userForm.github = this.currentUser.github || '';\n    this.userForm.twitter = this.currentUser.twitter || '';\n    this.userForm.linkedin = this.currentUser.linkedin || '';\n    this.fetchMyArticles();\n    this.fetchFavorites();\n    this.fetchLikes();\n  },\n  methods: {\n    async fetchMyArticles() {\n      this.loading = true;\n      try {\n        const response = await this.$axios.get('/articles', {\n          params: {\n            user_id: this.currentUser.id,\n            include_drafts: true\n          }\n        });\n        this.myArticles = response.articles;\n      } catch (error) {\n        this.$message.error('获取文章失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async fetchFavorites() {\n      try {\n        const response = await this.$axios.get('/interactions/my-favorites');\n        this.favoriteArticles = response;\n      } catch (error) {\n        console.error('获取收藏失败', error);\n      }\n    },\n    async fetchLikes() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/interactions/my-likes', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.likedArticles = response.data;\n      } catch (error) {\n        console.error('获取点赞失败', error);\n      }\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchMyArticles();\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async updateProfile() {\n      try {\n        const response = await axios.put('http://localhost:3000/api/auth/profile', {\n          email: this.userForm.email,\n          avatar: this.userForm.avatar,\n          bio: this.userForm.bio,\n          website: this.userForm.website,\n          github: this.userForm.github,\n          twitter: this.userForm.twitter,\n          linkedin: this.userForm.linkedin\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n\n        // 更新本地存储的用户信息\n        const updatedUser = response.data.user;\n        localStorage.setItem('user', JSON.stringify(updatedUser));\n        this.currentUser = updatedUser;\n        this.$message.success('资料更新成功');\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '资料更新失败');\n      }\n    },\n    handleAvatarSuccess(res) {\n      this.userForm.avatar = res.url;\n      this.$message.success('头像上传成功，点击保存修改生效');\n    },\n    beforeAvatarUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!');\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!');\n      }\n      return isJPG && isLt2M;\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["UserDashboard","NavBar","name","components","data","activeTab","loading","myArticles","favoriteArticles","likedArticles","currentUser","JSON","parse","localStorage","getItem","userForm","username","email","avatar","bio","website","github","twitter","linkedin","uploadHeaders","Authorization","created","fetchMyArticles","fetchFavorites","fetchLikes","methods","response","$axios","get","params","user_id","id","include_drafts","articles","error","$message","console","axios","headers","handleDelete","$confirm","type","delete","success","updateProfile","put","updatedUser","user","setItem","stringify","message","handleAvatarSuccess","res","url","beforeAvatarUpload","file","isJPG","isLt2M","size","handleLogout","removeItem","$router","push"],"sources":["src/views/UserCenter.vue"],"sourcesContent":["<template>\n  <div class=\"user-center\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\">\n        <el-tabs v-model=\"activeTab\" type=\"border-card\">\n          <!-- 数据中心 -->\n          <el-tab-pane label=\"数据中心\" name=\"dashboard\">\n            <user-dashboard />\n          </el-tab-pane>\n\n          <!-- 个人文章管理 -->\n          <el-tab-pane label=\"我的文章\" name=\"articles\">\n            <el-card shadow=\"never\" class=\"tab-card\">\n              <div class=\"pane-content\">\n                <div class=\"toolbar\">\n                  <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"$router.push('/article/new')\">发布文章</el-button>\n                </div>\n                <el-table :data=\"myArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                  <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                  <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                  <el-table-column prop=\"views\" label=\"阅读\" width=\"80\" align=\"center\"></el-table-column>\n                  <el-table-column prop=\"created_at\" label=\"发布时间\" width=\"180\">\n                    <template slot-scope=\"scope\">{{ new Date(scope.row.created_at).toLocaleString() }}</template>\n                  </el-table-column>\n                  <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n                    <template slot-scope=\"scope\">\n                      <el-button size=\"mini\" type=\"text\"\n                        @click=\"$router.push(`/article/${scope.row.id}`)\">查看</el-button>\n                      <el-button size=\"mini\" type=\"text\"\n                        @click=\"$router.push(`/article/edit/${scope.row.id}`)\">编辑</el-button>\n                      <el-button size=\"mini\" type=\"text\" style=\"color: #F56C6C\"\n                        @click=\"handleDelete(scope.row.id)\">删除</el-button>\n                    </template>\n                  </el-table-column>\n                </el-table>\n              </div>\n            </el-card>\n          </el-tab-pane>\n\n          <!-- 收藏夹 -->\n          <el-tab-pane label=\"我的收藏\" name=\"favorites\">\n            <el-card shadow=\"never\" class=\"tab-card\">\n              <div class=\"pane-content\">\n                <el-table :data=\"favoriteArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                  <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                  <el-table-column prop=\"User.username\" label=\"作者\" width=\"120\"></el-table-column>\n                  <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                  <el-table-column label=\"操作\" width=\"120\" align=\"center\">\n                    <template slot-scope=\"scope\">\n                      <el-button size=\"mini\" type=\"text\"\n                        @click=\"$router.push(`/article/${scope.row.id}`)\">查看</el-button>\n                    </template>\n                  </el-table-column>\n                </el-table>\n              </div>\n            </el-card>\n          </el-tab-pane>\n\n          <!-- 我的点赞 -->\n          <el-tab-pane label=\"我的点赞\" name=\"likes\">\n            <el-card shadow=\"never\" class=\"tab-card\">\n              <div class=\"pane-content\">\n                <el-table :data=\"likedArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                  <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                  <el-table-column prop=\"User.username\" label=\"作者\" width=\"120\"></el-table-column>\n                  <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                  <el-table-column label=\"操作\" width=\"120\" align=\"center\">\n                    <template slot-scope=\"scope\">\n                      <el-button size=\"mini\" type=\"text\"\n                        @click=\"$router.push(`/article/${scope.row.id}`)\">查看</el-button>\n                    </template>\n                  </el-table-column>\n                </el-table>\n              </div>\n            </el-card>\n          </el-tab-pane>\n\n          <!-- 个人资料修改 -->\n          <el-tab-pane label=\"基本资料\" name=\"profile\">\n            <el-card shadow=\"never\" class=\"tab-card\">\n              <div class=\"pane-content profile-form\">\n                <el-form :model=\"userForm\" label-width=\"80px\" style=\"max-width: 600px; margin: 0 auto;\">\n                  <el-form-item label=\"用户头像\">\n                    <el-upload class=\"avatar-uploader\" action=\"http://localhost:3000/api/upload/image\" name=\"image\"\n                      :headers=\"uploadHeaders\" :show-file-list=\"false\" :on-success=\"handleAvatarSuccess\"\n                      :before-upload=\"beforeAvatarUpload\">\n                      <img v-if=\"userForm.avatar\" :src=\"userForm.avatar\" class=\"avatar\">\n                      <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\n                    </el-upload>\n                    <small>点击上方区域上传头像</small>\n                  </el-form-item>\n                  <el-form-item label=\"用户名\">\n                    <el-input v-model=\"userForm.username\" disabled></el-input>\n                    <small>用户名暂不支持修改</small>\n                  </el-form-item>\n                  <el-form-item label=\"邮箱\">\n                    <el-input v-model=\"userForm.email\"></el-input>\n                  </el-form-item>\n                  <el-form-item label=\"个人简介\">\n                    <el-input type=\"textarea\" :rows=\"4\" v-model=\"userForm.bio\" placeholder=\"介绍一下自己吧...\"></el-input>\n                  </el-form-item>\n                  <el-form-item label=\"个人网站\">\n                    <el-input v-model=\"userForm.website\" placeholder=\"https://\"></el-input>\n                  </el-form-item>\n                  <el-form-item label=\"GitHub\">\n                    <el-input v-model=\"userForm.github\" placeholder=\"https://github.com/\"></el-input>\n                  </el-form-item>\n                  <el-form-item label=\"Twitter/X\">\n                    <el-input v-model=\"userForm.twitter\" placeholder=\"https://twitter.com/\"></el-input>\n                  </el-form-item>\n                  <el-form-item label=\"LinkedIn\">\n                    <el-input v-model=\"userForm.linkedin\" placeholder=\"https://linkedin.com/in/\"></el-input>\n                  </el-form-item>\n                  <el-form-item>\n                    <el-button type=\"primary\" @click=\"updateProfile\" style=\"width: 100%\">保存修改</el-button>\n                  </el-form-item>\n                </el-form>\n              </div>\n            </el-card>\n          </el-tab-pane>\n        </el-tabs>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\n\nimport UserDashboard from '@/components/UserDashboard.vue'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'UserCenter',\n  components: {\n    UserDashboard,\n    NavBar\n  },\n  data () {\n    return {\n      activeTab: 'dashboard',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      likedArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: '',\n        avatar: '',\n        bio: '',\n        website: '',\n        github: '',\n        twitter: '',\n        linkedin: ''\n      },\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    }\n  },\n  created () {\n    this.userForm.username = this.currentUser.username\n    this.userForm.email = this.currentUser.email || ''\n    this.userForm.avatar = this.currentUser.avatar || ''\n    this.userForm.bio = this.currentUser.bio || ''\n    this.userForm.website = this.currentUser.website || ''\n    this.userForm.github = this.currentUser.github || ''\n    this.userForm.twitter = this.currentUser.twitter || ''\n    this.userForm.linkedin = this.currentUser.linkedin || ''\n    this.fetchMyArticles()\n    this.fetchFavorites()\n    this.fetchLikes()\n  },\n  methods: {\n    async fetchMyArticles () {\n      this.loading = true\n      try {\n        const response = await this.$axios.get('/articles', {\n          params: { user_id: this.currentUser.id, include_drafts: true }\n        })\n        this.myArticles = response.articles\n      } catch (error) {\n        this.$message.error('获取文章失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    async fetchFavorites () {\n      try {\n        const response = await this.$axios.get('/interactions/my-favorites')\n        this.favoriteArticles = response\n      } catch (error) {\n        console.error('获取收藏失败', error)\n      }\n    },\n    async fetchLikes () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/interactions/my-likes', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.likedArticles = response.data\n      } catch (error) {\n        console.error('获取点赞失败', error)\n      }\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchMyArticles()\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async updateProfile () {\n      try {\n        const response = await axios.put('http://localhost:3000/api/auth/profile', {\n          email: this.userForm.email,\n          avatar: this.userForm.avatar,\n          bio: this.userForm.bio,\n          website: this.userForm.website,\n          github: this.userForm.github,\n          twitter: this.userForm.twitter,\n          linkedin: this.userForm.linkedin\n        }, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n\n        // 更新本地存储的用户信息\n        const updatedUser = response.data.user\n        localStorage.setItem('user', JSON.stringify(updatedUser))\n        this.currentUser = updatedUser\n\n        this.$message.success('资料更新成功')\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '资料更新失败')\n      }\n    },\n    handleAvatarSuccess (res) {\n      this.userForm.avatar = res.url\n      this.$message.success('头像上传成功，点击保存修改生效')\n    },\n    beforeAvatarUpload (file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png'\n      const isLt2M = file.size / 1024 / 1024 < 2\n\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!')\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!')\n      }\n      return isJPG && isLt2M\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/UserCenter.css\"></style>\n"],"mappings":"AAkIA,OAAAA,aAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAH,aAAA;IACAC;EACA;EACAG,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,UAAA;MACAC,gBAAA;MACAC,aAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,MAAA;QACAC,GAAA;QACAC,OAAA;QACAC,MAAA;QACAC,OAAA;QACAC,QAAA;MACA;MACAC,aAAA;QACAC,aAAA,YAAAZ,YAAA,CAAAC,OAAA;MACA;IACA;EACA;EACAY,QAAA;IACA,KAAAX,QAAA,CAAAC,QAAA,QAAAN,WAAA,CAAAM,QAAA;IACA,KAAAD,QAAA,CAAAE,KAAA,QAAAP,WAAA,CAAAO,KAAA;IACA,KAAAF,QAAA,CAAAG,MAAA,QAAAR,WAAA,CAAAQ,MAAA;IACA,KAAAH,QAAA,CAAAI,GAAA,QAAAT,WAAA,CAAAS,GAAA;IACA,KAAAJ,QAAA,CAAAK,OAAA,QAAAV,WAAA,CAAAU,OAAA;IACA,KAAAL,QAAA,CAAAM,MAAA,QAAAX,WAAA,CAAAW,MAAA;IACA,KAAAN,QAAA,CAAAO,OAAA,QAAAZ,WAAA,CAAAY,OAAA;IACA,KAAAP,QAAA,CAAAQ,QAAA,QAAAb,WAAA,CAAAa,QAAA;IACA,KAAAI,eAAA;IACA,KAAAC,cAAA;IACA,KAAAC,UAAA;EACA;EACAC,OAAA;IACA,MAAAH,gBAAA;MACA,KAAArB,OAAA;MACA;QACA,MAAAyB,QAAA,cAAAC,MAAA,CAAAC,GAAA;UACAC,MAAA;YAAAC,OAAA,OAAAzB,WAAA,CAAA0B,EAAA;YAAAC,cAAA;UAAA;QACA;QACA,KAAA9B,UAAA,GAAAwB,QAAA,CAAAO,QAAA;MACA,SAAAC,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAAjC,OAAA;MACA;IACA;IACA,MAAAsB,eAAA;MACA;QACA,MAAAG,QAAA,cAAAC,MAAA,CAAAC,GAAA;QACA,KAAAzB,gBAAA,GAAAuB,QAAA;MACA,SAAAQ,KAAA;QACAE,OAAA,CAAAF,KAAA,WAAAA,KAAA;MACA;IACA;IACA,MAAAV,WAAA;MACA;QACA,MAAAE,QAAA,SAAAW,KAAA,CAAAT,GAAA;UACAU,OAAA;YAAAlB,aAAA,YAAAZ,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAL,aAAA,GAAAsB,QAAA,CAAA3B,IAAA;MACA,SAAAmC,KAAA;QACAE,OAAA,CAAAF,KAAA,WAA