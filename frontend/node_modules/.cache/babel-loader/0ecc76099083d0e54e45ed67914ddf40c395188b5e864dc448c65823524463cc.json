{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleEdit',\n  data() {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    };\n  },\n  created() {\n    this.fetchCategories();\n    this.fetchTags();\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id);\n    }\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('获取分类失败');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('获取标签失败');\n      }\n    },\n    async fetchArticle(id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        const article = response.data;\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        };\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    handleContentChange(value, render) {\n      this.articleForm.html_content = render;\n    },\n    handleCoverSuccess(res) {\n      this.articleForm.cover = res.url;\n      this.$message.success('封面上传成功');\n    },\n    beforeCoverUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isJPG) this.$message.error('封面只能是 JPG 或 PNG 格式!');\n      if (!isLt2M) this.$message.error('封面大小不能超过 2MB!');\n      return isJPG && isLt2M;\n    },\n    async saveArticle() {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config);\n          this.$message.success('文章更新成功');\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config);\n          this.$message.success('文章发布成功');\n        }\n        this.$router.push('/admin/articles');\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","articleForm","title","category_id","tags","summary","content","html_content","status","cover","categories","uploadHeaders","Authorization","localStorage","getItem","created","fetchCategories","fetchTags","$route","params","id","fetchArticle","methods","response","get","error","$message","article","Tags","map","t","handleContentChange","value","render","handleCoverSuccess","res","url","success","beforeCoverUpload","file","isJPG","type","isLt2M","size","saveArticle","warning","config","headers","put","post","$router","push"],"sources":["src/views/admin/ArticleEdit.vue"],"sourcesContent":["<template>\n  <div class=\"article-edit\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/user/center\">个人中心</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-page-header @back=\"$router.back()\" :content=\"$route.params.id ? '编辑文章' : '发布新文章'\"\n          style=\"margin-bottom: 30px\"></el-page-header>\n\n        <el-card shadow=\"never\" class=\"edit-card\">\n          <el-form :model=\"articleForm\" ref=\"articleForm\" label-width=\"80px\">\n            <el-form-item label=\"文章标题\" prop=\"title\">\n              <el-input v-model=\"articleForm.title\" placeholder=\"请输入文章标题\"></el-input>\n            </el-form-item>\n            <el-form-item label=\"文章封面\">\n              <el-upload class=\"cover-uploader\" action=\"http://localhost:3000/api/upload/image\" name=\"image\"\n                :headers=\"uploadHeaders\" :show-file-list=\"false\" :on-success=\"handleCoverSuccess\"\n                :before-upload=\"beforeCoverUpload\">\n                <img v-if=\"articleForm.cover\" :src=\"articleForm.cover\" class=\"cover-image\">\n                <i v-else class=\"el-icon-plus cover-uploader-icon\"></i>\n              </el-upload>\n              <small>建议尺寸 800x400，用于首页展示</small>\n            </el-form-item>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <el-form-item label=\"所属分类\">\n                  <el-select v-model=\"articleForm.category_id\" placeholder=\"选择分类\" style=\"width: 100%\">\n                    <el-option v-for=\"cat in categories\" :key=\"cat.id\" :label=\"cat.name\" :value=\"cat.id\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item label=\"文章标签\">\n                  <el-select v-model=\"articleForm.tags\" multiple placeholder=\"选择标签\" style=\"width: 100%\">\n                    <el-option v-for=\"tag in tags\" :key=\"tag.id\" :label=\"tag.name\" :value=\"tag.id\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item label=\"文章摘要\">\n              <el-input type=\"textarea\" :rows=\"3\" v-model=\"articleForm.summary\" placeholder=\"请输入文章摘要\"></el-input>\n            </el-form-item>\n            <el-form-item label=\"文章内容\">\n              <mavon-editor v-model=\"articleForm.content\" @change=\"handleContentChange\" style=\"min-height: 500px\"\n                placeholder=\"开始创作吧...\"></mavon-editor>\n            </el-form-item>\n            <el-form-item>\n              <el-button type=\"primary\" icon=\"el-icon-check\" @click=\"saveArticle\">保存并发布</el-button>\n              <el-button icon=\"el-icon-close\" @click=\"$router.back()\">取消</el-button>\n            </el-form-item>\n          </el-form>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'ArticleEdit',\n  data () {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    }\n  },\n  created () {\n    this.fetchCategories()\n    this.fetchTags()\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id)\n    }\n  },\n  methods: {\n    async fetchCategories () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories')\n        this.categories = response.data\n      } catch (error) {\n        this.$message.error('获取分类失败')\n      }\n    },\n    async fetchTags () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags')\n        this.tags = response.data\n      } catch (error) {\n        this.$message.error('获取标签失败')\n      }\n    },\n    async fetchArticle (id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        const article = response.data\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        }\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    handleContentChange (value, render) {\n      this.articleForm.html_content = render\n    },\n    handleCoverSuccess (res) {\n      this.articleForm.cover = res.url\n      this.$message.success('封面上传成功')\n    },\n    beforeCoverUpload (file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png'\n      const isLt2M = file.size / 1024 / 1024 < 2\n      if (!isJPG) this.$message.error('封面只能是 JPG 或 PNG 格式!')\n      if (!isLt2M) this.$message.error('封面大小不能超过 2MB!')\n      return isJPG && isLt2M\n    },\n    async saveArticle () {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空')\n        return\n      }\n      try {\n        const id = this.$route.params.id\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        }\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config)\n          this.$message.success('文章更新成功')\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config)\n          this.$message.success('文章发布成功')\n        }\n        this.$router.push('/admin/articles')\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.cover-uploader {\n  border: 1px dashed #d9d9d9;\n  border-radius: 6px;\n  cursor: pointer;\n  position: relative;\n  overflow: hidden;\n  width: 300px;\n  height: 150px;\n}\n\n.cover-uploader:hover {\n  border-color: #409EFF;\n}\n\n.cover-uploader-icon {\n  font-size: 28px;\n  color: #8c939d;\n  width: 300px;\n  height: 150px;\n  line-height: 150px;\n  text-align: center;\n}\n\n.cover-image {\n  width: 300px;\n  height: 150px;\n  display: block;\n  object-fit: cover;\n}\n</style>\n"],"mappings":"AAkEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;QACAC,KAAA;QACAC,WAAA;QACAC,IAAA;QACAC,OAAA;QACAC,OAAA;QACAC,YAAA;QACAC,MAAA;QACAC,KAAA;MACA;MACAC,UAAA;MACAN,IAAA;MACAO,aAAA;QACAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,eAAA;IACA,KAAAC,SAAA;IACA,SAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA,KAAAC,YAAA,MAAAH,MAAA,CAAAC,MAAA,CAAAC,EAAA;IACA;EACA;EACAE,OAAA;IACA,MAAAN,gBAAA;MACA;QACA,MAAAO,QAAA,SAAAzB,KAAA,CAAA0B,GAAA;QACA,KAAAd,UAAA,GAAAa,QAAA,CAAAvB,IAAA;MACA,SAAAyB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAR,UAAA;MACA;QACA,MAAAM,QAAA,SAAAzB,KAAA,CAAA0B,GAAA;QACA,KAAApB,IAAA,GAAAmB,QAAA,CAAAvB,IAAA;MACA,SAAAyB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAJ,aAAAD,EAAA;MACA;QACA,MAAAG,QAAA,SAAAzB,KAAA,CAAA0B,GAAA,uCAAAJ,EAAA;QACA,MAAAO,OAAA,GAAAJ,QAAA,CAAAvB,IAAA;QACA,KAAAC,WAAA;UACA,GAAA0B,OAAA;UACAvB,IAAA,EAAAuB,OAAA,CAAAC,IAAA,CAAAC,GAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAV,EAAA;QACA;MACA,SAAAK,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAM,oBAAAC,KAAA,EAAAC,MAAA;MACA,KAAAhC,WAAA,CAAAM,YAAA,GAAA0B,MAAA;IACA;IACAC,mBAAAC,GAAA;MACA,KAAAlC,WAAA,CAAAQ,KAAA,GAAA0B,GAAA,CAAAC,GAAA;MACA,KAAAV,QAAA,CAAAW,OAAA;IACA;IACAC,kBAAAC,IAAA;MACA,MAAAC,KAAA,GAAAD,IAAA,CAAAE,IAAA,qBAAAF,IAAA,CAAAE,IAAA;MACA,MAAAC,MAAA,GAAAH,IAAA,CAAAI,IAAA;MACA,KAAAH,KAAA,OAAAd,QAAA,CAAAD,KAAA;MACA,KAAAiB,MAAA,OAAAhB,QAAA,CAAAD,KAAA;MACA,OAAAe,KAAA,IAAAE,MAAA;IACA;IACA,MAAAE,YAAA;MACA,UAAA3C,WAAA,CAAAC,KAAA,UAAAD,WAAA,CAAAK,OAAA;QACA,KAAAoB,QAAA,CAAAmB,OAAA;QACA;MACA;MACA;QACA,MAAAzB,EAAA,QAAAF,MAAA,CAAAC,MAAA,CAAAC,EAAA;QACA,MAAA0B,MAAA;UACAC,OAAA;YAAAnC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,IAAAM,EAAA;UACA,MAAAtB,KAAA,CAAAkD,GAAA,uCAAA5B,EAAA,SAAAnB,WAAA,EAAA6C,MAAA;UACA,KAAApB,QAAA,CAAAW,OAAA;QACA;UACA,MAAAvC,KAAA,CAAAmD,IAAA,4CAAAhD,WAAA,EAAA6C,MAAA;UACA,KAAApB,QAAA,CAAAW,OAAA;QACA;QACA,KAAAa,OAAA,CAAAC,IAAA;MACA,SA