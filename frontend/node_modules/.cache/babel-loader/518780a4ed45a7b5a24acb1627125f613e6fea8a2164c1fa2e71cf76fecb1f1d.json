{"ast":null,"code":"import axios from '../axios';\nexport default {\n  name: 'NotificationBell',\n  data() {\n    return {\n      showNotifications: false,\n      notifications: [],\n      unreadCount: 0\n    };\n  },\n  mounted() {\n    this.fetchNotifications();\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    }\n  },\n  methods: {\n    toggleNotifications() {\n      this.showNotifications = !this.showNotifications;\n    },\n    async fetchNotifications() {\n      if (!this.isLoggedIn) {\n        this.notifications = [];\n        this.unreadCount = 0;\n        return;\n      }\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications');\n        this.notifications = response.data.notifications || [];\n        this.unreadCount = this.notifications.filter(n => !n.is_read).length;\n      } catch (error) {\n        console.error('获取通知失败:', error);\n        this.notifications = [];\n        this.unreadCount = 0;\n      }\n    },\n    async markAsRead(notificationId) {\n      if (!this.isLoggedIn) return;\n      try {\n        await axios.put(`http://localhost:3000/api/notifications/${notificationId}/read`);\n        this.fetchNotifications();\n      } catch (error) {\n        console.error('标记已读失败:', error);\n      }\n    },\n    async markAllAsRead() {\n      if (!this.isLoggedIn) return;\n      try {\n        await axios.put('http://localhost:3000/api/notifications/read-all');\n        this.fetchNotifications();\n      } catch (error) {\n        console.error('全部标为已读失败:', error);\n      }\n    },\n    getNotificationIcon(type) {\n      const iconMap = {\n        comment: 'el-icon-message',\n        comment_like: 'el-icon-star-on',\n        like: 'el-icon-star-on',\n        favorite: 'el-icon-star-on',\n        reply: 'el-icon-chat-line-round',\n        system: 'el-icon-info'\n      };\n      return iconMap[type] || 'el-icon-info';\n    },\n    formatTime(timeString) {\n      const now = new Date();\n      const time = new Date(timeString);\n      const diff = now - time;\n      const minutes = Math.floor(diff / 60000);\n      const hours = Math.floor(diff / 3600000);\n      const days = Math.floor(diff / 86400000);\n      if (minutes < 60) {\n        return `${minutes}分钟前`;\n      } else if (hours < 24) {\n        return `${hours}小时前`;\n      } else if (days < 30) {\n        return `${days}天前`;\n      } else {\n        return time.toLocaleDateString();\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","showNotifications","notifications","unreadCount","mounted","fetchNotifications","computed","isLoggedIn","localStorage","getItem","methods","toggleNotifications","response","get","filter","n","is_read","length","error","console","markAsRead","notificationId","put","markAllAsRead","getNotificationIcon","type","iconMap","comment","comment_like","like","favorite","reply","system","formatTime","timeString","now","Date","time","diff","minutes","Math","floor","hours","days","toLocaleDateString"],"sources":["src/components/NotificationBell.vue"],"sourcesContent":["<template>\n  <div class=\"notification-bell\">\n    <i class=\"el-icon-bell\" @click=\"toggleNotifications\"></i>\n    <span v-if=\"unreadCount > 0\" class=\"notification-badge\">{{ unreadCount }}</span>\n\n    <div v-if=\"showNotifications\" class=\"notification-dropdown\">\n      <div class=\"notification-header\">\n        <h3>通知</h3>\n        <span class=\"mark-all-read\" @click=\"markAllAsRead\">全部标为已读</span>\n      </div>\n\n      <div class=\"notification-list\">\n        <div v-if=\"notifications.length === 0\" class=\"no-notifications\">\n          暂无通知\n        </div>\n\n        <div v-for=\"notification in notifications\" :key=\"notification.id\"\n          :class=\"['notification-item', notification.is_read ? 'read' : 'unread']\" @click=\"markAsRead(notification.id)\">\n          <div class=\"notification-icon\">\n            <i :class=\"getNotificationIcon(notification.type)\"></i>\n          </div>\n          <div class=\"notification-content\">\n            <div class=\"notification-text\">{{ notification.content }}</div>\n            <div class=\"notification-time\">{{ formatTime(notification.created_at) }}</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\n\nexport default {\n  name: 'NotificationBell',\n  data () {\n    return {\n      showNotifications: false,\n      notifications: [],\n      unreadCount: 0\n    }\n  },\n  mounted () {\n    this.fetchNotifications()\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    }\n  },\n  methods: {\n    toggleNotifications () {\n      this.showNotifications = !this.showNotifications\n    },\n    async fetchNotifications () {\n      if (!this.isLoggedIn) {\n        this.notifications = []\n        this.unreadCount = 0\n        return\n      }\n\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications')\n        this.notifications = response.data.notifications || []\n        this.unreadCount = this.notifications.filter(n => !n.is_read).length\n      } catch (error) {\n        console.error('获取通知失败:', error)\n        this.notifications = []\n        this.unreadCount = 0\n      }\n    },\n    async markAsRead (notificationId) {\n      if (!this.isLoggedIn) return\n\n      try {\n        await axios.put(`http://localhost:3000/api/notifications/${notificationId}/read`)\n        this.fetchNotifications()\n      } catch (error) {\n        console.error('标记已读失败:', error)\n      }\n    },\n    async markAllAsRead () {\n      if (!this.isLoggedIn) return\n\n      try {\n        await axios.put('http://localhost:3000/api/notifications/read-all')\n        this.fetchNotifications()\n      } catch (error) {\n        console.error('全部标为已读失败:', error)\n      }\n    },\n    getNotificationIcon (type) {\n      const iconMap = {\n        comment: 'el-icon-message',\n        comment_like: 'el-icon-star-on',\n        like: 'el-icon-star-on',\n        favorite: 'el-icon-star-on',\n        reply: 'el-icon-chat-line-round',\n        system: 'el-icon-info'\n      }\n      return iconMap[type] || 'el-icon-info'\n    },\n    formatTime (timeString) {\n      const now = new Date()\n      const time = new Date(timeString)\n      const diff = now - time\n      const minutes = Math.floor(diff / 60000)\n      const hours = Math.floor(diff / 3600000)\n      const days = Math.floor(diff / 86400000)\n\n      if (minutes < 60) {\n        return `${minutes}分钟前`\n      } else if (hours < 24) {\n        return `${hours}小时前`\n      } else if (days < 30) {\n        return `${days}天前`\n      } else {\n        return time.toLocaleDateString()\n      }\n    }\n  }\n}\n</script>\n<style scoped>\n.notification-bell {\n  position: relative;\n  cursor: pointer;\n}\n\n.notification-badge {\n  position: absolute;\n  top: -5px;\n  right: -5px;\n  background-color: #f56c6c;\n  color: white;\n  border-radius: 50%;\n  min-width: 18px;\n  height: 18px;\n  font-size: 12px;\n  line-height: 18px;\n  text-align: center;\n  padding: 0 6px;\n}\n\n.notification-dropdown {\n  position: absolute;\n  top: 100%;\n  right: 0;\n  width: 320px;\n  background-color: white;\n  border: 1px solid #ebeef5;\n  border-radius: 4px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  z-index: 1000;\n  margin-top: 8px;\n}\n\n.notification-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 12px 16px;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.notification-header h3 {\n  margin: 0;\n  font-size: 16px;\n  font-weight: 600;\n}\n\n.mark-all-read {\n  color: #409eff;\n  font-size: 12px;\n  cursor: pointer;\n}\n\n.mark-all-read:hover {\n  text-decoration: underline;\n}\n\n.notification-list {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.no-notifications {\n  padding: 20px;\n  text-align: center;\n  color: #909399;\n}\n\n.notification-item {\n  display: flex;\n  padding: 12px 16px;\n  border-bottom: 1px solid #f5f7fa;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.notification-item:hover {\n  background-color: #f5f7fa;\n}\n\n.notification-item.unread {\n  background-color: #f0f9ff;\n}\n\n.notification-icon {\n  margin-right: 12px;\n  font-size: 18px;\n  color: #409eff;\n}\n\n.notification-content {\n  flex: 1;\n}\n\n.notification-title {\n  font-size: 14px;\n  font-weight: 500;\n  margin-bottom: 4px;\n}\n\n.notification-text {\n  font-size: 13px;\n  color: #606266;\n  margin-bottom: 4px;\n}\n\n.notification-time {\n  font-size: 12px;\n  color: #909399;\n}\n</style>"],"mappings":"AAgCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,iBAAA;MACAC,aAAA;MACAC,WAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,kBAAA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,oBAAA;MACA,KAAAV,iBAAA,SAAAA,iBAAA;IACA;IACA,MAAAI,mBAAA;MACA,UAAAE,UAAA;QACA,KAAAL,aAAA;QACA,KAAAC,WAAA;QACA;MACA;MAEA;QACA,MAAAS,QAAA,SAAAd,KAAA,CAAAe,GAAA;QACA,KAAAX,aAAA,GAAAU,QAAA,CAAAZ,IAAA,CAAAE,aAAA;QACA,KAAAC,WAAA,QAAAD,aAAA,CAAAY,MAAA,CAAAC,CAAA,KAAAA,CAAA,CAAAC,OAAA,EAAAC,MAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA,KAAAhB,aAAA;QACA,KAAAC,WAAA;MACA;IACA;IACA,MAAAiB,WAAAC,cAAA;MACA,UAAAd,UAAA;MAEA;QACA,MAAAT,KAAA,CAAAwB,GAAA,4CAAAD,cAAA;QACA,KAAAhB,kBAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACA,MAAAK,cAAA;MACA,UAAAhB,UAAA;MAEA;QACA,MAAAT,KAAA,CAAAwB,GAAA;QACA,KAAAjB,kBAAA;MACA,SAAAa,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACAM,oBAAAC,IAAA;MACA,MAAAC,OAAA;QACAC,OAAA;QACAC,YAAA;QACAC,IAAA;QACAC,QAAA;QACAC,KAAA;QACAC,MAAA;MACA;MACA,OAAAN,OAAA,CAAAD,IAAA;IACA;IACAQ,WAAAC,UAAA;MACA,MAAAC,GAAA,OAAAC,IAAA;MACA,MAAAC,IAAA,OAAAD,IAAA,CAAAF,UAAA;MACA,MAAAI,IAAA,GAAAH,GAAA,GAAAE,IAAA;MACA,MAAAE,OAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAH,IAAA;MACA,MAAAI,KAAA,GAAAF,IAAA,CAAAC,KAAA,CAAAH,IAAA;MACA,MAAAK,IAAA,GAAAH,IAAA,CAAAC,KAAA,CAAAH,IAAA;MAEA,IAAA