{"ast":null,"code":"import axios from '../axios';\nexport default {\n  name: 'UserProfile',\n  data() {\n    return {\n      user: {},\n      articles: [],\n      loadingUser: false,\n      loadingArticles: false,\n      isLoggedIn: false,\n      currentUserId: null,\n      isFollowing: false,\n      loadingFollow: false\n    };\n  },\n  created() {\n    this.checkLoginStatus();\n  },\n  watch: {\n    '$route.params.id': {\n      handler: function (id) {\n        if (id) {\n          this.fetchUser(id);\n          this.fetchUserArticles(id);\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    checkLoginStatus() {\n      const token = localStorage.getItem('token');\n      if (token) {\n        this.isLoggedIn = true;\n        try {\n          const userInfo = JSON.parse(localStorage.getItem('userInfo'));\n          this.currentUserId = userInfo.id;\n        } catch (error) {\n          console.error('解析用户信息失败:', error);\n        }\n      }\n    },\n    async fetchUser(id) {\n      this.loadingUser = true;\n      try {\n        const response = await axios.get(`/auth/user/${id}`);\n        this.user = response.data;\n        if (this.isLoggedIn && this.currentUserId !== this.user.id) {\n          await this.checkFollowStatus(id);\n        }\n      } catch (error) {\n        this.$message.error('获取用户信息失败');\n      } finally {\n        this.loadingUser = false;\n      }\n    },\n    async fetchUserArticles(id) {\n      this.loadingArticles = true;\n      try {\n        const response = await axios.get('/articles', {\n          params: {\n            user_id: id\n          }\n        });\n        this.articles = response.data.articles;\n      } catch (error) {\n        this.$message.error('获取用户文章失败');\n      } finally {\n        this.loadingArticles = false;\n      }\n    },\n    async checkFollowStatus(userId) {\n      try {\n        const response = await axios.get(`/follows/check/${userId}`);\n        this.isFollowing = response.data.isFollowing;\n      } catch (error) {\n        console.error('检查关注状态失败:', error);\n      }\n    },\n    async toggleFollow() {\n      this.loadingFollow = true;\n      try {\n        if (this.isFollowing) {\n          await axios.delete(`/follows/unfollow/${this.user.id}`);\n          this.$message.success('取消关注成功');\n        } else {\n          await axios.post(`/follows/follow/${this.user.id}`);\n          this.$message.success('关注成功');\n        }\n        this.isFollowing = !this.isFollowing;\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '操作失败');\n      } finally {\n        this.loadingFollow = false;\n      }\n    },\n    sendPrivateMessage() {\n      this.$router.push(`/messages/private/${this.user.id}`);\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","user","articles","loadingUser","loadingArticles","isLoggedIn","currentUserId","isFollowing","loadingFollow","created","checkLoginStatus","watch","handler","id","fetchUser","fetchUserArticles","immediate","methods","token","localStorage","getItem","userInfo","JSON","parse","error","console","response","get","checkFollowStatus","$message","params","user_id","userId","toggleFollow","delete","success","post","message","sendPrivateMessage","$router","push"],"sources":["src/views/UserProfile.vue"],"sourcesContent":["<template>\n  <div class=\"user-profile\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/messages\">留言板</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-row :gutter=\"30\">\n          <!-- 用户基本信息 -->\n          <el-col :span=\"10\">\n            <el-card class=\"profile-card\" v-loading=\"loadingUser\">\n              <div class=\"profile-header\">\n                <el-avatar :size=\"100\" :src=\"user.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                <h2 class=\"username\">{{ user.username }}</h2>\n                <el-tag size=\"small\" :type=\"user.role === 'admin' ? 'danger' : 'success'\">{{ user.role === 'admin' ?\n                  '管理员' : '普通用户' }}</el-tag>\n                <div v-if=\"isLoggedIn && user.id !== currentUserId\" class=\"follow-section\">\n                  <el-button \n                    :type=\"isFollowing ? 'default' : 'primary'\" \n                    @click=\"toggleFollow\"\n                    :loading=\"loadingFollow\"\n                  >\n                    {{ isFollowing ? '已关注' : '关注' }}\n                  </el-button>\n                  <el-button \n                    type=\"info\" \n                    size=\"small\"\n                    @click=\"sendPrivateMessage\"\n                  >\n                    私信\n                  </el-button>\n                </div>\n              </div>\n              <div class=\"profile-details\">\n                <div class=\"detail-item\"><i class=\"el-icon-message\"></i> {{ user.email || '保密' }}</div>\n                <div class=\"detail-item\"><i class=\"el-icon-date\"></i> 加入于 {{ new\n                  Date(user.created_at).toLocaleDateString() }}</div>\n              </div>\n            </el-card>\n          </el-col>\n\n          <!-- 用户贡献文章 -->\n          <el-col :span=\"14\">\n            <el-card class=\"articles-card\">\n              <div slot=\"header\" class=\"card-header\">\n                <span>TA 的文章 ({{ articles.length }})</span>\n              </div>\n              <div class=\"article-list\" v-loading=\"loadingArticles\">\n                <div v-for=\"art in articles\" :key=\"art.id\" class=\"article-item\"\n                  @click=\"$router.push(`/article/${art.id}`)\">\n                  <div class=\"art-title\">{{ art.title }}</div>\n                  <div class=\"art-meta\">\n                    <span><i class=\"el-icon-view\"></i> {{ art.views }}</span>\n                    <span><i class=\"el-icon-date\"></i> {{ new Date(art.created_at).toLocaleDateString() }}</span>\n                  </div>\n                </div>\n                <el-empty v-if=\"articles.length === 0\" description=\"该用户暂未发布文章\"></el-empty>\n              </div>\n            </el-card>\n          </el-col>\n        </el-row>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\n\nexport default {\n  name: 'UserProfile',\n  data () {\n    return {\n      user: {},\n      articles: [],\n      loadingUser: false,\n      loadingArticles: false,\n      isLoggedIn: false,\n      currentUserId: null,\n      isFollowing: false,\n      loadingFollow: false\n    }\n  },\n  created () {\n    this.checkLoginStatus()\n  },\n  watch: {\n    '$route.params.id': {\n      handler: function (id) {\n        if (id) {\n          this.fetchUser(id)\n          this.fetchUserArticles(id)\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    checkLoginStatus () {\n      const token = localStorage.getItem('token')\n      if (token) {\n        this.isLoggedIn = true\n        try {\n          const userInfo = JSON.parse(localStorage.getItem('userInfo'))\n          this.currentUserId = userInfo.id\n        } catch (error) {\n          console.error('解析用户信息失败:', error)\n        }\n      }\n    },\n    async fetchUser (id) {\n      this.loadingUser = true\n      try {\n        const response = await axios.get(`/auth/user/${id}`)\n        this.user = response.data\n        if (this.isLoggedIn && this.currentUserId !== this.user.id) {\n          await this.checkFollowStatus(id)\n        }\n      } catch (error) {\n        this.$message.error('获取用户信息失败')\n      } finally {\n        this.loadingUser = false\n      }\n    },\n    async fetchUserArticles (id) {\n      this.loadingArticles = true\n      try {\n        const response = await axios.get('/articles', {\n          params: { user_id: id }\n        })\n        this.articles = response.data.articles\n      } catch (error) {\n        this.$message.error('获取用户文章失败')\n      } finally {\n        this.loadingArticles = false\n      }\n    },\n    async checkFollowStatus (userId) {\n      try {\n        const response = await axios.get(`/follows/check/${userId}`)\n        this.isFollowing = response.data.isFollowing\n      } catch (error) {\n        console.error('检查关注状态失败:', error)\n      }\n    },\n    async toggleFollow () {\n      this.loadingFollow = true\n      try {\n        if (this.isFollowing) {\n          await axios.delete(`/follows/unfollow/${this.user.id}`)\n          this.$message.success('取消关注成功')\n        } else {\n          await axios.post(`/follows/follow/${this.user.id}`)\n          this.$message.success('关注成功')\n        }\n        this.isFollowing = !this.isFollowing\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '操作失败')\n      } finally {\n        this.loadingFollow = false\n      }\n    },\n    sendPrivateMessage () {\n      this.$router.push(`/messages/private/${this.user.id}`)\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/UserProfile.css\"></style>\n"],"mappings":"AA0EA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,QAAA;MACAC,WAAA;MACAC,eAAA;MACAC,UAAA;MACAC,aAAA;MACAC,WAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,KAAA;IACA;MACAC,OAAA,WAAAA,CAAAC,EAAA;QACA,IAAAA,EAAA;UACA,KAAAC,SAAA,CAAAD,EAAA;UACA,KAAAE,iBAAA,CAAAF,EAAA;QACA;MACA;MACAG,SAAA;IACA;EACA;EACAC,OAAA;IACAP,iBAAA;MACA,MAAAQ,KAAA,GAAAC,YAAA,CAAAC,OAAA;MACA,IAAAF,KAAA;QACA,KAAAb,UAAA;QACA;UACA,MAAAgB,QAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAJ,YAAA,CAAAC,OAAA;UACA,KAAAd,aAAA,GAAAe,QAAA,CAAAR,EAAA;QACA,SAAAW,KAAA;UACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;QACA;MACA;IACA;IACA,MAAAV,UAAAD,EAAA;MACA,KAAAV,WAAA;MACA;QACA,MAAAuB,QAAA,SAAA5B,KAAA,CAAA6B,GAAA,eAAAd,EAAA;QACA,KAAAZ,IAAA,GAAAyB,QAAA,CAAA1B,IAAA;QACA,SAAAK,UAAA,SAAAC,aAAA,UAAAL,IAAA,CAAAY,EAAA;UACA,WAAAe,iBAAA,CAAAf,EAAA;QACA;MACA,SAAAW,KAAA;QACA,KAAAK,QAAA,CAAAL,KAAA;MACA;QACA,KAAArB,WAAA;MACA;IACA;IACA,MAAAY,kBAAAF,EAAA;MACA,KAAAT,eAAA;MACA;QACA,MAAAsB,QAAA,SAAA5B,KAAA,CAAA6B,GAAA;UACAG,MAAA;YAAAC,OAAA,EAAAlB;UAAA;QACA;QACA,KAAAX,QAAA,GAAAwB,QAAA,CAAA1B,IAAA,CAAAE,QAAA;MACA,SAAAsB,KAAA;QACA,KAAAK,QAAA,CAAAL,KAAA;MACA;QACA,KAAApB,eAAA;MACA;IACA;IACA,MAAAwB,kBAAAI,MAAA;MACA;QACA,MAAAN,QAAA,SAAA5B,KAAA,CAAA6B,GAAA,mBAAAK,MAAA;QACA,KAAAzB,WAAA,GAAAmB,QAAA,CAAA1B,IAAA,CAAAO,WAAA;MACA,SAAAiB,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACA,MAAAS,aAAA;MACA,KAAAzB,aAAA;MACA;QACA,SAAAD,WAAA;UACA,MAAAT,KAAA,CAAAoC,MAAA,2BAAAjC,IAAA,CAAAY,EAAA;UACA,KAAAgB,QAAA,CAAAM,OAAA;QACA;UACA,MAAArC,KAAA,CAAAsC,IAAA,yBAAAnC,IAAA,CAAAY,EAAA;UACA,KAAAgB,QAAA,CAAAM,OAAA;QACA;QACA,KAAA5B,WAAA,SAAAA,WAAA;MACA,SAAAiB,KAAA;QACA,KAAAK,QAAA,CAAAL,KAAA,CAAAA,KAAA,CAAAE,QAAA,EAAA1B,IAAA,EAAAqC,OAAA;MACA;QACA,KAAA7B,aAAA;MACA;IACA;IACA8B,mBAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,2BAAAvC,IAAA,CAAAY,EAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}