{"ast":null,"code":"import axios from 'axios';\nimport 'github-markdown-css/github-markdown.css';\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false\n    };\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle();\n        this.fetchComments();\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus();\n        }\n      },\n      immediate: true\n    }\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    canManage() {\n      if (!this.isLoggedIn || !this.article.id) return false;\n      return this.currentUser.role === 'admin' || this.article.user_id === this.currentUser.id;\n    }\n  },\n  created() {\n    // 逻辑已移至 watch\n  },\n  methods: {\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    async fetchInteractionStatus() {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.isFavorited = response.data.isFavorited;\n      } catch (error) {\n        console.error('获取交互状态失败', error);\n      }\n    },\n    async handleLike() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败');\n      }\n    },\n    async handleFavorite() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isFavorited = response.data.isFavorited;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败');\n      }\n    },\n    handleEdit() {\n      this.$router.push(`/admin/article/edit/${this.article.id}`);\n    },\n    async handleDelete() {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.$router.push('/');\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async fetchComments() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败', error);\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        });\n        this.$message.success('评论提交成功');\n        this.commentForm.nickname = '';\n        this.commentForm.email = '';\n        this.commentForm.content = '';\n        this.fetchComments(); // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","article","comments","commentForm","nickname","email","content","currentUser","JSON","parse","localStorage","getItem","isLiked","isFavorited","watch","handler","fetchArticle","fetchComments","isLoggedIn","fetchInteractionStatus","immediate","computed","canManage","id","role","user_id","created","methods","$route","params","response","get","error","$message","headers","Authorization","console","handleLike","post","article_id","success","message","handleFavorite","handleEdit","$router","push","handleDelete","$confirm","type","delete","submitComment","warning"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router>\n            <el-menu-item index=\"/\">首页</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-card class=\"detail-card\">\n          <div slot=\"header\">\n            <div class=\"title-wrapper\">\n              <h1 class=\"title\">{{ article.title }}</h1>\n              <div v-if=\"canManage\" class=\"detail-manage\">\n                <el-button type=\"primary\" size=\"small\" icon=\"el-icon-edit\" @click=\"handleEdit\">编辑文章</el-button>\n                <el-button type=\"danger\" size=\"small\" icon=\"el-icon-delete\" @click=\"handleDelete\">删除文章</el-button>\n              </div>\n            </div>\n            <div class=\"meta\">\n              <span><i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}</span>\n              <span><i class=\"el-icon-date\"></i> {{ new Date(article.created_at).toLocaleDateString() }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> 阅读: {{ article.views }}</span>\n            </div>\n          </div>\n          <!-- 使用 v-html 渲染 Markdown 解析后的 HTML -->\n          <div class=\"content markdown-body\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name\n              }}</el-tag>\n          </div>\n\n          <!-- 交互操作：点赞与收藏 -->\n          <div class=\"interactions\" v-if=\"isLoggedIn\">\n            <div class=\"interaction-item\">\n              <el-button :type=\"isLiked ? 'primary' : 'default'\" icon=\"el-icon-caret-top\" circle @click=\"handleLike\"\n                :title=\"isLiked ? '取消点赞' : '点赞'\"></el-button>\n              <span class=\"count\">{{ article.likes_count || 0 }}</span>\n            </div>\n            <div class=\"interaction-item\">\n              <el-button :type=\"isFavorited ? 'warning' : 'default'\" icon=\"el-icon-star-on\" circle\n                @click=\"handleFavorite\" :title=\"isFavorited ? '取消收藏' : '收藏'\"></el-button>\n              <span class=\"count\">{{ article.favorites_count || 0 }}</span>\n            </div>\n          </div>\n        </el-card>\n\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\" class=\"comment-header-title\">全部评论 ({{ commentsCount }})</div>\n\n          <!-- 评论输入框 -->\n          <el-form :model=\"commentForm\" ref=\"commentForm\" class=\"comment-form\">\n            <div class=\"comment-input-row\">\n              <el-avatar :size=\"40\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              <div class=\"input-main\">\n                <el-row :gutter=\"10\" v-if=\"!isLoggedIn\" style=\"margin-bottom: 10px\">\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.nickname\" placeholder=\"昵称 (必填)\" size=\"small\"></el-input>\n                  </el-col>\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.email\" placeholder=\"邮箱 (可选)\" size=\"small\"></el-input>\n                  </el-col>\n                </el-row>\n                <el-input type=\"textarea\" :rows=\"3\" v-model=\"commentForm.content\" :placeholder=\"replyPlaceholder\"\n                  @focus=\"onCommentFocus\"></el-input>\n                <div class=\"form-actions\" v-if=\"commentForm.content || showActions\">\n                  <el-button v-if=\"commentForm.parent_id\" size=\"small\" @click=\"cancelReply\">取消回复</el-button>\n                  <el-button type=\"primary\" size=\"small\" @click=\"submitComment\">提交评论</el-button>\n                </div>\n              </div>\n            </div>\n          </el-form>\n\n          <!-- 评论列表 -->\n          <div class=\"comment-list\">\n            <div v-for=\"comment in nestedComments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-main\">\n                <el-avatar :size=\"40\" :src=\"comment.User ? comment.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                <div class=\"comment-body\">\n                  <div class=\"comment-info\">\n                    <span class=\"nickname\">{{ comment.nickname }}</span>\n                    <span class=\"date\">{{ formatDate(comment.created_at) }}</span>\n                  </div>\n                  <div class=\"comment-text\">{{ comment.content }}</div>\n                  <div class=\"comment-footer\">\n                    <span class=\"reply-btn\" @click=\"handleReply(comment)\">回复</span>\n                  </div>\n\n                  <!-- 子评论 (二级评论) -->\n                  <div v-if=\"comment.replies && comment.replies.length\" class=\"reply-list\">\n                    <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"reply-item\">\n                      <el-avatar :size=\"30\" :src=\"reply.User ? reply.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                      <div class=\"reply-body\">\n                        <div class=\"comment-info\">\n                          <span class=\"nickname\">{{ reply.nickname }}</span>\n                          <span class=\"date\">{{ formatDate(reply.created_at) }}</span>\n                        </div>\n                        <div class=\"comment-text\">{{ reply.content }}</div>\n                        <div class=\"comment-footer\">\n                          <span class=\"reply-btn\" @click=\"handleReply(reply, comment.id)\">回复</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div v-if=\"comments.length === 0\" class=\"no-comments\">暂无评论，快来抢沙发吧！</div>\n          </div>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport 'github-markdown-css/github-markdown.css'\n\nexport default {\n  name: 'ArticleDetail',\n  data () {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false\n    }\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle()\n        this.fetchComments()\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus()\n        }\n      },\n      immediate: true\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    canManage () {\n      if (!this.isLoggedIn || !this.article.id) return false\n      return this.currentUser.role === 'admin' || (this.article.user_id === this.currentUser.id)\n    }\n  },\n  created () {\n    // 逻辑已移至 watch\n  },\n  methods: {\n    async fetchArticle () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        this.article = response.data\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    async fetchInteractionStatus () {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.isLiked = response.data.isLiked\n        this.isFavorited = response.data.isFavorited\n      } catch (error) {\n        console.error('获取交互状态失败', error)\n      }\n    },\n    async handleLike () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isLiked = response.data.isLiked\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败')\n      }\n    },\n    async handleFavorite () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isFavorited = response.data.isFavorited\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败')\n      }\n    },\n    handleEdit () {\n      this.$router.push(`/admin/article/edit/${this.article.id}`)\n    },\n    async handleDelete () {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.$router.push('/')\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async fetchComments () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`)\n        this.comments = response.data\n      } catch (error) {\n        console.error('获取评论失败', error)\n      }\n    },\n    async submitComment () {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容')\n        return\n      }\n      try {\n        const id = this.$route.params.id\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        })\n        this.$message.success('评论提交成功')\n        this.commentForm.nickname = ''\n        this.commentForm.email = ''\n        this.commentForm.content = ''\n        this.fetchComments() // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n\n.header-content {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.logo {\n  font-size: 24px;\n  font-weight: bold;\n  color: #409eff;\n  cursor: pointer;\n}\n\n.main {\n  max-width: 1000px;\n  margin: 20px auto;\n  padding: 0 20px;\n}\n\n.title-wrapper {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.title {\n  font-size: 32px;\n  margin: 10px 0;\n  color: #303133;\n  flex: 1;\n}\n\n.detail-manage {\n  margin-left: 20px;\n}\n\n.meta {\n  margin-top: 15px;\n  color: #909399;\n  font-size: 14px;\n}\n\n.meta span {\n  margin-right: 20px;\n}\n\n.meta i {\n  margin-right: 5px;\n}\n\n.content {\n  line-height: 1.8;\n  font-size: 16px;\n  padding: 20px 0;\n  color: #333;\n  overflow-x: auto;\n  /* 处理长代码或表格溢出 */\n}\n\n/* 覆盖 markdown-body 的默认样式以匹配页面主题 */\n.markdown-body {\n  background-color: transparent !important;\n  font-family: inherit !important;\n}\n\n.tags {\n  margin-top: 20px;\n  padding-top: 10px;\n  border-top: 1px solid #f2f6fc;\n}\n\n.interactions {\n  margin-top: 30px;\n  display: flex;\n  justify-content: center;\n  gap: 40px;\n}\n\n.interaction-item {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n}\n\n.interaction-item .count {\n  font-size: 14px;\n  color: #909399;\n}\n\n.comment-count {\n  font-weight: bold;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #409eff;\n  display: inline-block;\n}\n\n.comment-item {\n  padding: 15px 0;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.comment-nickname {\n  font-weight: bold;\n  color: #409eff;\n}\n\n.comment-date {\n  color: #909399;\n  font-size: 12px;\n  margin-left: 10px;\n}\n\n.comment-content {\n  margin-top: 8px;\n  line-height: 1.6;\n}\n\n.no-comments {\n  text-align: center;\n  color: #909399;\n  padding: 30px 0;\n}\n</style>\n"],"mappings":"AAwHA,OAAAA,KAAA;AACA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,KAAA;QACAC,OAAA;MACA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,WAAA;IACA;EACA;EACAC,KAAA;IACA;IACA;MACAC,OAAA,WAAAA,CAAA;QACA,KAAAC,YAAA