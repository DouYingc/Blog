{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'RelatedArticles',\n  props: {\n    currentArticleId: {\n      type: [Number, String],\n      required: true\n    }\n  },\n  data() {\n    return {\n      articles: []\n    };\n  },\n  watch: {\n    currentArticleId: {\n      handler(val) {\n        if (val) this.fetchRelatedArticles();\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    async fetchRelatedArticles() {\n      try {\n        const response = await axios.get(`/articles/${this.currentArticleId}/related`);\n        this.articles = response.data;\n      } catch (error) {\n        console.error('Fetch related articles failed', error);\n      }\n    },\n    goToArticle(id) {\n      this.$router.push(`/article/${id}`);\n    },\n    formatDate(date) {\n      if (!date) return '';\n      return new Date(date).toLocaleDateString();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","props","currentArticleId","type","Number","String","required","data","articles","watch","handler","val","fetchRelatedArticles","immediate","methods","response","get","error","console","goToArticle","id","$router","push","formatDate","date","Date","toLocaleDateString"],"sources":["src/components/RelatedArticles.vue"],"sourcesContent":["<template>\n  <div class=\"related-articles\" v-if=\"articles.length > 0\">\n    <div class=\"related-title\">相关推荐</div>\n    <el-row :gutter=\"20\">\n      <el-col :span=\"6\" v-for=\"article in articles\" :key=\"article.id\">\n        <el-card shadow=\"hover\" :body-style=\"{ padding: '0px' }\" class=\"related-card\"\n          @click.native=\"goToArticle(article.id)\">\n          <div class=\"image-placeholder\" v-if=\"!article.cover\">\n            {{ article.title.charAt(0) }}\n          </div>\n          <img v-else :src=\"article.cover\" class=\"image\">\n          <div style=\"padding: 14px;\">\n            <div class=\"related-article-title\" :title=\"article.title\">{{ article.title }}</div>\n            <div class=\"related-article-meta\">\n              <span><i class=\"el-icon-view\"></i> {{ article.views }}</span>\n              <span>{{ formatDate(article.created_at) }}</span>\n            </div>\n          </div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'RelatedArticles',\n  props: {\n    currentArticleId: {\n      type: [Number, String],\n      required: true\n    }\n  },\n  data () {\n    return {\n      articles: []\n    }\n  },\n  watch: {\n    currentArticleId: {\n      handler (val) {\n        if (val) this.fetchRelatedArticles()\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    async fetchRelatedArticles () {\n      try {\n        const response = await axios.get(`/articles/${this.currentArticleId}/related`)\n        this.articles = response.data\n      } catch (error) {\n        console.error('Fetch related articles failed', error)\n      }\n    },\n    goToArticle (id) {\n      this.$router.push(`/article/${id}`)\n    },\n    formatDate (date) {\n      if (!date) return ''\n      return new Date(date).toLocaleDateString()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.related-articles {\n  margin-top: 40px;\n  border-top: 1px solid #eee;\n  padding-top: 20px;\n}\n\n.related-title {\n  font-size: 20px;\n  font-weight: bold;\n  margin-bottom: 20px;\n  padding-left: 10px;\n  border-left: 4px solid #409EFF;\n}\n\n.related-card {\n  cursor: pointer;\n  transition: all 0.3s;\n  height: 100%;\n}\n\n.related-card:hover {\n  transform: translateY(-5px);\n}\n\n.related-article-title {\n  font-size: 16px;\n  font-weight: bold;\n  margin-bottom: 10px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  height: 44px;\n  line-height: 22px;\n}\n\n.related-article-meta {\n  font-size: 12px;\n  color: #999;\n  display: flex;\n  justify-content: space-between;\n}\n\n.image {\n  width: 100%;\n  height: 120px;\n  object-fit: cover;\n  display: block;\n}\n\n.image-placeholder {\n  width: 100%;\n  height: 120px;\n  background-color: #f5f7fa;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 40px;\n  color: #c0c4cc;\n}\n</style>\n"],"mappings":"AAyBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACAC,gBAAA;MACAC,IAAA,GAAAC,MAAA,EAAAC,MAAA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,QAAA;IACA;EACA;EACAC,KAAA;IACAP,gBAAA;MACAQ,QAAAC,GAAA;QACA,IAAAA,GAAA,OAAAC,oBAAA;MACA;MACAC,SAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAF,qBAAA;MACA;QACA,MAAAG,QAAA,SAAAhB,KAAA,CAAAiB,GAAA,mBAAAd,gBAAA;QACA,KAAAM,QAAA,GAAAO,QAAA,CAAAR,IAAA;MACA,SAAAU,KAAA;QACAC,OAAA,CAAAD,KAAA,kCAAAA,KAAA;MACA;IACA;IACAE,YAAAC,EAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,aAAAF,EAAA;IACA;IACAG,WAAAC,IAAA;MACA,KAAAA,IAAA;MACA,WAAAC,IAAA,CAAAD,IAAA,EAAAE,kBAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}