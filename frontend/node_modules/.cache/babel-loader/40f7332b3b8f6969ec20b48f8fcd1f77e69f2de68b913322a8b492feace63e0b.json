{"ast":null,"code":"import axios from 'axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'HomeView',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      articles: [],\n      categories: [],\n      tags: [],\n      total: 0,\n      pageSize: 10,\n      currentPage: 1,\n      categoryId: null,\n      tagId: null,\n      keyword: '',\n      recentMessages: [],\n      hotArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    isAdmin() {\n      return this.currentUser.role === 'admin';\n    }\n  },\n  created() {\n    this.keyword = this.$route.query.keyword || '';\n    this.fetchArticles();\n    this.fetchCategories();\n    this.fetchTags();\n    this.fetchRecentMessages();\n    this.fetchHotArticles();\n  },\n  watch: {\n    '$route.query.keyword'(newVal) {\n      this.keyword = newVal || '';\n      this.currentPage = 1;\n      this.fetchArticles();\n    }\n  },\n  methods: {\n    async fetchHotArticles() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            limit: 5,\n            order: 'views'\n          } // 后端需支持按阅读量排序\n        });\n        this.hotArticles = response.data.articles;\n      } catch (error) {\n        console.error('获取热门文章失败', error);\n      }\n    },\n    async fetchRecentMessages() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages');\n        this.recentMessages = response.data.slice(0, 5); // 只取前5条\n      } catch (error) {\n        console.error('获取最近留言失败', error);\n      }\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      return `${date.getMonth() + 1}-${date.getDate()}`;\n    },\n    handleSearch(keyword) {\n      this.keyword = keyword;\n      this.currentPage = 1;\n      this.fetchArticles();\n    },\n    async fetchArticles() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            page: this.currentPage,\n            limit: this.pageSize,\n            category_id: this.categoryId,\n            tag_id: this.tagId,\n            keyword: this.keyword\n          }\n        });\n        this.articles = response.data.articles;\n        this.total = response.data.total;\n      } catch (error) {\n        this.$message.error('获取文章列表失败');\n      }\n    },\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('获取分类失败');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('获取标签失败');\n      }\n    },\n    handlePageChange(page) {\n      this.currentPage = page;\n      this.fetchArticles();\n    },\n    filterByCategory(id) {\n      this.categoryId = id;\n      this.tagId = null;\n      this.currentPage = 1;\n      this.fetchArticles();\n    },\n    filterByTag(id) {\n      this.tagId = id;\n      this.categoryId = null;\n      this.currentPage = 1;\n      this.fetchArticles();\n    },\n    canManage(article) {\n      return this.isAdmin || article.user_id === this.currentUser.id;\n    },\n    handleEdit(id) {\n      this.$router.push(`/article/edit/${id}`);\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchArticles();\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    viewDetail(id) {\n      this.$router.push(`/article/${id}`);\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$message.success('已退出登录');\n      location.reload(); // 刷新页面更新状态\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","articles","categories","tags","total","pageSize","currentPage","categoryId","tagId","keyword","recentMessages","hotArticles","currentUser","JSON","parse","localStorage","getItem","computed","isLoggedIn","isAdmin","role","created","$route","query","fetchArticles","fetchCategories","fetchTags","fetchRecentMessages","fetchHotArticles","watch","$route.query.keyword","newVal","methods","response","get","params","limit","order","error","console","slice","formatDate","dateStr","date","Date","isNaN","getTime","getMonth","getDate","handleSearch","page","category_id","tag_id","$message","handlePageChange","filterByCategory","id","filterByTag","canManage","article","user_id","handleEdit","$router","push","handleDelete","$confirm","type","delete","headers","Authorization","success","viewDetail","handleLogout","removeItem","location","reload"],"sources":["src/views/Home.vue"],"sourcesContent":["<template>\n  <div class=\"home\">\n    <el-container>\n      <nav-bar @search=\"handleSearch\"></nav-bar>\n\n      <el-main class=\"main\">\n        <div class=\"main-layout\">\n          <!-- 左侧内容区 (75%) -->\n          <div class=\"left-container\">\n            <div class=\"article-list\">\n              <template v-if=\"articles.length > 0\">\n                <el-card v-for=\"article in articles\" :key=\"article.id\" class=\"article-card\">\n                  <div class=\"article-item\">\n                    <!-- 文章封面图 -->\n                    <div v-if=\"article.cover\" class=\"article-cover\" @click=\"viewDetail(article.id)\">\n                      <img :src=\"article.cover\" alt=\"封面\">\n                    </div>\n\n                    <div class=\"article-content\">\n                      <div slot=\"header\" class=\"clearfix article-header\">\n                        <span class=\"article-title\" @click=\"viewDetail(article.id)\">{{ article.title }}</span>\n                        <el-tag v-if=\"article.is_top\" size=\"mini\" type=\"danger\" style=\"margin-left: 10px\">置顶</el-tag>\n                        <!-- 为作者或管理员显示管理按钮 -->\n                        <span v-if=\"canManage(article)\" class=\"manage-shortcuts\">\n                          <el-button size=\"mini\" type=\"text\" icon=\"el-icon-edit\"\n                            @click.stop=\"handleEdit(article.id)\">编辑</el-button>\n                          <el-button size=\"mini\" type=\"text\" icon=\"el-icon-delete\" style=\"color: #F56C6C\"\n                            @click.stop=\"handleDelete(article.id)\">删除</el-button>\n                        </span>\n                      </div>\n                      <div class=\"article-summary\">{{ article.summary }}</div>\n                      <div class=\"article-footer\">\n                        <span class=\"article-info user-link\"\n                          @click.stop=\"$router.push(`/user/profile/${article.user_id}`)\">\n                          <i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}\n                        </span>\n                        <span class=\"article-info\">\n                          <i class=\"el-icon-date\"></i> {{ new Date(article.created_at).toLocaleDateString() }}\n                        </span>\n                        <span class=\"article-info\">\n                          <i class=\"el-icon-view\"></i> 阅读: {{ article.views }}\n                        </span>\n                        <span class=\"article-info\">\n                          <i class=\"el-icon-caret-top\"></i> 点赞: {{ article.likes_count || 0 }}\n                        </span>\n                        <span class=\"article-info\">\n                          <i class=\"el-icon-star-on\"></i> 收藏: {{ article.favorites_count || 0 }}\n                        </span>\n                        <span class=\"article-info\" v-if=\"article.Category\">\n                          <i class=\"el-icon-folder\"></i> {{ article.Category.name }}\n                        </span>\n                      </div>\n                    </div>\n                  </div>\n                </el-card>\n                <el-pagination layout=\"prev, pager, next\" :total=\"total\" :page-size=\"pageSize\"\n                  @current-change=\"handlePageChange\" style=\"text-align: center; margin-top: 20px\"></el-pagination>\n              </template>\n              <el-card v-else class=\"empty-card\">\n                <el-empty description=\"该分类下暂无文章\"></el-empty>\n              </el-card>\n            </div>\n          </div>\n\n          <!-- 右侧侧边栏 (25%) -->\n          <div class=\"right-container\">\n            <el-card class=\"sidebar-card\">\n              <div slot=\"header\">文章分类</div>\n              <ul class=\"sidebar-list\">\n                <li :class=\"{ active: categoryId === null }\" @click=\"filterByCategory(null)\">全部文章</li>\n                <li v-for=\"cat in categories\" :key=\"cat.id\" :class=\"{ active: categoryId === cat.id }\"\n                  @click=\"filterByCategory(cat.id)\">{{ cat.name }}</li>\n              </ul>\n            </el-card>\n            <!-- 留言板侧边栏快捷入口 (论坛化增强) -->\n            <el-card class=\"sidebar-card\" style=\"margin-top: 20px\">\n              <div slot=\"header\" class=\"sidebar-header\">\n                <span>社区动态</span>\n                <el-button type=\"text\" @click=\"$router.push('/messages')\">更多</el-button>\n              </div>\n              <div class=\"mini-messages\">\n                <div v-for=\"msg in recentMessages\" :key=\"msg.id\" class=\"mini-msg-item\">\n                  <div class=\"mini-msg-info\">\n                    <strong>{{ msg.nickname }}</strong>\n                    <span>{{ formatDate(msg.created_at) }}</span>\n                  </div>\n                  <div class=\"mini-msg-content\">{{ msg.content }}</div>\n                </div>\n                <div v-if=\"recentMessages.length === 0\" class=\"empty-mini\">暂无动态</div>\n              </div>\n            </el-card>\n\n            <el-card class=\"sidebar-card\" style=\"margin-top: 20px\">\n              <div slot=\"header\">热门讨论</div>\n              <ul class=\"sidebar-list\">\n                <li v-for=\"art in hotArticles\" :key=\"art.id\" @click=\"viewDetail(art.id)\">\n                  <div class=\"hot-item\">\n                    <span class=\"hot-title\">{{ art.title }}</span>\n                    <span class=\"hot-views\"><i class=\"el-icon-view\"></i> {{ art.views }}</span>\n                  </div>\n                </li>\n              </ul>\n            </el-card>\n\n            <el-card class=\"sidebar-card\" style=\"margin-top: 20px\">\n              <div slot=\"header\">热门标签</div>\n              <div class=\"tag-cloud\">\n                <el-tag v-for=\"tag in tags\" :key=\"tag.id\" size=\"small\" :type=\"tagId === tag.id ? 'primary' : 'info'\"\n                  style=\"margin: 5px; cursor: pointer\" @click=\"filterByTag(tag.id)\">{{ tag.name }}</el-tag>\n              </div>\n            </el-card>\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'HomeView',\n  components: { NavBar },\n  data () {\n    return {\n      articles: [],\n      categories: [],\n      tags: [],\n      total: 0,\n      pageSize: 10,\n      currentPage: 1,\n      categoryId: null,\n      tagId: null,\n      keyword: '',\n      recentMessages: [],\n      hotArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    isAdmin () {\n      return this.currentUser.role === 'admin'\n    }\n  },\n  created () {\n    this.keyword = this.$route.query.keyword || ''\n    this.fetchArticles()\n    this.fetchCategories()\n    this.fetchTags()\n    this.fetchRecentMessages()\n    this.fetchHotArticles()\n  },\n  watch: {\n    '$route.query.keyword' (newVal) {\n      this.keyword = newVal || ''\n      this.currentPage = 1\n      this.fetchArticles()\n    }\n  },\n  methods: {\n    async fetchHotArticles () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: { limit: 5, order: 'views' } // 后端需支持按阅读量排序\n        })\n        this.hotArticles = response.data.articles\n      } catch (error) {\n        console.error('获取热门文章失败', error)\n      }\n    },\n    async fetchRecentMessages () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages')\n        this.recentMessages = response.data.slice(0, 5) // 只取前5条\n      } catch (error) {\n        console.error('获取最近留言失败', error)\n      }\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      return `${date.getMonth() + 1}-${date.getDate()}`\n    },\n    handleSearch (keyword) {\n      this.keyword = keyword\n      this.currentPage = 1\n      this.fetchArticles()\n    },\n    async fetchArticles () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            page: this.currentPage,\n            limit: this.pageSize,\n            category_id: this.categoryId,\n            tag_id: this.tagId,\n            keyword: this.keyword\n          }\n        })\n        this.articles = response.data.articles\n        this.total = response.data.total\n      } catch (error) {\n        this.$message.error('获取文章列表失败')\n      }\n    },\n    async fetchCategories () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories')\n        this.categories = response.data\n      } catch (error) {\n        this.$message.error('获取分类失败')\n      }\n    },\n    async fetchTags () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags')\n        this.tags = response.data\n      } catch (error) {\n        this.$message.error('获取标签失败')\n      }\n    },\n    handlePageChange (page) {\n      this.currentPage = page\n      this.fetchArticles()\n    },\n    filterByCategory (id) {\n      this.categoryId = id\n      this.tagId = null\n      this.currentPage = 1\n      this.fetchArticles()\n    },\n    filterByTag (id) {\n      this.tagId = id\n      this.categoryId = null\n      this.currentPage = 1\n      this.fetchArticles()\n    },\n    canManage (article) {\n      return this.isAdmin || (article.user_id === this.currentUser.id)\n    },\n    handleEdit (id) {\n      this.$router.push(`/article/edit/${id}`)\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchArticles()\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    viewDetail (id) {\n      this.$router.push(`/article/${id}`)\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$message.success('已退出登录')\n      location.reload() // 刷新页面更新状态\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/Home.css\"></style>\n"],"mappings":"AAuHA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,QAAA;MACAC,UAAA;MACAC,IAAA;MACAC,KAAA;MACAC,QAAA;MACAC,WAAA;MACAC,UAAA;MACAC,KAAA;MACAC,OAAA;MACAC,cAAA;MACAC,WAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAH,YAAA,CAAAC,OAAA;IACA;IACAG,QAAA;MACA,YAAAP,WAAA,CAAAQ,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAZ,OAAA,QAAAa,MAAA,CAAAC,KAAA,CAAAd,OAAA;IACA,KAAAe,aAAA;IACA,KAAAC,eAAA;IACA,KAAAC,SAAA;IACA,KAAAC,mBAAA;IACA,KAAAC,gBAAA;EACA;EACAC,KAAA;IACA,sBAAAC,CAAAC,MAAA;MACA,KAAAtB,OAAA,GAAAsB,MAAA;MACA,KAAAzB,WAAA;MACA,KAAAkB,aAAA;IACA;EACA;EACAQ,OAAA;IACA,MAAAJ,iBAAA;MACA;QACA,MAAAK,QAAA,SAAArC,KAAA,CAAAsC,GAAA;UACAC,MAAA;YAAAC,KAAA;YAAAC,KAAA;UAAA;QACA;QACA,KAAA1B,WAAA,GAAAsB,QAAA,CAAAjC,IAAA,CAAAC,QAAA;MACA,SAAAqC,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACA,MAAAX,oBAAA;MACA;QACA,MAAAM,QAAA,SAAArC,KAAA,CAAAsC,GAAA;QACA,KAAAxB,cAAA,GAAAuB,QAAA,CAAAjC,IAAA,CAAAwC,KAAA;MACA,SAAAF,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACAG,WAAAC,OAAA;MACA,KAAAA,OAAA,IAAAA,OAAA,oBAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,IAAAG,KAAA,CAAAF,IAAA,CAAAG,OAAA;MACA,UAAAH,IAAA,CAAAI,QAAA,UAAAJ,IAAA,CAAAK,OAAA;IACA;IACAC,aAAAxC,OAAA;MACA,KAAAA,OAAA,GAAAA,OAAA;MACA,KAAAH,WAAA;MACA,KAAAkB,aAAA;IACA;IACA,MAAAA,cAAA;MACA;QACA,MAAAS,QAAA,SAAArC,KAAA,CAAAsC,GAAA;UACAC,MAAA;YACAe,IAAA,OAAA5C,WAAA;YACA8B,KAAA,OAAA/B,QAAA;YACA8C,WAAA,OAAA5C,UAAA;YACA6C,MAAA,OAAA5C,KAAA;YACAC,OAAA,OAAAA;UACA;QACA;QACA,KAAAR,QAAA,GAAAgC,QAAA,CAAAjC,IAAA,CAAAC,QAAA;QACA,KAAAG,KAAA,GAAA6B,QAAA,CAAAjC,IAAA,CAAAI,KAAA;MACA,SAAAkC,KAAA;QACA,KAAAe,QAAA,CAAAf,KAAA;MACA;IACA;IACA,MAAAb,gBAAA;MACA;QACA,MAAAQ,QAAA,SAAArC,KAAA,CAAAsC,GAAA;QACA,KAAAhC,UAAA,GAAA+B,QAAA,CAAAjC,IAAA;MACA,SAAAsC,KAAA;QACA,KAAAe,QAAA,CAAAf,KAAA;MACA;IACA;IACA,MAAAZ,UAAA;MACA;QACA,MAAAO,QAAA,SAAArC,KAAA,CAAAsC,GAAA;QACA,KAAA/B,IAAA,GAAA8B,QAAA,CAAAjC,IAAA;MACA,SAAAsC,KAAA;QACA,KAAAe,QAAA,CAAAf,KAAA;MACA;IACA;IACAgB,iBAAAJ,IAAA;MACA,KAAA5C,WAAA,GAAA4C,IAAA;MACA,KAAA1B,aAAA;IACA;IACA+B,iBAAAC,EAAA;MACA,KAAAjD,UAAA,GAAAiD,EAAA;MACA,KAAAhD,KAAA;MACA,KAAAF,WAAA;MACA,KAAAkB,aAAA;IACA;IACAiC,YAAAD,EAAA;MACA,KAAAhD,KAAA,GAAAgD,EAAA;MACA,KAAAjD,UAAA;MACA,KAAAD,WAAA;MACA,KAAAkB,aAAA;IACA;IACAkC,UAAAC,OAAA;MACA,YAAAxC,OAAA,IAAAwC,OAAA,CAAAC,OAAA,UAAAhD,WAAA,CAAA4C,EAAA;IACA;IACAK,WAAAL,EAAA;MACA,KAAAM,OAAA,CAAAC,IAAA,kBAAAP,EAAA;IACA;IACA,MAAAQ,aAAAR,EAAA;MACA;QACA,WAAAS,QAAA;UAAAC,IAAA;QAAA;QACA,MAAAtE,KAAA,CAAAuE,MAAA,uCAAAX,EAAA;UACAY,OAAA;YAAAC,aAAA,YAAAtD,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAqC,QAAA,CAAAiB,OAAA;QACA,KAAA9C,aAAA;MACA,SAAAc,KAAA;QACA,IAAAA,KAAA,oBAAAe,QAAA,CAAAf,KAAA;MACA;IACA;IACAiC,WAAAf,EAAA;MACA,KAAAM,OAAA,CAAAC,IAAA,aAAAP,EAAA;IACA;IACAgB,aAAA;MACAzD,YAAA,CAAA0D,UAAA;MACA1D,YAAA,CAAA0D,UAAA;MACA,KAAApB,QAAA,CAAAiB,OAAA;MACAI,QAAA,CAAAC,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}