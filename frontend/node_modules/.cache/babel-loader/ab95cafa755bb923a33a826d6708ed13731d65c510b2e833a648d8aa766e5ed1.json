{"ast":null,"code":"import axios from 'axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'Archives',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      articles: []\n    };\n  },\n  computed: {\n    timeline() {\n      const groups = {};\n      this.articles.forEach(article => {\n        const date = new Date(article.created_at);\n        const year = date.getFullYear();\n        if (!groups[year]) {\n          groups[year] = [];\n        }\n        groups[year].push(article);\n      });\n      return Object.keys(groups).sort((a, b) => b - a).map(year => ({\n        year: year + '年',\n        items: groups[year]\n      }));\n    }\n  },\n  created() {\n    this.fetchArchives();\n  },\n  methods: {\n    async fetchArchives() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles?type=archives');\n        this.articles = response.data;\n      } catch (error) {\n        this.$message.error('获取归档失败');\n      }\n    },\n    formatDate(dateStr) {\n      const date = new Date(dateStr);\n      return `${date.getMonth() + 1}-${date.getDate()}`;\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","articles","computed","timeline","groups","forEach","article","date","Date","created_at","year","getFullYear","push","Object","keys","sort","a","b","map","items","created","fetchArchives","methods","response","get","error","$message","formatDate","dateStr","getMonth","getDate"],"sources":["src/views/Archives.vue"],"sourcesContent":["<template>\n  <div class=\"archives-page\">\n    <nav-bar></nav-bar>\n    <div class=\"main-container\">\n      <el-card class=\"timeline-card\">\n        <div slot=\"header\" class=\"clearfix\">\n          <span class=\"card-title\">文章归档</span>\n          <span class=\"article-count\">共 {{ articles.length }} 篇</span>\n        </div>\n        <el-timeline>\n          <el-timeline-item v-for=\"(activity, index) in timeline\" :key=\"index\" :timestamp=\"activity.year\" placement=\"top\" size=\"large\" type=\"primary\">\n            <el-card v-for=\"item in activity.items\" :key=\"item.id\" class=\"archive-item\" shadow=\"hover\" @click.native=\"$router.push(`/article/${item.id}`)\">\n              <div class=\"item-content\">\n                <span class=\"item-date\">{{ formatDate(item.created_at) }}</span>\n                <span class=\"item-title\">{{ item.title }}</span>\n              </div>\n            </el-card>\n          </el-timeline-item>\n        </el-timeline>\n      </el-card>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'Archives',\n  components: { NavBar },\n  data() {\n    return {\n      articles: []\n    }\n  },\n  computed: {\n    timeline() {\n      const groups = {}\n      this.articles.forEach(article => {\n        const date = new Date(article.created_at)\n        const year = date.getFullYear()\n        if (!groups[year]) {\n          groups[year] = []\n        }\n        groups[year].push(article)\n      })\n      \n      return Object.keys(groups).sort((a, b) => b - a).map(year => ({\n        year: year + '年',\n        items: groups[year]\n      }))\n    }\n  },\n  created() {\n    this.fetchArchives()\n  },\n  methods: {\n    async fetchArchives() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles?type=archives')\n        this.articles = response.data\n      } catch (error) {\n        this.$message.error('获取归档失败')\n      }\n    },\n    formatDate(dateStr) {\n      const date = new Date(dateStr)\n      return `${date.getMonth() + 1}-${date.getDate()}`\n    }\n  }\n}\n</script>\n\n<style scoped>\n.archives-page {\n  min-height: 100vh;\n  background-color: #f5f7fa;\n}\n\n.main-container {\n  max-width: 1000px;\n  margin: 20px auto;\n  padding: 0 20px;\n}\n\n.timeline-card {\n  min-height: 500px;\n}\n\n.card-title {\n  font-size: 20px;\n  font-weight: bold;\n}\n\n.article-count {\n  float: right;\n  color: #909399;\n  font-size: 14px;\n  margin-top: 5px;\n}\n\n.archive-item {\n  margin-bottom: 10px;\n  cursor: pointer;\n  transition: transform 0.2s;\n}\n\n.archive-item:hover {\n  transform: translateX(5px);\n}\n\n.item-content {\n  display: flex;\n  align-items: center;\n}\n\n.item-date {\n  color: #909399;\n  margin-right: 15px;\n  font-family: monospace;\n}\n\n.item-title {\n  font-size: 16px;\n  color: #303133;\n}\n</style>\n"],"mappings":"AAyBA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACAC,SAAA;MACA,MAAAC,MAAA;MACA,KAAAH,QAAA,CAAAI,OAAA,CAAAC,OAAA;QACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA,CAAAG,UAAA;QACA,MAAAC,IAAA,GAAAH,IAAA,CAAAI,WAAA;QACA,KAAAP,MAAA,CAAAM,IAAA;UACAN,MAAA,CAAAM,IAAA;QACA;QACAN,MAAA,CAAAM,IAAA,EAAAE,IAAA,CAAAN,OAAA;MACA;MAEA,OAAAO,MAAA,CAAAC,IAAA,CAAAV,MAAA,EAAAW,IAAA,EAAAC,CAAA,EAAAC,CAAA,KAAAA,CAAA,GAAAD,CAAA,EAAAE,GAAA,CAAAR,IAAA;QACAA,IAAA,EAAAA,IAAA;QACAS,KAAA,EAAAf,MAAA,CAAAM,IAAA;MACA;IACA;EACA;EACAU,QAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAD,cAAA;MACA;QACA,MAAAE,QAAA,SAAA3B,KAAA,CAAA4B,GAAA;QACA,KAAAvB,QAAA,GAAAsB,QAAA,CAAAvB,IAAA;MACA,SAAAyB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,WAAAC,OAAA;MACA,MAAArB,IAAA,OAAAC,IAAA,CAAAoB,OAAA;MACA,UAAArB,IAAA,CAAAsB,QAAA,UAAAtB,IAAA,CAAAuB,OAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}