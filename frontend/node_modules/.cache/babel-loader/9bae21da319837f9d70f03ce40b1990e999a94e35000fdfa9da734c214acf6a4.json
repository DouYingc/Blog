{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'MessageBoard',\n  data() {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    };\n  },\n  created() {\n    if (this.currentUser.username) {\n      this.messageForm.nickname = this.currentUser.username;\n    }\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages');\n        this.messages = response.data;\n      } catch (error) {\n        this.$message.error('获取留言失败');\n      }\n    },\n    async submitMessage() {\n      if (!this.messageForm.nickname || !this.messageForm.content) {\n        this.$message.warning('请填写昵称和内容');\n        return;\n      }\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm);\n        this.$message.success('留言成功');\n        this.messageForm.content = '';\n        this.fetchMessages();\n      } catch (error) {\n        this.$message.error('留言失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","messages","messageForm","nickname","content","currentUser","JSON","parse","localStorage","getItem","created","username","fetchMessages","methods","response","get","error","$message","submitMessage","warning","post","success"],"sources":["src/views/MessageBoard.vue"],"sourcesContent":["<template>\n  <div class=\"message-board\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/messages\">留言板</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-card class=\"input-card\">\n          <div slot=\"header\">欢迎留言</div>\n          <el-form :model=\"messageForm\" label-width=\"0\">\n            <el-row :gutter=\"10\">\n              <el-col :span=\"8\">\n                <el-form-item>\n                  <el-input v-model=\"messageForm.nickname\" placeholder=\"昵称 (必填)\"></el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item>\n              <el-input type=\"textarea\" :rows=\"3\" v-model=\"messageForm.content\" placeholder=\"在这里写下你的想法...\"></el-input>\n            </el-form-item>\n            <el-form-item style=\"text-align: right\">\n              <el-button type=\"primary\" @click=\"submitMessage\">提交留言</el-button>\n            </el-form-item>\n          </el-form>\n        </el-card>\n\n        <div class=\"message-list\">\n          <div v-for=\"msg in messages\" :key=\"msg.id\" class=\"message-item\">\n            <el-card shadow=\"hover\">\n              <div class=\"message-header\">\n                <span class=\"nickname\">{{ msg.nickname }}</span>\n                <span class=\"date\">{{ new Date(msg.created_at).toLocaleString() }}</span>\n              </div>\n              <div class=\"message-content\">{{ msg.content }}</div>\n            </el-card>\n          </div>\n          <el-empty v-if=\"messages.length === 0\" description=\"暂无留言\"></el-empty>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'MessageBoard',\n  data () {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    }\n  },\n  created () {\n    if (this.currentUser.username) {\n      this.messageForm.nickname = this.currentUser.username\n    }\n    this.fetchMessages()\n  },\n  methods: {\n    async fetchMessages () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages')\n        this.messages = response.data\n      } catch (error) {\n        this.$message.error('获取留言失败')\n      }\n    },\n    async submitMessage () {\n      if (!this.messageForm.nickname || !this.messageForm.content) {\n        this.$message.warning('请填写昵称和内容')\n        return\n      }\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm)\n        this.$message.success('留言成功')\n        this.messageForm.content = ''\n        this.fetchMessages()\n      } catch (error) {\n        this.$message.error('留言失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n.header-content {\n  max-width: 800px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logo {\n  font-size: 20px;\n  font-weight: bold;\n  color: #409eff;\n  cursor: pointer;\n}\n.main {\n  max-width: 800px;\n  margin: 20px auto;\n}\n.input-card {\n  margin-bottom: 30px;\n}\n.message-item {\n  margin-bottom: 15px;\n}\n.message-header {\n  display: flex;\n  justify-content: space-between;\n  margin-bottom: 10px;\n}\n.nickname {\n  font-weight: bold;\n  color: #409eff;\n}\n.date {\n  color: #999;\n  font-size: 12px;\n}\n.message-content {\n  color: #606266;\n  line-height: 1.6;\n}\n</style>\n"],"mappings":"AAmDA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,OAAA;MACA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACA,SAAAL,WAAA,CAAAM,QAAA;MACA,KAAAT,WAAA,CAAAC,QAAA,QAAAE,WAAA,CAAAM,QAAA;IACA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAD,cAAA;MACA;QACA,MAAAE,QAAA,SAAAhB,KAAA,CAAAiB,GAAA;QACA,KAAAd,QAAA,GAAAa,QAAA,CAAAd,IAAA;MACA,SAAAgB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAE,cAAA;MACA,UAAAhB,WAAA,CAAAC,QAAA,UAAAD,WAAA,CAAAE,OAAA;QACA,KAAAa,QAAA,CAAAE,OAAA;QACA;MACA;MACA;QACA,MAAArB,KAAA,CAAAsB,IAAA,4CAAAlB,WAAA;QACA,KAAAe,QAAA,CAAAI,OAAA;QACA,KAAAnB,WAAA,CAAAE,OAAA;QACA,KAAAQ,aAAA;MACA,SAAAI,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}