{"ast":null,"code":"import axios from 'axios';\nimport 'github-markdown-css/github-markdown.css';\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: '',\n        parent_id: null\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false,\n      showActions: false,\n      replyPlaceholder: '写下你的评论...',\n      errorMsg: '',\n      toc: [],\n      tocVisible: false,\n      readingProgress: 0\n    };\n  },\n  computed: {\n    mainStyle() {\n      return {\n        maxWidth: '1000px',\n        width: '100%',\n        margin: '20px auto',\n        padding: '0 20px',\n        boxSizing: 'border-box'\n      };\n    },\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    canManage() {\n      if (!this.isLoggedIn || !this.article.id) return false;\n      return this.currentUser.role === 'admin' || this.article.user_id === this.currentUser.id;\n    },\n    commentsCount() {\n      return this.comments.length;\n    },\n    nestedComments() {\n      const roots = this.comments.filter(c => !c.parent_id);\n      return roots.map(root => ({\n        ...root,\n        replies: this.comments.filter(c => c.parent_id === root.id)\n      }));\n    }\n  },\n  mounted() {\n    this.updateReadingProgress();\n    window.addEventListener('scroll', this.updateReadingProgress, {\n      passive: true\n    });\n  },\n  beforeDestroy() {\n    window.removeEventListener('scroll', this.updateReadingProgress);\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle();\n        this.fetchComments();\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus();\n        }\n        this.initCommentForm();\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    updateReadingProgress() {\n      const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;\n      const total = (document.documentElement.scrollHeight || 0) - (document.documentElement.clientHeight || 0);\n      const progress = total > 0 ? scrollTop / total * 100 : 0;\n      this.readingProgress = Math.max(0, Math.min(100, Math.round(progress)));\n    },\n    buildToc() {\n      const html = this.article && this.article.html_content ? this.article.html_content : '';\n      if (!html) {\n        this.toc = [];\n        return;\n      }\n      const container = document.createElement('div');\n      container.innerHTML = html;\n      const headings = Array.from(container.querySelectorAll('h1,h2,h3'));\n      this.toc = headings.map((h, idx) => {\n        const level = parseInt(h.tagName.replace('H', ''), 10);\n        const anchor = h.querySelector('a[id]');\n        const id = anchor ? anchor.getAttribute('id') : `toc-${idx}`;\n        const text = (h.textContent || '').trim();\n        return {\n          id,\n          text,\n          level\n        };\n      }).filter(item => item.text);\n    },\n    scrollToHeading(id) {\n      const el = document.getElementById(id);\n      if (el) {\n        el.scrollIntoView({\n          behavior: 'smooth',\n          block: 'start'\n        });\n      }\n      this.tocVisible = false;\n    },\n    initCommentForm() {\n      if (this.isLoggedIn) {\n        this.commentForm.nickname = this.currentUser.username;\n        this.commentForm.email = this.currentUser.email || '';\n      }\n    },\n    onCommentFocus() {\n      this.showActions = true;\n    },\n    handleReply(comment, parentId = null) {\n      this.commentForm.parent_id = parentId || comment.id;\n      this.commentForm.content = `@${comment.nickname} `;\n      this.replyPlaceholder = `回复 @${comment.nickname}`;\n      this.showActions = true;\n      // 滚动到输入框\n      document.querySelector('.comment-form').scrollIntoView({\n        behavior: 'smooth'\n      });\n    },\n    cancelReply() {\n      this.commentForm.parent_id = null;\n      this.commentForm.content = '';\n      this.replyPlaceholder = '写下你的评论...';\n      this.showActions = false;\n    },\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        if (!id) {\n          this.errorMsg = '文章 ID 缺失';\n          this.$message.error('文章 ID 缺失');\n          return;\n        }\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n        this.errorMsg = '';\n        this.buildToc();\n        this.$nextTick(() => {\n          this.updateReadingProgress();\n        });\n      } catch (error) {\n        console.error('获取文章详情失败:', error);\n        this.article = {};\n        const url = `http://localhost:3000/api/articles/${this.$route.params.id}`;\n        this.errorMsg = `获取文章失败: ${error.message} (URL: ${url})`;\n        this.$message.error('获取文章详情失败');\n        this.toc = [];\n      }\n    },\n    async fetchInteractionStatus() {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.isFavorited = response.data.isFavorited;\n      } catch (error) {\n        console.error('获取交互状态失败', error);\n      }\n    },\n    async handleLike() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败');\n      }\n    },\n    async handleFavorite() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isFavorited = response.data.isFavorited;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败');\n      }\n    },\n    handleEdit() {\n      this.$router.push(`/article/edit/${this.article.id}`);\n    },\n    async handleDelete() {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.$router.push('/');\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async fetchComments() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败', error);\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和内容');\n        return;\n      }\n      try {\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: this.article.id\n        });\n        this.$message.success('评论成功');\n        this.commentForm.content = '';\n        this.cancelReply();\n        this.fetchComments();\n      } catch (error) {\n        this.$message.error('评论失败');\n      }\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知时间';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      const Y = date.getFullYear();\n      const M = (date.getMonth() + 1).toString().padStart(2, '0');\n      const D = date.getDate().toString().padStart(2, '0');\n      const h = date.getHours().toString().padStart(2, '0');\n      const m = date.getMinutes().toString().padStart(2, '0');\n      if (isNaN(Y) || isNaN(date.getMonth()) || isNaN(date.getDate())) return '无效日期';\n      return `${Y}-${M}-${D} ${h}:${m}`;\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","article","comments","commentForm","nickname","email","content","parent_id","currentUser","JSON","parse","localStorage","getItem","isLiked","isFavorited","showActions","replyPlaceholder","errorMsg","toc","tocVisible","readingProgress","computed","mainStyle","maxWidth","width","margin","padding","boxSizing","isLoggedIn","canManage","id","role","user_id","commentsCount","length","nestedComments","roots","filter","c","map","root","replies","mounted","updateReadingProgress","window","addEventListener","passive","beforeDestroy","removeEventListener","watch","handler","fetchArticle","fetchComments","fetchInteractionStatus","initCommentForm","immediate","methods","scrollTop","pageYOffset","document","documentElement","total","scrollHeight","clientHeight","progress","Math","max","min","round","buildToc","html","html_content","container","createElement","innerHTML","headings","Array","from","querySelectorAll","h","idx","level","parseInt","tagName","replace","anchor","querySelector","getAttribute","text","textContent","trim","item","scrollToHeading","el","getElementById","scrollIntoView","behavior","block","username","onCommentFocus","handleReply","comment","parentId","cancelReply","$route","params","$message","error","response","get","$nextTick","console","url","message","headers","Authorization","handleLike","post","article_id","success","handleFavorite","handleEdit","$router","push","handleDelete","$confirm","type","delete","submitComment","warning","formatDate","dateStr","date","Date","isNaN","getTime","Y","getFullYear","M","getMonth","toString","padStart","D","getDate","getHours","m","getMinutes"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router>\n            <el-menu-item index=\"/\">首页</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <div class=\"reading-progress\">\n        <div class=\"reading-progress-bar\" :style=\"{ width: readingProgress + '%' }\"></div>\n      </div>\n\n      <el-main class=\"main\" :style=\"mainStyle\">\n        <el-card class=\"detail-card\">\n          <el-alert v-if=\"errorMsg\" :title=\"errorMsg\" type=\"error\" show-icon style=\"margin-bottom: 20px\"></el-alert>\n          <div slot=\"header\">\n            <div class=\"title-wrapper\">\n              <h1 class=\"title\">{{ article.title }}</h1>\n              <div v-if=\"canManage\" class=\"detail-manage\">\n                <el-button type=\"primary\" size=\"small\" icon=\"el-icon-edit\" @click=\"handleEdit\">编辑文章</el-button>\n                <el-button type=\"danger\" size=\"small\" icon=\"el-icon-delete\" @click=\"handleDelete\">删除文章</el-button>\n                <el-button v-if=\"toc.length\" size=\"small\" icon=\"el-icon-tickets\"\n                  @click=\"tocVisible = true\">目录</el-button>\n              </div>\n            </div>\n            <div class=\"meta\">\n              <span class=\"user-link\" @click=\"$router.push(`/user/profile/${article.user_id}`)\">\n                <i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}\n              </span>\n              <span><i class=\"el-icon-date\"></i> {{ formatDate(article.created_at) }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> 阅读: {{ article.views }}</span>\n            </div>\n          </div>\n          <!-- 使用 v-html 渲染 Markdown 解析后的 HTML -->\n          <div class=\"content markdown-body\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name\n              }}</el-tag>\n          </div>\n\n          <!-- 交互操作：点赞与收藏 -->\n          <div class=\"interactions\" v-if=\"isLoggedIn\">\n            <div class=\"interaction-item\">\n              <el-button :type=\"isLiked ? 'primary' : 'default'\" icon=\"el-icon-caret-top\" circle @click=\"handleLike\"\n                :title=\"isLiked ? '取消点赞' : '点赞'\"></el-button>\n              <span class=\"count\">{{ article.likes_count || 0 }}</span>\n            </div>\n            <div class=\"interaction-item\">\n              <el-button :type=\"isFavorited ? 'warning' : 'default'\" icon=\"el-icon-star-on\" circle\n                @click=\"handleFavorite\" :title=\"isFavorited ? '取消收藏' : '收藏'\"></el-button>\n              <span class=\"count\">{{ article.favorites_count || 0 }}</span>\n            </div>\n          </div>\n        </el-card>\n\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\" class=\"comment-header-title\">全部评论 ({{ commentsCount }})</div>\n\n          <!-- 评论输入框 -->\n          <el-form :model=\"commentForm\" ref=\"commentForm\" class=\"comment-form\">\n            <div class=\"comment-input-row\">\n              <el-avatar :size=\"40\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              <div class=\"input-main\">\n                <el-row :gutter=\"10\" v-if=\"!isLoggedIn\" style=\"margin-bottom: 10px\">\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.nickname\" placeholder=\"昵称 (必填)\" size=\"small\"></el-input>\n                  </el-col>\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.email\" placeholder=\"邮箱 (可选)\" size=\"small\"></el-input>\n                  </el-col>\n                </el-row>\n                <el-input type=\"textarea\" :rows=\"3\" v-model=\"commentForm.content\" :placeholder=\"replyPlaceholder\"\n                  @focus=\"onCommentFocus\"></el-input>\n                <div class=\"form-actions\" v-if=\"commentForm.content || showActions\">\n                  <el-button v-if=\"commentForm.parent_id\" size=\"small\" @click=\"cancelReply\">取消回复</el-button>\n                  <el-button type=\"primary\" size=\"small\" @click=\"submitComment\">提交评论</el-button>\n                </div>\n              </div>\n            </div>\n          </el-form>\n\n          <!-- 评论列表 -->\n          <div class=\"comment-list\">\n            <div v-for=\"comment in nestedComments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-main\">\n                <el-avatar :size=\"40\" :src=\"comment.User ? comment.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                <div class=\"comment-body\">\n                  <div class=\"comment-info\">\n                    <span class=\"nickname\" :class=\"{ 'user-link': !!comment.user_id }\"\n                      @click=\"comment.user_id && $router.push(`/user/profile/${comment.user_id}`)\">{{ comment.nickname\n                      }}</span>\n                    <span class=\"date\">{{ formatDate(comment.created_at) }}</span>\n                  </div>\n                  <div class=\"comment-text\">{{ comment.content }}</div>\n                  <div class=\"comment-footer\">\n                    <span class=\"reply-btn\" @click=\"handleReply(comment)\">回复</span>\n                  </div>\n\n                  <!-- 子评论 (二级评论) -->\n                  <div v-if=\"comment.replies && comment.replies.length\" class=\"reply-list\">\n                    <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"reply-item\">\n                      <el-avatar :size=\"30\" :src=\"reply.User ? reply.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                      <div class=\"reply-body\">\n                        <div class=\"comment-info\">\n                          <span class=\"nickname\" :class=\"{ 'user-link': !!reply.user_id }\"\n                            @click=\"reply.user_id && $router.push(`/user/profile/${reply.user_id}`)\">{{ reply.nickname\n                            }}</span>\n                          <span class=\"date\">{{ formatDate(reply.created_at) }}</span>\n                        </div>\n                        <div class=\"comment-text\">{{ reply.content }}</div>\n                        <div class=\"comment-footer\">\n                          <span class=\"reply-btn\" @click=\"handleReply(reply, comment.id)\">回复</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div v-if=\"comments.length === 0\" class=\"no-comments\">暂无评论，快来抢沙发吧！</div>\n          </div>\n        </el-card>\n        <el-backtop :bottom=\"40\" :right=\"40\"></el-backtop>\n      </el-main>\n    </el-container>\n\n    <el-drawer title=\"目录\" :visible.sync=\"tocVisible\" direction=\"rtl\" size=\"320px\">\n      <div class=\"toc-list\">\n        <div v-for=\"item in toc\" :key=\"item.id\" class=\"toc-item\" :class=\"`lv-${item.level}`\"\n          @click=\"scrollToHeading(item.id)\">\n          {{ item.text }}\n        </div>\n      </div>\n    </el-drawer>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport 'github-markdown-css/github-markdown.css'\n\nexport default {\n  name: 'ArticleDetail',\n  data () {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: '',\n        parent_id: null\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false,\n      showActions: false,\n      replyPlaceholder: '写下你的评论...',\n      errorMsg: '',\n      toc: [],\n      tocVisible: false,\n      readingProgress: 0\n    }\n  },\n  computed: {\n    mainStyle () {\n      return {\n        maxWidth: '1000px',\n        width: '100%',\n        margin: '20px auto',\n        padding: '0 20px',\n        boxSizing: 'border-box'\n      }\n    },\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    canManage () {\n      if (!this.isLoggedIn || !this.article.id) return false\n      return this.currentUser.role === 'admin' || (this.article.user_id === this.currentUser.id)\n    },\n    commentsCount () {\n      return this.comments.length\n    },\n    nestedComments () {\n      const roots = this.comments.filter(c => !c.parent_id)\n      return roots.map(root => ({\n        ...root,\n        replies: this.comments.filter(c => c.parent_id === root.id)\n      }))\n    }\n  },\n  mounted () {\n    this.updateReadingProgress()\n    window.addEventListener('scroll', this.updateReadingProgress, { passive: true })\n  },\n  beforeDestroy () {\n    window.removeEventListener('scroll', this.updateReadingProgress)\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle()\n        this.fetchComments()\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus()\n        }\n        this.initCommentForm()\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    updateReadingProgress () {\n      const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0\n      const total = (document.documentElement.scrollHeight || 0) - (document.documentElement.clientHeight || 0)\n      const progress = total > 0 ? (scrollTop / total) * 100 : 0\n      this.readingProgress = Math.max(0, Math.min(100, Math.round(progress)))\n    },\n    buildToc () {\n      const html = this.article && this.article.html_content ? this.article.html_content : ''\n      if (!html) {\n        this.toc = []\n        return\n      }\n      const container = document.createElement('div')\n      container.innerHTML = html\n      const headings = Array.from(container.querySelectorAll('h1,h2,h3'))\n      this.toc = headings.map((h, idx) => {\n        const level = parseInt(h.tagName.replace('H', ''), 10)\n        const anchor = h.querySelector('a[id]')\n        const id = anchor ? anchor.getAttribute('id') : `toc-${idx}`\n        const text = (h.textContent || '').trim()\n        return { id, text, level }\n      }).filter(item => item.text)\n    },\n    scrollToHeading (id) {\n      const el = document.getElementById(id)\n      if (el) {\n        el.scrollIntoView({ behavior: 'smooth', block: 'start' })\n      }\n      this.tocVisible = false\n    },\n    initCommentForm () {\n      if (this.isLoggedIn) {\n        this.commentForm.nickname = this.currentUser.username\n        this.commentForm.email = this.currentUser.email || ''\n      }\n    },\n    onCommentFocus () {\n      this.showActions = true\n    },\n    handleReply (comment, parentId = null) {\n      this.commentForm.parent_id = parentId || comment.id\n      this.commentForm.content = `@${comment.nickname} `\n      this.replyPlaceholder = `回复 @${comment.nickname}`\n      this.showActions = true\n      // 滚动到输入框\n      document.querySelector('.comment-form').scrollIntoView({ behavior: 'smooth' })\n    },\n    cancelReply () {\n      this.commentForm.parent_id = null\n      this.commentForm.content = ''\n      this.replyPlaceholder = '写下你的评论...'\n      this.showActions = false\n    },\n    async fetchArticle () {\n      try {\n        const id = this.$route.params.id\n        if (!id) {\n          this.errorMsg = '文章 ID 缺失'\n          this.$message.error('文章 ID 缺失')\n          return\n        }\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        this.article = response.data\n        this.errorMsg = ''\n        this.buildToc()\n        this.$nextTick(() => {\n          this.updateReadingProgress()\n        })\n      } catch (error) {\n        console.error('获取文章详情失败:', error)\n        this.article = {}\n        const url = `http://localhost:3000/api/articles/${this.$route.params.id}`\n        this.errorMsg = `获取文章失败: ${error.message} (URL: ${url})`\n        this.$message.error('获取文章详情失败')\n        this.toc = []\n      }\n    },\n    async fetchInteractionStatus () {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.isLiked = response.data.isLiked\n        this.isFavorited = response.data.isFavorited\n      } catch (error) {\n        console.error('获取交互状态失败', error)\n      }\n    },\n    async handleLike () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isLiked = response.data.isLiked\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败')\n      }\n    },\n    async handleFavorite () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isFavorited = response.data.isFavorited\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败')\n      }\n    },\n    handleEdit () {\n      this.$router.push(`/article/edit/${this.article.id}`)\n    },\n    async handleDelete () {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.$router.push('/')\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async fetchComments () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`)\n        this.comments = response.data\n      } catch (error) {\n        console.error('获取评论失败', error)\n      }\n    },\n    async submitComment () {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和内容')\n        return\n      }\n      try {\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: this.article.id\n        })\n        this.$message.success('评论成功')\n        this.commentForm.content = ''\n        this.cancelReply()\n        this.fetchComments()\n      } catch (error) {\n        this.$message.error('评论失败')\n      }\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知时间'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      const Y = date.getFullYear()\n      const M = (date.getMonth() + 1).toString().padStart(2, '0')\n      const D = date.getDate().to