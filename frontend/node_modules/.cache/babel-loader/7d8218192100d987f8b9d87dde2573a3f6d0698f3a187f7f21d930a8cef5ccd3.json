{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      }\n    };\n  },\n  created() {\n    this.fetchArticle();\n    this.fetchComments();\n  },\n  methods: {\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    async fetchComments() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败', error);\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        });\n        this.$message.success('评论提交成功');\n        this.commentForm.nickname = '';\n        this.commentForm.email = '';\n        this.commentForm.content = '';\n        this.fetchComments(); // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","article","comments","commentForm","nickname","email","content","created","fetchArticle","fetchComments","methods","id","$route","params","response","get","error","$message","console","submitComment","warning","post","article_id","success"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router>\n            <el-menu-item index=\"/\">首页</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-card class=\"detail-card\">\n          <div slot=\"header\">\n            <h1 class=\"title\">{{ article.title }}</h1>\n            <div class=\"meta\">\n              <span><i class=\"el-icon-date\"></i> {{ new Date(article.created_at).toLocaleDateString() }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> 阅读: {{ article.views }}</span>\n            </div>\n          </div>\n          <!-- 使用 v-html 渲染 Markdown 解析后的 HTML -->\n          <div class=\"content markdown-body\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name\n              }}</el-tag>\n          </div>\n        </el-card>\n\n        <!-- 评论区域 -->\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\">发表评论</div>\n          <el-form :model=\"commentForm\" ref=\"commentForm\" label-width=\"0\">\n            <el-row :gutter=\"10\">\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.nickname\" placeholder=\"昵称 (必填)\"></el-input>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.email\" placeholder=\"邮箱 (可选)\"></el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item>\n              <el-input type=\"textarea\" :rows=\"3\" v-model=\"commentForm.content\" placeholder=\"写下你的评论...\"></el-input>\n            </el-form-item>\n            <el-form-item style=\"text-align: right\">\n              <el-button type=\"primary\" @click=\"submitComment\">提交评论</el-button>\n            </el-form-item>\n          </el-form>\n\n          <div class=\"comment-list\">\n            <div class=\"comment-count\">共 {{ comments.length }} 条评论</div>\n            <div v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-header\">\n                <span class=\"comment-nickname\">{{ comment.nickname }}</span>\n                <span class=\"comment-date\">{{ new Date(comment.created_at).toLocaleString() }}</span>\n              </div>\n              <div class=\"comment-content\">{{ comment.content }}</div>\n            </div>\n            <div v-if=\"comments.length === 0\" class=\"no-comments\">暂无评论，快来抢沙发吧！</div>\n          </div>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'ArticleDetail',\n  data () {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      }\n    }\n  },\n  created () {\n    this.fetchArticle()\n    this.fetchComments()\n  },\n  methods: {\n    async fetchArticle () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        this.article = response.data\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    async fetchComments () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`)\n        this.comments = response.data\n      } catch (error) {\n        console.error('获取评论失败', error)\n      }\n    },\n    async submitComment () {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容')\n        return\n      }\n      try {\n        const id = this.$route.params.id\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        })\n        this.$message.success('评论提交成功')\n        this.commentForm.nickname = ''\n        this.commentForm.email = ''\n        this.commentForm.content = ''\n        this.fetchComments() // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n\n.header-content {\n  max-width: 900px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.logo {\n  font-size: 24px;\n  font-weight: bold;\n  color: #409eff;\n}\n\n.main {\n  max-width: 900px;\n  margin: 20px auto;\n}\n\n.title {\n  font-size: 32px;\n  margin: 10px 0;\n  color: #303133;\n}\n\n.meta {\n  margin-top: 15px;\n  color: #909399;\n  font-size: 14px;\n}\n\n.meta span {\n  margin-right: 20px;\n}\n\n.meta i {\n  margin-right: 5px;\n}\n\n.content {\n  line-height: 1.8;\n  font-size: 16px;\n  padding: 20px 0;\n  color: #333;\n}\n\n.comment-count {\n  font-weight: bold;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #409eff;\n  display: inline-block;\n}\n\n.comment-item {\n  padding: 15px 0;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.comment-nickname {\n  font-weight: bold;\n  color: #409eff;\n}\n\n.comment-date {\n  color: #909399;\n  font-size: 12px;\n  margin-left: 10px;\n}\n\n.comment-content {\n  margin-top: 8px;\n  line-height: 1.6;\n}\n\n.no-comments {\n  text-align: center;\n  color: #909399;\n  padding: 30px 0;\n}\n</style>\n"],"mappings":"AAwEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA