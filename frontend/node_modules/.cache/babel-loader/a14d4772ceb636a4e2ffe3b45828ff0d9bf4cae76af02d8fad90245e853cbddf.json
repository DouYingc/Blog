{"ast":null,"code":"import axios from '../axios';\nimport * as echarts from 'echarts';\nexport default {\n  name: 'AdminDashboard',\n  data() {\n    return {\n      summary: {\n        articleCount: 0,\n        userCount: 0,\n        commentCount: 0,\n        totalViews: 0\n      }\n    };\n  },\n  mounted() {\n    this.fetchSummary();\n    this.initTrendChart();\n    this.initPieChart();\n  },\n  methods: {\n    async fetchSummary() {\n      try {\n        const response = await axios.get('/stats/summary', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.summary = response.data;\n      } catch (error) {\n        console.error('获取统计数据失败', error);\n      }\n    },\n    async initTrendChart() {\n      const chart = echarts.init(this.$refs.trendChart);\n      try {\n        const response = await axios.get('/stats/trend', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        const data = response.data;\n        chart.setOption({\n          tooltip: {\n            trigger: 'axis'\n          },\n          xAxis: {\n            type: 'category',\n            data: data.map(item => item.date)\n          },\n          yAxis: {\n            type: 'value'\n          },\n          series: [{\n            data: data.map(item => item.count),\n            type: 'line',\n            smooth: true,\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [{\n                offset: 0,\n                color: 'rgba(64, 158, 255, 0.5)'\n              }, {\n                offset: 1,\n                color: 'rgba(64, 158, 255, 0.1)'\n              }])\n            },\n            itemStyle: {\n              color: '#409eff'\n            }\n          }]\n        });\n      } catch (error) {\n        console.error('获取趋势图失败', error);\n      }\n    },\n    async initPieChart() {\n      const chart = echarts.init(this.$refs.pieChart);\n      try {\n        const response = await axios.get('/stats/categories', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        const data = response.data;\n        chart.setOption({\n          tooltip: {\n            trigger: 'item'\n          },\n          legend: {\n            bottom: '0%',\n            left: 'center'\n          },\n          series: [{\n            name: '文章数量',\n            type: 'pie',\n            radius: ['40%', '60%'],\n            center: ['50%', '45%'],\n            avoidLabelOverlap: false,\n            itemStyle: {\n              borderRadius: 10,\n              borderColor: '#fff',\n              borderWidth: 2\n            },\n            label: {\n              show: false,\n              position: 'center'\n            },\n            emphasis: {\n              label: {\n                show: true,\n                fontSize: 20,\n                fontWeight: 'bold'\n              }\n            },\n            labelLine: {\n              show: false\n            },\n            data: data.map(item => ({\n              name: item.name,\n              value: item.articleCount\n            }))\n          }]\n        });\n      } catch (error) {\n        console.error('获取饼图失败', error);\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","echarts","name","data","summary","articleCount","userCount","commentCount","totalViews","mounted","fetchSummary","initTrendChart","initPieChart","methods","response","get","headers","Authorization","localStorage","getItem","error","console","chart","init","$refs","trendChart","setOption","tooltip","trigger","xAxis","type","map","item","date","yAxis","series","count","smooth","areaStyle","color","graphic","LinearGradient","offset","itemStyle","pieChart","legend","bottom","left","radius","center","avoidLabelOverlap","borderRadius","borderColor","borderWidth","label","show","position","emphasis","fontSize","fontWeight","labelLine","value"],"sources":["src/views/admin/AdminDashboard.vue"],"sourcesContent":["<template>\n  <div class=\"admin-dashboard\">\n    <!-- 数据概览卡片 -->\n    <el-row :gutter=\"20\">\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">文章总数</div>\n          <div class=\"stat-value\">{{ summary.articleCount }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">注册用户</div>\n          <div class=\"stat-value\">{{ summary.userCount }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">全站评论</div>\n          <div class=\"stat-value\">{{ summary.commentCount }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"6\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div class=\"stat-title\">总阅读量</div>\n          <div class=\"stat-value\">{{ summary.totalViews }}</div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <!-- 图表区域 -->\n    <el-row :gutter=\"20\" style=\"margin-top: 30px\">\n      <el-col :span=\"16\">\n        <el-card header=\"文章发布趋势 (近7天)\" shadow=\"never\">\n          <div ref=\"trendChart\" style=\"height: 350px\"></div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"8\">\n        <el-card header=\"文章分类分布\" shadow=\"never\">\n          <div ref=\"pieChart\" style=\"height: 350px\"></div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\nimport * as echarts from 'echarts'\n\nexport default {\n  name: 'AdminDashboard',\n  data () {\n    return {\n      summary: {\n        articleCount: 0,\n        userCount: 0,\n        commentCount: 0,\n        totalViews: 0\n      }\n    }\n  },\n  mounted () {\n    this.fetchSummary()\n    this.initTrendChart()\n    this.initPieChart()\n  },\n  methods: {\n    async fetchSummary () {\n      try {\n        const response = await axios.get('/stats/summary', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.summary = response.data\n      } catch (error) {\n        console.error('获取统计数据失败', error)\n      }\n    },\n    async initTrendChart () {\n      const chart = echarts.init(this.$refs.trendChart)\n      try {\n        const response = await axios.get('/stats/trend', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        const data = response.data\n\n        chart.setOption({\n          tooltip: { trigger: 'axis' },\n          xAxis: {\n            type: 'category',\n            data: data.map(item => item.date)\n          },\n          yAxis: { type: 'value' },\n          series: [{\n            data: data.map(item => item.count),\n            type: 'line',\n            smooth: true,\n            areaStyle: {\n              color: new echarts.graphic.LinearGradient(0, 0, 0, 1, [\n                { offset: 0, color: 'rgba(64, 158, 255, 0.5)' },\n                { offset: 1, color: 'rgba(64, 158, 255, 0.1)' }\n              ])\n            },\n            itemStyle: { color: '#409eff' }\n          }]\n        })\n      } catch (error) {\n        console.error('获取趋势图失败', error)\n      }\n    },\n    async initPieChart () {\n      const chart = echarts.init(this.$refs.pieChart)\n      try {\n        const response = await axios.get('/stats/categories', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        const data = response.data\n\n        chart.setOption({\n          tooltip: { trigger: 'item' },\n          legend: { bottom: '0%', left: 'center' },\n          series: [\n            {\n              name: '文章数量',\n              type: 'pie',\n              radius: ['40%', '60%'],\n              center: ['50%', '45%'],\n              avoidLabelOverlap: false,\n              itemStyle: {\n                borderRadius: 10,\n                borderColor: '#fff',\n                borderWidth: 2\n              },\n              label: { show: false, position: 'center' },\n              emphasis: {\n                label: { show: true, fontSize: 20, fontWeight: 'bold' }\n              },\n              labelLine: { show: false },\n              data: data.map(item => ({\n                name: item.name,\n                value: item.articleCount\n              }))\n            }\n          ]\n        })\n      } catch (error) {\n        console.error('获取饼图失败', error)\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.stat-card {\n  text-align: center;\n}\n\n.stat-title {\n  color: #909399;\n  font-size: 14px;\n  margin-bottom: 10px;\n}\n\n.stat-value {\n  font-size: 28px;\n  font-weight: bold;\n  color: #303133;\n}\n</style>\n"],"mappings":"AA+CA,OAAAA,KAAA;AACA,YAAAC,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;QACAC,YAAA;QACAC,SAAA;QACAC,YAAA;QACAC,UAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;IACA,KAAAC,cAAA;IACA,KAAAC,YAAA;EACA;EACAC,OAAA;IACA,MAAAH,aAAA;MACA;QACA,MAAAI,QAAA,SAAAd,KAAA,CAAAe,GAAA;UACAC,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAf,OAAA,GAAAU,QAAA,CAAAX,IAAA;MACA,SAAAiB,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;MACA;IACA;IACA,MAAAT,eAAA;MACA,MAAAW,KAAA,GAAArB,OAAA,CAAAsB,IAAA,MAAAC,KAAA,CAAAC,UAAA;MACA;QACA,MAAAX,QAAA,SAAAd,KAAA,CAAAe,GAAA;UACAC,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,MAAAhB,IAAA,GAAAW,QAAA,CAAAX,IAAA;QAEAmB,KAAA,CAAAI,SAAA;UACAC,OAAA;YAAAC,OAAA;UAAA;UACAC,KAAA;YACAC,IAAA;YACA3B,IAAA,EAAAA,IAAA,CAAA4B,GAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAC,IAAA;UACA;UACAC,KAAA;YAAAJ,IAAA;UAAA;UACAK,MAAA;YACAhC,IAAA,EAAAA,IAAA,CAAA4B,GAAA,CAAAC,IAAA,IAAAA,IAAA,CAAAI,KAAA;YACAN,IAAA;YACAO,MAAA;YACAC,SAAA;cACAC,KAAA,MAAAtC,OAAA,CAAAuC,OAAA,CAAAC,cAAA,cACA;gBAAAC,MAAA;gBAAAH,KAAA;cAAA,GACA;gBAAAG,MAAA;gBAAAH,KAAA