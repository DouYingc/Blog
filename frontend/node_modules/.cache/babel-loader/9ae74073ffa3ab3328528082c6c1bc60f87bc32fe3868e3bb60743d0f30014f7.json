{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleEdit',\n  data() {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published'\n      },\n      categories: [],\n      tags: []\n    };\n  },\n  created() {\n    this.fetchCategories();\n    this.fetchTags();\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id);\n    }\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch categories');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch tags');\n      }\n    },\n    async fetchArticle(id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        const article = response.data;\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        };\n      } catch (error) {\n        this.$message.error('Failed to fetch article');\n      }\n    },\n    handleContentChange(value, render) {\n      this.articleForm.html_content = render;\n    },\n    async saveArticle() {\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config);\n          this.$message.success('Article updated successfully');\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config);\n          this.$message.success('Article created successfully');\n        }\n        this.$router.push('/admin/articles');\n      } catch (error) {\n        this.$message.error('Failed to save article');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","articleForm","title","category_id","tags","summary","content","html_content","status","categories","created","fetchCategories","fetchTags","$route","params","id","fetchArticle","methods","response","get","error","$message","article","Tags","map","t","handleContentChange","value","render","saveArticle","config","headers","Authorization","localStorage","getItem","put","success","post","$router","push"],"sources":["src/views/admin/ArticleEdit.vue"],"sourcesContent":["<template>\n  <div class=\"article-edit\">\n    <el-form :model=\"articleForm\" ref=\"articleForm\" label-width=\"80px\">\n      <el-form-item label=\"Title\" prop=\"title\">\n        <el-input v-model=\"articleForm.title\" placeholder=\"Title\"></el-input>\n      </el-form-item>\n      <el-row :gutter=\"20\">\n        <el-col :span=\"12\">\n          <el-form-item label=\"Category\">\n            <el-select v-model=\"articleForm.category_id\" placeholder=\"Select Category\" style=\"width: 100%\">\n              <el-option v-for=\"cat in categories\" :key=\"cat.id\" :label=\"cat.name\" :value=\"cat.id\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"12\">\n          <el-form-item label=\"Tags\">\n            <el-select v-model=\"articleForm.tags\" multiple placeholder=\"Select Tags\" style=\"width: 100%\">\n              <el-option v-for=\"tag in tags\" :key=\"tag.id\" :label=\"tag.name\" :value=\"tag.id\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n      </el-row>\n      <el-form-item label=\"Summary\">\n        <el-input type=\"textarea\" v-model=\"articleForm.summary\" placeholder=\"Summary\"></el-input>\n      </el-form-item>\n      <el-form-item label=\"Content\">\n        <mavon-editor v-model=\"articleForm.content\" @change=\"handleContentChange\" style=\"min-height: 400px\"></mavon-editor>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" @click=\"saveArticle\">Save</el-button>\n        <el-button @click=\"$router.back()\">Cancel</el-button>\n      </el-form-item>\n    </el-form>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'ArticleEdit',\n  data() {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published'\n      },\n      categories: [],\n      tags: []\n    };\n  },\n  created() {\n    this.fetchCategories();\n    this.fetchTags();\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id);\n    }\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch categories');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch tags');\n      }\n    },\n    async fetchArticle(id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        const article = response.data;\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        };\n      } catch (error) {\n        this.$message.error('Failed to fetch article');\n      }\n    },\n    handleContentChange(value, render) {\n      this.articleForm.html_content = render;\n    },\n    async saveArticle() {\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config);\n          this.$message.success('Article updated successfully');\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config);\n          this.$message.success('Article created successfully');\n        }\n        this.$router.push('/admin/articles');\n      } catch (error) {\n        this.$message.error('Failed to save article');\n      }\n    }\n  }\n};\n</script>\n"],"mappings":"AAqCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;QACAC,KAAA;QACAC,WAAA;QACAC,IAAA;QACAC,OAAA;QACAC,OAAA;QACAC,YAAA;QACAC,MAAA;MACA;MACAC,UAAA;MACAL,IAAA;IACA;EACA;EACAM,QAAA;IACA,KAAAC,eAAA;IACA,KAAAC,SAAA;IACA,SAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA,KAAAC,YAAA,MAAAH,MAAA,CAAAC,MAAA,CAAAC,EAAA;IACA;EACA;EACAE,OAAA;IACA,MAAAN,gBAAA;MACA;QACA,MAAAO,QAAA,SAAApB,KAAA,CAAAqB,GAAA;QACA,KAAAV,UAAA,GAAAS,QAAA,CAAAlB,IAAA;MACA,SAAAoB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAR,UAAA;MACA;QACA,MAAAM,QAAA,SAAApB,KAAA,CAAAqB,GAAA;QACA,KAAAf,IAAA,GAAAc,QAAA,CAAAlB,IAAA;MACA,SAAAoB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAJ,aAAAD,EAAA;MACA;QACA,MAAAG,QAAA,SAAApB,KAAA,CAAAqB,GAAA,uCAAAJ,EAAA;QACA,MAAAO,OAAA,GAAAJ,QAAA,CAAAlB,IAAA;QACA,KAAAC,WAAA;UACA,GAAAqB,OAAA;UACAlB,IAAA,EAAAkB,OAAA,CAAAC,IAAA,CAAAC,GAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAV,EAAA;QACA;MACA,SAAAK,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAM,oBAAAC,KAAA,EAAAC,MAAA;MACA,KAAA3B,WAAA,CAAAM,YAAA,GAAAqB,MAAA;IACA;IACA,MAAAC,YAAA;MACA;QACA,MAAAd,EAAA,QAAAF,MAAA,CAAAC,MAAA,CAAAC,EAAA;QACA,MAAAe,MAAA;UACAC,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,IAAAnB,EAAA;UACA,MAAAjB,KAAA,CAAAqC,GAAA,uCAAApB,EAAA,SAAAd,WAAA,EAAA6B,MAAA;UACA,KAAAT,QAA