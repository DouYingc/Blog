{"ast":null,"code":"import axios from 'axios';\nimport { io } from 'socket.io-client';\nexport default {\n  name: 'NotificationBell',\n  data() {\n    return {\n      socket: null,\n      notifications: [],\n      unreadCount: 0,\n      page: 1,\n      pageSize: 10,\n      hasMore: true\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    userId() {\n      const user = JSON.parse(localStorage.getItem('user') || '{}');\n      return user.id;\n    }\n  },\n  created() {\n    if (this.isLoggedIn) {\n      this.initSocket();\n      this.fetchNotifications();\n      this.fetchUnreadCount();\n    }\n  },\n  beforeDestroy() {\n    if (this.socket) {\n      this.socket.disconnect();\n    }\n  },\n  methods: {\n    // 初始化 WebSocket\n    initSocket() {\n      this.socket = io('http://localhost:3000');\n\n      // 注册当前用户\n      this.socket.on('connect', () => {\n        console.log('Socket connected');\n        if (this.userId) {\n          this.socket.emit('register', this.userId);\n        }\n      });\n\n      // 接收实时通知\n      this.socket.on('notification', data => {\n        this.notifications.unshift(data);\n        this.unreadCount++;\n        this.$notify({\n          title: data.title,\n          message: data.content,\n          type: 'info',\n          duration: 5000\n        });\n      });\n      this.socket.on('disconnect', () => {\n        console.log('Socket disconnected');\n      });\n    },\n    // 获取通知列表\n    async fetchNotifications() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          },\n          params: {\n            page: this.page,\n            limit: this.pageSize\n          }\n        });\n        if (this.page === 1) {\n          this.notifications = response.data.notifications;\n        } else {\n          this.notifications.push(...response.data.notifications);\n        }\n        this.hasMore = response.data.notifications.length === this.pageSize;\n      } catch (error) {\n        console.error('获取通知失败', error);\n      }\n    },\n    // 获取未读数量\n    async fetchUnreadCount() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications/unread-count', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.unreadCount = response.data.count;\n      } catch (error) {\n        console.error('获取未读数量失败', error);\n      }\n    },\n    // 标记已读\n    async markAsRead(id) {\n      try {\n        await axios.put(`http://localhost:3000/api/notifications/${id}/read`, {}, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        const notif = this.notifications.find(n => n.id === id);\n        if (notif) {\n          notif.is_read = true;\n          this.unreadCount = Math.max(0, this.unreadCount - 1);\n        }\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    },\n    // 标记全部已读\n    async markAllRead() {\n      try {\n        await axios.put('http://localhost:3000/api/notifications/read-all', {}, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.notifications.forEach(n => n.is_read = true);\n        this.unreadCount = 0;\n        this.$message.success('已全部标记为已读');\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    },\n    // 删除通知\n    async deleteNotification(id) {\n      try {\n        await axios.delete(`http://localhost:3000/api/notifications/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        const index = this.notifications.findIndex(n => n.id === id);\n        if (index > -1) {\n          const notif = this.notifications[index];\n          if (!notif.is_read) {\n            this.unreadCount = Math.max(0, this.unreadCount - 1);\n          }\n          this.notifications.splice(index, 1);\n        }\n      } catch (error) {\n        this.$message.error('删除失败');\n      }\n    },\n    // 加载更多\n    loadMore() {\n      this.page++;\n      this.fetchNotifications();\n    },\n    // 处理通知点击\n    handleNotificationClick(notif) {\n      // 标记为已读\n      if (!notif.is_read) {\n        this.markAsRead(notif.id);\n      }\n\n      // 跳转到相关页面\n      if (notif.related_type === 'article' && notif.related_id) {\n        const targetPath = `/article/${notif.related_id}`;\n        // 检查是否已经在目标页面，如果是则不跳转\n        if (this.$route.path !== targetPath) {\n          this.$router.push(targetPath);\n        }\n      }\n    },\n    // 获取通知图标\n    getNotificationIcon(type) {\n      const icons = {\n        comment: 'el-icon-chat-dot-square',\n        like: 'el-icon-thumb',\n        comment_like: 'el-icon-thumb',\n        favorite: 'el-icon-star-on',\n        reply: 'el-icon-chat-line-round',\n        system: 'el-icon-info'\n      };\n      return icons[type] || 'el-icon-info';\n    },\n    // 格式化时间\n    formatTime(timeStr) {\n      if (!timeStr) return '';\n      const date = new Date(timeStr);\n      const now = new Date();\n      const diff = now - date;\n\n      // 小于1小时显示分钟\n      if (diff < 3600000) {\n        const minutes = Math.floor(diff / 60000);\n        return minutes < 1 ? '刚刚' : `${minutes}分钟前`;\n      }\n\n      // 小于24小时显示小时\n      if (diff < 86400000) {\n        return `${Math.floor(diff / 3600000)}小时前`;\n      }\n\n      // 小于7天显示天数\n      if (diff < 604800000) {\n        return `${Math.floor(diff / 86400000)}天前`;\n      }\n      return date.toLocaleDateString();\n    }\n  }\n};","map":{"version":3,"names":["axios","io","name","data","socket","notifications","unreadCount","page","pageSize","hasMore","computed","isLoggedIn","localStorage","getItem","userId","user","JSON","parse","id","created","initSocket","fetchNotifications","fetchUnreadCount","beforeDestroy","disconnect","methods","on","console","log","emit","unshift","$notify","title","message","content","type","duration","response","get","headers","Authorization","params","limit","push","length","error","count","markAsRead","put","notif","find","n","is_read","Math","max","$message","markAllRead","forEach","success","deleteNotification","delete","index","findIndex","splice","loadMore","handleNotificationClick","related_type","related_id","targetPath","$route","path","$router","getNotificationIcon","icons","comment","like","comment_like","favorite","reply","system","formatTime","timeStr","date","Date","now","diff","minutes","floor","toLocaleDateString"],"sources":["src/components/NotificationBell.vue"],"sourcesContent":["<template>\n  <div class=\"notification-bell\">\n    <el-popover placement=\"bottom\" width=\"350\" trigger=\"click\" popper-class=\"notification-popover\">\n      <div slot=\"reference\" class=\"bell-wrapper\">\n        <el-badge :value=\"unreadCount\" :hidden=\"unreadCount === 0\" :max=\"99\">\n          <i class=\"el-icon-bell\" :class=\"{ 'has-unread': unreadCount > 0 }\"></i>\n        </el-badge>\n      </div>\n\n      <div class=\"notification-header\">\n        <span class=\"title\">通知中心</span>\n        <el-button v-if=\"unreadCount > 0\" type=\"text\" size=\"mini\" @click=\"markAllRead\">\n          全部已读\n        </el-button>\n      </div>\n\n      <div class=\"notification-list\" v-if=\"notifications.length > 0\">\n        <div v-for=\"notif in notifications\" :key=\"notif.id\" class=\"notification-item\"\n          :class=\"{ unread: !notif.is_read }\" @click=\"handleNotificationClick(notif)\">\n          <div class=\"notification-icon\">\n            <i :class=\"getNotificationIcon(notif.type)\"></i>\n          </div>\n          <div class=\"notification-content\">\n            <div class=\"notification-title\">{{ notif.title }}</div>\n            <div class=\"notification-text\">{{ notif.content }}</div>\n            <div class=\"notification-time\">{{ formatTime(notif.created_at) }}</div>\n          </div>\n          <div class=\"notification-actions\">\n            <el-button v-if=\"!notif.is_read\" type=\"text\" size=\"mini\" @click.stop=\"markAsRead(notif.id)\">\n              标为已读\n            </el-button>\n            <el-button type=\"text\" size=\"mini\" class=\"delete-btn\" @click.stop=\"deleteNotification(notif.id)\">\n              <i class=\"el-icon-close\"></i>\n            </el-button>\n          </div>\n        </div>\n\n        <div class=\"notification-footer\">\n          <el-button type=\"text\" size=\"small\" @click=\"loadMore\" v-if=\"hasMore\">\n            加载更多\n          </el-button>\n          <span v-else class=\"no-more\">没有更多通知了</span>\n        </div>\n      </div>\n\n      <el-empty v-else description=\"暂无通知\"></el-empty>\n    </el-popover>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport { io } from 'socket.io-client'\n\nexport default {\n  name: 'NotificationBell',\n  data () {\n    return {\n      socket: null,\n      notifications: [],\n      unreadCount: 0,\n      page: 1,\n      pageSize: 10,\n      hasMore: true\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    userId () {\n      const user = JSON.parse(localStorage.getItem('user') || '{}')\n      return user.id\n    }\n  },\n  created () {\n    if (this.isLoggedIn) {\n      this.initSocket()\n      this.fetchNotifications()\n      this.fetchUnreadCount()\n    }\n  },\n  beforeDestroy () {\n    if (this.socket) {\n      this.socket.disconnect()\n    }\n  },\n  methods: {\n    // 初始化 WebSocket\n    initSocket () {\n      this.socket = io('http://localhost:3000')\n\n      // 注册当前用户\n      this.socket.on('connect', () => {\n        console.log('Socket connected')\n        if (this.userId) {\n          this.socket.emit('register', this.userId)\n        }\n      })\n\n      // 接收实时通知\n      this.socket.on('notification', (data) => {\n        this.notifications.unshift(data)\n        this.unreadCount++\n        this.$notify({\n          title: data.title,\n          message: data.content,\n          type: 'info',\n          duration: 5000\n        })\n      })\n\n      this.socket.on('disconnect', () => {\n        console.log('Socket disconnected')\n      })\n    },\n\n    // 获取通知列表\n    async fetchNotifications () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` },\n          params: { page: this.page, limit: this.pageSize }\n        })\n\n        if (this.page === 1) {\n          this.notifications = response.data.notifications\n        } else {\n          this.notifications.push(...response.data.notifications)\n        }\n\n        this.hasMore = response.data.notifications.length === this.pageSize\n      } catch (error) {\n        console.error('获取通知失败', error)\n      }\n    },\n\n    // 获取未读数量\n    async fetchUnreadCount () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/notifications/unread-count', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.unreadCount = response.data.count\n      } catch (error) {\n        console.error('获取未读数量失败', error)\n      }\n    },\n\n    // 标记已读\n    async markAsRead (id) {\n      try {\n        await axios.put(`http://localhost:3000/api/notifications/${id}/read`, {}, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n\n        const notif = this.notifications.find(n => n.id === id)\n        if (notif) {\n          notif.is_read = true\n          this.unreadCount = Math.max(0, this.unreadCount - 1)\n        }\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    },\n\n    // 标记全部已读\n    async markAllRead () {\n      try {\n        await axios.put('http://localhost:3000/api/notifications/read-all', {}, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n\n        this.notifications.forEach(n => n.is_read = true)\n        this.unreadCount = 0\n        this.$message.success('已全部标记为已读')\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    },\n\n    // 删除通知\n    async deleteNotification (id) {\n      try {\n        await axios.delete(`http://localhost:3000/api/notifications/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n\n        const index = this.notifications.findIndex(n => n.id === id)\n        if (index > -1) {\n          const notif = this.notifications[index]\n          if (!notif.is_read) {\n            this.unreadCount = Math.max(0, this.unreadCount - 1)\n          }\n          this.notifications.splice(index, 1)\n        }\n      } catch (error) {\n        this.$message.error('删除失败')\n      }\n    },\n\n    // 加载更多\n    loadMore () {\n      this.page++\n      this.fetchNotifications()\n    },\n\n    // 处理通知点击\n    handleNotificationClick (notif) {\n      // 标记为已读\n      if (!notif.is_read) {\n        this.markAsRead(notif.id)\n      }\n\n      // 跳转到相关页面\n      if (notif.related_type === 'article' && notif.related_id) {\n        const targetPath = `/article/${notif.related_id}`\n        // 检查是否已经在目标页面，如果是则不跳转\n        if (this.$route.path !== targetPath) {\n          this.$router.push(targetPath)\n        }\n      }\n    },\n\n    // 获取通知图标\n    getNotificationIcon (type) {\n      const icons = {\n        comment: 'el-icon-chat-dot-square',\n        like: 'el-icon-thumb',\n        comment_like: 'el-icon-thumb',\n        favorite: 'el-icon-star-on',\n        reply: 'el-icon-chat-line-round',\n        system: 'el-icon-info'\n      }\n      return icons[type] || 'el-icon-info'\n    },\n\n    // 格式化时间\n    formatTime (timeStr) {\n      if (!timeStr) return ''\n      const date = new Date(timeStr)\n      const now = new Date()\n      const diff = now - date\n\n      // 小于1小时显示分钟\n      if (diff < 3600000) {\n        const minutes = Math.floor(diff / 60000)\n        return minutes < 1 ? '刚刚' : `${minutes}分钟前`\n      }\n\n      // 小于24小时显示小时\n      if (diff < 86400000) {\n        return `${Math.floor(diff / 3600000)}小时前`\n      }\n\n      // 小于7天显示天数\n      if (diff < 604800000) {\n        return `${Math.floor(diff / 86400000)}天前`\n      }\n\n      return date.toLocaleDateString()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.notification-bell {\n  display: inline-block;\n}\n\n.bell-wrapper {\n  cursor: pointer;\n  padding: 8px;\n  font-size: 20px;\n  color: #606266;\n}\n\n.bell-wrapper:hover {\n  color: #409eff;\n}\n\n.bell-wrapper .has-unread {\n  color: #409eff;\n  animation: bell-shake 2s infinite;\n}\n\n@keyframes bell-shake {\n\n  0%,\n  100% {\n    transform: rotate(0);\n  }\n\n  10%,\n  30%,\n  50%,\n  70%,\n  90% {\n    transform: rotate(-5deg);\n  }\n\n  20%,\n  40%,\n  60%,\n  80% {\n    transform: rotate(5deg);\n  }\n}\n\n.notification-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  padding: 10px 15px;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.notification-header .title {\n  font-weight: bold;\n  font-size: 16px;\n}\n\n.notification-list {\n  max-height: 400px;\n  overflow-y: auto;\n}\n\n.notification-item {\n  display: flex;\n  padding: 12px 15px;\n  border-bottom: 1px solid #ebeef5;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.notification-item:hover {\n  background-color: #f5f7fa;\n}\n\n.notification-item.unread {\n  background-color: #f0f9ff;\n}\n\n.notification-icon {\n  width: 36px;\n  height: 36px;\n  border-radius: 50%;\n  background-color: #ecf5ff;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-right: 12px;\n  flex-shrink: 0;\n}\n\n.notification-icon i {\n  color: #409eff;\n  font-size: 16px;\n}\n\n.notification-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.notification-title {\n  font-weight: 500;\n  font-size: 14px;\n  color: #303133;\n  margin-bottom: 4px;\n}\n\n.notification-text {\n  font-size: 13px;\n  color: #606266;\n  line-height: 1.4;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n}\n\n.notification-time {\n  font-size: 12px;\n  color: #909399;\n  margin-top: 4px;\n}\n\n.notification-actions {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-end;\n  margin-left: 8px;\n}\n\n.notification-actions .delete-btn {\n  color: #c0c4cc;\n  padding: 0;\n  margin-top: 4px;\n}\n\n.notification-actions .delete-btn:hover {\n  color: #f56c6c;\n}\n\n.notification-footer {\n  text-align: center;\n  padding: 10px;\n}\n\n.notification-footer .no-more {\n  color: #909399;\n  font-size: 12px;\n}\n</style>\n\n<style>\n.notification-popover {\n  padding: 0 !important;\n}\n</style>\n"],"mappings":"AAmDA,OAAAA,KAAA;AACA,SAAAC,EAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,MAAA;MACAC,aAAA;MACAC,WAAA;MACAC,IAAA;MACAC,QAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAC,YAAA,CAAAC,OAAA;IACA;IACAC,OAAA;MACA,MAAAC,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAL,YAAA,CAAAC,OAAA;MACA,OAAAE,IAAA,CAAAG,EAAA;IACA;EACA;EACAC,QAAA;IACA,SAAAR,UAAA;MACA,KAAAS,UAAA;MACA,KAAAC,kBAAA;MACA,KAAAC,gBAAA;IACA;EACA;EACAC,cAAA;IACA,SAAAnB,MAAA;MACA,KAAAA,MAAA,CAAAoB,UAAA;IACA;EACA;EACAC,OAAA;IACA;IACAL,WAAA;MACA,KAAAhB,MAAA,GAAAH,EAAA;;MAEA;MACA,KAAAG,MAAA,CAAAsB,EAAA;QACAC,OAAA,CAAAC,GAAA;QACA,SAAAd,MAAA;UACA,KAAAV,MAAA,CAAAyB,IAAA,kBAAAf,MAAA;QACA;MACA;;MAEA;MACA,KAAAV,MAAA,CAAAsB,EAAA,iBAAAvB,IAAA;QACA,KAAAE,aAAA,CAAAyB,OAAA,CAAA3B,IAAA;QACA,KAAAG,WAAA;QACA,KAAAyB,OAAA;UACAC,KAAA,EAAA7B,IAAA,CAAA6B,KAAA;UACAC,OAAA,EAAA9B,IAAA,CAAA+B,OAAA;UACAC,IAAA;UACAC,QAAA;QACA;MACA;MAEA,KAAAhC,MAAA,CAAAsB,EAAA;QACAC,OAAA,CAAAC,GAAA;MACA;IACA;IAEA;IACA,MAAAP,mBAAA;MACA;QACA,MAAAgB,QAAA,SAAArC,KAAA,CAAAsC,GAAA;U