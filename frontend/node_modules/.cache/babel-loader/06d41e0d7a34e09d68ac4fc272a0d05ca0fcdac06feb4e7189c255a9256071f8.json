{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'TagCloud',\n  data() {\n    return {\n      tags: []\n    };\n  },\n  mounted() {\n    this.fetchPopularTags();\n  },\n  methods: {\n    async fetchPopularTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags/popular');\n        this.tags = response.data;\n      } catch (error) {\n        console.error('获取热门标签失败:', error);\n      }\n    },\n    getTagClass(count) {\n      if (count >= 10) {\n        return 'tag-large';\n      } else if (count >= 5) {\n        return 'tag-medium';\n      } else {\n        return 'tag-small';\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","tags","mounted","fetchPopularTags","methods","response","get","error","console","getTagClass","count"],"sources":["src/components/TagCloud.vue"],"sourcesContent":["<template>\n  <div class=\"tag-cloud\">\n    <h3 class=\"tag-cloud-title\">热门标签</h3>\n    <div class=\"tag-cloud-tags\">\n      <router-link\n        v-for=\"tag in tags\"\n        :key=\"tag.id\"\n        :to=\"`/?tag_id=${tag.id}`\"\n        :class=\"['tag-item', getTagClass(tag.articleCount)]\"\n        :title=\"`${tag.name} (${tag.articleCount}篇文章)`\"\n      >\n        {{ tag.name }}\n      </router-link>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'TagCloud',\n  data() {\n    return {\n      tags: []\n    }\n  },\n  mounted() {\n    this.fetchPopularTags()\n  },\n  methods: {\n    async fetchPopularTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags/popular')\n        this.tags = response.data\n      } catch (error) {\n        console.error('获取热门标签失败:', error)\n      }\n    },\n    getTagClass(count) {\n      if (count >= 10) {\n        return 'tag-large'\n      } else if (count >= 5) {\n        return 'tag-medium'\n      } else {\n        return 'tag-small'\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.tag-cloud {\n  background-color: #fff;\n  border-radius: 8px;\n  padding: 20px;\n  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);\n}\n\n.tag-cloud-title {\n  font-size: 18px;\n  font-weight: bold;\n  margin-bottom: 16px;\n  color: #303133;\n}\n\n.tag-cloud-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.tag-item {\n  padding: 6px 12px;\n  border-radius: 16px;\n  text-decoration: none;\n  color: #409eff;\n  background-color: #ecf5ff;\n  transition: all 0.3s ease;\n  cursor: pointer;\n}\n\n.tag-item:hover {\n  background-color: #409eff;\n  color: #fff;\n  transform: translateY(-2px);\n}\n\n.tag-small {\n  font-size: 12px;\n}\n\n.tag-medium {\n  font-size: 14px;\n}\n\n.tag-large {\n  font-size: 16px;\n  font-weight: bold;\n}\n</style>"],"mappings":"AAkBA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA;QACA,MAAAE,QAAA,SAAAP,KAAA,CAAAQ,GAAA;QACA,KAAAL,IAAA,GAAAI,QAAA,CAAAL,IAAA;MACA,SAAAO,KAAA;QACAC,OAAA,CAAAD,KAAA,cAAAA,KAAA;MACA;IACA;IACAE,YAAAC,KAAA;MACA,IAAAA,KAAA;QACA;MACA,WAAAA,KAAA;QACA;MACA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}