{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'UserCenter',\n  data() {\n    return {\n      activeTab: 'articles',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: '',\n        avatar: ''\n      },\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    };\n  },\n  created() {\n    this.userForm.username = this.currentUser.username;\n    this.userForm.email = this.currentUser.email || '';\n    this.userForm.avatar = this.currentUser.avatar || '';\n    this.fetchMyArticles();\n    this.fetchFavorites();\n  },\n  methods: {\n    async fetchMyArticles() {\n      this.loading = true;\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            user_id: this.currentUser.id\n          }\n        });\n        this.myArticles = response.data.articles;\n      } catch (error) {\n        this.$message.error('获取文章失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async fetchFavorites() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/interactions/my-favorites', {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.favoriteArticles = response.data;\n      } catch (error) {\n        console.error('获取收藏失败', error);\n      }\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchMyArticles();\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async updateProfile() {\n      this.$message.info('资料修改功能正在完善中...');\n    },\n    handleAvatarSuccess(res) {\n      this.userForm.avatar = res.url;\n      this.$message.success('头像上传成功，点击保存修改生效');\n    },\n    beforeAvatarUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!');\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!');\n      }\n      return isJPG && isLt2M;\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","activeTab","loading","myArticles","favoriteArticles","currentUser","JSON","parse","localStorage","getItem","userForm","username","email","avatar","uploadHeaders","Authorization","created","fetchMyArticles","fetchFavorites","methods","response","get","params","user_id","id","articles","error","$message","headers","console","handleDelete","$confirm","type","delete","success","updateProfile","info","handleAvatarSuccess","res","url","beforeAvatarUpload","file","isJPG","isLt2M","size","handleLogout","removeItem","$router","push"],"sources":["src/views/UserCenter.vue"],"sourcesContent":["<template>\n  <div class=\"user-center\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人中心</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">返回首页</el-menu-item>\n            <el-menu-item @click=\"handleLogout\">退出登录</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-tabs v-model=\"activeTab\" type=\"border-card\">\n          <!-- 个人文章管理 -->\n          <el-tab-pane label=\"我的文章\" name=\"articles\">\n            <div class=\"pane-content\">\n              <div class=\"toolbar\">\n                <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"$router.push('/admin/article/new')\">发布文章</el-button>\n              </div>\n              <el-table :data=\"myArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                <el-table-column prop=\"views\" label=\"阅读\" width=\"80\" align=\"center\"></el-table-column>\n                <el-table-column prop=\"created_at\" label=\"发布时间\" width=\"180\">\n                  <template slot-scope=\"scope\">{{ new Date(scope.row.created_at).toLocaleString() }}</template>\n                </el-table-column>\n                <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n                  <template slot-scope=\"scope\">\n                    <el-button size=\"mini\" type=\"text\" @click=\"$router.push(`/admin/article/edit/${scope.row.id}`)\">编辑</el-button>\n                    <el-button size=\"mini\" type=\"text\" style=\"color: #F56C6C\" @click=\"handleDelete(scope.row.id)\">删除</el-button>\n                  </template>\n                </el-table-column>\n              </el-table>\n            </div>\n          </el-tab-pane>\n\n          <!-- 收藏夹 -->\n          <el-tab-pane label=\"我的收藏\" name=\"favorites\">\n            <div class=\"pane-content\">\n              <el-table :data=\"favoriteArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                <el-table-column prop=\"User.username\" label=\"作者\" width=\"120\"></el-table-column>\n                <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                <el-table-column label=\"操作\" width=\"120\" align=\"center\">\n                  <template slot-scope=\"scope\">\n                    <el-button size=\"mini\" type=\"text\" @click=\"$router.push(`/article/${scope.row.id}`)\">查看</el-button>\n                  </template>\n                </el-table-column>\n              </el-table>\n            </div>\n          </el-tab-pane>\n\n          <!-- 个人资料修改 -->\n          <el-tab-pane label=\"基本资料\" name=\"profile\">\n            <div class=\"pane-content profile-form\">\n              <el-form :model=\"userForm\" label-width=\"80px\" style=\"max-width: 400px\">\n                <el-form-item label=\"用户头像\">\n                  <el-upload\n                    class=\"avatar-uploader\"\n                    action=\"http://localhost:3000/api/upload/image\"\n                    name=\"image\"\n                    :headers=\"uploadHeaders\"\n                    :show-file-list=\"false\"\n                    :on-success=\"handleAvatarSuccess\"\n                    :before-upload=\"beforeAvatarUpload\">\n                    <img v-if=\"userForm.avatar\" :src=\"userForm.avatar\" class=\"avatar\">\n                    <i v-else class=\"el-icon-plus avatar-uploader-icon\"></i>\n                  </el-upload>\n                  <small>点击上方区域上传头像</small>\n                </el-form-item>\n                <el-form-item label=\"用户名\">\n                  <el-input v-model=\"userForm.username\" disabled></el-input>\n                  <small>用户名暂不支持修改</small>\n                </el-form-item>\n                <el-form-item label=\"邮箱\">\n                  <el-input v-model=\"userForm.email\"></el-input>\n                </el-form-item>\n                <el-form-item>\n                  <el-button type=\"primary\" @click=\"updateProfile\">保存修改</el-button>\n                </el-form-item>\n              </el-form>\n            </div>\n          </el-tab-pane>\n        </el-tabs>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'UserCenter',\n  data () {\n    return {\n      activeTab: 'articles',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: '',\n        avatar: ''\n      },\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    }\n  },\n  created () {\n    this.userForm.username = this.currentUser.username\n    this.userForm.email = this.currentUser.email || ''\n    this.userForm.avatar = this.currentUser.avatar || ''\n    this.fetchMyArticles()\n    this.fetchFavorites()\n  },\n  methods: {\n    async fetchMyArticles () {\n      this.loading = true\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: { user_id: this.currentUser.id }\n        })\n        this.myArticles = response.data.articles\n      } catch (error) {\n        this.$message.error('获取文章失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    async fetchFavorites () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/interactions/my-favorites', {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.favoriteArticles = response.data\n      } catch (error) {\n        console.error('获取收藏失败', error)\n      }\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchMyArticles()\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async updateProfile () {\n      this.$message.info('资料修改功能正在完善中...')\n    },\n    handleAvatarSuccess (res) {\n      this.userForm.avatar = res.url\n      this.$message.success('头像上传成功，点击保存修改生效')\n    },\n    beforeAvatarUpload (file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png'\n      const isLt2M = file.size / 1024 / 1024 < 2\n\n      if (!isJPG) {\n        this.$message.error('上传头像图片只能是 JPG 或 PNG 格式!')\n      }\n      if (!isLt2M) {\n        this.$message.error('上传头像图片大小不能超过 2MB!')\n      }\n      return isJPG && isLt2M\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n.header-content {\n  max-width: 1000px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logo {\n  font-size: 20px;\n  font-weight: bold;\n  color: #409eff;\n  cursor: pointer;\n}\n.main {\n  max-width: 1000px;\n  margin: 30px auto;\n}\n.pane-content {\n  padding: 20px;\n}\n.toolbar {\n  margin-bottom: 20px;\n}\n.profile-form {\n  padding-top: 30px;\n}\n</style>\n"],"mappings":"AA4FA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,UAAA;MACAC,gBAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,QAAA;QACAC,QAAA;QACAC,KAAA;QACAC,MAAA;MACA;MACAC,aAAA;QACAC,aAAA,YAAAP,YAAA,CAAAC,OAAA;MACA;IACA;EACA;EACAO,QAAA;IACA,KAAAN,QAAA,CAAAC,QAAA,QAAAN,WAAA,CAAAM,QAAA;IACA,KAAAD,QAAA,CAAAE,KAAA,QAAAP,WAAA,CAAAO,KAAA;IACA,KAAAF,QAAA,CAAAG,MAAA,QAAAR,WAAA,CAAAQ,MAAA;IACA,KAAAI,eAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAF,gBAAA;MACA,KAAAf,OAAA;MACA;QACA,MAAAkB,QAAA,SAAAtB,KAAA,CAAAuB,GAAA;UACAC,MAAA;YAAAC,OAAA,OAAAlB,WAAA,CAAAmB;UAAA;QACA;QACA,KAAArB,UAAA,GAAAiB,QAAA,CAAApB,IAAA,CAAAyB,QAAA;MACA,SAAAC,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAAxB,OAAA;MACA;IACA;IACA,MAAAgB,eAAA;MACA;QACA,MAAAE,QAAA,SAAAtB,KAAA,CAAAuB,GAAA;UACAO,OAAA;YAAAb,aAAA,YAAAP,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAL,gBAAA,GAAAgB,QAAA,CAAApB,IAAA;MACA,SAAA0B,KAAA;QACAG,OAAA,CAAAH,KAAA,WAAAA,KAAA;MACA;IACA;IACA,MAAAI,aAAAN,EAAA;MACA;QACA,WAAAO,QAAA;UAAAC,IAAA;QAAA;QACA,MAAAlC,KAAA,CAAAmC,MAAA,uCAAAT,EAAA;UACAI,OAAA;YAAAb,aAAA,YAAAP,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAkB,QAAA,CAAAO,OAAA;QACA,KAAAjB,eAAA;MACA,SAAAS,KAAA;QACA,IAAAA,KAAA,oBAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAS,cAAA;MACA,KAAAR,QAAA,CAAAS,IAAA;IACA;IACAC,oBAAAC,GAAA;MACA,KAAA5B,QAAA,CAAAG,MAAA,GAAAyB,GAAA,CAAAC,GAAA;MACA,KAAAZ,QAAA,CAAAO,OAAA;IACA;IACAM,mBAAAC,IAAA;MACA,MAAAC,KAAA,GAAAD,IAAA,CAAAT,IAAA,qBAAAS,IAAA,CAAAT,IAAA;MACA,MAAAW,MAAA,GAAAF,IAAA,CAAAG,IAAA;MAEA,KAAAF,KAAA;QACA,KAAAf,QAAA,CAAAD,KAAA;MACA;MACA,KAAAiB,MAAA;QACA,KAAAhB,QAAA,CAAAD,KAAA;MACA;MACA,OAAAgB,KAAA,IAAAC,MAAA;IACA;IACAE,aAAA;MACArC,YAAA,CAAAsC,UAAA;MACAtC,YAAA,CAAAsC,UAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}