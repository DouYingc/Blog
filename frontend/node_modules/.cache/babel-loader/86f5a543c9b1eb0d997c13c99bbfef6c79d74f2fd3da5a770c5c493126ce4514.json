{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleEdit',\n  data() {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    };\n  },\n  computed: {\n    isAdmin() {\n      const user = JSON.parse(localStorage.getItem('user') || '{}');\n      return user.role === 'admin';\n    }\n  },\n  created() {\n    this.fetchCategories();\n    this.fetchTags();\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id);\n    }\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('获取分类失败');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('获取标签失败');\n      }\n    },\n    async fetchArticle(id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        const article = response.data;\n\n        // 权限校验：非管理员且不是自己的文章，无权编辑\n        const user = JSON.parse(localStorage.getItem('user') || '{}');\n        if (user.role !== 'admin' && article.user_id !== user.id) {\n          this.$message.error('您无权编辑他人的文章');\n          this.$router.push('/');\n          return;\n        }\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        };\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    handleContentChange(value, render) {\n      this.articleForm.html_content = render;\n    },\n    // 处理 mavon-editor 图片上传\n    async handleImgAdd(pos, $file) {\n      const formData = new FormData();\n      formData.append('image', $file);\n      try {\n        const response = await axios.post('http://localhost:3000/api/upload/image', formData, {\n          headers: {\n            ...this.uploadHeaders,\n            'Content-Type': 'multipart/form-data'\n          }\n        });\n        // 将编辑器中的 base64 替换为服务器返回的 URL\n        this.$refs.md.$img2Url(pos, response.data.url);\n      } catch (error) {\n        this.$message.error('图片上传失败');\n      }\n    },\n    handleCoverSuccess(res) {\n      this.articleForm.cover = res.url;\n      this.$message.success('封面上传成功');\n    },\n    beforeCoverUpload(file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png';\n      const isLt2M = file.size / 1024 / 1024 < 2;\n      if (!isJPG) this.$message.error('封面只能是 JPG 或 PNG 格式!');\n      if (!isLt2M) this.$message.error('封面大小不能超过 2MB!');\n      return isJPG && isLt2M;\n    },\n    startAutoSave() {\n      if (this.autoSaveTimer) {\n        clearTimeout(this.autoSaveTimer);\n      }\n      this.autoSaveTimer = setTimeout(() => {\n        this.autoSave();\n      }, 3000); // 3秒后自动保存\n    },\n    async autoSave() {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        return;\n      }\n      const formData = {\n        ...this.articleForm,\n        status: 'draft'\n      };\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, formData, config);\n        } else {\n          const response = await axios.post('http://localhost:3000/api/articles', formData, config);\n          this.$route.params.id = response.data.id;\n        }\n        this.$message.success('自动保存成功', {\n          duration: 1500\n        });\n      } catch (error) {\n        console.error('自动保存失败', error);\n      }\n    },\n    async saveArticle(status = 'published') {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空');\n        return;\n      }\n      const formData = {\n        ...this.articleForm,\n        status: status\n      };\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, formData, config);\n          this.$message.success(status === 'published' ? '文章更新成功' : '草稿保存成功');\n        } else {\n          await axios.post('http://localhost:3000/api/articles', formData, config);\n          this.$message.success(status === 'published' ? '文章发布成功' : '草稿保存成功');\n        }\n\n        // 根据角色跳转\n        const user = JSON.parse(localStorage.getItem('user') || '{}');\n        if (user.role === 'admin') {\n          this.$router.push('/admin/articles');\n        } else {\n          this.$router.push('/user/center');\n        }\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","articleForm","title","category_id","tags","summary","content","html_content","cover","categories","uploadHeaders","Authorization","localStorage","getItem","computed","isAdmin","user","JSON","parse","role","created","fetchCategories","fetchTags","$route","params","id","fetchArticle","methods","response","get","error","$message","article","user_id","$router","push","Tags","map","t","handleContentChange","value","render","handleImgAdd","pos","$file","formData","FormData","append","post","headers","$refs","md","$img2Url","url","handleCoverSuccess","res","success","beforeCoverUpload","file","isJPG","type","isLt2M","size","startAutoSave","autoSaveTimer","clearTimeout","setTimeout","autoSave","status","config","put","duration","console","saveArticle","warning"],"sources":["src/views/admin/ArticleEdit.vue"],"sourcesContent":["<template>\n  <div class=\"article-edit\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/user/center\">个人中心</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-page-header @back=\"$router.back()\" :content=\"$route.params.id ? '编辑文章' : '发布新文章'\"\n          style=\"margin-bottom: 30px\"></el-page-header>\n\n        <el-card shadow=\"never\" class=\"edit-card\">\n          <el-form :model=\"articleForm\" ref=\"articleForm\" label-width=\"80px\">\n            <el-form-item label=\"文章标题\" prop=\"title\">\n              <el-input v-model=\"articleForm.title\" placeholder=\"请输入文章标题\"></el-input>\n            </el-form-item>\n            <el-form-item label=\"文章封面\">\n              <el-upload class=\"cover-uploader\" action=\"http://localhost:3000/api/upload/image\" name=\"image\"\n                :headers=\"uploadHeaders\" :show-file-list=\"false\" :on-success=\"handleCoverSuccess\"\n                :before-upload=\"beforeCoverUpload\">\n                <img v-if=\"articleForm.cover\" :src=\"articleForm.cover\" class=\"cover-image\">\n                <i v-else class=\"el-icon-plus cover-uploader-icon\"></i>\n              </el-upload>\n              <small>建议尺寸 800x400，用于首页展示</small>\n            </el-form-item>\n            <el-row :gutter=\"20\">\n              <el-col :span=\"12\">\n                <el-form-item label=\"所属分类\">\n                  <el-select v-model=\"articleForm.category_id\" placeholder=\"选择分类\" style=\"width: 100%\">\n                    <el-option v-for=\"cat in categories\" :key=\"cat.id\" :label=\"cat.name\" :value=\"cat.id\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item label=\"文章标签\">\n                  <el-select v-model=\"articleForm.tags\" multiple placeholder=\"选择标签\" style=\"width: 100%\">\n                    <el-option v-for=\"tag in tags\" :key=\"tag.id\" :label=\"tag.name\" :value=\"tag.id\"></el-option>\n                  </el-select>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item label=\"文章摘要\">\n              <el-input type=\"textarea\" :rows=\"3\" v-model=\"articleForm.summary\" placeholder=\"请输入文章摘要\"></el-input>\n            </el-form-item>\n            <el-form-item label=\"是否置顶\" v-if=\"isAdmin\">\n              <el-switch v-model=\"articleForm.is_top\" :active-value=\"1\" :inactive-value=\"0\"></el-switch>\n            </el-form-item>\n            <el-form-item label=\"文章内容\">\n              <mavon-editor v-model=\"articleForm.content\" ref=\"md\" @imgAdd=\"handleImgAdd\" @change=\"handleContentChange\"\n                style=\"min-height: 500px\" placeholder=\"开始创作吧...\"></mavon-editor>\n            </el-form-item>\n            <el-form-item>\n              <el-button type=\"primary\" icon=\"el-icon-check\" @click=\"saveArticle\">保存并发布</el-button>\n              <el-button icon=\"el-icon-close\" @click=\"$router.back()\">取消</el-button>\n            </el-form-item>\n          </el-form>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'ArticleEdit',\n  data () {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    }\n  },\n  computed: {\n    isAdmin () {\n      const user = JSON.parse(localStorage.getItem('user') || '{}')\n      return user.role === 'admin'\n    }\n  },\n  created () {\n    this.fetchCategories()\n    this.fetchTags()\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id)\n    }\n  },\n  methods: {\n    async fetchCategories () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories')\n        this.categories = response.data\n      } catch (error) {\n        this.$message.error('获取分类失败')\n      }\n    },\n    async fetchTags () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags')\n        this.tags = response.data\n      } catch (error) {\n        this.$message.error('获取标签失败')\n      }\n    },\n    async fetchArticle (id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        const article = response.data\n\n        // 权限校验：非管理员且不是自己的文章，无权编辑\n        const user = JSON.parse(localStorage.getItem('user') || '{}')\n        if (user.role !== 'admin' && article.user_id !== user.id) {\n          this.$message.error('您无权编辑他人的文章')\n          this.$router.push('/')\n          return\n        }\n\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        }\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    handleContentChange (value, render) {\n      this.articleForm.html_content = render\n    },\n    // 处理 mavon-editor 图片上传\n    async handleImgAdd (pos, $file) {\n      const formData = new FormData()\n      formData.append('image', $file)\n      try {\n        const response = await axios.post('http://localhost:3000/api/upload/image', formData, {\n          headers: {\n            ...this.uploadHeaders,\n            'Content-Type': 'multipart/form-data'\n          }\n        })\n        // 将编辑器中的 base64 替换为服务器返回的 URL\n        this.$refs.md.$img2Url(pos, response.data.url)\n      } catch (error) {\n        this.$message.error('图片上传失败')\n      }\n    },\n    handleCoverSuccess (res) {\n      this.articleForm.cover = res.url\n      this.$message.success('封面上传成功')\n    },\n    beforeCoverUpload (file) {\n      const isJPG = file.type === 'image/jpeg' || file.type === 'image/png'\n      const isLt2M = file.size / 1024 / 1024 < 2\n      if (!isJPG) this.$message.error('封面只能是 JPG 或 PNG 格式!')\n      if (!isLt2M) this.$message.error('封面大小不能超过 2MB!')\n      return isJPG && isLt2M\n    },\n    startAutoSave () {\n      if (this.autoSaveTimer) {\n        clearTimeout(this.autoSaveTimer)\n      }\n      this.autoSaveTimer = setTimeout(() => {\n        this.autoSave()\n      }, 3000) // 3秒后自动保存\n    },\n    async autoSave () {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        return\n      }\n\n      const formData = {\n        ...this.articleForm,\n        status: 'draft'\n      }\n\n      try {\n        const id = this.$route.params.id\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        }\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, formData, config)\n        } else {\n          const response = await axios.post('http://localhost:3000/api/articles', formData, config)\n          this.$route.params.id = response.data.id\n        }\n        this.$message.success('自动保存成功', { duration: 1500 })\n      } catch (error) {\n        console.error('自动保存失败', error)\n      }\n    },\n    async saveArticle (status = 'published') {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空')\n        return\n      }\n\n      const formData = {\n        ...this.articleForm,\n        status: status\n      }\n\n      try {\n        const id = this.$route.params.id\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        }\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, formData, config)\n          this.$message.success(status === 'published' ? '文章更新成功' : '草稿保存成功')\n        } else {\n          await axios.post('http://localhost:3000/api/articles', formData, config)\n          this.$message.success(status === 'published' ? '文章发布成功' : '草稿保存成功')\n        }\n\n        // 根据角色跳转\n        const user = JSON.parse(localStorage.getItem('user') || '{}')\n        if (user.role === 'admin') {\n          this.$router.push('/admin/articles')\n        } else {\n          this.$router.push('/user/center')\n        }\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../../assets/styles/views/ArticleEdit.css\"></style>\n"],"mappings":"AAqEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;QACAC,KAAA;QACAC,WAAA;QACAC,IAAA;QACAC,OAAA;QACAC,OAAA;QACAC,YAAA;QACAC,KAAA;MACA;MACAC,UAAA;MACAL,IAAA;MACAM,aAAA;QACAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACAC,QAAA;MACA,MAAAC,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAN,YAAA,CAAAC,OAAA;MACA,OAAAG,IAAA,CAAAG,IAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,eAAA;IACA,KAAAC,SAAA;IACA,SAAAC,MAAA,CAAAC,MAAA,CAAAC,EAAA;MACA,KAAAC,YAAA,MAAAH,MAAA,CAAAC,MAAA,CAAAC,EAAA;IACA;EACA;EACAE,OAAA;IACA,MAAAN,gBAAA;MACA;QACA,MAAAO,QAAA,SAAA9B,KAAA,CAAA+B,GAAA;QACA,KAAApB,UAAA,GAAAmB,QAAA,CAAA5B,IAAA;MACA,SAAA8B,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAR,UAAA;MACA;QACA,MAAAM,QAAA,SAAA9B,KAAA,CAAA+B,GAAA;QACA,KAAAzB,IAAA,GAAAwB,QAAA,CAAA5B,IAAA;MACA,SAAA8B,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAJ,aAAAD,EAAA;MACA;QACA,MAAAG,QAAA,SAAA9B,KAAA,CAAA+B,GAAA,uCAAAJ,EAAA;QACA,MAAAO,OAAA,GAAAJ,QAAA,CAAA5B,IAAA;;QAEA;QACA,MAAAgB,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAN,YAAA,CAAAC,OAAA