{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      }\n    };\n  },\n  created() {\n    this.fetchArticle();\n  },\n  methods: {\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch article');\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('Please fill in nickname and content');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        await axios.post(`http://localhost:3000/api/articles/${id}/comments`, {\n          ...this.commentForm,\n          article_id: id\n        });\n        this.$message.success('Comment submitted successfully');\n        this.commentForm.nickname = '';\n        this.commentForm.email = '';\n        this.commentForm.content = '';\n        this.fetchArticle(); // Refresh article to see comments (need comments API implementation)\n      } catch (error) {\n        this.$message.error('Failed to submit comment');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","article","comments","commentForm","nickname","email","content","created","fetchArticle","methods","id","$route","params","response","get","error","$message","submitComment","warning","post","article_id","success"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\">Personal Blog</div>\n          <el-menu mode=\"horizontal\" router>\n            <el-menu-item index=\"/\">Home</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-card class=\"detail-card\">\n          <div slot=\"header\">\n            <h1 class=\"title\">{{ article.title }}</h1>\n            <div class=\"meta\">\n              <span>{{ new Date(article.created_at).toLocaleDateString() }}</span>\n              <span v-if=\"article.Category\">{{ article.Category.name }}</span>\n              <span>Views: {{ article.views }}</span>\n            </div>\n          </div>\n          <div class=\"content\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name }}</el-tag>\n          </div>\n        </el-card>\n\n        <!-- Comments section -->\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\">Comments</div>\n          <el-form :model=\"commentForm\" ref=\"commentForm\" label-width=\"0\">\n            <el-row :gutter=\"10\">\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.nickname\" placeholder=\"Nickname (required)\"></el-input>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.email\" placeholder=\"Email (optional)\"></el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item>\n              <el-input type=\"textarea\" v-model=\"commentForm.content\" placeholder=\"Leave a comment...\"></el-input>\n            </el-form-item>\n            <el-form-item>\n              <el-button type=\"primary\" @click=\"submitComment\">Submit</el-button>\n            </el-form-item>\n          </el-form>\n\n          <div class=\"comment-list\">\n            <div v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-header\">\n                <span class=\"comment-nickname\">{{ comment.nickname }}</span>\n                <span class=\"comment-date\">{{ new Date(comment.created_at).toLocaleString() }}</span>\n              </div>\n              <div class=\"comment-content\">{{ comment.content }}</div>\n            </div>\n          </div>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      }\n    };\n  },\n  created() {\n    this.fetchArticle();\n  },\n  methods: {\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n      } catch (error) {\n        this.$message.error('Failed to fetch article');\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('Please fill in nickname and content');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        await axios.post(`http://localhost:3000/api/articles/${id}/comments`, {\n          ...this.commentForm,\n          article_id: id\n        });\n        this.$message.success('Comment submitted successfully');\n        this.commentForm.nickname = '';\n        this.commentForm.email = '';\n        this.commentForm.content = '';\n        this.fetchArticle(); // Refresh article to see comments (need comments API implementation)\n      } catch (error) {\n        this.$message.error('Failed to submit comment');\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n.header-content {\n  max-width: 800px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.main {\n  max-width: 800px;\n  margin: 20px auto;\n}\n.title {\n  font-size: 28px;\n  margin: 0;\n}\n.meta {\n  margin-top: 10px;\n  color: #999;\n  font-size: 14px;\n}\n.meta span {\n  margin-right: 15px;\n}\n.content {\n  line-height: 1.8;\n  font-size: 16px;\n}\n.comment-item {\n  padding: 15px 0;\n  border-bottom: 1px solid #f2f6fc;\n}\n.comment-nickname {\n  font-weight: bold;\n}\n.comment-date {\n  color: #999;\n  font-size: 12px;\n  margin-left: 10px;\n}\n.comment-content {\n  margin-top: 5px;\n}\n</style>\n"],"mappings":"AAoEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,KAAA;QACAC,OAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;EACA;EACAC,OAAA;IACA,MAAAD,aAAA;MACA;QACA,MAAAE,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;QACA,MAAAG,QAAA,SAAAf,KAAA,CAAAgB,GAAA,uCAAAJ,EAAA;QACA,KAAAT,OAAA,GAAAY,QAAA,CAAAb,IAAA;MACA,SAAAe,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAE,cAAA;MACA,UAAAd,WAAA,CAAAC,QAAA,UAAAD,WAAA,CAAAG,OAAA;QACA,KAAAU,QAAA,CAAAE,OAAA;QACA;MACA;MACA;QACA,MAAAR,EAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,EAAA;QACA,MAAAZ,KAAA,CAAAqB,IAAA,uCAAAT,EAAA;UACA,QAAAP,WAAA;UACAiB,UAAA,EAAAV;QACA;QACA,KAAAM,QAAA,CAAAK,OAAA;QACA,KAAAlB,WAAA,CAAAC,QAAA;QACA,KAAAD,WAAA,CAAAE,KAAA;QACA,KAAAF,WAAA,CAAAG,OAAA;QACA,KAAAE,YAAA;MACA,SAAAO,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}