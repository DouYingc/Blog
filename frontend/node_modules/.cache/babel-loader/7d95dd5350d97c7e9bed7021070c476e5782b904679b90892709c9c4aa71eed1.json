{"ast":null,"code":"import axios from 'axios';\nimport * as echarts from 'echarts';\nexport default {\n  name: 'UserDashboard',\n  data() {\n    return {\n      stats: {\n        articleCount: 0,\n        totalViews: 0,\n        totalLikes: 0,\n        categoryDistribution: [],\n        topArticles: []\n      },\n      categoryChart: null,\n      topArticlesChart: null\n    };\n  },\n  mounted() {\n    this.fetchStats();\n    window.addEventListener('resize', this.handleResize);\n  },\n  beforeDestroy() {\n    window.removeEventListener('resize', this.handleResize);\n    if (this.categoryChart) this.categoryChart.dispose();\n    if (this.topArticlesChart) this.topArticlesChart.dispose();\n  },\n  methods: {\n    async fetchStats() {\n      try {\n        const token = localStorage.getItem('token');\n        const response = await axios.get('http://localhost:3000/api/stats/user-stats', {\n          headers: {\n            Authorization: `Bearer ${token}`\n          }\n        });\n        this.stats = response.data;\n        this.initCharts();\n      } catch (error) {\n        console.error('获取统计数据失败', error);\n        // Only show error if it's not a 401 (auth handled elsewhere usually)\n        if (error.response && error.response.status !== 401) {\n          this.$message.error('获取统计数据失败');\n        }\n      }\n    },\n    initCharts() {\n      // Category Chart\n      if (this.$refs.categoryChart) {\n        this.categoryChart = echarts.init(this.$refs.categoryChart);\n        this.categoryChart.setOption({\n          tooltip: {\n            trigger: 'item'\n          },\n          legend: {\n            bottom: '0%',\n            left: 'center'\n          },\n          series: [{\n            name: '文章分类',\n            type: 'pie',\n            radius: ['40%', '60%'],\n            // 稍微缩小半径\n            center: ['50%', '45%'],\n            // 稍微上移\n            avoidLabelOverlap: false,\n            itemStyle: {\n              borderRadius: 10,\n              borderColor: '#fff',\n              borderWidth: 2\n            },\n            label: {\n              show: false,\n              position: 'center'\n            },\n            emphasis: {\n              label: {\n                show: true,\n                fontSize: 20,\n                fontWeight: 'bold'\n              }\n            },\n            labelLine: {\n              show: false\n            },\n            data: this.stats.categoryDistribution\n          }]\n        });\n      }\n\n      // Top Articles Chart\n      if (this.$refs.topArticlesChart) {\n        this.topArticlesChart = echarts.init(this.$refs.topArticlesChart);\n        const titles = this.stats.topArticles.map(a => a.title.substring(0, 10) + (a.title.length > 10 ? '...' : ''));\n        const views = this.stats.topArticles.map(a => a.views);\n        this.topArticlesChart.setOption({\n          tooltip: {\n            trigger: 'axis',\n            axisPointer: {\n              type: 'shadow'\n            }\n          },\n          grid: {\n            left: '3%',\n            right: '4%',\n            bottom: '3%',\n            containLabel: true\n          },\n          xAxis: [{\n            type: 'category',\n            data: titles,\n            axisTick: {\n              alignWithLabel: true\n            },\n            axisLabel: {\n              interval: 0,\n              rotate: 30\n            }\n          }],\n          yAxis: [{\n            type: 'value'\n          }],\n          series: [{\n            name: '阅读量',\n            type: 'bar',\n            barWidth: '60%',\n            data: views,\n            itemStyle: {\n              color: '#409EFF'\n            }\n          }]\n        });\n      }\n    },\n    handleResize() {\n      if (this.categoryChart) this.categoryChart.resize();\n      if (this.topArticlesChart) this.topArticlesChart.resize();\n    }\n  }\n};","map":{"version":3,"names":["axios","echarts","name","data","stats","articleCount","totalViews","totalLikes","categoryDistribution","topArticles","categoryChart","topArticlesChart","mounted","fetchStats","window","addEventListener","handleResize","beforeDestroy","removeEventListener","dispose","methods","token","localStorage","getItem","response","get","headers","Authorization","initCharts","error","console","status","$message","$refs","init","setOption","tooltip","trigger","legend","bottom","left","series","type","radius","center","avoidLabelOverlap","itemStyle","borderRadius","borderColor","borderWidth","label","show","position","emphasis","fontSize","fontWeight","labelLine","titles","map","a","title","substring","length","views","axisPointer","grid","right","containLabel","xAxis","axisTick","alignWithLabel","axisLabel","interval","rotate","yAxis","barWidth","color","resize"],"sources":["src/components/UserDashboard.vue"],"sourcesContent":["<template>\n  <div class=\"user-dashboard\">\n    <el-row :gutter=\"20\">\n      <el-col :span=\"8\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>文章总数</span>\n          </div>\n          <div class=\"stat-value\">{{ stats.articleCount }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"8\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>总阅读量</span>\n          </div>\n          <div class=\"stat-value\">{{ stats.totalViews }}</div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"8\">\n        <el-card shadow=\"hover\" class=\"stat-card\">\n          <div slot=\"header\" class=\"clearfix\">\n            <span>总获赞数</span>\n          </div>\n          <div class=\"stat-value\">{{ stats.totalLikes }}</div>\n        </el-card>\n      </el-col>\n    </el-row>\n\n    <el-row :gutter=\"20\" style=\"margin-top: 20px;\">\n      <el-col :span=\"24\" style=\"margin-bottom: 20px;\">\n        <el-card shadow=\"hover\">\n          <div slot=\"header\">文章分类分布</div>\n          <div ref=\"categoryChart\" style=\"height: 300px;\"></div>\n        </el-card>\n      </el-col>\n      <el-col :span=\"24\">\n        <el-card shadow=\"hover\">\n          <div slot=\"header\">阅读量 Top 5</div>\n          <div ref=\"topArticlesChart\" style=\"height: 300px;\"></div>\n        </el-card>\n      </el-col>\n    </el-row>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport * as echarts from 'echarts'\n\nexport default {\n  name: 'UserDashboard',\n  data () {\n    return {\n      stats: {\n        articleCount: 0,\n        totalViews: 0,\n        totalLikes: 0,\n        categoryDistribution: [],\n        topArticles: []\n      },\n      categoryChart: null,\n      topArticlesChart: null\n    }\n  },\n  mounted () {\n    this.fetchStats()\n    window.addEventListener('resize', this.handleResize)\n  },\n  beforeDestroy () {\n    window.removeEventListener('resize', this.handleResize)\n    if (this.categoryChart) this.categoryChart.dispose()\n    if (this.topArticlesChart) this.topArticlesChart.dispose()\n  },\n  methods: {\n    async fetchStats () {\n      try {\n        const token = localStorage.getItem('token')\n        const response = await axios.get('http://localhost:3000/api/stats/user-stats', {\n          headers: { Authorization: `Bearer ${token}` }\n        })\n        this.stats = response.data\n        this.initCharts()\n      } catch (error) {\n        console.error('获取统计数据失败', error)\n        // Only show error if it's not a 401 (auth handled elsewhere usually)\n        if (error.response && error.response.status !== 401) {\n          this.$message.error('获取统计数据失败')\n        }\n      }\n    },\n    initCharts () {\n      // Category Chart\n      if (this.$refs.categoryChart) {\n        this.categoryChart = echarts.init(this.$refs.categoryChart)\n        this.categoryChart.setOption({\n          tooltip: {\n            trigger: 'item'\n          },\n          legend: {\n            bottom: '0%',\n            left: 'center'\n          },\n          series: [\n            {\n              name: '文章分类',\n              type: 'pie',\n              radius: ['40%', '60%'], // 稍微缩小半径\n              center: ['50%', '45%'], // 稍微上移\n              avoidLabelOverlap: false,\n              itemStyle: {\n                borderRadius: 10,\n                borderColor: '#fff',\n                borderWidth: 2\n              },\n              label: {\n                show: false,\n                position: 'center'\n              },\n              emphasis: {\n                label: {\n                  show: true,\n                  fontSize: 20,\n                  fontWeight: 'bold'\n                }\n              },\n              labelLine: {\n                show: false\n              },\n              data: this.stats.categoryDistribution\n            }\n          ]\n        })\n      }\n\n      // Top Articles Chart\n      if (this.$refs.topArticlesChart) {\n        this.topArticlesChart = echarts.init(this.$refs.topArticlesChart)\n        const titles = this.stats.topArticles.map(a => a.title.substring(0, 10) + (a.title.length > 10 ? '...' : ''))\n        const views = this.stats.topArticles.map(a => a.views)\n\n        this.topArticlesChart.setOption({\n          tooltip: {\n            trigger: 'axis',\n            axisPointer: {\n              type: 'shadow'\n            }\n          },\n          grid: {\n            left: '3%',\n            right: '4%',\n            bottom: '3%',\n            containLabel: true\n          },\n          xAxis: [\n            {\n              type: 'category',\n              data: titles,\n              axisTick: {\n                alignWithLabel: true\n              },\n              axisLabel: {\n                interval: 0,\n                rotate: 30\n              }\n            }\n          ],\n          yAxis: [\n            {\n              type: 'value'\n            }\n          ],\n          series: [\n            {\n              name: '阅读量',\n              type: 'bar',\n              barWidth: '60%',\n              data: views,\n              itemStyle: {\n                color: '#409EFF'\n              }\n            }\n          ]\n        })\n      }\n    },\n    handleResize () {\n      if (this.categoryChart) this.categoryChart.resize()\n      if (this.topArticlesChart) this.topArticlesChart.resize()\n    }\n  }\n}\n</script>\n\n<style scoped src=\"@/assets/styles/components/UserDashboard.css\"></style>\n"],"mappings":"AA+CA,OAAAA,KAAA;AACA,YAAAC,OAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,KAAA;QACAC,YAAA;QACAC,UAAA;QACAC,UAAA;QACAC,oBAAA;QACAC,WAAA;MACA;MACAC,aAAA;MACAC,gBAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,UAAA;IACAC,MAAA,CAAAC,gBAAA,gBAAAC,YAAA;EACA;EACAC,cAAA;IACAH,MAAA,CAAAI,mBAAA,gBAAAF,YAAA;IACA,SAAAN,aAAA,OAAAA,aAAA,CAAAS,OAAA;IACA,SAAAR,gBAAA,OAAAA,gBAAA,CAAAQ,OAAA;EACA;EACAC,OAAA;IACA,MAAAP,WAAA;MACA;QACA,MAAAQ,KAAA,GAAAC,YAAA,CAAAC,OAAA;QACA,MAAAC,QAAA,SAAAxB,KAAA,CAAAyB,GAAA;UACAC,OAAA;YAAAC,aAAA,YAAAN,KAAA;UAAA;QACA;QACA,KAAAjB,KAAA,GAAAoB,QAAA,CAAArB,IAAA;QACA,KAAAyB,UAAA;MACA,SAAAC,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;QACA;QACA,IAAAA,KAAA,CAAAL,QAAA,IAAAK,KAAA,CAAAL,QAAA,CAAAO,MAAA;UACA,KAAAC,QAAA,CAAAH,KAAA;QACA;MACA;IACA;IACAD,WAAA;MACA;MACA,SAAAK,KAAA,CAAAvB,aAAA;QACA,KAAAA,aAAA,GAAAT,OAAA,CAAAiC,IAAA,MAAAD,KAAA,CAAAvB,aAAA;QACA,KAAAA,aAAA,CAAAyB,SAAA;UACAC,OAAA;YACAC,OAAA;UACA;UACAC,MAAA;YACAC,MAAA;YACAC,IAAA;UACA;UACAC,MAAA,GACA;YACAvC,IAAA;YACAwC,IAAA;YACAC,MAAA;YAAA;YACAC,MAAA;YAAA;YACAC,iBAAA;YACAC,SAAA;cACAC,YAAA;cACAC,WAAA;cACAC,WAAA;YACA;YACAC,KAAA;cACAC,IAAA;cACAC,QAAA;YACA;YACAC,QAAA;cACAH,KAAA;gBACAC,IAAA;gBACAG,QAAA;gBACAC,UAAA;cACA;YACA;YACAC,SAAA;cACAL,IAAA;YACA;YACAhD,IAAA,OAAAC,KAAA,CAAAI;UACA;QAEA;MACA;;MAEA;MACA,SAAAyB,KAAA,CAAAtB,gBAAA;QACA,KAAAA,gBAAA,GAAAV,OAAA,CAAAiC,IAAA,MAAAD,KAAA,CAAAtB,gBAAA;QACA,MAAA8C,MAAA,QAAArD,KAAA,CAAAK,WAAA,CAAAiD,GAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAC,KAAA,CAAAC,SAAA,WAAAF,CAAA,CAAAC,KAAA,CAAAE,MAAA;QACA,MAAAC,KAAA,QAAA3D