{"ast":null,"code":"export default {\n  name: 'NavBar',\n  data() {\n    return {\n      keyword: '',\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    isAdmin() {\n      return this.currentUser.role === 'admin';\n    }\n  },\n  methods: {\n    handleSearch() {\n      if (this.keyword.trim()) {\n        if (this.$route.path !== '/') {\n          this.$router.push(`/?keyword=${this.keyword}`);\n        } else {\n          // 如果已经在首页，通过 emit 事件或者 bus 通知父组件\n          this.$emit('search', this.keyword);\n        }\n      } else {\n        if (this.$route.path === '/') {\n          this.$emit('search', '');\n        }\n      }\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      if (this.$route.path === '/') {\n        location.reload();\n      } else {\n        this.$router.push('/');\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","keyword","currentUser","JSON","parse","localStorage","getItem","computed","isLoggedIn","isAdmin","role","methods","handleSearch","trim","$route","path","$router","push","$emit","handleLogout","removeItem","location","reload"],"sources":["src/components/NavBar.vue"],"sourcesContent":["<template>\n  <el-header class=\"header\">\n    <div class=\"header-content\">\n      <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n      <div class=\"search-bar\">\n        <el-input v-model=\"keyword\" placeholder=\"搜索文章...\" prefix-icon=\"el-icon-search\" clearable\n          @keyup.enter.native=\"handleSearch\" @clear=\"handleSearch\" size=\"small\" class=\"search-input\"></el-input>\n      </div>\n      <el-menu mode=\"horizontal\" router :default-active=\"$route.path\" class=\"nav-menu\">\n        <el-menu-item index=\"/\">首页</el-menu-item>\n        <el-menu-item index=\"/archives\">归档</el-menu-item>\n        <el-menu-item index=\"/messages\">留言板</el-menu-item>\n        <el-menu-item v-if=\"!isLoggedIn\" index=\"/login\">登录/注册</el-menu-item>\n        <el-submenu v-else index=\"user-menu\">\n          <template slot=\"title\">\n            <div class=\"user-nav\">\n              <el-avatar v-if=\"currentUser.avatar\" :size=\"30\" :src=\"currentUser.avatar\"\n                style=\"margin-right: 8px; vertical-align: middle\"></el-avatar>\n              <i v-else class=\"el-icon-user\" style=\"margin-right: 8px\"></i>\n              <span>{{ currentUser.username }}</span>\n            </div>\n          </template>\n          <el-menu-item index=\"/user/center\">个人中心</el-menu-item>\n          <el-menu-item v-if=\"isAdmin\" index=\"/admin\">系统后台</el-menu-item>\n          <el-menu-item @click=\"handleLogout\">退出登录</el-menu-item>\n        </el-submenu>\n      </el-menu>\n    </div>\n  </el-header>\n</template>\n\n<script>\nexport default {\n  name: 'NavBar',\n  data () {\n    return {\n      keyword: '',\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    isAdmin () {\n      return this.currentUser.role === 'admin'\n    }\n  },\n  methods: {\n    handleSearch () {\n      if (this.keyword.trim()) {\n        if (this.$route.path !== '/') {\n          this.$router.push(`/?keyword=${this.keyword}`)\n        } else {\n          // 如果已经在首页，通过 emit 事件或者 bus 通知父组件\n          this.$emit('search', this.keyword)\n        }\n      } else {\n        if (this.$route.path === '/') {\n          this.$emit('search', '')\n        }\n      }\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      if (this.$route.path === '/') {\n        location.reload()\n      } else {\n        this.$router.push('/')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #e6e6e6;\n  position: sticky;\n  top: 0;\n  z-index: 1000;\n  padding: 0;\n}\n\n.header-content {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  height: 60px;\n  padding: 0 20px;\n}\n\n.logo {\n  font-size: 24px;\n  font-weight: bold;\n  color: #409EFF;\n  margin-right: 40px;\n  cursor: pointer;\n  white-space: nowrap;\n}\n\n.search-bar {\n  flex: 1;\n  max-width: 300px;\n  margin-right: 20px;\n}\n\n.nav-menu {\n  border-bottom: none !important;\n  flex: 1;\n  display: flex;\n  justify-content: flex-end;\n}\n\n.user-nav {\n  display: inline-flex;\n  align-items: center;\n  height: 100%; /* Ensure it takes full height */\n}\n\n/* Fix Element UI submenu arrow position */\n::v-deep .el-submenu__title i.el-submenu__icon-arrow {\n  position: static;\n  margin-left: 8px;\n  margin-top: 0;\n}\n</style>\n"],"mappings":"AAgCA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAH,YAAA,CAAAC,OAAA;IACA;IACAG,QAAA;MACA,YAAAP,WAAA,CAAAQ,IAAA;IACA;EACA;EACAC,OAAA;IACAC,aAAA;MACA,SAAAX,OAAA,CAAAY,IAAA;QACA,SAAAC,MAAA,CAAAC,IAAA;UACA,KAAAC,OAAA,CAAAC,IAAA,mBAAAhB,OAAA;QACA;UACA;UACA,KAAAiB,KAAA,gBAAAjB,OAAA;QACA;MACA;QACA,SAAAa,MAAA,CAAAC,IAAA;UACA,KAAAG,KAAA;QACA;MACA;IACA;IACAC,aAAA;MACAd,YAAA,CAAAe,UAAA;MACAf,YAAA,CAAAe,UAAA;MACA,SAAAN,MAAA,CAAAC,IAAA;QACAM,QAAA,CAAAC,MAAA;MACA;QACA,KAAAN,OAAA,CAAAC,IAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}