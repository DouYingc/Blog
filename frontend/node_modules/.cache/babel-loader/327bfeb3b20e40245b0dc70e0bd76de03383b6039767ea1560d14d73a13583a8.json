{"ast":null,"code":"import axios from 'axios';\nimport 'github-markdown-css/github-markdown.css';\nimport RelatedArticles from '@/components/RelatedArticles.vue';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'ArticleDetail',\n  components: {\n    RelatedArticles,\n    NavBar\n  },\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: '',\n        parent_id: null\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false,\n      showActions: false,\n      replyPlaceholder: '写下你的评论...',\n      errorMsg: '',\n      toc: [],\n      tocVisible: false,\n      readingProgress: 0\n    };\n  },\n  computed: {\n    mainStyle() {\n      return {\n        maxWidth: '1000px',\n        width: '100%',\n        margin: '100px auto',\n        padding: '0 20px',\n        boxSizing: 'border-box'\n      };\n    },\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    canManage() {\n      if (!this.isLoggedIn || !this.article.id) return false;\n      return this.currentUser.role === 'admin' || this.article.user_id === this.currentUser.id;\n    },\n    commentsCount() {\n      return this.comments.length;\n    },\n    nestedComments() {\n      const roots = this.comments.filter(c => !c.parent_id);\n      return roots.map(root => {\n        // 确保原始对象有必要的响应式属性\n        if (!root.hasOwnProperty('showReplyBox')) {\n          this.$set(root, 'showReplyBox', false);\n          this.$set(root, 'replyForm', {\n            content: '',\n            parent_id: root.id\n          });\n        }\n        const replies = this.comments.filter(c => c.parent_id === root.id).map(reply => {\n          // 确保子评论有必要的响应式属性\n          if (!reply.hasOwnProperty('showReplyBox')) {\n            this.$set(reply, 'showReplyBox', false);\n            this.$set(reply, 'replyForm', {\n              content: '',\n              parent_id: reply.id\n            });\n          }\n          return reply;\n        });\n\n        // 直接使用root对象，不创建新对象，避免响应式问题\n        root.replies = replies;\n        return root;\n      });\n    }\n  },\n  mounted() {\n    this.updateReadingProgress();\n    window.addEventListener('scroll', this.updateReadingProgress, {\n      passive: true\n    });\n  },\n  beforeDestroy() {\n    window.removeEventListener('scroll', this.updateReadingProgress);\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle();\n        this.fetchComments();\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus();\n        }\n        this.initCommentForm();\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    updateReadingProgress() {\n      const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0;\n      const total = (document.documentElement.scrollHeight || 0) - (document.documentElement.clientHeight || 0);\n      const progress = total > 0 ? scrollTop / total * 100 : 0;\n      this.readingProgress = Math.max(0, Math.min(100, Math.round(progress)));\n    },\n    buildToc() {\n      const html = this.article && this.article.html_content ? this.article.html_content : '';\n      if (!html) {\n        this.toc = [];\n        return;\n      }\n\n      // 创建一个临时容器来解析HTML\n      const container = document.createElement('div');\n      container.innerHTML = html;\n      const headings = Array.from(container.querySelectorAll('h1,h2,h3'));\n\n      // 构建目录，使用一致的ID生成逻辑\n      this.toc = headings.map((h, idx) => {\n        const level = parseInt(h.tagName.replace('H', ''), 10);\n        const text = h.textContent.trim();\n\n        // 生成一致的ID\n        const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || `heading-${idx}`;\n        return {\n          id,\n          text,\n          level\n        };\n      }).filter(item => item.text);\n\n      // 立即为页面中的标题添加ID\n      this.$nextTick(() => {\n        this.addHeadingIds();\n      });\n    },\n    addHeadingIds() {\n      const contentElement = document.querySelector('.content.markdown-body');\n      if (!contentElement) return;\n      const headings = Array.from(contentElement.querySelectorAll('h1,h2,h3'));\n      console.log('找到页面中的标题:', headings.map(h => h.textContent.trim()));\n      headings.forEach((h, idx) => {\n        const text = h.textContent.trim();\n        const id = text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') || `heading-${idx}`;\n        h.id = id;\n        console.log('为标题添加ID:', {\n          text,\n          id\n        });\n      });\n    },\n    scrollToHeading(id) {\n      // 先关闭目录\n      this.tocVisible = false;\n\n      // 使用绝对位置计算来滚动\n      setTimeout(() => {\n        const el = document.getElementById(id);\n        if (el) {\n          console.log('找到标题元素，准备滚动:', id);\n\n          // 计算元素的绝对位置\n          let offsetTop = el.offsetTop;\n          let parent = el.offsetParent;\n\n          // 累加所有父元素的offsetTop\n          while (parent) {\n            offsetTop += parent.offsetTop;\n            parent = parent.offsetParent;\n          }\n\n          // 考虑导航栏高度\n          const headerHeight = 80;\n          console.log('滚动位置:', offsetTop - headerHeight);\n\n          // 使用window.scrollTo滚动\n          window.scrollTo({\n            top: offsetTop - headerHeight,\n            behavior: 'auto' // 不使用动画，确保能生效\n          });\n        }\n      }, 100);\n    },\n    initCommentForm() {\n      if (this.isLoggedIn) {\n        this.commentForm.nickname = this.currentUser.username;\n        this.commentForm.email = this.currentUser.email || '';\n      }\n    },\n    onCommentFocus() {\n      this.showActions = true;\n    },\n    onReplyFocus() {\n      // 可以在这里添加回复框聚焦的逻辑\n    },\n    cancelReply() {\n      this.commentForm.parent_id = null;\n      this.commentForm.content = '';\n      this.showActions = false;\n    },\n    toggleReplyBox(comment, parentId = null) {\n      // 先关闭所有回复框\n      this.closeAllReplyBoxes();\n\n      // 切换当前回复框显示状态\n      this.$set(comment, 'showReplyBox', !comment.showReplyBox);\n      if (comment.showReplyBox) {\n        // 确保回复表单存在且是响应式的\n        if (!comment.replyForm) {\n          this.$set(comment, 'replyForm', {\n            content: '',\n            parent_id: parentId || comment.id\n          });\n        }\n        // 更新回复内容\n        comment.replyForm.content = `@${comment.nickname} `;\n        comment.replyForm.parent_id = parentId || comment.id;\n      }\n    },\n    closeAllReplyBoxes() {\n      // 直接操作原始comments数组，使用$set确保响应式更新\n      this.comments.forEach(comment => {\n        this.$set(comment, 'showReplyBox', false);\n      });\n    },\n    async submitReply(comment) {\n      if (!comment.replyForm || !comment.replyForm.content.trim()) {\n        this.$message.warning('回复内容不能为空');\n        return;\n      }\n      try {\n        const headers = {};\n        const token = localStorage.getItem('token');\n        if (token) {\n          headers.Authorization = `Bearer ${token}`;\n        }\n        await axios.post('http://localhost:3000/api/comments', {\n          ...comment.replyForm,\n          article_id: this.article.id,\n          nickname: this.commentForm.nickname,\n          email: this.commentForm.email\n        }, {\n          headers\n        });\n        this.$message.success('回复成功');\n        comment.showReplyBox = false;\n        this.fetchComments();\n      } catch (error) {\n        this.$message.error('回复失败');\n      }\n    },\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        if (!id) {\n          this.errorMsg = '文章 ID 缺失';\n          this.$message.error('文章 ID 缺失');\n          return;\n        }\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n        this.errorMsg = '';\n        this.buildToc();\n        this.$nextTick(() => {\n          this.updateReadingProgress();\n        });\n      } catch (error) {\n        console.error('获取文章详情失败:', error);\n        this.article = {};\n        const url = `http://localhost:3000/api/articles/${this.$route.params.id}`;\n        this.errorMsg = `获取文章失败: ${error.message} (URL: ${url})`;\n        this.$message.error('获取文章详情失败');\n        this.toc = [];\n      }\n    },\n    async fetchInteractionStatus() {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.isFavorited = response.data.isFavorited;\n      } catch (error) {\n        console.error('获取交互状态失败', error);\n      }\n    },\n    async handleLike() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isLiked = response.data.isLiked;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败');\n      }\n    },\n    async handleFavorite() {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite', {\n          article_id: this.article.id\n        }, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.isFavorited = response.data.isFavorited;\n        this.$message.success(response.data.message);\n        this.fetchArticle(); // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败');\n      }\n    },\n    handleEdit() {\n      this.$router.push(`/article/edit/${this.article.id}`);\n    },\n    async handleDelete() {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.$router.push('/');\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async fetchComments() {\n      try {\n        const id = this.$route.params.id;\n        const headers = {};\n        const token = localStorage.getItem('token');\n        if (token) {\n          headers.Authorization = `Bearer ${token}`;\n        }\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`, {\n          headers\n        });\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败', error);\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和内容');\n        return;\n      }\n      try {\n        const headers = {};\n        const token = localStorage.getItem('token');\n        if (token) {\n          headers.Authorization = `Bearer ${token}`;\n        }\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: this.article.id\n        }, {\n          headers\n        });\n        this.$message.success('评论成功');\n        this.commentForm.content = '';\n        this.commentForm.parent_id = null;\n        this.showActions = false;\n        this.fetchComments();\n      } catch (error) {\n        this.$message.error('评论失败');\n      }\n    },\n    async handleCommentLike(comment) {\n      try {\n        const headers = {\n          Authorization: `Bearer ${localStorage.getItem('token')}`\n        };\n        let successMessage = '';\n        if (comment.is_liked) {\n          await axios.delete(`http://localhost:3000/api/comments/${comment.id}/like`, {\n            headers\n          });\n          comment.is_liked = false;\n          comment.likes_count = Math.max(0, (comment.likes_count || 0) - 1);\n          successMessage = '取消点赞成功';\n        } else {\n          await axios.post(`http://localhost:3000/api/comments/${comment.id}/like`, {}, {\n            headers\n          });\n          comment.is_liked = true;\n          comment.likes_count = (comment.likes_count || 0) + 1;\n          successMessage = '点赞成功';\n        }\n\n        // 更新原始comments数组中的状态，确保数据一致性\n        const index = this.comments.findIndex(c => c.id === comment.id);\n        if (index !== -1) {\n          this.$set(this.comments[index], 'is_liked', comment.is_liked);\n          this.$set(this.comments[index], 'likes_count', comment.likes_count);\n        }\n        this.$message.success(successMessage);\n      } catch (error) {\n        console.error('点赞操作失败:', error);\n        this.$message.error(error.response?.data?.message || '操作失败');\n      }\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知时间';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      const Y = date.getFullYear();\n      const M = (date.getMonth() + 1).toString().padStart(2, '0');\n      const D = date.getDate().toString().padStart(2, '0');\n      const h = date.getHours().toString().padStart(2, '0');\n      const m = date.getMinutes().toString().padStart(2, '0');\n      if (isNaN(Y) || isNaN(date.getMonth()) || isNaN(date.getDate())) return '无效日期';\n      return `${Y}-${M}-${D} ${h}:${m}`;\n    }\n  }\n};","map":{"version":3,"names":["axios","RelatedArticles","NavBar","name","components","data","article","comments","commentForm","nickname","email","content","parent_id","currentUser","JSON","parse","localStorage","getItem","isLiked","isFavorited","showActions","replyPlaceholder","errorMsg","toc","tocVisible","readingProgress","computed","mainStyle","maxWidth","width","margin","padding","boxSizing","isLoggedIn","canManage","id","role","user_id","commentsCount","length","nestedComments","roots","filter","c","map","root","hasOwnProperty","$set","replies","reply","mounted","updateReadingProgress","window","addEventListener","passive","beforeDestroy","removeEventListener","watch","handler","fetchArticle","fetchComments","fetchInteractionStatus","initCommentForm","immediate","methods","scrollTop","pageYOffset","document","documentElement","total","scrollHeight","clientHeight","progress","Math","max","min","round","buildToc","html","html_content","container","createElement","innerHTML","headings","Array","from","querySelectorAll","h","idx","level","parseInt","tagName","replace","text","textContent","trim","toLowerCase","item","$nextTick","addHeadingIds","contentElement","querySelector","console","log","forEach","scrollToHeading","setTimeout","el","getElementById","offsetTop","parent","offsetParent","headerHeight","scrollTo","top","behavior","username","onCommentFocus","onReplyFocus","cancelReply","toggleReplyBox","comment","parentId","closeAllReplyBoxes","showReplyBox","replyForm","submitReply","$message","warning","headers","token","Authorization","post","article_id","success","error","$route","params","response","get","url","message","handleLike","handleFavorite","handleEdit","$router","push","handleDelete","$confirm","type","delete","submitComment","handleCommentLike","successMessage","is_liked","likes_count","index","findIndex","formatDate","dateStr","date","Date","isNaN","getTime","Y","getFullYear","M","getMonth","toString","padStart","D","getDate","getHours","m","getMinutes"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <div class=\"reading-progress\">\n        <div class=\"reading-progress-bar\" :style=\"{ width: readingProgress + '%' }\"></div>\n      </div>\n\n      <el-main class=\"main\" :style=\"mainStyle\">\n        <el-card class=\"detail-card\">\n          <el-alert v-if=\"errorMsg\" :title=\"errorMsg\" type=\"error\" show-icon style=\"margin-bottom: 20px\"></el-alert>\n          <div slot=\"header\">\n            <div class=\"title-wrapper\">\n              <h1 class=\"title\">{{ article.title }}</h1>\n              <div class=\"detail-manage\">\n                <el-button v-if=\"canManage\" type=\"primary\" size=\"small\" icon=\"el-icon-edit\"\n                  @click=\"handleEdit\">编辑文章</el-button>\n                <el-button v-if=\"canManage\" type=\"danger\" size=\"small\" icon=\"el-icon-delete\"\n                  @click=\"handleDelete\">删除文章</el-button>\n                <el-button v-if=\"toc.length\" size=\"small\" icon=\"el-icon-tickets\"\n                  @click=\"tocVisible = true\">目录</el-button>\n              </div>\n            </div>\n            <div class=\"meta\">\n              <span class=\"user-link\" @click=\"$router.push(`/user/profile/${article.user_id}`)\">\n                <i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}\n              </span>\n              <span><i class=\"el-icon-date\"></i> {{ formatDate(article.created_at) }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> 阅读: {{ article.views }}</span>\n            </div>\n          </div>\n          <!-- 使用 v-html 渲染 Markdown 解析后的 HTML -->\n          <div class=\"content markdown-body\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name\n            }}</el-tag>\n          </div>\n\n          <!-- 交互操作：点赞与收藏 -->\n          <div class=\"interactions\" v-if=\"isLoggedIn\">\n            <div class=\"interaction-item\">\n              <el-button :type=\"isLiked ? 'primary' : 'default'\" icon=\"el-icon-caret-top\" circle @click=\"handleLike\"\n                :title=\"isLiked ? '取消点赞' : '点赞'\"></el-button>\n              <span class=\"count\">{{ article.likes_count || 0 }}</span>\n              <span class=\"label\">点赞</span>\n            </div>\n            <div class=\"interaction-item\">\n              <el-button :type=\"isFavorited ? 'warning' : 'default'\" icon=\"el-icon-star-on\" circle\n                @click=\"handleFavorite\" :title=\"isFavorited ? '取消收藏' : '收藏'\"></el-button>\n              <span class=\"count\">{{ article.favorites_count || 0 }}</span>\n              <span class=\"label\">收藏</span>\n            </div>\n          </div>\n        </el-card>\n\n        <related-articles v-if=\"article.id\" :currentArticleId=\"article.id\"></related-articles>\n\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\" class=\"comment-header-title\">全部评论 ({{ commentsCount }})</div>\n\n          <!-- 评论输入框 -->\n          <el-form :model=\"commentForm\" ref=\"commentForm\" class=\"comment-form\">\n            <div class=\"comment-input-row\">\n              <el-avatar :size=\"40\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              <div class=\"input-main\">\n                <el-row :gutter=\"10\" v-if=\"!isLoggedIn\" style=\"margin-bottom: 10px\">\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.nickname\" placeholder=\"昵称 (必填)\" size=\"small\"></el-input>\n                  </el-col>\n                  <el-col :span=\"12\">\n                    <el-input v-model=\"commentForm.email\" placeholder=\"邮箱 (可选)\" size=\"small\"></el-input>\n                  </el-col>\n                </el-row>\n                <el-input type=\"textarea\" :rows=\"3\" v-model=\"commentForm.content\" :placeholder=\"replyPlaceholder\"\n                  @focus=\"onCommentFocus\"></el-input>\n                <div class=\"form-actions\" v-if=\"commentForm.content || showActions\">\n                  <el-button v-if=\"commentForm.parent_id\" size=\"small\" @click=\"cancelReply\">取消回复</el-button>\n                  <el-button type=\"primary\" size=\"small\" @click=\"submitComment\">提交评论</el-button>\n                </div>\n              </div>\n            </div>\n          </el-form>\n\n          <!-- 评论列表 -->\n          <div class=\"comment-list\">\n            <div v-for=\"comment in nestedComments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-main\">\n                <el-avatar :size=\"40\" :src=\"comment.User ? comment.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                <div class=\"comment-body\">\n                  <div class=\"comment-info\">\n                    <span class=\"nickname\" :class=\"{ 'user-link': !!comment.user_id }\"\n                      @click=\"comment.user_id && $router.push(`/user/profile/${comment.user_id}`)\">{{ comment.nickname\n                      }}</span>\n                    <span class=\"date\">{{ formatDate(comment.created_at) }}</span>\n                  </div>\n                  <div class=\"comment-text\">{{ comment.content }}</div>\n                  <div class=\"comment-footer\">\n                    <span class=\"like-btn\" @click=\"handleCommentLike(comment)\" :class=\"{ active: comment.is_liked }\">\n                      <i class=\"el-icon-thumb\"></i> {{ comment.likes_count || 0 }}\n                    </span>\n                    <span class=\"reply-btn\" @click=\"toggleReplyBox(comment)\">\n                      <i class=\"el-icon-chat-dot-round\"></i> 回复\n                    </span>\n                  </div>\n\n                  <!-- 单独的回复框 -->\n                  <div v-if=\"comment.showReplyBox\" class=\"reply-form-container\">\n                    <el-form :model=\"comment.replyForm\" label-width=\"0\">\n                      <el-input type=\"textarea\" :rows=\"2\" v-model=\"comment.replyForm.content\" placeholder=\"写下你的回复...\"\n                        @focus=\"onReplyFocus\"></el-input>\n                      <div class=\"reply-form-actions\">\n                        <el-button size=\"small\" @click=\"comment.showReplyBox = false\">取消</el-button>\n                        <el-button type=\"primary\" size=\"small\" @click=\"submitReply(comment)\">回复</el-button>\n                      </div>\n                    </el-form>\n                  </div>\n\n                  <!-- 子评论 (二级评论) -->\n                  <div v-if=\"comment.replies && comment.replies.length\" class=\"reply-list\">\n                    <div v-for=\"reply in comment.replies\" :key=\"reply.id\" class=\"reply-item\">\n                      <el-avatar :size=\"30\" :src=\"reply.User ? reply.User.avatar : ''\" icon=\"el-icon-user\"></el-avatar>\n                      <div class=\"reply-body\">\n                        <div class=\"comment-info\">\n                          <span class=\"nickname\" :class=\"{ 'user-link': !!reply.user_id }\"\n                            @click=\"reply.user_id && $router.push(`/user/profile/${reply.user_id}`)\">{{ reply.nickname\n                            }}</span>\n                          <span class=\"date\">{{ formatDate(reply.created_at) }}</span>\n                        </div>\n                        <div class=\"comment-text\">{{ reply.content }}</div>\n                        <div class=\"comment-footer\">\n                          <span class=\"like-btn\" @click=\"handleCommentLike(reply)\" :class=\"{ active: reply.is_liked }\">\n                            <i class=\"el-icon-thumb\"></i> {{ reply.likes_count || 0 }}\n                          </span>\n                          <span class=\"reply-btn\" @click=\"toggleReplyBox(reply, comment.id)\">\n                            <i class=\"el-icon-chat-dot-round\"></i> 回复\n                          </span>\n                        </div>\n\n                        <!-- 子评论的回复框 -->\n                        <div v-if=\"reply.showReplyBox\" class=\"reply-form-container\">\n                          <el-form :model=\"reply.replyForm\" label-width=\"0\">\n                            <el-input type=\"textarea\" :rows=\"2\" v-model=\"reply.replyForm.content\"\n                              placeholder=\"写下你的回复...\" @focus=\"onReplyFocus\"></el-input>\n                            <div class=\"reply-form-actions\">\n                              <el-button size=\"small\" @click=\"reply.showReplyBox = false\">取消</el-button>\n                              <el-button type=\"primary\" size=\"small\"\n                                @click=\"submitReply(reply, comment.id)\">回复</el-button>\n                            </div>\n                          </el-form>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n            <div v-if=\"comments.length === 0\" class=\"no-comments\">暂无评论，快来抢沙发吧！</div>\n          </div>\n        </el-card>\n        <el-backtop :bottom=\"40\" :right=\"40\"></el-backtop>\n      </el-main>\n    </el-container>\n\n    <el-drawer title=\"目录\" :visible.sync=\"tocVisible\" direction=\"rtl\" size=\"320px\">\n      <div class=\"toc-list\">\n        <div v-for=\"item in toc\" :key=\"item.id\" class=\"toc-item\" :class=\"`lv-${item.level}`\"\n          @click=\"scrollToHeading(item.id)\">\n          {{ item.text }}\n        </div>\n      </div>\n    </el-drawer>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport 'github-markdown-css/github-markdown.css'\nimport RelatedArticles from '@/components/RelatedArticles.vue'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'ArticleDetail',\n  components: {\n    RelatedArticles,\n    NavBar\n  },\n  data () {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: '',\n        parent_id: null\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      isLiked: false,\n      isFavorited: false,\n      showActions: false,\n      replyPlaceholder: '写下你的评论...',\n      errorMsg: '',\n      toc: [],\n      tocVisible: false,\n      readingProgress: 0\n    }\n  },\n  computed: {\n    mainStyle () {\n      return {\n        maxWidth: '1000px',\n        width: '100%',\n        margin: '100px auto',\n        padding: '0 20px',\n        boxSizing: 'border-box'\n      }\n    },\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    canManage () {\n      if (!this.isLoggedIn || !this.article.id) return false\n      return this.currentUser.role === 'admin' || (this.article.user_id === this.currentUser.id)\n    },\n    commentsCount () {\n      return this.comments.length\n    },\n    nestedComments () {\n      const roots = this.comments.filter(c => !c.parent_id)\n      return roots.map(root => {\n        // 确保原始对象有必要的响应式属性\n        if (!root.hasOwnProperty('showReplyBox')) {\n          this.$set(root, 'showReplyBox', false)\n          this.$set(root, 'replyForm', { content: '', parent_id: root.id })\n        }\n\n        const replies = this.comments.filter(c => c.parent_id === root.id).map(reply => {\n          // 确保子评论有必要的响应式属性\n          if (!reply.hasOwnProperty('showReplyBox')) {\n            this.$set(reply, 'showReplyBox', false)\n            this.$set(reply, 'replyForm', { content: '', parent_id: reply.id })\n          }\n          return reply\n        })\n\n        // 直接使用root对象，不创建新对象，避免响应式问题\n        root.replies = replies\n        return root\n      })\n    }\n  },\n  mounted () {\n    this.updateReadingProgress()\n    window.addEventListener('scroll', this.updateReadingProgress, { passive: true })\n  },\n  beforeDestroy () {\n    window.removeEventListener('scroll', this.updateReadingProgress)\n  },\n  watch: {\n    // 监听路由变化，重新获取数据\n    '$route.params.id': {\n      handler: function () {\n        this.fetchArticle()\n        this.fetchComments()\n        if (this.isLoggedIn) {\n          this.fetchInteractionStatus()\n        }\n        this.initCommentForm()\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    updateReadingProgress () {\n      const scrollTop = window.pageYOffset || document.documentElement.scrollTop || 0\n      const total = (document.documentElement.scrollHeight || 0) - (document.documentElement.clientHeight || 0)\n      const progress = total > 0 ? (scrollTop / total) * 100 : 0\n      this.readingProgress = Math.max(0, Math.min(100, Math.round(progress)))\n    },\n    buildToc () {\n      const html = this.article && this.article.html_content ? this.article.html_content : ''\n      if (!html) {\n        this.toc = []\n        return\n      }\n\n      // 创建一个临时容器来解析HTML\n      const container = document.createElement('div')\n      container.innerHTML = html\n      const headings = Array.from(container.querySelectorAll('h1,h2,h3'))\n\n      // 构建目录，使用一致的ID生成逻辑\n      this.toc = headings.map((h, idx) => {\n        const level = parseInt(h.tagName.replace('H', ''), 10)\n        const text = h.textContent.trim()\n\n        // 生成一致的ID\n        const id = text.toLowerCase()\n          .replace(/[^a-z0-9]+/g, '-')\n          .replace(/^-+|-+$/g, '') || `heading-${idx}`\n\n        return { id, text, level }\n      }).filter(item => item.text)\n\n      // 立即为页面中的标题添加ID\n      this.$nextTick(() => {\n        this.addHeadingIds()\n      })\n    },\n    addHeadingIds () {\n      const contentElement = document.querySelector('.content.markdown-body')\n      if (!contentElement) return\n\n      const headings = Array.from(contentElement.querySelectorAll('h1,h2,h3'))\n      console.log('找到页面中的标题:', headings.map(h => h.textContent.trim()))\n\n      headings.forEach((h, idx) => {\n        const text = h.textContent.trim()\n        const id = text.toLowerCase()\n          .replace(/[^a-z0-9]+/g, '-')\n          .replace(/^-+|-+$/g, '') || `heading-${idx}`\n\n        h.id = id\n        console.log('为标题添加ID:', { text, id })\n      })\n    },\n    scrollToHeading (id) {\n      // 先关闭目录\n      this.tocVisible = false\n\n      // 使用绝对位置计算来滚动\n      setTimeout(() => {\n        const el = document.getElementById(id)\n        if (el) {\n          console.log('找到标题元素，准备滚动:', id)\n\n          // 计算元素的绝对位置\n          let offsetTop = el.offsetTop\n          let parent = el.offsetParent\n\n          // 累加所有父元素的offsetTop\n          while (parent) {\n            offsetTop += parent.offsetTop\n            parent = parent.offsetParent\n          }\n\n          // 考虑导航栏高度\n          const headerHeight = 80\n\n          console.log('滚动位置:', offsetTop - headerHeight)\n\n          // 使用window.scrollTo滚动\n          window.scrollTo({\n            top: offsetTop - headerHeight,\n            behavior: 'auto' // 不使用动画，确保能生效\n          })\n        }\n      }, 100)\n    },\n    initCommentForm () {\n      if (this.isLoggedIn) {\n        this.commentForm.nickname = this.currentUser.username\n        this.commentForm.email = this.currentUser.email || ''\n      }\n    },\n    onCommentFocus () {\n      this.showActions = true\n    },\n    onReplyFocus () {\n      // 可以在这里添加回复框聚焦的逻辑\n    },\n    cancelReply () {\n      this.commentForm.parent_id = null\n      this.commentForm.content = ''\n      this.showActions = false\n    },\n    toggleReplyBox (comment, parentId = null) {\n      // 先关闭所有回复框\n      this.closeAllReplyBoxes()\n\n      // 切换当前回复框显示状态\n      this.$set(comment, 'showReplyBox', !comment.showReplyBox)\n      if (comment.showReplyBox) {\n        // 确保回复表单存在且是响应式的\n        if (!comment.replyForm) {\n          this.$set(comment, 'replyForm', { content: '', parent_id: parentId || comment.id })\n        }\n        // 更新回复内容\n        comment.replyForm.content = `@${comment.nickname} `\n        comment.replyForm.parent_id = parentId || comment.id\n      }\n    },\n    closeAllReplyBoxes () {\n      // 直接操作原始comments数组，使用$set确保响应式更新\n      this.comments.forEach(comment => {\n        this.$set(comment, 'showReplyBox', false)\n      })\n    },\n    async submitReply (comment) {\n      if (!comment.replyForm || !comment.replyForm.content.trim()) {\n        this.$message.warning('回复内容不能为空')\n        return\n      }\n\n      try {\n        const headers = {}\n        const token = localStorage.getItem('token')\n        if (token) {\n          headers.Authorization = `Bearer ${token}`\n        }\n\n        await axios.post('http://localhost:3000/api/comments', {\n          ...comment.replyForm,\n          article_id: this.article.id,\n          nickname: this.commentForm.nickname,\n          email: this.commentForm.email\n        }, { headers })\n\n        this.$message.success('回复成功')\n        comment.showReplyBox = false\n        this.fetchComments()\n      } catch (error) {\n        this.$message.error('回复失败')\n      }\n    },\n    async fetchArticle () {\n      try {\n        const id = this.$route.params.id\n        if (!id) {\n          this.errorMsg = '文章 ID 缺失'\n          this.$message.error('文章 ID 缺失')\n          return\n        }\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        this.article = response.data\n        this.errorMsg = ''\n        this.buildToc()\n        this.$nextTick(() => {\n          this.updateReadingProgress()\n        })\n      } catch (error) {\n        console.error('获取文章详情失败:', error)\n        this.article = {}\n        const url = `http://localhost:3000/api/articles/${this.$route.params.id}`\n        this.errorMsg = `获取文章失败: ${error.message} (URL: ${url})`\n        this.$message.error('获取文章详情失败')\n        this.toc = []\n      }\n    },\n    async fetchInteractionStatus () {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/interactions/status/${this.$route.params.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.isLiked = response.data.isLiked\n        this.isFavorited = response.data.isFavorited\n      } catch (error) {\n        console.error('获取交互状态失败', error)\n      }\n    },\n    async handleLike () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/like',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isLiked = response.data.isLiked\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('点赞失败')\n      }\n    },\n    async handleFavorite () {\n      try {\n        const response = await axios.post('http://localhost:3000/api/interactions/favorite',\n          { article_id: this.article.id },\n          { headers: { Authorization: `Bearer ${localStorage.getItem('token')}` } }\n        )\n        this.isFavorited = response.data.isFavorited\n        this.$message.success(response.data.message)\n        this.fetchArticle() // 重新获取以更新计数\n      } catch (error) {\n        this.$message.error('收藏失败')\n      }\n    },\n    handleEdit () {\n      this.$router.push(`/article/edit/${this.article.id}`)\n    },\n    async handleDelete () {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.$router.push('/')\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async fetchComments () {\n      try {\n        const id = this.$route.params.id\n        const headers = {}\n        const token = localStorage.getItem('token')\n        if (token) {\n          headers.Authorization = `Bearer ${token}`\n        }\n\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`, { headers })\n        this.comments = response.data\n      } catch (error) {\n        console.error('获取评论失败', error)\n      }\n    },\n    async submitComment () {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和内容')\n        return\n      }\n      try {\n        const headers = {}\n        const token = localStorage.getItem('token')\n        if (token) {\n          headers.Authorization = `Bearer ${token}`\n        }\n\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: this.article.id\n        }, { headers })\n\n        this.$message.success('评论成功')\n        this.commentForm.content = ''\n        this.commentForm.parent_id = null\n        this.showActions = false\n        this.fetchComments()\n      } catch (error) {\n        this.$message.error('评论失败')\n      }\n    },\n    async handleCommentLike (comment) {\n      try {\n        const headers = {\n          Authorization: `Bearer ${localStorage.getItem('token')}`\n        }\n\n        let successMessage = ''\n\n        if (comment.is_liked) {\n          await axios.delete(`http://localhost:3000/api/comments/${comment.id}/like`, { headers })\n          comment.is_liked = false\n          comment.likes_count = Math.max(0, (comment.likes_count || 0) - 1)\n          successMessage = '取消点赞成功'\n        } else {\n          await axios.post(`http://localhost:3000/api/comments/${comment.id}/like`, {}, { headers })\n          comment.is_liked = true\n          comment.likes_count = (comment.likes_count || 0) + 1\n          successMessage = '点赞成功'\n        }\n\n        // 更新原始comments数组中的状态，确保数据一致性\n        const index = this.comments.findIndex(c => c.id === comment.id)\n        if (index !== -1) {\n          this.$set(this.comments[index], 'is_liked', comment.is_liked)\n          this.$set(this.comments[index], 'likes_count', comment.likes_count)\n        }\n\n        this.$message.success(successMessage)\n      } catch (error) {\n        console.error('点赞操作失败:', error)\n        this.$message.error(error.response?.data?.message || '操作失败')\n      }\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知时间'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      const Y = date.getFullYear()\n      const M = (date.getMonth() + 1).toString().padStart(2, '0')\n      const D = date.getDate().toString().padStart(2, '0')\n      const h = date.getHours().toString().padStart(2, '0')\n      const m = date.getMinutes().toString().padStart(2, '0')\n      if (isNaN(Y) || isNaN(date.getMonth()) || isNaN(date.getDate())) return '无效日期'\n      return `${Y}-${M}-${D} ${h}:${m}`\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/ArticleDetail.css\"></style>\n"],"mappings":"AAiLA,OAAAA,KAAA;AACA;AACA,OAAAC,eAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAH,eAAA;IACAC;EACA;EACAG,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,KAAA;QACAC,OAAA;QACAC,SAAA;MACA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,OAAA;MACAC,WAAA;MACAC,WAAA;MACAC,gBAAA;MACAC,QAAA;MACAC,GAAA;MACAC,UAAA;MACAC,eAAA;IACA;EACA;EACAC,QAAA;IACAC,UAAA;MACA;QACAC,QAAA;QACAC,KAAA;QACAC,MAAA;QACAC,OAAA;QACAC,SAAA;MACA;IACA;IACAC,WAAA;MACA,SAAAjB,YAAA,CAAAC,OAAA;IACA;IACAiB,UAAA;MACA,UAAAD,UAAA,UAAA3B,OAAA,CAAA6B,EAAA;MACA,YAAAtB,WAAA,CAAAuB,IAAA,qBAAA9B,OAAA,CAAA+B,OAAA,UAAAxB,WAAA,CAAAsB,EAAA;IACA;IACAG,cAAA;MACA,YAAA/B,QAAA,CAAAgC,MAAA;IACA;IACAC,eAAA;MACA,MAAAC,KAAA,QAAAlC,QAAA,CAAAmC,MAAA,CAAAC,CAAA,KAAAA,CAAA,CAAA/B,SAAA;MACA,OA