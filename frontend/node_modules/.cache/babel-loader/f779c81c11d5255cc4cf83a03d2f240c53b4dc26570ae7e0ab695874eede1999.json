{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'UserProfile',\n  data() {\n    return {\n      user: {},\n      articles: [],\n      loadingUser: false,\n      loadingArticles: false\n    };\n  },\n  watch: {\n    '$route.params.id': {\n      handler: function (id) {\n        if (id) {\n          this.fetchUser(id);\n          this.fetchUserArticles(id);\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    async fetchUser(id) {\n      this.loadingUser = true;\n      try {\n        const response = await axios.get(`http://localhost:3000/api/auth/user/${id}`);\n        this.user = response.data;\n      } catch (error) {\n        this.$message.error('获取用户信息失败');\n      } finally {\n        this.loadingUser = false;\n      }\n    },\n    async fetchUserArticles(id) {\n      this.loadingArticles = true;\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            user_id: id\n          }\n        });\n        this.articles = response.data.articles;\n      } catch (error) {\n        this.$message.error('获取用户文章失败');\n      } finally {\n        this.loadingArticles = false;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","user","articles","loadingUser","loadingArticles","watch","handler","id","fetchUser","fetchUserArticles","immediate","methods","response","get","error","$message","params","user_id"],"sources":["src/views/UserProfile.vue"],"sourcesContent":["<template>\n  <div class=\"user-profile\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">首页</el-menu-item>\n            <el-menu-item index=\"/messages\">留言板</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-row :gutter=\"30\">\n          <!-- 用户基本信息 -->\n          <el-col :span=\"8\">\n            <el-card class=\"profile-card\" v-loading=\"loadingUser\">\n              <div class=\"profile-header\">\n                <el-avatar :size=\"100\" :src=\"user.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                <h2 class=\"username\">{{ user.username }}</h2>\n                <el-tag size=\"small\" :type=\"user.role === 'admin' ? 'danger' : 'success'\">{{ user.role === 'admin' ? '管理员' : '普通用户' }}</el-tag>\n              </div>\n              <div class=\"profile-details\">\n                <div class=\"detail-item\"><i class=\"el-icon-message\"></i> {{ user.email || '保密' }}</div>\n                <div class=\"detail-item\"><i class=\"el-icon-date\"></i> 加入于 {{ new Date(user.created_at).toLocaleDateString() }}</div>\n              </div>\n            </el-card>\n          </el-col>\n\n          <!-- 用户贡献文章 -->\n          <el-col :span=\"16\">\n            <el-card class=\"articles-card\">\n              <div slot=\"header\" class=\"card-header\">\n                <span>TA 的文章 ({{ articles.length }})</span>\n              </div>\n              <div class=\"article-list\" v-loading=\"loadingArticles\">\n                <div v-for=\"art in articles\" :key=\"art.id\" class=\"article-item\" @click=\"$router.push(`/article/${art.id}`)\">\n                  <div class=\"art-title\">{{ art.title }}</div>\n                  <div class=\"art-meta\">\n                    <span><i class=\"el-icon-view\"></i> {{ art.views }}</span>\n                    <span><i class=\"el-icon-date\"></i> {{ new Date(art.created_at).toLocaleDateString() }}</span>\n                  </div>\n                </div>\n                <el-empty v-if=\"articles.length === 0\" description=\"该用户暂未发布文章\"></el-empty>\n              </div>\n            </el-card>\n          </el-col>\n        </el-row>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'UserProfile',\n  data () {\n    return {\n      user: {},\n      articles: [],\n      loadingUser: false,\n      loadingArticles: false\n    }\n  },\n  watch: {\n    '$route.params.id': {\n      handler: function (id) {\n        if (id) {\n          this.fetchUser(id)\n          this.fetchUserArticles(id)\n        }\n      },\n      immediate: true\n    }\n  },\n  methods: {\n    async fetchUser (id) {\n      this.loadingUser = true\n      try {\n        const response = await axios.get(`http://localhost:3000/api/auth/user/${id}`)\n        this.user = response.data\n      } catch (error) {\n        this.$message.error('获取用户信息失败')\n      } finally {\n        this.loadingUser = false\n      }\n    },\n    async fetchUserArticles (id) {\n      this.loadingArticles = true\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: { user_id: id }\n        })\n        this.articles = response.data.articles\n      } catch (error) {\n        this.$message.error('获取用户文章失败')\n      } finally {\n        this.loadingArticles = false\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #e2e8f0;\n}\n.header-content {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logo {\n  font-size: 24px;\n  font-weight: 800;\n  background: linear-gradient(45deg, #409eff, #36cfc9);\n  -webkit-background-clip: text;\n  -webkit-text-fill-color: transparent;\n  cursor: pointer;\n}\n.main {\n  max-width: 1200px;\n  margin: 40px auto;\n}\n.profile-card {\n  text-align: center;\n  padding: 20px 0;\n  border: none;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n}\n.username {\n  margin: 15px 0 10px;\n  color: #1e293b;\n}\n.profile-details {\n  margin-top: 30px;\n  text-align: left;\n  padding: 0 30px;\n}\n.detail-item {\n  color: #64748b;\n  font-size: 14px;\n  margin-bottom: 12px;\n}\n.detail-item i {\n  margin-right: 10px;\n  width: 16px;\n}\n.articles-card {\n  border: none;\n  box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);\n}\n.article-item {\n  padding: 15px 0;\n  border-bottom: 1px solid #f1f5f9;\n  cursor: pointer;\n  transition: all 0.2s;\n}\n.article-item:hover {\n  background-color: #f8fafc;\n  padding-left: 10px;\n}\n.article-item:last-child {\n  border-bottom: none;\n}\n.art-title {\n  font-size: 16px;\n  font-weight: 600;\n  color: #334155;\n  margin-bottom: 8px;\n}\n.art-meta {\n  font-size: 12px;\n  color: #94a3b8;\n}\n.art-meta span {\n  margin-right: 15px;\n}\n</style>\n"],"mappings":"AAuDA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,IAAA;MACAC,QAAA;MACAC,WAAA;MACAC,eAAA;IACA;EACA;EACAC,KAAA;IACA;MACAC,OAAA,WAAAA,CAAAC,EAAA;QACA,IAAAA,EAAA;UACA,KAAAC,SAAA,CAAAD,EAAA;UACA,KAAAE,iBAAA,CAAAF,EAAA;QACA;MACA;MACAG,SAAA;IACA;EACA;EACAC,OAAA;IACA,MAAAH,UAAAD,EAAA;MACA,KAAAJ,WAAA;MACA;QACA,MAAAS,QAAA,SAAAd,KAAA,CAAAe,GAAA,wCAAAN,EAAA;QACA,KAAAN,IAAA,GAAAW,QAAA,CAAAZ,IAAA;MACA,SAAAc,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAAX,WAAA;MACA;IACA;IACA,MAAAM,kBAAAF,EAAA;MACA,KAAAH,eAAA;MACA;QACA,MAAAQ,QAAA,SAAAd,KAAA,CAAAe,GAAA;UACAG,MAAA;YAAAC,OAAA,EAAAV;UAAA;QACA;QACA,KAAAL,QAAA,GAAAU,QAAA,CAAAZ,IAAA,CAAAE,QAAA;MACA,SAAAY,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAAV,eAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}