{"ast":null,"code":"import axios from 'axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'MessageBoard',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: '',\n        parent_id: null\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      replyTarget: '',\n      replyPlaceholder: '写下你的想法...',\n      // 分页相关\n      currentPage: 1,\n      pageSize: 5,\n      totalMessages: 0\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    isAdmin() {\n      return this.currentUser.role === 'admin';\n    },\n    nestedMessages() {\n      const roots = this.messages.filter(m => !m.parent_id);\n      return roots.map(root => ({\n        ...root,\n        replies: this.messages.filter(m => m.parent_id === root.id).sort((a, b) => new Date(a.created_at) - new Date(b.created_at))\n      }));\n    }\n  },\n  created() {\n    this.initForm();\n    this.fetchMessages();\n  },\n  methods: {\n    initForm() {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username;\n        this.messageForm.avatar = this.currentUser.avatar || '';\n      } else {\n        this.messageForm.nickname = '';\n        this.messageForm.avatar = '';\n      }\n      this.cancelReply();\n    },\n    async fetchMessages() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages');\n        this.messages = response.data;\n      } catch (error) {\n        this.$message.error('获取留言失败');\n      }\n    },\n    async submitMessage() {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称');\n        return;\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm);\n        this.$message.success('发布成功');\n        this.messageForm.content = '';\n        this.cancelReply();\n        this.fetchMessages();\n      } catch (error) {\n        this.$message.error('发布失败');\n      } finally {\n        this.submitting = false;\n      }\n    },\n    replyTo(msg, rootMsg = null) {\n      // 如果回复的是子评论，则 parent_id 应该是它的父评论 ID\n      this.messageForm.parent_id = rootMsg ? rootMsg.id : msg.id;\n      this.replyTarget = msg.nickname;\n      this.messageForm.content = `@${msg.nickname} `;\n      this.replyPlaceholder = `回复 @${msg.nickname}...`;\n      // 自动滚动到输入框\n      const inputCard = document.querySelector('.input-card');\n      if (inputCard) {\n        inputCard.scrollIntoView({\n          behavior: 'smooth'\n        });\n      }\n    },\n    cancelReply() {\n      this.messageForm.parent_id = null;\n      this.replyTarget = '';\n      this.replyPlaceholder = '写下你的想法...';\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这条留言吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchMessages();\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败');\n        }\n      }\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n      location.reload();\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","messages","messageForm","nickname","content","avatar","parent_id","submitting","currentUser","JSON","parse","localStorage","getItem","replyTarget","replyPlaceholder","currentPage","pageSize","totalMessages","computed","isLoggedIn","isAdmin","role","nestedMessages","roots","filter","m","map","root","replies","id","sort","a","b","Date","created_at","created","initForm","fetchMessages","methods","username","cancelReply","response","get","error","$message","submitMessage","warning","post","success","replyTo","msg","rootMsg","inputCard","document","querySelector","scrollIntoView","behavior","handleDelete","$confirm","confirmButtonText","cancelButtonText","type","delete","headers","Authorization","formatDate","dateStr","date","isNaN","getTime","getFullYear","getMonth","getDate","getHours","toString","padStart","getMinutes","handleLogout","removeItem","$router","push","location","reload"],"sources":["src/views/MessageBoard.vue"],"sourcesContent":["<template>\n  <div class=\"message-board\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\">\n        <div class=\"board-hero\">\n          <div class=\"hero-content\">\n            <h1>社区留言板</h1>\n            <p>欢迎在这里分享你的想法、建议或单纯打个招呼！</p>\n          </div>\n        </div>\n\n        <div class=\"board-container\">\n          <!-- 留言输入区 -->\n          <div class=\"input-section\">\n            <el-card class=\"input-card\" shadow=\"hover\">\n              <div class=\"input-wrapper\">\n                <div class=\"user-info-section\">\n                  <el-avatar :size=\"60\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\"\n                    class=\"user-avatar\"></el-avatar>\n                  <div class=\"user-welcome\">\n                    <div v-if=\"isLoggedIn\">\n                      {{ currentUser.username }}\n                      <span v-if=\"isAdmin\" class=\"user-role-tag\">管理员</span>\n                    </div>\n                    <div v-else>游客</div>\n                  </div>\n                </div>\n\n                <div class=\"form-content\">\n                  <el-form :model=\"messageForm\" label-width=\"0\">\n                    <el-form-item v-if=\"!isLoggedIn\">\n                      <el-input v-model=\"messageForm.nickname\" placeholder=\"请输入您的昵称\"\n                        prefix-icon=\"el-icon-user\"></el-input>\n                    </el-form-item>\n\n                    <div v-if=\"messageForm.parent_id\" class=\"reply-indicator\">\n                      <span>回复: {{ replyTarget }}</span>\n                      <i class=\"el-icon-close\" @click=\"cancelReply\"></i>\n                    </div>\n\n                    <el-form-item>\n                      <el-input type=\"textarea\" :rows=\"6\" v-model=\"messageForm.content\" :placeholder=\"replyPlaceholder\"\n                        resize=\"none\"></el-input>\n                    </el-form-item>\n                    <div class=\"form-footer\">\n                      <span class=\"tip\"><i class=\"el-icon-info\"></i> 文明发言，共建和谐社区</span>\n                      <el-button type=\"primary\" round icon=\"el-icon-s-promotion\" @click=\"submitMessage\"\n                        :loading=\"submitting\">发布</el-button>\n                    </div>\n                  </el-form>\n                </div>\n              </div>\n            </el-card>\n          </div>\n\n          <!-- 留言列表区 -->\n          <div class=\"message-section\">\n            <div class=\"message-list-container\">\n              <div class=\"list-header\">\n                <div class=\"list-title\">全部留言 ({{ totalMessages }})</div>\n              </div>\n              <div class=\"message-list\">\n                <div v-for=\"msg in nestedMessages\" :key=\"msg.id\" class=\"message-wrapper\">\n                  <div class=\"message-item\">\n                    <div class=\"msg-avatar-wrapper\">\n                      <el-avatar :size=\"50\" :src=\"msg.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                    </div>\n                    <div class=\"msg-main\">\n                      <div class=\"msg-header\">\n                        <span class=\"nickname\">{{ msg.nickname }}</span>\n                        <span class=\"date\">{{ formatDate(msg.created_at) }}</span>\n                      </div>\n                      <div class=\"msg-content\">{{ msg.content }}</div>\n                      <div class=\"msg-actions\">\n                        <span class=\"action-btn\" @click=\"replyTo(msg)\"><i class=\"el-icon-chat-round\"></i> 回复</span>\n                        <span v-if=\"isAdmin\" class=\"action-btn delete-btn\" @click=\"handleDelete(msg.id)\"><i\n                            class=\"el-icon-delete\"></i> 删除</span>\n                      </div>\n                    </div>\n                  </div>\n\n                  <!-- 回复列表 -->\n                  <div v-if=\"msg.replies && msg.replies.length\" class=\"reply-list\">\n                    <div v-for=\"reply in msg.replies\" :key=\"reply.id\" class=\"reply-item\">\n                      <div class=\"msg-avatar-wrapper\">\n                        <el-avatar :size=\"36\" :src=\"reply.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                      </div>\n                      <div class=\"msg-main\">\n                        <div class=\"msg-header\">\n                          <span class=\"nickname\">{{ reply.nickname }}</span>\n                          <span class=\"date\">{{ formatDate(reply.created_at) }}</span>\n                        </div>\n                        <div class=\"msg-content\">{{ reply.content }}</div>\n                        <div class=\"msg-actions\">\n                          <span class=\"action-btn\" @click=\"replyTo(reply, msg)\"><i class=\"el-icon-chat-round\"></i>\n                            回复</span>\n                          <span v-if=\"isAdmin\" class=\"action-btn delete-btn\" @click=\"handleDelete(reply.id)\"><i\n                              class=\"el-icon-delete\"></i> 删除</span>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                </div>\n                <el-empty v-if=\"messages.length === 0\" description=\"暂无留言，快来抢沙发吧！\"></el-empty>\n              </div>\n\n              <!-- 分页组件 -->\n              <div class=\"pagination-container\">\n                <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\n                  :current-page=\"currentPage\" :page-sizes=\"[5, 10, 20]\" :page-size=\"pageSize\"\n                  layout=\"total, sizes, prev, pager, next\" :total=\"totalMessages\">\n                </el-pagination>\n              </div>\n            </div>\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'MessageBoard',\n  components: { NavBar },\n  data () {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: '',\n        parent_id: null\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      replyTarget: '',\n      replyPlaceholder: '写下你的想法...',\n      // 分页相关\n      currentPage: 1,\n      pageSize: 5,\n      totalMessages: 0\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    isAdmin () {\n      return this.currentUser.role === 'admin'\n    },\n    nestedMessages () {\n      const roots = this.messages.filter(m => !m.parent_id)\n      return roots.map(root => ({\n        ...root,\n        replies: this.messages.filter(m => m.parent_id === root.id).sort((a, b) => new Date(a.created_at) - new Date(b.created_at))\n      }))\n    }\n  },\n  created () {\n    this.initForm()\n    this.fetchMessages()\n  },\n  methods: {\n    initForm () {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username\n        this.messageForm.avatar = this.currentUser.avatar || ''\n      } else {\n        this.messageForm.nickname = ''\n        this.messageForm.avatar = ''\n      }\n      this.cancelReply()\n    },\n    async fetchMessages () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages')\n        this.messages = response.data\n      } catch (error) {\n        this.$message.error('获取留言失败')\n      }\n    },\n    async submitMessage () {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称')\n        return\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空')\n        return\n      }\n      this.submitting = true\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm)\n        this.$message.success('发布成功')\n        this.messageForm.content = ''\n        this.cancelReply()\n        this.fetchMessages()\n      } catch (error) {\n        this.$message.error('发布失败')\n      } finally {\n        this.submitting = false\n      }\n    },\n    replyTo (msg, rootMsg = null) {\n      // 如果回复的是子评论，则 parent_id 应该是它的父评论 ID\n      this.messageForm.parent_id = rootMsg ? rootMsg.id : msg.id\n      this.replyTarget = msg.nickname\n      this.messageForm.content = `@${msg.nickname} `\n      this.replyPlaceholder = `回复 @${msg.nickname}...`\n      // 自动滚动到输入框\n      const inputCard = document.querySelector('.input-card')\n      if (inputCard) {\n        inputCard.scrollIntoView({ behavior: 'smooth' })\n      }\n    },\n    cancelReply () {\n      this.messageForm.parent_id = null\n      this.replyTarget = ''\n      this.replyPlaceholder = '写下你的想法...'\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这条留言吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        })\n        await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchMessages()\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败')\n        }\n      }\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n      location.reload()\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/MessageBoard.css\"></style>\n"],"mappings":"AA4HA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,OAAA;QACAC,MAAA;QACAC,SAAA;MACA;MACAC,UAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,WAAA;MACAC,gBAAA;MACA;MACAC,WAAA;MACAC,QAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAR,YAAA,CAAAC,OAAA;IACA;IACAQ,QAAA;MACA,YAAAZ,WAAA,CAAAa,IAAA;IACA;IACAC,eAAA;MACA,MAAAC,KAAA,QAAAtB,QAAA,CAAAuB,MAAA,CAAAC,CAAA,KAAAA,CAAA,CAAAnB,SAAA;MACA,OAAAiB,KAAA,CAAAG,GAAA,CAAAC,IAAA;QACA,GAAAA,IAAA;QACAC,OAAA,OAAA3B,QAAA,CAAAuB,MAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAnB,SAAA,KAAAqB,IAAA,CAAAE,EAAA,EAAAC,IAAA,EAAAC,CAAA,EAAAC,CAAA,SAAAC,IAAA,CAAAF,CAAA,CAAAG,UAAA,QAAAD,IAAA,CAAAD,CAAA,CAAAE,UAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,QAAA