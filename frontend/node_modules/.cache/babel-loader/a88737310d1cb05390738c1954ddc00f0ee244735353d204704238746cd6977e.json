{"ast":null,"code":"/**\n * 通知页面组件\n * 功能：展示用户收到的回复和点赞通知\n */\nimport axios from '../axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'Notifications',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      activeTab: 'replies',\n      // 当前激活的标签页\n      notifications: [],\n      // 通知列表\n      loading: false,\n      // 加载状态\n      page: 1,\n      // 当前页码\n      pageSize: 10,\n      // 每页数量\n      total: 0 // 总数量\n    };\n  },\n  computed: {\n    /**\n     * 主内容区域样式\n     */\n    mainStyle() {\n      return {\n        maxWidth: '1200px',\n        width: '100%',\n        margin: '80px auto 20px',\n        padding: '0 20px',\n        minHeight: 'calc(100vh - 100px)'\n      };\n    }\n  },\n  mounted() {\n    // 初始化获取通知列表\n    this.fetchNotifications();\n  },\n  watch: {\n    // 监听标签页变化，重新获取通知\n    activeTab: {\n      handler() {\n        this.page = 1;\n        this.fetchNotifications();\n      }\n    }\n  },\n  methods: {\n    /**\n     * 处理标签页切换\n     */\n    handleTabChange(tab) {\n      this.activeTab = tab;\n    },\n    /**\n     * 处理分页变化\n     */\n    handlePageChange(currentPage) {\n      this.page = currentPage;\n      this.fetchNotifications();\n    },\n    /**\n     * 获取通知列表\n     */\n    async fetchNotifications() {\n      this.loading = true;\n      try {\n        const response = await axios.get('/notifications', {\n          params: {\n            type: this.activeTab === 'replies' ? 'replies' : 'likes',\n            page: this.page,\n            limit: this.pageSize\n          }\n        });\n        this.notifications = response.data.notifications || [];\n        this.total = response.data.total || 0;\n      } catch (error) {\n        console.error('获取通知失败:', error);\n        this.notifications = [];\n        this.total = 0;\n      } finally {\n        this.loading = false;\n      }\n    },\n    /**\n     * 处理回复\n     */\n    handleReply(notification) {\n      // 跳转到相应的文章页面并滚动到评论位置\n      if (notification.target_type === 'comment' && notification.target_id) {\n        const articleId = notification.comment && notification.comment.article_id;\n        if (articleId) {\n          sessionStorage.setItem('scrollToCommentId', notification.target_id);\n          this.$router.push(`/article/${articleId}`);\n        } else {\n          this.$message.warning('相关内容已不存在或无法访问');\n        }\n      } else {\n        this.$message.warning('相关内容已不存在或无法访问');\n      }\n    },\n    /**\n     * 处理点赞\n     */\n    async handleLike(notification) {\n      try {\n        await axios.post(`/comments/${notification.target_id}/like`);\n        this.$message.success('点赞成功');\n      } catch (error) {\n        this.$message.error('点赞失败');\n      }\n    },\n    /**\n     * 格式化日期\n     */\n    formatDate(dateStr) {\n      if (!dateStr) return '未知时间';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      const Y = date.getFullYear();\n      const M = (date.getMonth() + 1).toString().padStart(2, '0');\n      const D = date.getDate().toString().padStart(2, '0');\n      const h = date.getHours().toString().padStart(2, '0');\n      const m = date.getMinutes().toString().padStart(2, '0');\n      return `${Y}-${M}-${D} ${h}:${m}`;\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","activeTab","notifications","loading","page","pageSize","total","computed","mainStyle","maxWidth","width","margin","padding","minHeight","mounted","fetchNotifications","watch","handler","methods","handleTabChange","tab","handlePageChange","currentPage","response","get","params","type","limit","error","console","handleReply","notification","target_type","target_id","articleId","comment","article_id","sessionStorage","setItem","$router","push","$message","warning","handleLike","post","success","formatDate","dateStr","date","Date","isNaN","getTime","Y","getFullYear","M","getMonth","toString","padStart","D","getDate","h","getHours","m","getMinutes"],"sources":["src/views/Notifications.vue"],"sourcesContent":["<template>\n  <div class=\"notifications\">\n    <el-container direction=\"vertical\">\n      <!-- 导航栏 -->\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\" :style=\"mainStyle\">\n        <div class=\"notification-container\">\n          <!-- 左侧导航 -->\n          <div class=\"notification-sidebar\">\n            <h2 class=\"sidebar-title\">消息中心</h2>\n            <el-menu :default-active=\"activeTab\" class=\"notification-menu\" @select=\"handleTabChange\">\n              <el-menu-item index=\"replies\">\n                <i class=\"el-icon-message\"></i>\n                <span>回复我的</span>\n              </el-menu-item>\n              <el-menu-item index=\"likes\">\n                <i class=\"el-icon-star-on\"></i>\n                <span>收到的赞</span>\n              </el-menu-item>\n            </el-menu>\n          </div>\n\n          <!-- 右侧内容 -->\n          <div class=\"notification-content\">\n            <div class=\"content-header\">\n              <h3>{{ activeTab === 'replies' ? '回复我的' : '收到的赞' }}</h3>\n            </div>\n\n            <!-- 通知列表 -->\n            <div class=\"notification-list\">\n              <div v-if=\"loading\" class=\"loading\">\n                <el-spinner type=\"wave\" size=\"large\"></el-spinner>\n                <p>加载中...</p>\n              </div>\n\n              <div v-else-if=\"notifications.length === 0\" class=\"no-notifications\">\n                <el-empty description=\"暂无通知\" />\n              </div>\n\n              <div v-for=\"notification in notifications\" :key=\"notification.id\" class=\"notification-item\">\n                <div class=\"notification-avatar\">\n                  <el-avatar :size=\"40\" :src=\"notification.sender && notification.sender.avatar || ''\"\n                    :icon=\"'el-icon-user'\"></el-avatar>\n                </div>\n                <div class=\"notification-body\">\n                  <div class=\"notification-text\">\n                    <span class=\"sender\">{{ notification.sender && notification.sender.username }}</span>\n                    <span v-if=\"activeTab === 'replies'\"> 回复了我的评论</span>\n                    <span v-else> 点赞了我的评论</span>\n                  </div>\n                  <div class=\"notification-content-text\">{{ notification.content }}</div>\n                  <div class=\"notification-meta\">\n                    <span class=\"notification-time\">{{ formatDate(notification.created_at) }}</span>\n                    <div class=\"notification-actions\">\n                      <el-button type=\"text\" size=\"small\" @click=\"handleReply(notification)\">\n                        回复\n                      </el-button>\n                      <el-button type=\"text\" size=\"small\" @click=\"handleLike(notification)\">\n                        点赞\n                      </el-button>\n                    </div>\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            <!-- 分页 -->\n            <div v-if=\"total > 0\" class=\"pagination\">\n              <el-pagination :current-page=\"page\" :page-size=\"pageSize\" :total=\"total\" layout=\"prev, pager, next\"\n                @current-change=\"handlePageChange\"></el-pagination>\n            </div>\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\n/**\n * 通知页面组件\n * 功能：展示用户收到的回复和点赞通知\n */\nimport axios from '../axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'Notifications',\n  components: {\n    NavBar\n  },\n  data () {\n    return {\n      activeTab: 'replies', // 当前激活的标签页\n      notifications: [], // 通知列表\n      loading: false, // 加载状态\n      page: 1, // 当前页码\n      pageSize: 10, // 每页数量\n      total: 0 // 总数量\n    }\n  },\n  computed: {\n    /**\n     * 主内容区域样式\n     */\n    mainStyle () {\n      return {\n        maxWidth: '1200px',\n        width: '100%',\n        margin: '80px auto 20px',\n        padding: '0 20px',\n        minHeight: 'calc(100vh - 100px)'\n      }\n    }\n  },\n  mounted () {\n    // 初始化获取通知列表\n    this.fetchNotifications()\n  },\n  watch: {\n    // 监听标签页变化，重新获取通知\n    activeTab: {\n      handler () {\n        this.page = 1\n        this.fetchNotifications()\n      }\n    }\n  },\n  methods: {\n    /**\n     * 处理标签页切换\n     */\n    handleTabChange (tab) {\n      this.activeTab = tab\n    },\n\n    /**\n     * 处理分页变化\n     */\n    handlePageChange (currentPage) {\n      this.page = currentPage\n      this.fetchNotifications()\n    },\n\n    /**\n     * 获取通知列表\n     */\n    async fetchNotifications () {\n      this.loading = true\n      try {\n        const response = await axios.get('/notifications', {\n          params: {\n            type: this.activeTab === 'replies' ? 'replies' : 'likes',\n            page: this.page,\n            limit: this.pageSize\n          }\n        })\n        this.notifications = response.data.notifications || []\n        this.total = response.data.total || 0\n      } catch (error) {\n        console.error('获取通知失败:', error)\n        this.notifications = []\n        this.total = 0\n      } finally {\n        this.loading = false\n      }\n    },\n\n    /**\n     * 处理回复\n     */\n    handleReply (notification) {\n      // 跳转到相应的文章页面并滚动到评论位置\n      if (notification.target_type === 'comment' && notification.target_id) {\n        const articleId = notification.comment && notification.comment.article_id\n        if (articleId) {\n          sessionStorage.setItem('scrollToCommentId', notification.target_id)\n          this.$router.push(`/article/${articleId}`)\n        } else {\n          this.$message.warning('相关内容已不存在或无法访问')\n        }\n      } else {\n        this.$message.warning('相关内容已不存在或无法访问')\n      }\n    },\n\n    /**\n     * 处理点赞\n     */\n    async handleLike (notification) {\n      try {\n        await axios.post(`/comments/${notification.target_id}/like`)\n        this.$message.success('点赞成功')\n      } catch (error) {\n        this.$message.error('点赞失败')\n      }\n    },\n\n    /**\n     * 格式化日期\n     */\n    formatDate (dateStr) {\n      if (!dateStr) return '未知时间'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      const Y = date.getFullYear()\n      const M = (date.getMonth() + 1).toString().padStart(2, '0')\n      const D = date.getDate().toString().padStart(2, '0')\n      const h = date.getHours().toString().padStart(2, '0')\n      const m = date.getMinutes().toString().padStart(2, '0')\n      return `${Y}-${M}-${D} ${h}:${m}`\n    }\n  }\n}\n</script>\n\n<style scoped>\n.notifications {\n  min-height: 100vh;\n  background-color: #f5f7fa;\n}\n\n.notification-container {\n  display: flex;\n  background-color: white;\n  border-radius: 8px;\n  box-shadow: 0 2px 12px 0 rgba(0, 0, 0, 0.1);\n  overflow: hidden;\n}\n\n.notification-sidebar {\n  width: 200px;\n  border-right: 1px solid #ebeef5;\n  background-color: #fafafa;\n}\n\n.sidebar-title {\n  padding: 20px;\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.notification-menu {\n  border: none;\n}\n\n.notification-menu .el-menu-item {\n  height: 60px;\n  line-height: 60px;\n  font-size: 14px;\n}\n\n.notification-menu .el-menu-item.is-active {\n  background-color: #ecf5ff;\n  color: #409eff;\n}\n\n.notification-content {\n  flex: 1;\n  padding: 20px;\n}\n\n.content-header {\n  margin-bottom: 20px;\n  border-bottom: 1px solid #ebeef5;\n  padding-bottom: 15px;\n}\n\n.content-header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.notification-list {\n  min-height: 400px;\n}\n\n.loading {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  padding: 60px 0;\n}\n\n.loading p {\n  margin-top: 10px;\n  color: #909399;\n}\n\n.no-notifications {\n  padding: 60px 0;\n}\n\n.notification-item {\n  display: flex;\n  padding: 15px 0;\n  border-bottom: 1px solid #f5f7fa;\n}\n\n.notification-item:last-child {\n  border-bottom: none;\n}\n\n.notification-avatar {\n  margin-right: 15px;\n}\n\n.notification-body {\n  flex: 1;\n}\n\n.notification-text {\n  font-size: 14px;\n  margin-bottom: 5px;\n}\n\n.notification-text .sender {\n  font-weight: 500;\n  color: #303133;\n}\n\n.notification-content-text {\n  font-size: 13px;\n  color: #606266;\n  margin-bottom: 8px;\n  line-height: 1.4;\n}\n\n.notification-meta {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.notification-time {\n  font-size: 12px;\n  color: #909399;\n}\n\n.notification-actions {\n  display: flex;\n  gap: 10px;\n}\n\n.pagination {\n  margin-top: 20px;\n  display: flex;\n  justify-content: flex-end;\n}\n</style>"],"mappings":"AAgFA;AACA;AACA;AACA;AACA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACA;MACAC,SAAA;MAAA;MACAC,aAAA;MAAA;MACAC,OAAA;MAAA;MACAC,IAAA;MAAA;MACAC,QAAA;MAAA;MACAC,KAAA;IACA;EACA;EACAC,QAAA;IACA;AACA;AACA;IACAC,UAAA;MACA;QACAC,QAAA;QACAC,KAAA;QACAC,MAAA;QACAC,OAAA;QACAC,SAAA;MACA;IACA;EACA;EACAC,QAAA;IACA;IACA,KAAAC,kBAAA;EACA;EACAC,KAAA;IACA;IACAf,SAAA;MACAgB,QAAA;QACA,KAAAb,IAAA;QACA,KAAAW,kBAAA;MACA;IACA;EACA;EACAG,OAAA;IACA;AACA;AACA;IACAC,gBAAAC,GAAA;MACA,KAAAnB,SAAA,GAAAmB,GAAA;IACA;IAEA;AACA;AACA;IACAC,iBAAAC,WAAA;MACA,KAAAlB,IAAA,GAAAkB,WAAA;MACA,KAAAP,kBAAA;IACA;IAEA;AACA;AACA;IACA,MAAAA,mBAAA;MACA,KAAAZ,OAAA;MACA;QACA,MAAAoB,QAAA,SAAA3B,KAAA,CAAA4B,GAAA;UACAC,MAAA;YACAC,IAAA,OAAAzB,SAAA;YACAG,IAAA,OAAAA,IAAA;YACAuB,KAAA,OAAAtB;UACA;QACA;QACA,KAAAH,aAAA,GAAAqB,QAAA,CAAAvB,IAAA,CAAAE,aAAA;QACA,KAAAI,KAAA,GAAAiB,QAAA,CAAAvB,IAAA,CAAAM,KAAA;MACA,SAAAsB,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;QACA,KAAA1B,aAAA;QACA,KAAAI,KAAA;MACA;QACA,KAAAH,OAAA;MACA;IACA;IAEA;AACA;AACA;IACA2B,YAAAC,YAAA;MACA;MACA,IAAAA,YAAA,CAAAC,WAAA,kBAAAD,YAAA,CAAAE,SAAA;QACA,MAAAC,SAAA,GAAAH,YAAA,CAAAI,OAAA,IAAAJ,YAAA,CAAAI,OAAA,CAAAC,UAAA;QACA,IAAAF,SAAA;UACAG,cAAA,CAAAC,OAAA,sBAAAP,YAAA,CAAAE,SAAA;UACA,KAAAM,OAAA,CAAAC,IAAA,aAAAN,SAAA;QACA;UACA,KAAAO,QAAA,CAAAC,OAAA;QACA;MACA;QACA,KAAAD,QAAA,CAAAC,OAAA;MACA;IACA;IAEA;AACA;AACA;IACA,MAAAC,WAAAZ,YAAA;MACA;QACA,MAAAnC,KAAA,CAAAgD,IAAA,cAAAb,YAAA,CAAAE,SAAA;QACA,KAAAQ,QAAA,CAAAI,OAAA;MACA,SAAAjB,KAAA;QACA,KAAAa,QAAA,CAAAb,KAAA;MACA;IACA;IAEA;AACA;AACA;IACAkB,WAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,IAAAG,KAAA,CAAAF,IAAA,CAAAG,OAAA;MACA,MAAAC,CAAA,GAAAJ,IAAA,CAAAK,WAAA;MACA,MAAAC,CAAA,IAAAN,IAAA,CAAAO,QAAA,QAAAC,QAAA,GAAAC,QAAA;MACA,MAAAC,CAAA,GAAAV,IAAA,CAAAW,OAAA,GAAAH,QAAA,GAAAC,QAAA;MACA,MAAAG,CAAA,GAAAZ,IAAA,CAAAa,QAAA,GAAAL,QAAA,GAAAC,QAAA;MACA,MAAAK,CAAA,GAAAd,IAAA,CAAAe,UAAA,GAAAP,QAAA,GAAAC,QAAA;MACA,UAAAL,CAAA,IAAAE,CAAA,IAAAI,CAAA,IAAAE,CAAA,IAAAE,CAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}