{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'UserCenter',\n  data() {\n    return {\n      activeTab: 'articles',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: ''\n      }\n    };\n  },\n  created() {\n    this.userForm.username = this.currentUser.username;\n    this.userForm.email = this.currentUser.email || '';\n    this.fetchMyArticles();\n    this.fetchFavorites();\n  },\n  methods: {\n    async fetchMyArticles() {\n      this.loading = true;\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: {\n            user_id: this.currentUser.id\n          }\n        });\n        this.myArticles = response.data.articles;\n      } catch (error) {\n        this.$message.error('获取文章失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchMyArticles();\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async updateProfile() {\n      this.$message.info('资料修改功能正在完善中...');\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","activeTab","loading","myArticles","favoriteArticles","currentUser","JSON","parse","localStorage","getItem","userForm","username","email","created","fetchMyArticles","fetchFavorites","methods","response","get","params","user_id","id","articles","error","$message","handleDelete","$confirm","type","delete","headers","Authorization","success","updateProfile","info","handleLogout","removeItem","$router","push"],"sources":["src/views/UserCenter.vue"],"sourcesContent":["<template>\n  <div class=\"user-center\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\" @click=\"$router.push('/')\">个人中心</div>\n          <el-menu mode=\"horizontal\" router :default-active=\"$route.path\">\n            <el-menu-item index=\"/\">返回首页</el-menu-item>\n            <el-menu-item @click=\"handleLogout\">退出登录</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-tabs v-model=\"activeTab\" type=\"border-card\">\n          <!-- 个人文章管理 -->\n          <el-tab-pane label=\"我的文章\" name=\"articles\">\n            <div class=\"pane-content\">\n              <div class=\"toolbar\">\n                <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"$router.push('/admin/article/new')\">发布文章</el-button>\n              </div>\n              <el-table :data=\"myArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                <el-table-column prop=\"views\" label=\"阅读\" width=\"80\" align=\"center\"></el-table-column>\n                <el-table-column prop=\"created_at\" label=\"发布时间\" width=\"180\">\n                  <template slot-scope=\"scope\">{{ new Date(scope.row.created_at).toLocaleString() }}</template>\n                </el-table-column>\n                <el-table-column label=\"操作\" width=\"180\" align=\"center\">\n                  <template slot-scope=\"scope\">\n                    <el-button size=\"mini\" type=\"text\" @click=\"$router.push(`/admin/article/edit/${scope.row.id}`)\">编辑</el-button>\n                    <el-button size=\"mini\" type=\"text\" style=\"color: #F56C6C\" @click=\"handleDelete(scope.row.id)\">删除</el-button>\n                  </template>\n                </el-table-column>\n              </el-table>\n            </div>\n          </el-tab-pane>\n\n          <!-- 收藏夹 -->\n          <el-tab-pane label=\"我的收藏\" name=\"favorites\">\n            <div class=\"pane-content\">\n              <el-table :data=\"favoriteArticles\" style=\"width: 100%\" v-loading=\"loading\">\n                <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n                <el-table-column prop=\"User.username\" label=\"作者\" width=\"120\"></el-table-column>\n                <el-table-column prop=\"Category.name\" label=\"分类\" width=\"120\"></el-table-column>\n                <el-table-column label=\"操作\" width=\"120\" align=\"center\">\n                  <template slot-scope=\"scope\">\n                    <el-button size=\"mini\" type=\"text\" @click=\"$router.push(`/article/${scope.row.id}`)\">查看</el-button>\n                  </template>\n                </el-table-column>\n              </el-table>\n            </div>\n          </el-tab-pane>\n\n          <!-- 个人资料修改 -->\n          <el-tab-pane label=\"基本资料\" name=\"profile\">\n            <div class=\"pane-content profile-form\">\n              <el-form :model=\"userForm\" label-width=\"80px\" style=\"max-width: 400px\">\n                <el-form-item label=\"用户名\">\n                  <el-input v-model=\"userForm.username\" disabled></el-input>\n                  <small>用户名暂不支持修改</small>\n                </el-form-item>\n                <el-form-item label=\"邮箱\">\n                  <el-input v-model=\"userForm.email\"></el-input>\n                </el-form-item>\n                <el-form-item>\n                  <el-button type=\"primary\" @click=\"updateProfile\">保存修改</el-button>\n                </el-form-item>\n              </el-form>\n            </div>\n          </el-tab-pane>\n        </el-tabs>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'UserCenter',\n  data () {\n    return {\n      activeTab: 'articles',\n      loading: false,\n      myArticles: [],\n      favoriteArticles: [],\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      userForm: {\n        username: '',\n        email: ''\n      }\n    }\n  },\n  created () {\n    this.userForm.username = this.currentUser.username\n    this.userForm.email = this.currentUser.email || ''\n    this.fetchMyArticles()\n    this.fetchFavorites()\n  },\n  methods: {\n    async fetchMyArticles () {\n      this.loading = true\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles', {\n          params: { user_id: this.currentUser.id }\n        })\n        this.myArticles = response.data.articles\n      } catch (error) {\n        this.$message.error('获取文章失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchMyArticles()\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async updateProfile () {\n      this.$message.info('资料修改功能正在完善中...')\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n.header-content {\n  max-width: 1000px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.logo {\n  font-size: 20px;\n  font-weight: bold;\n  color: #409eff;\n  cursor: pointer;\n}\n.main {\n  max-width: 1000px;\n  margin: 30px auto;\n}\n.pane-content {\n  padding: 20px;\n}\n.toolbar {\n  margin-bottom: 20px;\n}\n.profile-form {\n  padding-top: 30px;\n}\n</style>\n"],"mappings":"AA8EA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,SAAA;MACAC,OAAA;MACAC,UAAA;MACAC,gBAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,QAAA;QACAC,QAAA;QACAC,KAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAH,QAAA,CAAAC,QAAA,QAAAN,WAAA,CAAAM,QAAA;IACA,KAAAD,QAAA,CAAAE,KAAA,QAAAP,WAAA,CAAAO,KAAA;IACA,KAAAE,eAAA;IACA,KAAAC,cAAA;EACA;EACAC,OAAA;IACA,MAAAF,gBAAA;MACA,KAAAZ,OAAA;MACA;QACA,MAAAe,QAAA,SAAAnB,KAAA,CAAAoB,GAAA;UACAC,MAAA;YAAAC,OAAA,OAAAf,WAAA,CAAAgB;UAAA;QACA;QACA,KAAAlB,UAAA,GAAAc,QAAA,CAAAjB,IAAA,CAAAsB,QAAA;MACA,SAAAC,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAArB,OAAA;MACA;IACA;IACA,MAAAuB,aAAAJ,EAAA;MACA;QACA,WAAAK,QAAA;UAAAC,IAAA;QAAA;QACA,MAAA7B,KAAA,CAAA8B,MAAA,uCAAAP,EAAA;UACAQ,OAAA;YAAAC,aAAA,YAAAtB,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAe,QAAA,CAAAO,OAAA;QACA,KAAAjB,eAAA;MACA,SAAAS,KAAA;QACA,IAAAA,KAAA,oBAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAS,cAAA;MACA,KAAAR,QAAA,CAAAS,IAAA;IACA;IACAC,aAAA;MACA1B,YAAA,CAAA2B,UAAA;MACA3B,YAAA,CAAA2B,UAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}