{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleDetail',\n  data() {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    };\n  },\n  computed: {\n    canManage() {\n      return this.currentUser.role === 'admin' || this.article.user_id === this.currentUser.id;\n    }\n  },\n  created() {\n    this.fetchArticle();\n    this.fetchComments();\n  },\n  methods: {\n    async fetchArticle() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        this.article = response.data;\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    handleEdit() {\n      this.$router.push(`/admin/article/edit/${this.article.id}`);\n    },\n    async handleDelete() {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', {\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.$router.push('/');\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败');\n      }\n    },\n    async fetchComments() {\n      try {\n        const id = this.$route.params.id;\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`);\n        this.comments = response.data;\n      } catch (error) {\n        console.error('获取评论失败', error);\n      }\n    },\n    async submitComment() {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        });\n        this.$message.success('评论提交成功');\n        this.commentForm.nickname = '';\n        this.commentForm.email = '';\n        this.commentForm.content = '';\n        this.fetchComments(); // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","article","comments","commentForm","nickname","email","content","currentUser","JSON","parse","localStorage","getItem","computed","canManage","role","user_id","id","created","fetchArticle","fetchComments","methods","$route","params","response","get","error","$message","handleEdit","$router","push","handleDelete","$confirm","type","delete","headers","Authorization","success","console","submitComment","warning","post","article_id"],"sources":["src/views/ArticleDetail.vue"],"sourcesContent":["<template>\n  <div class=\"article-detail\">\n    <el-container>\n      <el-header class=\"header\">\n        <div class=\"header-content\">\n          <div class=\"logo\">个人技术博客</div>\n          <el-menu mode=\"horizontal\" router>\n            <el-menu-item index=\"/\">首页</el-menu-item>\n          </el-menu>\n        </div>\n      </el-header>\n\n      <el-main class=\"main\">\n        <el-card class=\"detail-card\">\n          <div slot=\"header\">\n            <div class=\"title-wrapper\">\n              <h1 class=\"title\">{{ article.title }}</h1>\n              <div v-if=\"canManage\" class=\"detail-manage\">\n                <el-button type=\"primary\" size=\"small\" icon=\"el-icon-edit\" @click=\"handleEdit\">编辑文章</el-button>\n                <el-button type=\"danger\" size=\"small\" icon=\"el-icon-delete\" @click=\"handleDelete\">删除文章</el-button>\n              </div>\n            </div>\n            <div class=\"meta\">\n              <span><i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}</span>\n              <span><i class=\"el-icon-date\"></i> {{ new Date(article.created_at).toLocaleDateString() }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> 阅读: {{ article.views }}</span>\n            </div>\n          </div>\n          <!-- 使用 v-html 渲染 Markdown 解析后的 HTML -->\n          <div class=\"content markdown-body\" v-html=\"article.html_content\"></div>\n          <div class=\"tags\" v-if=\"article.Tags && article.Tags.length\">\n            <el-tag v-for=\"tag in article.Tags\" :key=\"tag.id\" size=\"mini\" style=\"margin-right: 5px\">{{ tag.name\n              }}</el-tag>\n          </div>\n        </el-card>\n\n        <!-- 评论区域 -->\n        <el-card class=\"comments-card\" style=\"margin-top: 20px\">\n          <div slot=\"header\">发表评论</div>\n          <el-form :model=\"commentForm\" ref=\"commentForm\" label-width=\"0\">\n            <el-row :gutter=\"10\">\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.nickname\" placeholder=\"昵称 (必填)\"></el-input>\n                </el-form-item>\n              </el-col>\n              <el-col :span=\"12\">\n                <el-form-item>\n                  <el-input v-model=\"commentForm.email\" placeholder=\"邮箱 (可选)\"></el-input>\n                </el-form-item>\n              </el-col>\n            </el-row>\n            <el-form-item>\n              <el-input type=\"textarea\" :rows=\"3\" v-model=\"commentForm.content\" placeholder=\"写下你的评论...\"></el-input>\n            </el-form-item>\n            <el-form-item style=\"text-align: right\">\n              <el-button type=\"primary\" @click=\"submitComment\">提交评论</el-button>\n            </el-form-item>\n          </el-form>\n\n          <div class=\"comment-list\">\n            <div class=\"comment-count\">共 {{ comments.length }} 条评论</div>\n            <div v-for=\"comment in comments\" :key=\"comment.id\" class=\"comment-item\">\n              <div class=\"comment-header\">\n                <span class=\"comment-nickname\">{{ comment.nickname }}</span>\n                <span class=\"comment-date\">{{ new Date(comment.created_at).toLocaleString() }}</span>\n              </div>\n              <div class=\"comment-content\">{{ comment.content }}</div>\n            </div>\n            <div v-if=\"comments.length === 0\" class=\"no-comments\">暂无评论，快来抢沙发吧！</div>\n          </div>\n        </el-card>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'ArticleDetail',\n  data () {\n    return {\n      article: {},\n      comments: [],\n      commentForm: {\n        nickname: '',\n        email: '',\n        content: ''\n      },\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}')\n    }\n  },\n  computed: {\n    canManage () {\n      return this.currentUser.role === 'admin' || (this.article.user_id === this.currentUser.id)\n    }\n  },\n  created () {\n    this.fetchArticle()\n    this.fetchComments()\n  },\n  methods: {\n    async fetchArticle () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        this.article = response.data\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    handleEdit () {\n      this.$router.push(`/admin/article/edit/${this.article.id}`)\n    },\n    async handleDelete () {\n      try {\n        await this.$confirm('确定要删除这篇文章吗？', '提示', { type: 'warning' })\n        await axios.delete(`http://localhost:3000/api/articles/${this.article.id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.$router.push('/')\n      } catch (error) {\n        if (error !== 'cancel') this.$message.error('删除失败')\n      }\n    },\n    async fetchComments () {\n      try {\n        const id = this.$route.params.id\n        const response = await axios.get(`http://localhost:3000/api/comments/article/${id}`)\n        this.comments = response.data\n      } catch (error) {\n        console.error('获取评论失败', error)\n      }\n    },\n    async submitComment () {\n      if (!this.commentForm.nickname || !this.commentForm.content) {\n        this.$message.warning('请填写昵称和评论内容')\n        return\n      }\n      try {\n        const id = this.$route.params.id\n        await axios.post('http://localhost:3000/api/comments', {\n          ...this.commentForm,\n          article_id: id\n        })\n        this.$message.success('评论提交成功')\n        this.commentForm.nickname = ''\n        this.commentForm.email = ''\n        this.commentForm.content = ''\n        this.fetchComments() // 刷新评论列表\n      } catch (error) {\n        this.$message.error('评论提交失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.header {\n  background-color: #fff;\n  border-bottom: 1px solid #dcdfe6;\n}\n\n.header-content {\n  max-width: 900px;\n  margin: 0 auto;\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n\n.logo {\n  font-size: 24px;\n  font-weight: bold;\n  color: #409eff;\n}\n\n.main {\n  max-width: 900px;\n  margin: 20px auto;\n}\n\n.title-wrapper {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n}\n.title {\n  font-size: 32px;\n  margin: 10px 0;\n  color: #303133;\n  flex: 1;\n}\n.detail-manage {\n  margin-left: 20px;\n}\n.meta {\n  margin-top: 15px;\n  color: #909399;\n  font-size: 14px;\n}\n\n.meta span {\n  margin-right: 20px;\n}\n\n.meta i {\n  margin-right: 5px;\n}\n\n.content {\n  line-height: 1.8;\n  font-size: 16px;\n  padding: 20px 0;\n  color: #333;\n}\n\n.comment-count {\n  font-weight: bold;\n  margin-bottom: 20px;\n  padding-bottom: 10px;\n  border-bottom: 2px solid #409eff;\n  display: inline-block;\n}\n\n.comment-item {\n  padding: 15px 0;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.comment-nickname {\n  font-weight: bold;\n  color: #409eff;\n}\n\n.comment-date {\n  color: #909399;\n  font-size: 12px;\n  margin-left: 10px;\n}\n\n.comment-content {\n  margin-top: 8px;\n  line-height: 1.6;\n}\n\n.no-comments {\n  text-align: center;\n  color: #909399;\n  padding: 30px 0;\n}\n</style>\n"],"mappings":"AA+EA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,OAAA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,KAAA;QACAC,OAAA;MACA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,UAAA;MACA,YAAAN,WAAA,CAAAO,IAAA,qBAAAb,OAAA,CAAAc,OAAA,UAAAR,WAAA,CAAAS,EAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,YAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAF,aAAA;MACA;QACA,MAAAF,EAAA,QAAAK,MAAA,CAAAC,MAAA,CAAAN,EAAA;QACA,MAAAO,QAAA,SAAAzB,KAAA,CAAA0B,GAAA,uCAAAR,EAAA;QACA,KAAAf,OAAA,GAAAsB,QAAA,CAAAvB,IAAA;MACA,SAAAyB,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,WAAA;MACA,KAAAC,OAAA,CAAAC,IAAA,6BAAA5B,OAAA,CAAAe,EAAA;IACA;IACA,MAAAc,aAAA;MACA;QACA,WAAAC,QAAA;UAAAC,IAAA;QAAA;QACA,MAAAlC,KAAA,CAAAmC,MAAA,4CAAAhC,OAAA,CAAAe,EAAA;UACAkB,OAAA;YAAAC,aAAA,YAAAzB,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAe,QAAA,CAAAU,OAAA;QACA,KAAAR,OAAA,CAAAC,IAAA;MACA,SAAAJ,KAAA;QACA,IAAAA,KAAA,oBAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAN,cAAA;MACA;QACA,MAAAH,EAAA,QAAAK,MAAA,CAAAC,MAAA,CAAAN,EAAA;QACA,MAAAO,QAAA,SAAAzB,KAAA,CAAA0B,GAAA,+CAAAR,EAAA;QACA,KAAAd,QAAA,GAAAqB,QAAA,CAAAvB,IAAA;MACA,SAAAyB,KAAA;QACAY,OAAA,CAAAZ,KAAA,WAAAA,KAAA;MACA;IACA;IACA,MAAAa,cAAA;MACA,UAAAnC,WAAA,CAAAC,QAAA,UAAAD,WAAA,CAAAG,OAAA;QACA,KAAAoB,QAAA,CAAAa,OAAA;QACA;MACA;MACA;QACA,MAAAvB,EAAA,QAAAK,MAAA,CAAAC,MAAA,CAAAN,EAAA;QACA,MAAAlB,KAAA,CAAA0C,IAAA;UACA,QAAArC,WAAA;UACAsC,UAAA,EAAAzB;QACA;QACA,KAAAU,QAAA,CAAAU,OAAA;QACA,KAAAjC,WAAA,CAAAC,QAAA;QACA,KAAAD,WAAA,CAAAE,KAAA;QACA,KAAAF,WAAA,CAAAG,OAAA;QACA,KAAAa,aAAA;MACA,SAAAM,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceT