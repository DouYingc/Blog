{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleEdit',\n  data() {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    };\n  },\n  created() {\n    this.fetchCategories();\n    this.fetchTags();\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id);\n    }\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('获取分类失败');\n      }\n    },\n    async fetchTags() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags');\n        this.tags = response.data;\n      } catch (error) {\n        this.$message.error('获取标签失败');\n      }\n    },\n    async fetchArticle(id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`);\n        const article = response.data;\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        };\n      } catch (error) {\n        this.$message.error('获取文章详情失败');\n      }\n    },\n    handleContentChange(value, render) {\n      this.articleForm.html_content = render;\n    },\n    async saveArticle() {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空');\n        return;\n      }\n      try {\n        const id = this.$route.params.id;\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config);\n          this.$message.success('文章更新成功');\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config);\n          this.$message.success('文章发布成功');\n        }\n        this.$router.push('/admin/articles');\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","articleForm","title","category_id","tags","summary","content","html_content","status","cover","categories","uploadHeaders","Authorization","localStorage","getItem","created","fetchCategories","fetchTags","$route","params","id","fetchArticle","methods","response","get","error","$message","article","Tags","map","t","handleContentChange","value","render","saveArticle","warning","config","headers","put","success","post","$router","push"],"sources":["src/views/admin/ArticleEdit.vue"],"sourcesContent":["<template>\n  <div class=\"article-edit\">\n    <el-page-header @back=\"$router.back()\" :content=\"$route.params.id ? '编辑文章' : '发布新文章'\"\n      style=\"margin-bottom: 20px\"></el-page-header>\n    <el-form :model=\"articleForm\" ref=\"articleForm\" label-width=\"80px\">\n      <el-form-item label=\"文章标题\" prop=\"title\">\n        <el-input v-model=\"articleForm.title\" placeholder=\"请输入文章标题\"></el-input>\n      </el-form-item>\n      <el-form-item label=\"文章封面\">\n        <el-upload\n          class=\"cover-uploader\"\n          action=\"http://localhost:3000/api/upload/image\"\n          name=\"image\"\n          :headers=\"uploadHeaders\"\n          :show-file-list=\"false\"\n          :on-success=\"handleCoverSuccess\"\n          :before-upload=\"beforeCoverUpload\">\n          <img v-if=\"articleForm.cover\" :src=\"articleForm.cover\" class=\"cover-image\">\n          <i v-else class=\"el-icon-plus cover-uploader-icon\"></i>\n        </el-upload>\n        <small>建议尺寸 800x400，用于首页展示</small>\n      </el-form-item>\n      <el-row :gutter=\"20\">\n        <el-col :span=\"12\">\n          <el-form-item label=\"所属分类\">\n            <el-select v-model=\"articleForm.category_id\" placeholder=\"选择分类\" style=\"width: 100%\">\n              <el-option v-for=\"cat in categories\" :key=\"cat.id\" :label=\"cat.name\" :value=\"cat.id\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n        <el-col :span=\"12\">\n          <el-form-item label=\"文章标签\">\n            <el-select v-model=\"articleForm.tags\" multiple placeholder=\"选择标签\" style=\"width: 100%\">\n              <el-option v-for=\"tag in tags\" :key=\"tag.id\" :label=\"tag.name\" :value=\"tag.id\"></el-option>\n            </el-select>\n          </el-form-item>\n        </el-col>\n      </el-row>\n      <el-form-item label=\"文章摘要\">\n        <el-input type=\"textarea\" :rows=\"3\" v-model=\"articleForm.summary\" placeholder=\"请输入文章摘要\"></el-input>\n      </el-form-item>\n      <el-form-item label=\"文章内容\">\n        <mavon-editor v-model=\"articleForm.content\" @change=\"handleContentChange\" style=\"min-height: 500px\"\n          placeholder=\"开始创作吧...\"></mavon-editor>\n      </el-form-item>\n      <el-form-item>\n        <el-button type=\"primary\" icon=\"el-icon-check\" @click=\"saveArticle\">保存并发布</el-button>\n        <el-button icon=\"el-icon-close\" @click=\"$router.back()\">取消</el-button>\n      </el-form-item>\n    </el-form>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'ArticleEdit',\n  data () {\n    return {\n      articleForm: {\n        title: '',\n        category_id: null,\n        tags: [],\n        summary: '',\n        content: '',\n        html_content: '',\n        status: 'published',\n        cover: ''\n      },\n      categories: [],\n      tags: [],\n      uploadHeaders: {\n        Authorization: `Bearer ${localStorage.getItem('token')}`\n      }\n    }\n  },\n  created () {\n    this.fetchCategories()\n    this.fetchTags()\n    if (this.$route.params.id) {\n      this.fetchArticle(this.$route.params.id)\n    }\n  },\n  methods: {\n    async fetchCategories () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/categories')\n        this.categories = response.data\n      } catch (error) {\n        this.$message.error('获取分类失败')\n      }\n    },\n    async fetchTags () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/tags')\n        this.tags = response.data\n      } catch (error) {\n        this.$message.error('获取标签失败')\n      }\n    },\n    async fetchArticle (id) {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/articles/${id}`)\n        const article = response.data\n        this.articleForm = {\n          ...article,\n          tags: article.Tags.map(t => t.id)\n        }\n      } catch (error) {\n        this.$message.error('获取文章详情失败')\n      }\n    },\n    handleContentChange (value, render) {\n      this.articleForm.html_content = render\n    },\n    async saveArticle () {\n      if (!this.articleForm.title || !this.articleForm.content) {\n        this.$message.warning('标题和内容不能为空')\n        return\n      }\n      try {\n        const id = this.$route.params.id\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        }\n        if (id) {\n          await axios.put(`http://localhost:3000/api/articles/${id}`, this.articleForm, config)\n          this.$message.success('文章更新成功')\n        } else {\n          await axios.post('http://localhost:3000/api/articles', this.articleForm, config)\n          this.$message.success('文章发布成功')\n        }\n        this.$router.push('/admin/articles')\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    }\n  }\n}\n</script>\n"],"mappings":"AAsDA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,WAAA;QACAC,KAAA;QACAC,WAAA;QACAC,IAAA;QACAC,OAAA;QACAC