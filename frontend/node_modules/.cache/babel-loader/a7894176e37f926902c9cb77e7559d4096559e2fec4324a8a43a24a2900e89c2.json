{"ast":null,"code":"export default {\n  name: 'Admin',\n  data() {\n    return {\n      activeMenu: '/admin/articles'\n    };\n  },\n  methods: {\n    handleSelect(key) {\n      this.activeMenu = key;\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$message.success('Logged out successfully');\n      this.$router.push('/login');\n    }\n  }\n};","map":{"version":3,"names":["name","data","activeMenu","methods","handleSelect","key","handleLogout","localStorage","removeItem","$message","success","$router","push"],"sources":["src/views/Admin.vue"],"sourcesContent":["<template>\n  <div class=\"admin\">\n    <el-container style=\"height: 100vh;\">\n      <el-aside width=\"200px\" style=\"background-color: rgb(238, 241, 246)\">\n        <el-menu :default-active=\"activeMenu\" @select=\"handleSelect\" router>\n          <el-menu-item index=\"/admin/articles\">\n            <i class=\"el-icon-document\"></i>\n            <span slot=\"title\">Articles</span>\n          </el-menu-item>\n          <el-menu-item index=\"/admin/categories\">\n            <i class=\"el-icon-menu\"></i>\n            <span slot=\"title\">Categories</span>\n          </el-menu-item>\n          <el-menu-item index=\"/admin/tags\">\n            <i class=\"el-icon-collection-tag\"></i>\n            <span slot=\"title\">Tags</span>\n          </el-menu-item>\n          <el-menu-item index=\"/admin/comments\">\n            <i class=\"el-icon-chat-dot-round\"></i>\n            <span slot=\"title\">Comments</span>\n          </el-menu-item>\n        </el-menu>\n      </el-aside>\n\n      <el-container>\n        <el-header\n          style=\"text-align: right; font-size: 12px; background-color: #fff; line-height: 60px; border-bottom: 1px solid #dcdfe6;\">\n          <el-dropdown>\n            <i class=\"el-icon-setting\" style=\"margin-right: 15px\"></i>\n            <el-dropdown-menu slot=\"dropdown\">\n              <el-dropdown-item @click.native=\"handleLogout\">Logout</el-dropdown-item>\n            </el-dropdown-menu>\n          </el-dropdown>\n          <span>Admin</span>\n        </el-header>\n\n        <el-main>\n          <router-view />\n          <!-- Placeholder for initial view -->\n          <div v-if=\"$route.path === '/admin'\">\n            <h2>Welcome, Admin!</h2>\n            <p>Select a menu item on the left to manage your blog.</p>\n          </div>\n        </el-main>\n      </el-container>\n    </el-container>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Admin',\n  data () {\n    return {\n      activeMenu: '/admin/articles'\n    }\n  },\n  methods: {\n    handleSelect (key) {\n      this.activeMenu = key\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$message.success('Logged out successfully')\n      this.$router.push('/login')\n    }\n  }\n}\n</script>\n\n<style scoped>\n.admin {\n  height: 100vh;\n}\n\n.el-header {\n  background-color: #B3C0D1;\n  color: #333;\n  line-height: 60px;\n}\n\n.el-aside {\n  color: #333;\n}\n</style>\n"],"mappings":"AAkDA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;IACA;EACA;EACAC,OAAA;IACAC,aAAAC,GAAA;MACA,KAAAH,UAAA,GAAAG,GAAA;IACA;IACAC,aAAA;MACAC,YAAA,CAAAC,UAAA;MACAD,YAAA,CAAAC,UAAA;MACA,KAAAC,QAAA,CAAAC,OAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}