{"ast":null,"code":"import axios from '../axios';\nexport default {\n  data() {\n    return {\n      announcements: [],\n      currentIndex: 0\n    };\n  },\n  computed: {\n    currentAnnouncement() {\n      return this.announcements[this.currentIndex] || {};\n    }\n  },\n  mounted() {\n    this.fetchAnnouncements();\n  },\n  methods: {\n    async fetchAnnouncements() {\n      try {\n        const response = await axios.get('/announcements');\n        this.announcements = response.data.announcements;\n      } catch (error) {\n        console.error('获取公告失败:', error);\n      }\n    },\n    nextAnnouncement() {\n      this.currentIndex = (this.currentIndex + 1) % this.announcements.length;\n    }\n  }\n};","map":{"version":3,"names":["axios","data","announcements","currentIndex","computed","currentAnnouncement","mounted","fetchAnnouncements","methods","response","get","error","console","nextAnnouncement","length"],"sources":["src/components/AnnouncementBar.vue"],"sourcesContent":["<template>\n  <div v-if=\"announcements.length > 0\" class=\"announcement-bar\">\n    <div class=\"announcement-content\">\n      <i class=\"el-icon-bell\"></i>\n      <span class=\"announcement-text\">{{ currentAnnouncement.content }}</span>\n      <el-button type=\"text\" @click=\"nextAnnouncement\">下一条</el-button>\n    </div>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\n\nexport default {\n  data() {\n    return {\n      announcements: [],\n      currentIndex: 0\n    }\n  },\n  computed: {\n    currentAnnouncement() {\n      return this.announcements[this.currentIndex] || {}\n    }\n  },\n  mounted() {\n    this.fetchAnnouncements()\n  },\n  methods: {\n    async fetchAnnouncements() {\n      try {\n        const response = await axios.get('/announcements')\n        this.announcements = response.data.announcements\n      } catch (error) {\n        console.error('获取公告失败:', error)\n      }\n    },\n    nextAnnouncement() {\n      this.currentIndex = (this.currentIndex + 1) % this.announcements.length\n    }\n  }\n}\n</script>\n\n<style scoped>\n.announcement-bar {\n  background-color: #f0f9ff;\n  border-bottom: 1px solid #d9ecff;\n  padding: 10px 0;\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  z-index: 102;\n}\n\n.announcement-content {\n  max-width: 1200px;\n  margin: 0 auto;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 0 30px;\n}\n\n.announcement-text {\n  flex: 1;\n  color: #1890ff;\n  font-size: 14px;\n}\n</style>"],"mappings":"AAWA,OAAAA,KAAA;AAEA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,YAAA;IACA;EACA;EACAC,QAAA;IACAC,oBAAA;MACA,YAAAH,aAAA,MAAAC,YAAA;IACA;EACA;EACAG,QAAA;IACA,KAAAC,kBAAA;EACA;EACAC,OAAA;IACA,MAAAD,mBAAA;MACA;QACA,MAAAE,QAAA,SAAAT,KAAA,CAAAU,GAAA;QACA,KAAAR,aAAA,GAAAO,QAAA,CAAAR,IAAA,CAAAC,aAAA;MACA,SAAAS,KAAA;QACAC,OAAA,CAAAD,KAAA,YAAAA,KAAA;MACA;IACA;IACAE,iBAAA;MACA,KAAAV,YAAA,SAAAA,YAAA,aAAAD,aAAA,CAAAY,MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}