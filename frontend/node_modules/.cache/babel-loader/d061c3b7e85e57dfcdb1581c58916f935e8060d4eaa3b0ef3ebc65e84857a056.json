{"ast":null,"code":"/**\n * 搜索框组件\n * 功能：提供文章搜索功能，包括搜索建议和搜索结果展示\n */\nimport axios from '../axios'; // 网络请求\n\nexport default {\n  name: 'SearchBox',\n  data() {\n    return {\n      searchKeyword: '',\n      // 搜索关键词\n      searchedKeyword: '',\n      // 已搜索的关键词\n      searchDialogVisible: false,\n      // 搜索结果对话框是否可见\n      searchResults: [],\n      // 搜索结果\n      searchTotal: 0,\n      // 搜索结果总数\n      searchPage: 1,\n      // 当前搜索页码\n      searchPageSize: 10 // 每页搜索结果数量\n    };\n  },\n  methods: {\n    /**\n     * 获取搜索建议\n     */\n    async fetchSuggestions(queryString, cb) {\n      if (queryString.length < 2) {\n        cb([]);\n        return;\n      }\n      try {\n        const response = await axios.get(`/search/suggestions?keyword=${queryString}`);\n        const suggestions = [...response.data.articles.map(a => ({\n          ...a,\n          value: a.title\n        })), ...response.data.tags.map(t => ({\n          ...t,\n          value: t.name\n        }))];\n        cb(suggestions);\n      } catch (error) {\n        cb([]);\n      }\n    },\n    /**\n     * 选择建议项\n     */\n    handleSelect(item) {\n      if (item.type === 'article') {\n        this.$router.push(`/article/${item.id}`);\n      } else if (item.type === 'tag') {\n        this.$router.push(`/?tag_id=${item.id}`);\n      }\n      this.searchKeyword = '';\n    },\n    /**\n     * 执行搜索\n     */\n    async handleSearch() {\n      if (!this.searchKeyword.trim()) {\n        this.$message.warning('请输入搜索关键词');\n        return;\n      }\n      this.searchPage = 1;\n      this.searchedKeyword = this.searchKeyword;\n      await this.performSearch();\n      // 使用nextTick确保DOM更新后再显示对话框\n      this.$nextTick(() => {\n        this.searchDialogVisible = true;\n      });\n    },\n    /**\n     * 执行搜索请求\n     */\n    async performSearch() {\n      try {\n        const response = await axios.get(`/search/articles`, {\n          params: {\n            keyword: this.searchedKeyword,\n            page: this.searchPage,\n            limit: this.searchPageSize\n          }\n        });\n        this.searchResults = response.data.articles;\n        this.searchTotal = response.data.total;\n      } catch (error) {\n        this.$message.error('搜索失败');\n        console.error(error);\n      }\n    },\n    /**\n     * 分页切换\n     */\n    handlePageChange(page) {\n      this.searchPage = page;\n      this.performSearch();\n    },\n    /**\n     * 跳转到文章详情\n     */\n    goToArticle(id) {\n      this.searchDialogVisible = false;\n      this.searchKeyword = '';\n      this.$router.push(`/article/${id}`);\n    },\n    /**\n     * 格式化日期\n     */\n    formatDate(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleDateString();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","searchKeyword","searchedKeyword","searchDialogVisible","searchResults","searchTotal","searchPage","searchPageSize","methods","fetchSuggestions","queryString","cb","length","response","get","suggestions","articles","map","a","value","title","tags","t","error","handleSelect","item","type","$router","push","id","handleSearch","trim","$message","warning","performSearch","$nextTick","params","keyword","page","limit","total","console","handlePageChange","goToArticle","formatDate","dateStr","date","Date","toLocaleDateString"],"sources":["src/components/SearchBox.vue"],"sourcesContent":["<template>\n  <div class=\"search-box\">\n    <div class=\"search-input-wrapper\">\n      <!-- 搜索输入框 -->\n      <el-autocomplete v-model=\"searchKeyword\" :fetch-suggestions=\"fetchSuggestions\" placeholder=\"搜索文章...\"\n        :trigger-on-focus=\"false\" @select=\"handleSelect\" @keyup.enter.native=\"handleSearch\" class=\"search-input\"\n        prefix-icon=\"el-icon-search\" clearable>\n        <template slot-scope=\"{ item }\">\n          <div class=\"suggestion-item\">\n            <i :class=\"item.type === 'article' ? 'el-icon-document' : 'el-icon-price-tag'\"></i>\n            <span class=\"suggestion-text\">{{ item.title || item.name }}</span>\n          </div>\n        </template>\n      </el-autocomplete>\n\n      <!-- 搜索按钮 -->\n      <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\" class=\"search-button\">搜索</el-button>\n    </div>\n\n    <!-- 搜索结果对话框 -->\n    <el-dialog title=\"搜索结果\" :visible.sync=\"searchDialogVisible\" width=\"70%\" class=\"search-result-dialog\"\n      :append-to-body=\"true\">\n      <div v-if=\"searchResults.length > 0\">\n        <div class=\"search-stats\">找到 {{ searchTotal }} 条关于 \"{{ searchedKeyword }}\" 的结果</div>\n\n        <div class=\"search-results\">\n          <!-- 搜索结果项 -->\n          <div v-for=\"article in searchResults\" :key=\"article.id\" class=\"search-result-item\"\n            @click=\"goToArticle(article.id)\">\n            <h4 class=\"result-title\" v-html=\"article.title_highlight || article.title\"></h4>\n            <p class=\"result-summary\" v-html=\"article.summary_highlight\"></p>\n            <div class=\"result-meta\">\n              <span><i class=\"el-icon-user\"></i> {{ article.User ? article.User.username : '未知' }}</span>\n              <span><i class=\"el-icon-date\"></i> {{ formatDate(article.created_at) }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i> {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> {{ article.views }}</span>\n            </div>\n          </div>\n        </div>\n\n        <!-- 分页控件 -->\n        <el-pagination v-if=\"searchTotal > searchPageSize\" layout=\"prev, pager, next\" :total=\"searchTotal\"\n          :page-size=\"searchPageSize\" :current-page=\"searchPage\" @current-change=\"handlePageChange\"\n          style=\"text-align: center; margin-top: 20px\"></el-pagination>\n      </div>\n\n      <!-- 空状态 -->\n      <el-empty v-else description=\"未找到相关文章\"></el-empty>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\n/**\n * 搜索框组件\n * 功能：提供文章搜索功能，包括搜索建议和搜索结果展示\n */\nimport axios from '../axios' // 网络请求\n\nexport default {\n  name: 'SearchBox',\n  data () {\n    return {\n      searchKeyword: '', // 搜索关键词\n      searchedKeyword: '', // 已搜索的关键词\n      searchDialogVisible: false, // 搜索结果对话框是否可见\n      searchResults: [], // 搜索结果\n      searchTotal: 0, // 搜索结果总数\n      searchPage: 1, // 当前搜索页码\n      searchPageSize: 10 // 每页搜索结果数量\n    }\n  },\n  methods: {\n    /**\n     * 获取搜索建议\n     */\n    async fetchSuggestions (queryString, cb) {\n      if (queryString.length < 2) {\n        cb([])\n        return\n      }\n\n      try {\n        const response = await axios.get(`/search/suggestions?keyword=${queryString}`)\n        const suggestions = [\n          ...response.data.articles.map(a => ({ ...a, value: a.title })),\n          ...response.data.tags.map(t => ({ ...t, value: t.name }))\n        ]\n        cb(suggestions)\n      } catch (error) {\n        cb([])\n      }\n    },\n\n    /**\n     * 选择建议项\n     */\n    handleSelect (item) {\n      if (item.type === 'article') {\n        this.$router.push(`/article/${item.id}`)\n      } else if (item.type === 'tag') {\n        this.$router.push(`/?tag_id=${item.id}`)\n      }\n      this.searchKeyword = ''\n    },\n\n    /**\n     * 执行搜索\n     */\n    async handleSearch () {\n      if (!this.searchKeyword.trim()) {\n        this.$message.warning('请输入搜索关键词')\n        return\n      }\n\n      this.searchPage = 1\n      this.searchedKeyword = this.searchKeyword\n      await this.performSearch()\n      // 使用nextTick确保DOM更新后再显示对话框\n      this.$nextTick(() => {\n        this.searchDialogVisible = true\n      })\n    },\n\n    /**\n     * 执行搜索请求\n     */\n    async performSearch () {\n      try {\n        const response = await axios.get(`/search/articles`, {\n          params: {\n            keyword: this.searchedKeyword,\n            page: this.searchPage,\n            limit: this.searchPageSize\n          }\n        })\n\n        this.searchResults = response.data.articles\n        this.searchTotal = response.data.total\n      } catch (error) {\n        this.$message.error('搜索失败')\n        console.error(error)\n      }\n    },\n\n    /**\n     * 分页切换\n     */\n    handlePageChange (page) {\n      this.searchPage = page\n      this.performSearch()\n    },\n\n    /**\n     * 跳转到文章详情\n     */\n    goToArticle (id) {\n      this.searchDialogVisible = false\n      this.searchKeyword = ''\n      this.$router.push(`/article/${id}`)\n    },\n\n    /**\n     * 格式化日期\n     */\n    formatDate (dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleDateString()\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 搜索框容器 */\n.search-box {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  width: 100%;\n  padding: 8px 0 8px 0;\n}\n\n/* 搜索输入区域 */\n.search-input-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n}\n\n/* 搜索输入框 */\n.search-input {\n  flex: 1;\n  min-width: 0;\n}\n\n/* 搜索按钮 */\n.search-button {\n  white-space: nowrap;\n  padding: 0 16px;\n  height: 36px;\n  font-size: 14px;\n}\n\n/* 搜索建议项 */\n.suggestion-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 0;\n}\n\n.suggestion-item i {\n  color: #909399;\n}\n\n/* 搜索统计信息 */\n.search-stats {\n  color: #909399;\n  font-size: 14px;\n  margin-bottom: 15px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid #ebeef5;\n}\n\n/* 搜索结果项 */\n.search-result-item {\n  padding: 15px;\n  border-bottom: 1px solid #ebeef5;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.search-result-item:hover {\n  background-color: #f5f7fa;\n}\n\n/* 搜索结果标题 */\n.result-title {\n  margin: 0 0 8px 0;\n  color: #409eff;\n  font-size: 16px;\n}\n\n.result-title :deep(mark) {\n  background-color: #ffeb3b;\n  color: #333;\n  padding: 0 2px;\n}\n\n/* 搜索结果摘要 */\n.result-summary {\n  margin: 0 0 10px 0;\n  color: #606266;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.result-summary :deep(mark) {\n  background-color: #ffeb3b;\n  color: #333;\n  padding: 0 2px;\n}\n\n/* 搜索结果元信息 */\n.result-meta {\n  display: flex;\n  gap: 15px;\n  font-size: 12px;\n  color: #909399;\n}\n\n.result-meta span {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n</style>\n"],"mappings":"AAqDA;AACA;AACA;AACA;AACA,OAAAA,KAAA;;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,aAAA;MAAA;MACAC,eAAA;MAAA;MACAC,mBAAA;MAAA;MACAC,aAAA;MAAA;MACAC,WAAA;MAAA;MACAC,UAAA;MAAA;MACAC,cAAA;IACA;EACA;EACAC,OAAA;IACA;AACA;AACA;IACA,MAAAC,iBAAAC,WAAA,EAAAC,EAAA;MACA,IAAAD,WAAA,CAAAE,MAAA;QACAD,EAAA;QACA;MACA;MAEA;QACA,MAAAE,QAAA,SAAAf,KAAA,CAAAgB,GAAA,gCAAAJ,WAAA;QACA,MAAAK,WAAA,IACA,GAAAF,QAAA,CAAAb,IAAA,CAAAgB,QAAA,CAAAC,GAAA,CAAAC,CAAA;UAAA,GAAAA,CAAA;UAAAC,KAAA,EAAAD,CAAA,CAAAE;QAAA,KACA,GAAAP,QAAA,CAAAb,IAAA,CAAAqB,IAAA,CAAAJ,GAAA,CAAAK,CAAA;UAAA,GAAAA,CAAA;UAAAH,KAAA,EAAAG,CAAA,CAAAvB;QAAA,IACA;QACAY,EAAA,CAAAI,WAAA;MACA,SAAAQ,KAAA;QACAZ,EAAA;MACA;IACA;IAEA;AACA;AACA;IACAa,aAAAC,IAAA;MACA,IAAAA,IAAA,CAAAC,IAAA;QACA,KAAAC,OAAA,CAAAC,IAAA,aAAAH,IAAA,CAAAI,EAAA;MACA,WAAAJ,IAAA,CAAAC,IAAA;QACA,KAAAC,OAAA,CAAAC,IAAA,aAAAH,IAAA,CAAAI,EAAA;MACA;MACA,KAAA5B,aAAA;IACA;IAEA;AACA;AACA;IACA,MAAA6B,aAAA;MACA,UAAA7B,aAAA,CAAA8B,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MAEA,KAAA3B,UAAA;MACA,KAAAJ,eAAA,QAAAD,aAAA;MACA,WAAAiC,aAAA;MACA;MACA,KAAAC,SAAA;QACA,KAAAhC,mBAAA;MACA;IACA;IAEA;AACA;AACA;IACA,MAAA+B,cAAA;MACA;QACA,MAAArB,QAAA,SAAAf,KAAA,CAAAgB,GAAA;UACAsB,MAAA;YACAC,OAAA,OAAAnC,eAAA;YACAoC,IAAA,OAAAhC,UAAA;YACAiC,KAAA,OAAAhC;UACA;QACA;QAEA,KAAAH,aAAA,GAAAS,QAAA,CAAAb,IAAA,CAAAgB,QAAA;QACA,KAAAX,WAAA,GAAAQ,QAAA,CAAAb,IAAA,CAAAwC,KAAA;MACA,SAAAjB,KAAA;QACA,KAAAS,QAAA,CAAAT,KAAA;QACAkB,OAAA,CAAAlB,KAAA,CAAAA,KAAA;MACA;IACA;IAEA;AACA;AACA;IACAmB,iBAAAJ,IAAA;MACA,KAAAhC,UAAA,GAAAgC,IAAA;MACA,KAAAJ,aAAA;IACA;IAEA;AACA;AACA;IACAS,YAAAd,EAAA;MACA,KAAA1B,mBAAA;MACA,KAAAF,aAAA;MACA,KAAA0B,OAAA,CAAAC,IAAA,aAAAC,EAAA;IACA;IAEA;AACA;AACA;IACAe,WAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OA