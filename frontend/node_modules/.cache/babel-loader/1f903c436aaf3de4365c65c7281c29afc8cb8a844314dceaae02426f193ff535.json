{"ast":null,"code":"import axios from '../../axios';\nexport default {\n  data() {\n    return {\n      announcements: [],\n      showAddDialog: false,\n      form: {\n        id: null,\n        title: '',\n        content: '',\n        is_active: true\n      }\n    };\n  },\n  mounted() {\n    this.fetchAnnouncements();\n  },\n  methods: {\n    async fetchAnnouncements() {\n      try {\n        const response = await axios.get('/announcements/admin');\n        this.announcements = response.data.announcements;\n      } catch (error) {\n        this.$message.error('获取公告失败');\n      }\n    },\n    addAnnouncement() {\n      this.form = {\n        id: null,\n        title: '',\n        content: '',\n        is_active: true\n      };\n      this.showAddDialog = true;\n    },\n    editAnnouncement(announcement) {\n      this.form = {\n        ...announcement\n      };\n      this.showAddDialog = true;\n    },\n    async saveAnnouncement() {\n      try {\n        if (this.form.id) {\n          await axios.put(`/announcements/${this.form.id}`, this.form);\n          this.$message.success('公告更新成功');\n        } else {\n          await axios.post('/announcements', this.form);\n          this.$message.success('公告创建成功');\n        }\n        this.showAddDialog = false;\n        this.fetchAnnouncements();\n      } catch (error) {\n        this.$message.error('保存公告失败');\n      }\n    },\n    async updateStatus(announcement) {\n      try {\n        await axios.put(`/announcements/${announcement.id}`, {\n          is_active: announcement.is_active\n        });\n        this.$message.success('状态更新成功');\n      } catch (error) {\n        this.$message.error('状态更新失败');\n        announcement.is_active = !announcement.is_active;\n      }\n    },\n    async deleteAnnouncement(id) {\n      try {\n        await axios.delete(`/announcements/${id}`);\n        this.$message.success('公告删除成功');\n        this.fetchAnnouncements();\n      } catch (error) {\n        this.$message.error('公告删除失败');\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","data","announcements","showAddDialog","form","id","title","content","is_active","mounted","fetchAnnouncements","methods","response","get","error","$message","addAnnouncement","editAnnouncement","announcement","saveAnnouncement","put","success","post","updateStatus","deleteAnnouncement","delete"],"sources":["src/views/admin/AnnouncementList.vue"],"sourcesContent":["<template>\n  <div class=\"announcement-list\">\n    <h2>系统公告管理</h2>\n    <el-button type=\"primary\" @click=\"addAnnouncement\">添加公告</el-button>\n    <el-table :data=\"announcements\" style=\"margin-top: 20px\">\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\n      <el-table-column prop=\"title\" label=\"标题\"></el-table-column>\n      <el-table-column prop=\"is_active\" label=\"状态\" width=\"100\">\n        <template slot-scope=\"scope\">\n          <el-switch v-model=\"scope.row.is_active\" @change=\"updateStatus(scope.row)\"></el-switch>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"created_at\" label=\"创建时间\" width=\"180\"></el-table-column>\n      <el-table-column label=\"操作\" width=\"150\">\n        <template slot-scope=\"scope\">\n          <el-button type=\"primary\" size=\"small\" @click=\"editAnnouncement(scope.row)\">编辑</el-button>\n          <el-button type=\"danger\" size=\"small\" @click=\"deleteAnnouncement(scope.row.id)\">删除</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <!-- 添加/编辑公告对话框 -->\n    <el-dialog title=\"公告管理\" :visible.sync=\"showAddDialog\" width=\"600px\">\n      <el-form :model=\"form\" label-width=\"80px\">\n        <el-form-item label=\"标题\">\n          <el-input v-model=\"form.title\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"内容\">\n          <el-input type=\"textarea\" v-model=\"form.content\" :rows=\"10\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"状态\">\n          <el-switch v-model=\"form.is_active\"></el-switch>\n        </el-form-item>\n      </el-form>\n      <span slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"showAddDialog = false\">取消</el-button>\n        <el-button type=\"primary\" @click=\"saveAnnouncement\">保存</el-button>\n      </span>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport axios from '../../axios'\n\nexport default {\n  data() {\n    return {\n      announcements: [],\n      showAddDialog: false,\n      form: {\n        id: null,\n        title: '',\n        content: '',\n        is_active: true\n      }\n    }\n  },\n  mounted() {\n    this.fetchAnnouncements()\n  },\n  methods: {\n    async fetchAnnouncements() {\n      try {\n        const response = await axios.get('/announcements/admin')\n        this.announcements = response.data.announcements\n      } catch (error) {\n        this.$message.error('获取公告失败')\n      }\n    },\n    addAnnouncement() {\n      this.form = {\n        id: null,\n        title: '',\n        content: '',\n        is_active: true\n      }\n      this.showAddDialog = true\n    },\n    editAnnouncement(announcement) {\n      this.form = { ...announcement }\n      this.showAddDialog = true\n    },\n    async saveAnnouncement() {\n      try {\n        if (this.form.id) {\n          await axios.put(`/announcements/${this.form.id}`, this.form)\n          this.$message.success('公告更新成功')\n        } else {\n          await axios.post('/announcements', this.form)\n          this.$message.success('公告创建成功')\n        }\n        this.showAddDialog = false\n        this.fetchAnnouncements()\n      } catch (error) {\n        this.$message.error('保存公告失败')\n      }\n    },\n    async updateStatus(announcement) {\n      try {\n        await axios.put(`/announcements/${announcement.id}`, {\n          is_active: announcement.is_active\n        })\n        this.$message.success('状态更新成功')\n      } catch (error) {\n        this.$message.error('状态更新失败')\n        announcement.is_active = !announcement.is_active\n      }\n    },\n    async deleteAnnouncement(id) {\n      try {\n        await axios.delete(`/announcements/${id}`)\n        this.$message.success('公告删除成功')\n        this.fetchAnnouncements()\n      } catch (error) {\n        this.$message.error('公告删除失败')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.announcement-list {\n  padding: 20px;\n}\n</style>"],"mappings":"AA2CA,OAAAA,KAAA;AAEA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,aAAA;MACAC,IAAA;QACAC,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,SAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,kBAAA;EACA;EACAC,OAAA;IACA,MAAAD,mBAAA;MACA;QACA,MAAAE,QAAA,SAAAZ,KAAA,CAAAa,GAAA;QACA,KAAAX,aAAA,GAAAU,QAAA,CAAAX,IAAA,CAAAC,aAAA;MACA,SAAAY,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,gBAAA;MACA,KAAAZ,IAAA;QACAC,EAAA;QACAC,KAAA;QACAC,OAAA;QACAC,SAAA;MACA;MACA,KAAAL,aAAA;IACA;IACAc,iBAAAC,YAAA;MACA,KAAAd,IAAA;QAAA,GAAAc;MAAA;MACA,KAAAf,aAAA;IACA;IACA,MAAAgB,iBAAA;MACA;QACA,SAAAf,IAAA,CAAAC,EAAA;UACA,MAAAL,KAAA,CAAAoB,GAAA,wBAAAhB,IAAA,CAAAC,EAAA,SAAAD,IAAA;UACA,KAAAW,QAAA,CAAAM,OAAA;QACA;UACA,MAAArB,KAAA,CAAAsB,IAAA,wBAAAlB,IAAA;UACA,KAAAW,QAAA,CAAAM,OAAA;QACA;QACA,KAAAlB,aAAA;QACA,KAAAO,kBAAA;MACA,SAAAI,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAS,aAAAL,YAAA;MACA;QACA,MAAAlB,KAAA,CAAAoB,GAAA,mBAAAF,YAAA,CAAAb,EAAA;UACAG,SAAA,EAAAU,YAAA,CAAAV;QACA;QACA,KAAAO,QAAA,CAAAM,OAAA;MACA,SAAAP,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;QACAI,YAAA,CAAAV,SAAA,IAAAU,YAAA,CAAAV,SAAA;MACA;IACA;IACA,MAAAgB,mBAAAnB,EAAA;MACA;QACA,MAAAL,KAAA,CAAAyB,MAAA,mBAAApB,EAAA;QACA,KAAAU,QAAA,CAAAM,OAAA;QACA,KAAAX,kBAAA;MACA,SAAAI,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}