{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'ArticleList',\n  data() {\n    return {\n      articles: []\n    };\n  },\n  created() {\n    this.fetchArticles();\n  },\n  methods: {\n    async fetchArticles() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles');\n        this.articles = response.data.articles;\n      } catch (error) {\n        this.$message.error('Failed to fetch articles');\n      }\n    },\n    handleCreate() {\n      this.$router.push('/admin/article/new');\n    },\n    handleEdit(id) {\n      this.$router.push(`/admin/article/edit/${id}`);\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('Are you sure to delete this article?', 'Warning', {\n          confirmButtonText: 'OK',\n          cancelButtonText: 'Cancel',\n          type: 'warning'\n        });\n        // API for delete article needs implementation\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('Article deleted successfully');\n        this.fetchArticles();\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('Failed to delete article');\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","articles","created","fetchArticles","methods","response","get","error","$message","handleCreate","$router","push","handleEdit","id","handleDelete","$confirm","confirmButtonText","cancelButtonText","type","delete","headers","Authorization","localStorage","getItem","success"],"sources":["src/views/admin/ArticleList.vue"],"sourcesContent":["<template>\n  <div class=\"article-list\">\n    <div class=\"toolbar\">\n      <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"handleCreate\">New Article</el-button>\n    </div>\n    <el-table :data=\"articles\" style=\"width: 100%\">\n      <el-table-column prop=\"title\" label=\"Title\"></el-table-column>\n      <el-table-column prop=\"Category.name\" label=\"Category\"></el-table-column>\n      <el-table-column prop=\"views\" label=\"Views\" width=\"100\"></el-table-column>\n      <el-table-column prop=\"status\" label=\"Status\" width=\"100\">\n        <template slot-scope=\"scope\">\n          <el-tag :type=\"scope.row.status === 'published' ? 'success' : 'info'\">{{ scope.row.status }}</el-tag>\n        </template>\n      </el-table-column>\n      <el-table-column prop=\"created_at\" label=\"Created At\" width=\"180\">\n        <template slot-scope=\"scope\">{{ new Date(scope.row.created_at).toLocaleString() }}</template>\n      </el-table-column>\n      <el-table-column label=\"Actions\" width=\"200\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"mini\" @click=\"handleEdit(scope.row.id)\">Edit</el-button>\n          <el-button size=\"mini\" type=\"danger\" @click=\"handleDelete(scope.row.id)\">Delete</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios';\n\nexport default {\n  name: 'ArticleList',\n  data() {\n    return {\n      articles: []\n    };\n  },\n  created() {\n    this.fetchArticles();\n  },\n  methods: {\n    async fetchArticles() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/articles');\n        this.articles = response.data.articles;\n      } catch (error) {\n        this.$message.error('Failed to fetch articles');\n      }\n    },\n    handleCreate() {\n      this.$router.push('/admin/article/new');\n    },\n    handleEdit(id) {\n      this.$router.push(`/admin/article/edit/${id}`);\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('Are you sure to delete this article?', 'Warning', {\n          confirmButtonText: 'OK',\n          cancelButtonText: 'Cancel',\n          type: 'warning'\n        });\n        // API for delete article needs implementation\n        await axios.delete(`http://localhost:3000/api/articles/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        });\n        this.$message.success('Article deleted successfully');\n        this.fetchArticles();\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('Failed to delete article');\n        }\n      }\n    }\n  }\n};\n</script>\n\n<style scoped>\n.toolbar {\n  margin-bottom: 20px;\n}\n</style>\n"],"mappings":"AA4BA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAD,cAAA;MACA;QACA,MAAAE,QAAA,SAAAP,KAAA,CAAAQ,GAAA;QACA,KAAAL,QAAA,GAAAI,QAAA,CAAAL,IAAA,CAAAC,QAAA;MACA,SAAAM,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,aAAA;MACA,KAAAC,OAAA,CAAAC,IAAA;IACA;IACAC,WAAAC,EAAA;MACA,KAAAH,OAAA,CAAAC,IAAA,wBAAAE,EAAA;IACA;IACA,MAAAC,aAAAD,EAAA;MACA;QACA,WAAAE,QAAA;UACAC,iBAAA;UACAC,gBAAA;UACAC,IAAA;QACA;QACA;QACA,MAAApB,KAAA,CAAAqB,MAAA,uCAAAN,EAAA;UACAO,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAf,QAAA,CAAAgB,OAAA;QACA,KAAArB,aAAA;MACA,SAAAI,KAAA;QACA,IAAAA,KAAA;UACA,KAAAC,QAAA,CAAAD,KAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}