{"ast":null,"code":"/**\n * 私信页面组件\n * 功能：实现用户之间的私信聊天功能，包括对话列表、消息展示和发送\n */\nimport axios from '../axios'; // 网络请求\nimport NavBar from '@/components/NavBar.vue'; // 导航栏组件\n\nexport default {\n  name: 'PrivateMessages',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      conversations: [],\n      // 对话列表\n      messages: [],\n      // 消息列表\n      activeConversation: null,\n      // 当前激活的对话\n      activeConversationId: null,\n      // 当前激活的对话ID\n      messageText: '',\n      // 消息输入框内容\n      loading: false,\n      // 加载状态\n      currentUserId: null // 当前用户ID\n    };\n  },\n  created() {\n    // 获取当前用户ID\n    this.getCurrentUserId();\n    // 获取对话列表\n    this.fetchConversations();\n\n    // 如果URL中有用户ID，自动选择该对话\n    const userId = this.$route.params.userId;\n    if (userId) {\n      this.selectConversationById(parseInt(userId));\n    }\n  },\n  methods: {\n    /**\n     * 获取当前用户ID\n     */\n    getCurrentUserId() {\n      try {\n        const userInfoStr = localStorage.getItem('userInfo');\n        const userInfo = JSON.parse(userInfoStr || '{}');\n        this.currentUserId = userInfo.id;\n\n        // 如果localStorage中没有userInfo，尝试从token解析\n        if (!this.currentUserId) {\n          const token = localStorage.getItem('token');\n          if (token) {\n            try {\n              const payload = JSON.parse(atob(token.split('.')[1]));\n              this.currentUserId = payload.id;\n            } catch (e) {\n              console.error('解析token失败:', e);\n            }\n          }\n        }\n      } catch (error) {\n        console.error('解析用户信息失败:', error);\n      }\n    },\n    /**\n     * 获取对话列表\n     */\n    async fetchConversations() {\n      try {\n        const response = await axios.get('/privateMessages/conversations');\n        this.conversations = response.data.conversations;\n      } catch (error) {\n        this.$message.error('获取对话列表失败');\n      }\n    },\n    /**\n     * 选择对话\n     * @param {object} conversation - 对话对象\n     */\n    async selectConversation(conversation) {\n      this.activeConversation = conversation;\n      this.activeConversationId = conversation.id;\n      await this.fetchMessages(conversation.id);\n\n      // 批量标记该用户的所有未读消息为已读\n      try {\n        await axios.patch(`/privateMessages/mark-all-read/${conversation.id}`);\n        // 实时更新未读消息数为0\n        this.$set(conversation, 'unread_count', 0);\n\n        // 通知导航栏更新未读消息计数\n        this.$root.$emit('updateUnreadCount');\n      } catch (error) {\n        console.error('标记消息已读失败:', error);\n      }\n    },\n    /**\n     * 根据用户ID选择对话\n     * @param {number} userId - 用户ID\n     */\n    async selectConversationById(userId) {\n      const conversation = this.conversations.find(c => c.id === userId);\n      if (conversation) {\n        await this.selectConversation(conversation);\n      } else {\n        // 如果用户不在对话列表中，创建一个临时对话并获取用户信息\n        this.activeConversation = {\n          id: userId\n        };\n        this.activeConversationId = userId;\n\n        // 先获取用户信息\n        try {\n          const userResponse = await axios.get(`/auth/user/${userId}`);\n          this.activeConversation.username = userResponse.data.username;\n          this.activeConversation.avatar = userResponse.data.avatar;\n        } catch (error) {\n          console.error('获取用户信息失败:', error);\n        }\n        await this.fetchMessages(userId);\n      }\n    },\n    /**\n     * 获取消息列表\n     * @param {number} userId - 用户ID\n     */\n    async fetchMessages(userId) {\n      this.loading = true;\n      try {\n        // 获取所有消息，设置较大的limit值\n        const response = await axios.get(`/privateMessages/conversation/${userId}?limit=100`);\n        this.messages = response.data.messages;\n\n        // 获取用户信息\n        if (!this.activeConversation.username) {\n          const userResponse = await axios.get(`/auth/user/${userId}`);\n          this.activeConversation.username = userResponse.data.username;\n          this.activeConversation.avatar = userResponse.data.avatar;\n        }\n\n        // 滚动到底部\n        this.$nextTick(() => {\n          this.scrollToBottom();\n        });\n      } catch (error) {\n        this.$message.error('获取消息失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    /**\n     * 发送消息\n     */\n    async sendMessage() {\n      if (!this.messageText.trim() || !this.activeConversationId) return;\n      const content = this.messageText.trim();\n      this.messageText = '';\n      try {\n        await axios.post('/privateMessages/send', {\n          receiver_id: this.activeConversationId,\n          content\n        });\n\n        // 重新获取消息\n        await this.fetchMessages(this.activeConversationId);\n        // 重新获取对话列表，更新最新消息预览\n        await this.fetchConversations();\n        this.$message.success('消息发送成功');\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '消息发送失败');\n        this.messageText = content;\n      }\n    },\n    /**\n     * 格式化时间\n     * @param {string} time - 时间字符串\n     * @returns {string} 格式化后的时间\n     */\n    formatTime(time) {\n      const date = new Date(time);\n      const now = new Date();\n      const isToday = date.toDateString() === now.toDateString();\n      if (isToday) {\n        return `今天 ${date.toLocaleString('zh-CN', {\n          hour: '2-digit',\n          minute: '2-digit'\n        })}`;\n      } else {\n        return date.toLocaleString('zh-CN', {\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric',\n          hour: '2-digit',\n          minute: '2-digit'\n        });\n      }\n    },\n    /**\n     * 滚动到消息列表底部\n     */\n    scrollToBottom() {\n      const messagesList = this.$refs.messagesList;\n      if (messagesList) {\n        messagesList.scrollTop = messagesList.scrollHeight;\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","conversations","messages","activeConversation","activeConversationId","messageText","loading","currentUserId","created","getCurrentUserId","fetchConversations","userId","$route","params","selectConversationById","parseInt","methods","userInfoStr","localStorage","getItem","userInfo","JSON","parse","id","token","payload","atob","split","e","console","error","response","get","$message","selectConversation","conversation","fetchMessages","patch","$set","$root","$emit","find","c","userResponse","username","avatar","$nextTick","scrollToBottom","sendMessage","trim","content","post","receiver_id","success","message","formatTime","time","date","Date","now","isToday","toDateString","toLocaleString","hour","minute","year","month","day","messagesList","$refs","scrollTop","scrollHeight"],"sources":["src/views/PrivateMessages.vue"],"sourcesContent":["<template>\n  <div class=\"private-messages\">\n    <nav-bar></nav-bar>\n    <el-container class=\"main-container\">\n      <el-aside width=\"300px\" class=\"message-sidebar\">\n        <div class=\"sidebar-header\">\n          <h3>私信</h3>\n        </div>\n        <div class=\"conversation-list\">\n          <el-card v-for=\"conversation in conversations\" :key=\"conversation.id\"\n            :class=\"{ 'active': activeConversationId === conversation.id }\" class=\"conversation-item\">\n            <div class=\"conversation-header\" @click.stop=\"selectConversation(conversation)\">\n              <el-badge :value=\"conversation.unread_count || 0\" :hidden=\"!(conversation.unread_count > 0)\"\n                class=\"unread-badge\">\n                <el-avatar :size=\"40\" :src=\"conversation.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              </el-badge>\n              <div class=\"conversation-info\">\n                <div class=\"username\">{{ conversation.username }}</div>\n                <div class=\"last-message\">{{ conversation.last_message }}</div>\n              </div>\n            </div>\n          </el-card>\n        </div>\n      </el-aside>\n\n      <el-main class=\"message-content\">\n        <div v-if=\"activeConversation\" class=\"chat-container\">\n          <div class=\"chat-header\">\n            <el-avatar :size=\"40\" :src=\"activeConversation.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n            <div class=\"chat-title\">{{ activeConversation.username }}</div>\n          </div>\n\n          <div class=\"messages-list\" ref=\"messagesList\">\n            <div v-for=\"message in messages\" :key=\"message.id\">\n              <div class=\"message-time\">{{ formatTime(message.created_at) }}</div>\n              <div :class=\"[\n                'message-item',\n                parseInt(message.sender_id) === parseInt(currentUserId) ? 'my-message' : 'other-message'\n              ]\">\n                <el-avatar v-if=\"parseInt(message.sender_id) !== parseInt(currentUserId)\" :size=\"30\"\n                  :src=\"message.Sender?.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                <div class=\"message-content\">\n                  <div class=\"message-text\">{{ message.content }}</div>\n                </div>\n                <el-avatar v-if=\"parseInt(message.sender_id) === parseInt(currentUserId)\" :size=\"30\"\n                  :src=\"message.Sender?.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n              </div>\n            </div>\n          </div>\n\n          <div class=\"message-input\">\n            <el-input v-model=\"messageText\" type=\"textarea\" :rows=\"2\" placeholder=\"输入消息...\"\n              @keyup.enter.native=\"sendMessage\"></el-input>\n            <el-button type=\"primary\" @click=\"sendMessage\" :disabled=\"!messageText.trim()\">发送</el-button>\n          </div>\n        </div>\n\n        <div v-else class=\"empty-state\">\n          <el-empty description=\"请选择一个对话开始聊天\"></el-empty>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\n/**\n * 私信页面组件\n * 功能：实现用户之间的私信聊天功能，包括对话列表、消息展示和发送\n */\nimport axios from '../axios' // 网络请求\nimport NavBar from '@/components/NavBar.vue' // 导航栏组件\n\nexport default {\n  name: 'PrivateMessages',\n  components: {\n    NavBar\n  },\n  data () {\n    return {\n      conversations: [], // 对话列表\n      messages: [], // 消息列表\n      activeConversation: null, // 当前激活的对话\n      activeConversationId: null, // 当前激活的对话ID\n      messageText: '', // 消息输入框内容\n      loading: false, // 加载状态\n      currentUserId: null // 当前用户ID\n    }\n  },\n  created () {\n    // 获取当前用户ID\n    this.getCurrentUserId()\n    // 获取对话列表\n    this.fetchConversations()\n\n    // 如果URL中有用户ID，自动选择该对话\n    const userId = this.$route.params.userId\n    if (userId) {\n      this.selectConversationById(parseInt(userId))\n    }\n  },\n  methods: {\n    /**\n     * 获取当前用户ID\n     */\n    getCurrentUserId () {\n      try {\n        const userInfoStr = localStorage.getItem('userInfo')\n        const userInfo = JSON.parse(userInfoStr || '{}')\n        this.currentUserId = userInfo.id\n\n        // 如果localStorage中没有userInfo，尝试从token解析\n        if (!this.currentUserId) {\n          const token = localStorage.getItem('token')\n          if (token) {\n            try {\n              const payload = JSON.parse(atob(token.split('.')[1]))\n              this.currentUserId = payload.id\n            } catch (e) {\n              console.error('解析token失败:', e)\n            }\n          }\n        }\n      } catch (error) {\n        console.error('解析用户信息失败:', error)\n      }\n    },\n    /**\n     * 获取对话列表\n     */\n    async fetchConversations () {\n      try {\n        const response = await axios.get('/privateMessages/conversations')\n        this.conversations = response.data.conversations\n      } catch (error) {\n        this.$message.error('获取对话列表失败')\n      }\n    },\n    /**\n     * 选择对话\n     * @param {object} conversation - 对话对象\n     */\n    async selectConversation (conversation) {\n      this.activeConversation = conversation\n      this.activeConversationId = conversation.id\n      await this.fetchMessages(conversation.id)\n      \n      // 批量标记该用户的所有未读消息为已读\n      try {\n        await axios.patch(`/privateMessages/mark-all-read/${conversation.id}`)\n        // 实时更新未读消息数为0\n        this.$set(conversation, 'unread_count', 0)\n        \n        // 通知导航栏更新未读消息计数\n        this.$root.$emit('updateUnreadCount')\n      } catch (error) {\n        console.error('标记消息已读失败:', error)\n      }\n    },\n    /**\n     * 根据用户ID选择对话\n     * @param {number} userId - 用户ID\n     */\n    async selectConversationById (userId) {\n      const conversation = this.conversations.find(c => c.id === userId)\n      if (conversation) {\n        await this.selectConversation(conversation)\n      } else {\n        // 如果用户不在对话列表中，创建一个临时对话并获取用户信息\n        this.activeConversation = { id: userId }\n        this.activeConversationId = userId\n\n        // 先获取用户信息\n        try {\n          const userResponse = await axios.get(`/auth/user/${userId}`)\n          this.activeConversation.username = userResponse.data.username\n          this.activeConversation.avatar = userResponse.data.avatar\n        } catch (error) {\n          console.error('获取用户信息失败:', error)\n        }\n\n        await this.fetchMessages(userId)\n      }\n    },\n    /**\n     * 获取消息列表\n     * @param {number} userId - 用户ID\n     */\n    async fetchMessages (userId) {\n      this.loading = true\n      try {\n        // 获取所有消息，设置较大的limit值\n        const response = await axios.get(`/privateMessages/conversation/${userId}?limit=100`)\n        this.messages = response.data.messages\n\n        // 获取用户信息\n        if (!this.activeConversation.username) {\n          const userResponse = await axios.get(`/auth/user/${userId}`)\n          this.activeConversation.username = userResponse.data.username\n          this.activeConversation.avatar = userResponse.data.avatar\n        }\n\n        // 滚动到底部\n        this.$nextTick(() => {\n          this.scrollToBottom()\n        })\n      } catch (error) {\n        this.$message.error('获取消息失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    /**\n     * 发送消息\n     */\n    async sendMessage () {\n      if (!this.messageText.trim() || !this.activeConversationId) return\n\n      const content = this.messageText.trim()\n      this.messageText = ''\n\n      try {\n        await axios.post('/privateMessages/send', {\n          receiver_id: this.activeConversationId,\n          content\n        })\n\n        // 重新获取消息\n        await this.fetchMessages(this.activeConversationId)\n        // 重新获取对话列表，更新最新消息预览\n        await this.fetchConversations()\n        this.$message.success('消息发送成功')\n      } catch (error) {\n        this.$message.error(error.response?.data?.message || '消息发送失败')\n        this.messageText = content\n      }\n    },\n    /**\n     * 格式化时间\n     * @param {string} time - 时间字符串\n     * @returns {string} 格式化后的时间\n     */\n    formatTime (time) {\n      const date = new Date(time)\n      const now = new Date()\n      const isToday = date.toDateString() === now.toDateString()\n\n      if (isToday) {\n        return `今天 ${date.toLocaleString('zh-CN', {\n          hour: '2-digit',\n          minute: '2-digit'\n        })}`\n      } else {\n        return date.toLocaleString('zh-CN', {\n          year: 'numeric',\n          month: 'long',\n          day: 'numeric',\n          hour: '2-digit',\n          minute: '2-digit'\n        })\n      }\n    },\n    /**\n     * 滚动到消息列表底部\n     */\n    scrollToBottom () {\n      const messagesList = this.$refs.messagesList\n      if (messagesList) {\n        messagesList.scrollTop = messagesList.scrollHeight\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n/**\n * 私信页面样式\n */\n.private-messages {\n  height: 100vh;\n  display: flex;\n  flex-direction: column;\n  padding-top: 80px;\n  width: 80%;\n  margin: 0 auto;\n  box-sizing: border-box;\n}\n\n.main-container {\n  flex: 1;\n  display: flex;\n  overflow: hidden;\n}\n\n.message-sidebar {\n  border-right: 1px solid #e2e8f0;\n  overflow-y: auto;\n}\n\n.sidebar-header {\n  padding: 20px;\n  border-bottom: 1px solid #e2e8f0;\n}\n\n.sidebar-header h3 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 600;\n}\n\n.conversation-list {\n  padding: 10px;\n}\n\n.conversation-item {\n  margin-bottom: 10px;\n  cursor: pointer;\n  transition: all 0.2s;\n  position: relative;\n  z-index: 1;\n}\n\n.conversation-item:hover {\n  border-color: #409eff;\n}\n\n.conversation-item.active {\n  border-color: #409eff;\n  background-color: #ecf5ff;\n}\n\n.conversation-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px;\n  cursor: pointer;\n}\n\n.conversation-info {\n  flex: 1;\n}\n\n.username {\n  font-weight: 600;\n  color: #1e293b;\n}\n\n.last-message {\n  font-size: 12px;\n  color: #64748b;\n  white-space: nowrap;\n  overflow: hidden;\n  text-overflow: ellipsis;\n}\n\n.unread-badge {\n  position: relative;\n}\n\n.message-content {\n  flex: 1;\n  display: flex;\n  flex-direction: column;\n}\n\n.chat-container {\n  display: flex;\n  flex-direction: column;\n  height: 100%;\n  max-height: 100%;\n}\n\n.chat-header {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 20px;\n  border-bottom: 1px solid #e2e8f0;\n}\n\n.chat-title {\n  font-size: 18px;\n  font-weight: 600;\n  color: #1e293b;\n}\n\n.messages-list {\n  flex: 1;\n  padding: 20px;\n  overflow-y: auto;\n  background-color: #f8fafc;\n}\n\n.message-item {\n  display: flex;\n  margin-bottom: 10px;\n  gap: 12px;\n  align-items: flex-start;\n  width: 100%;\n}\n\n.my-message {\n  justify-content: flex-end;\n}\n\n.my-message .message-content {\n  align-items: flex-end;\n}\n\n.other-message {\n  justify-content: flex-start;\n}\n\n.other-message .message-content {\n  align-items: flex-start;\n}\n\n.message-text {\n  max-width: 70%;\n  padding: 12px 16px;\n  border-radius: 18px;\n  word-wrap: break-word;\n}\n\n.my-message .message-text {\n  background-color: #409eff;\n  color: white;\n  border-bottom-right-radius: 4px;\n}\n\n.other-message .message-text {\n  background-color: white;\n  color: #1e293b;\n  border-bottom-left-radius: 4px;\n}\n\n.message-time {\n  font-size: 12px;\n  color: #94a3b8;\n  text-align: center;\n  margin: 10px 0;\n}\n\n.message-input {\n  padding: 20px;\n  border-top: 1px solid #e2e8f0;\n  display: flex;\n  gap: 12px;\n  background-color: white;\n}\n\n.message-input .el-input {\n  flex: 1;\n}\n\n.empty-state {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 100%;\n}\n</style>"],"mappings":"AAkEA;AACA;AACA;AACA;AACA,OAAAA,KAAA;AACA,OAAAC,MAAA;;AAEA;EACAC,IAAA;EACAC,UAAA;IACAF;EACA;EACAG,KAAA;IACA;MACAC,aAAA;MAAA;MACAC,QAAA;MAAA;MACAC,kBAAA;MAAA;MACAC,oBAAA;MAAA;MACAC,WAAA;MAAA;MACAC,OAAA;MAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACA;IACA,KAAAC,gBAAA;IACA;IACA,KAAAC,kBAAA;;IAEA;IACA,MAAAC,MAAA,QAAAC,MAAA,CAAAC,MAAA,CAAAF,MAAA;IACA,IAAAA,MAAA;MACA,KAAAG,sBAAA,CAAAC,QAAA,CAAAJ,MAAA;IACA;EACA;EACAK,OAAA;IACA;AACA;AACA;IACAP,iBAAA;MACA;QACA,MAAAQ,WAAA,GAAAC,YAAA,CAAAC,OAAA;QACA,MAAAC,QAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAL,WAAA;QACA,KAAAV,aAAA,GAAAa,QAAA,CAAAG,EAAA;;QAEA;QACA,UAAAhB,aAAA;UACA,MAAAiB,KAAA,GAAAN,YAAA,CAAAC,OAAA;UACA,IAAAK,KAAA;YACA;cACA,MAAAC,OAAA,GAAAJ,IAAA,CAAAC,KAAA,CAAAI,IAAA,CAAAF,KAAA,CAAAG,KAAA;cACA,KAAApB,aAAA,GAAAkB,OAAA,CAAAF,EAAA;YACA,SAAAK,CAAA;cACAC,OAAA,CAAAC,KAAA,eAAAF,CAAA;YACA;UACA;QACA;MACA,SAAAE,KAAA;QACAD,OAAA,CAAAC,KAAA,cAAAA,KAAA;MACA;IACA;IACA;AACA;AACA;IACA,MAAApB,mBAAA;MACA;QACA,MAAAqB,QAAA,SAAAnC,KAAA,CAAAoC,GAAA;QACA,KAAA/B,aAAA,GAAA8B,QAAA,CAAA/B,IAAA,CAAAC,aAAA;MACA,SAAA6B,KAAA;QACA,KAAAG,QAAA,CAAAH,KAAA;MACA;IACA;IACA;AACA;AACA;AACA;IACA,MAAAI,mBAAAC,YAAA;MACA,KAAAhC,kBAAA,GAAAgC,YAAA;MACA,KAAA/B,oBAAA,GAAA+B,YAAA,CAAAZ,EAAA;MACA,WAAAa,aAAA,CAAAD,YAAA,CAAAZ,EAAA;;MAEA;MACA;QACA,MAAA3B,KAAA,CAAAyC,KAAA,mCAAAF,YAAA,CAAAZ,EAAA;QACA;QACA,KAAAe,IAAA,CAAAH,YAAA;;QAEA;QACA,KAAAI,KAAA,CAAAC,KAAA;MACA,SAAAV,KAAA;QACAD,OAAA,CAAAC,KAAA,cAAAA,KAAA;MACA;IACA;IACA;AACA;AACA;AACA;IACA,MAAAhB,uBAAAH,MAAA;MACA,MAAAwB,YAAA,QAAAlC,aAAA,CAAAwC,IAAA,CAAAC,CAAA,IAAAA,CAAA,CAAAnB,EA