{"ast":null,"code":"import axios from 'axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'MessageBoard',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: '',\n        parent_id: null\n      },\n      replyForm: {\n        content: ''\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      replyTarget: '',\n      replyPlaceholder: '写下你的想法...',\n      showingReplyForm: null,\n      // 分页相关\n      currentPage: 1,\n      pageSize: 5,\n      totalMessages: 0,\n      // 侧边栏数据\n      activeUsers: 12,\n      todayMessages: 5,\n      hotTopics: [{\n        id: 1,\n        title: '技术交流',\n        count: 8\n      }, {\n        id: 2,\n        title: '学习心得',\n        count: 6\n      }, {\n        id: 3,\n        title: '问题求助',\n        count: 4\n      }, {\n        id: 4,\n        title: '经验分享',\n        count: 3\n      }, {\n        id: 5,\n        title: '项目讨论',\n        count: 2\n      }]\n    };\n  },\n  computed: {\n    isLoggedIn() {\n      return !!localStorage.getItem('token');\n    },\n    isAdmin() {\n      return this.currentUser.role === 'admin';\n    },\n    nestedMessages() {\n      if (!this.messages || !Array.isArray(this.messages)) {\n        return [];\n      }\n      const roots = this.messages.filter(m => !m.parent_id);\n      return roots.map(root => ({\n        ...root,\n        replies: this.messages.filter(m => m.parent_id === root.id).sort((a, b) => new Date(a.created_at) - new Date(b.created_at))\n      }));\n    }\n  },\n  created() {\n    this.initForm();\n    this.fetchMessages();\n    this.fetchStats();\n  },\n  methods: {\n    initForm() {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username;\n        this.messageForm.avatar = this.currentUser.avatar || '';\n      } else {\n        this.messageForm.nickname = '';\n        this.messageForm.avatar = '';\n      }\n      this.cancelReply();\n    },\n    async fetchMessages() {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/messages?page=${this.currentPage}&limit=${this.pageSize}`);\n        this.messages = response.data.rows;\n        this.totalMessages = response.data.count;\n      } catch (error) {\n        this.$message.error('获取留言失败');\n      }\n    },\n    async fetchStats() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages/stats');\n        this.totalMessages = response.data.totalMessages;\n        this.activeUsers = response.data.activeUsers;\n        this.todayMessages = response.data.todayMessages;\n      } catch (error) {\n        console.error('获取统计数据失败', error);\n        // 使用默认值避免404错误影响页面显示\n        this.totalMessages = 0;\n        this.activeUsers = 12;\n        this.todayMessages = 5;\n      }\n    },\n    async submitMessage() {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称');\n        return;\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm);\n        this.$message.success('发布成功');\n        this.messageForm.content = '';\n        this.cancelReply();\n        this.currentPage = 1;\n        this.fetchMessages();\n        this.fetchStats();\n      } catch (error) {\n        this.$message.error('发布失败');\n      } finally {\n        this.submitting = false;\n      }\n    },\n    replyTo(msg, rootMsg = null) {\n      // 如果回复的是子评论，则 parent_id 应该是它的父评论 ID\n      this.messageForm.parent_id = rootMsg ? rootMsg.id : msg.id;\n      this.replyTarget = msg.nickname;\n      this.messageForm.content = `@${msg.nickname} `;\n      this.replyPlaceholder = `回复 @${msg.nickname}...`;\n      // 自动滚动到输入框\n      const inputCard = document.querySelector('.input-card');\n      if (inputCard) {\n        inputCard.scrollIntoView({\n          behavior: 'smooth'\n        });\n      }\n    },\n    showReplyForm(msg, rootMsg = null) {\n      this.showingReplyForm = msg.id;\n      this.replyForm.content = '';\n    },\n    cancelReplyForm() {\n      this.showingReplyForm = null;\n      this.replyForm.content = '';\n    },\n    async submitReply(parentId) {\n      if (!this.replyForm.content.trim()) {\n        this.$message.warning('回复内容不能为空');\n        return;\n      }\n      this.submitting = true;\n      try {\n        const formData = {\n          nickname: this.isLoggedIn ? this.currentUser.username : '',\n          content: this.replyForm.content,\n          avatar: this.currentUser.avatar || '',\n          parent_id: parentId\n        };\n        await axios.post('http://localhost:3000/api/messages', formData);\n        this.$message.success('回复成功');\n        this.cancelReplyForm();\n        this.fetchMessages();\n        this.fetchStats();\n      } catch (error) {\n        this.$message.error('回复失败');\n      } finally {\n        this.submitting = false;\n      }\n    },\n    cancelReply() {\n      this.messageForm.parent_id = null;\n      this.replyTarget = '';\n      this.replyPlaceholder = '写下你的想法...';\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这条留言吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        });\n        await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.currentPage = 1;\n        this.fetchMessages();\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败');\n        }\n      }\n    },\n    formatDate(dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知';\n      const date = new Date(dateStr);\n      if (isNaN(date.getTime())) return '无效日期';\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`;\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.currentPage = 1;\n      this.fetchMessages();\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n      this.fetchMessages();\n    },\n    handleLogout() {\n      localStorage.removeItem('token');\n      localStorage.removeItem('user');\n      this.$router.push('/');\n      location.reload();\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","messages","messageForm","nickname","content","avatar","parent_id","replyForm","submitting","currentUser","JSON","parse","localStorage","getItem","replyTarget","replyPlaceholder","showingReplyForm","currentPage","pageSize","totalMessages","activeUsers","todayMessages","hotTopics","id","title","count","computed","isLoggedIn","isAdmin","role","nestedMessages","Array","isArray","roots","filter","m","map","root","replies","sort","a","b","Date","created_at","created","initForm","fetchMessages","fetchStats","methods","username","cancelReply","response","get","rows","error","$message","console","submitMessage","warning","post","success","replyTo","msg","rootMsg","inputCard","document","querySelector","scrollIntoView","behavior","showReplyForm","cancelReplyForm","submitReply","parentId","trim","formData","handleDelete","$confirm","confirmButtonText","cancelButtonText","type","delete","headers","Authorization","formatDate","dateStr","date","isNaN","getTime","getFullYear","getMonth","getDate","getHours","toString","padStart","getMinutes","handleSizeChange","val","handleCurrentChange","handleLogout","removeItem","$router","push","location","reload"],"sources":["src/views/MessageBoard.vue"],"sourcesContent":["<template>\n  <div class=\"message-board\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\">\n        <div class=\"board-hero\">\n          <div class=\"hero-content\">\n            <div class=\"hero-main\">\n              <h1>社区留言板</h1>\n              <p>欢迎在这里分享你的想法、建议或单纯打个招呼！</p>\n            </div>\n            <div class=\"hero-announcement\">\n              <div class=\"announcement-item\">\n                <div class=\"announcement-title\">社区公告</div>\n                <div class=\"announcement-date\">2026-03-20</div>\n                <div class=\"announcement-text\">请文明发言，共同维护良好的社区氛围。</div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"board-container\">\n          <!-- 主内容区 -->\n          <div class=\"main-content\">\n\n            <!-- 留言输入区 -->\n            <div class=\"input-section\">\n              <el-card class=\"input-card\" shadow=\"hover\">\n                <div class=\"input-wrapper\">\n                  <div class=\"user-info-section\">\n                    <el-avatar :size=\"60\" :src=\"currentUser.avatar || ''\" icon=\"el-icon-user\"\n                      class=\"user-avatar\"></el-avatar>\n                    <div class=\"user-welcome\">\n                      <div v-if=\"isLoggedIn\">\n                        {{ currentUser.username }}\n                        <span v-if=\"isAdmin\" class=\"user-role-tag\">管理员</span>\n                      </div>\n                      <div v-else>游客</div>\n                    </div>\n                  </div>\n\n                  <div class=\"form-content\">\n                    <el-form :model=\"messageForm\" label-width=\"0\">\n                      <el-form-item v-if=\"!isLoggedIn\">\n                        <el-input v-model=\"messageForm.nickname\" placeholder=\"请输入您的昵称\"\n                          prefix-icon=\"el-icon-user\"></el-input>\n                      </el-form-item>\n\n                      <div v-if=\"messageForm.parent_id\" class=\"reply-indicator\">\n                        <span>回复: {{ replyTarget }}</span>\n                        <i class=\"el-icon-close\" @click=\"cancelReply\"></i>\n                      </div>\n\n                      <el-form-item>\n                        <el-input type=\"textarea\" :rows=\"6\" v-model=\"messageForm.content\"\n                          :placeholder=\"replyPlaceholder\" resize=\"none\"></el-input>\n                      </el-form-item>\n                      <div class=\"form-footer\">\n                        <span class=\"tip\"><i class=\"el-icon-info\"></i> 文明发言，共建和谐社区</span>\n                        <el-button type=\"primary\" round icon=\"el-icon-s-promotion\" @click=\"submitMessage\"\n                          :loading=\"submitting\">发布</el-button>\n                      </div>\n                    </el-form>\n                  </div>\n                </div>\n              </el-card>\n            </div>\n\n            <!-- 留言列表区 -->\n            <div class=\"message-section\">\n              <div class=\"message-list-container\">\n                <div class=\"list-header\">\n                  <div class=\"list-title\">全部留言 ({{ totalMessages }})</div>\n                </div>\n                <div class=\"message-list\">\n                  <div v-for=\"msg in nestedMessages\" :key=\"msg.id\" class=\"message-wrapper\">\n                    <div class=\"message-item\">\n                      <div class=\"msg-avatar-wrapper\">\n                        <el-avatar :size=\"50\" :src=\"msg.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                      </div>\n                      <div class=\"msg-main\">\n                        <div class=\"msg-header\">\n                          <span class=\"nickname\">{{ msg.nickname }}</span>\n                          <span class=\"date\">{{ formatDate(msg.created_at) }}</span>\n                        </div>\n                        <div class=\"msg-content\">{{ msg.content }}</div>\n                        <div class=\"msg-actions\">\n                          <span class=\"action-btn\" @click=\"showReplyForm(msg, null)\"><i class=\"el-icon-chat-round\"></i>\n                            回复</span>\n                          <span v-if=\"isAdmin\" class=\"action-btn delete-btn\" @click=\"handleDelete(msg.id)\"><i\n                              class=\"el-icon-delete\"></i> 删除</span>\n                        </div>\n\n                        <!-- 嵌入式回复表单 -->\n                        <div v-if=\"showingReplyForm === msg.id\" class=\"reply-form-container\">\n                          <el-form :model=\"replyForm\" label-width=\"0\">\n                            <el-form-item>\n                              <el-input type=\"textarea\" :rows=\"3\" v-model=\"replyForm.content\" placeholder=\"回复...\"\n                                resize=\"none\"></el-input>\n                            </el-form-item>\n                            <div class=\"reply-form-actions\">\n                              <el-button size=\"small\" @click=\"cancelReplyForm\">取消</el-button>\n                              <el-button type=\"primary\" size=\"small\" @click=\"submitReply(msg.id)\"\n                                :loading=\"submitting\">回复</el-button>\n                            </div>\n                          </el-form>\n                        </div>\n                      </div>\n                    </div>\n\n                    <!-- 回复列表 -->\n                    <div v-if=\"msg.replies && msg.replies.length\" class=\"reply-list\">\n                      <div v-for=\"reply in msg.replies\" :key=\"reply.id\" class=\"reply-item\">\n                        <div class=\"msg-avatar-wrapper\">\n                          <el-avatar :size=\"36\" :src=\"reply.avatar || ''\" icon=\"el-icon-user\"></el-avatar>\n                        </div>\n                        <div class=\"msg-main\">\n                          <div class=\"msg-header\">\n                            <span class=\"nickname\">{{ reply.nickname }}</span>\n                            <span class=\"date\">{{ formatDate(reply.created_at) }}</span>\n                          </div>\n                          <div class=\"msg-content\">{{ reply.content }}</div>\n                          <div class=\"msg-actions\">\n                            <span class=\"action-btn\" @click=\"showReplyForm(reply, msg)\"><i\n                                class=\"el-icon-chat-round\"></i>\n                              回复</span>\n                            <span v-if=\"isAdmin\" class=\"action-btn delete-btn\" @click=\"handleDelete(reply.id)\"><i\n                                class=\"el-icon-delete\"></i> 删除</span>\n                          </div>\n\n                          <!-- 嵌入式回复表单 -->\n                          <div v-if=\"showingReplyForm === reply.id\" class=\"reply-form-container\">\n                            <el-form :model=\"replyForm\" label-width=\"0\">\n                              <el-form-item>\n                                <el-input type=\"textarea\" :rows=\"3\" v-model=\"replyForm.content\"\n                                  :placeholder=\"`回复 @${reply.nickname}...`\" resize=\"none\"></el-input>\n                              </el-form-item>\n                              <div class=\"reply-form-actions\">\n                                <el-button size=\"small\" @click=\"cancelReplyForm\">取消</el-button>\n                                <el-button type=\"primary\" size=\"small\" @click=\"submitReply(reply.id)\"\n                                  :loading=\"submitting\">回复</el-button>\n                              </div>\n                            </el-form>\n                          </div>\n                        </div>\n                      </div>\n                    </div>\n                  </div>\n                  <el-empty v-if=\"messages.length === 0\" description=\"暂无留言，快来抢沙发吧！\"></el-empty>\n                </div>\n\n                <!-- 分页组件 -->\n                <div class=\"pagination-container\">\n                  <el-pagination @size-change=\"handleSizeChange\" @current-change=\"handleCurrentChange\"\n                    :current-page=\"currentPage\" :page-sizes=\"[5, 10, 20]\" :page-size=\"pageSize\"\n                    layout=\"total, sizes, prev, pager, next\" :total=\"totalMessages\">\n                  </el-pagination>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <!-- 侧边栏 -->\n          <div class=\"sidebar\">\n            <!-- 统计信息 -->\n            <el-card class=\"sidebar-card\" shadow=\"hover\">\n              <div slot=\"header\" class=\"sidebar-header\">\n                <i class=\"el-icon-data-line\"></i> 留言统计\n              </div>\n              <div class=\"stats-content\">\n                <div class=\"stat-item\">\n                  <div class=\"stat-value\">{{ totalMessages }}</div>\n                  <div class=\"stat-label\">总留言数</div>\n                </div>\n                <div class=\"stat-divider\"></div>\n                <div class=\"stat-item\">\n                  <div class=\"stat-value\">{{ activeUsers }}</div>\n                  <div class=\"stat-label\">活跃用户</div>\n                </div>\n                <div class=\"stat-divider\"></div>\n                <div class=\"stat-item\">\n                  <div class=\"stat-value\">{{ todayMessages }}</div>\n                  <div class=\"stat-label\">今日留言</div>\n                </div>\n              </div>\n            </el-card>\n\n            <!-- 热门话题 -->\n            <el-card class=\"sidebar-card\" shadow=\"hover\" style=\"margin-top: 20px;\">\n              <div slot=\"header\" class=\"sidebar-header\">\n                <i class=\"el-icon-star-on\"></i> 热门话题\n              </div>\n              <div class=\"topic-list\">\n                <div v-for=\"topic in hotTopics\" :key=\"topic.id\" class=\"topic-item\">\n                  <i class=\"el-icon-trophy\"></i>\n                  <span>{{ topic.title }}</span>\n                  <span class=\"topic-count\">{{ topic.count }}条留言</span>\n                </div>\n              </div>\n            </el-card>\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'MessageBoard',\n  components: { NavBar },\n  data () {\n    return {\n      messages: [],\n      messageForm: {\n        nickname: '',\n        content: '',\n        avatar: '',\n        parent_id: null\n      },\n      replyForm: {\n        content: ''\n      },\n      submitting: false,\n      currentUser: JSON.parse(localStorage.getItem('user') || '{}'),\n      replyTarget: '',\n      replyPlaceholder: '写下你的想法...',\n      showingReplyForm: null,\n      // 分页相关\n      currentPage: 1,\n      pageSize: 5,\n      totalMessages: 0,\n      // 侧边栏数据\n      activeUsers: 12,\n      todayMessages: 5,\n      hotTopics: [\n        { id: 1, title: '技术交流', count: 8 },\n        { id: 2, title: '学习心得', count: 6 },\n        { id: 3, title: '问题求助', count: 4 },\n        { id: 4, title: '经验分享', count: 3 },\n        { id: 5, title: '项目讨论', count: 2 }\n      ]\n    }\n  },\n  computed: {\n    isLoggedIn () {\n      return !!localStorage.getItem('token')\n    },\n    isAdmin () {\n      return this.currentUser.role === 'admin'\n    },\n    nestedMessages () {\n      if (!this.messages || !Array.isArray(this.messages)) {\n        return []\n      }\n      const roots = this.messages.filter(m => !m.parent_id)\n      return roots.map(root => ({\n        ...root,\n        replies: this.messages.filter(m => m.parent_id === root.id).sort((a, b) => new Date(a.created_at) - new Date(b.created_at))\n      }))\n    }\n  },\n  created () {\n    this.initForm()\n    this.fetchMessages()\n    this.fetchStats()\n  },\n  methods: {\n    initForm () {\n      if (this.isLoggedIn) {\n        this.messageForm.nickname = this.currentUser.username\n        this.messageForm.avatar = this.currentUser.avatar || ''\n      } else {\n        this.messageForm.nickname = ''\n        this.messageForm.avatar = ''\n      }\n      this.cancelReply()\n    },\n    async fetchMessages () {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/messages?page=${this.currentPage}&limit=${this.pageSize}`)\n        this.messages = response.data.rows\n        this.totalMessages = response.data.count\n      } catch (error) {\n        this.$message.error('获取留言失败')\n      }\n    },\n\n    async fetchStats () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/messages/stats')\n        this.totalMessages = response.data.totalMessages\n        this.activeUsers = response.data.activeUsers\n        this.todayMessages = response.data.todayMessages\n      } catch (error) {\n        console.error('获取统计数据失败', error)\n        // 使用默认值避免404错误影响页面显示\n        this.totalMessages = 0\n        this.activeUsers = 12\n        this.todayMessages = 5\n      }\n    },\n    async submitMessage () {\n      if (!this.messageForm.nickname) {\n        this.$message.warning('请填写昵称')\n        return\n      }\n      if (!this.messageForm.content) {\n        this.$message.warning('内容不能为空')\n        return\n      }\n      this.submitting = true\n      try {\n        await axios.post('http://localhost:3000/api/messages', this.messageForm)\n        this.$message.success('发布成功')\n        this.messageForm.content = ''\n        this.cancelReply()\n        this.currentPage = 1\n        this.fetchMessages()\n        this.fetchStats()\n      } catch (error) {\n        this.$message.error('发布失败')\n      } finally {\n        this.submitting = false\n      }\n    },\n    replyTo (msg, rootMsg = null) {\n      // 如果回复的是子评论，则 parent_id 应该是它的父评论 ID\n      this.messageForm.parent_id = rootMsg ? rootMsg.id : msg.id\n      this.replyTarget = msg.nickname\n      this.messageForm.content = `@${msg.nickname} `\n      this.replyPlaceholder = `回复 @${msg.nickname}...`\n      // 自动滚动到输入框\n      const inputCard = document.querySelector('.input-card')\n      if (inputCard) {\n        inputCard.scrollIntoView({ behavior: 'smooth' })\n      }\n    },\n    showReplyForm (msg, rootMsg = null) {\n      this.showingReplyForm = msg.id\n      this.replyForm.content = ''\n    },\n    cancelReplyForm () {\n      this.showingReplyForm = null\n      this.replyForm.content = ''\n    },\n    async submitReply (parentId) {\n      if (!this.replyForm.content.trim()) {\n        this.$message.warning('回复内容不能为空')\n        return\n      }\n\n      this.submitting = true\n      try {\n        const formData = {\n          nickname: this.isLoggedIn ? this.currentUser.username : '',\n          content: this.replyForm.content,\n          avatar: this.currentUser.avatar || '',\n          parent_id: parentId\n        }\n\n        await axios.post('http://localhost:3000/api/messages', formData)\n        this.$message.success('回复成功')\n        this.cancelReplyForm()\n        this.fetchMessages()\n        this.fetchStats()\n      } catch (error) {\n        this.$message.error('回复失败')\n      } finally {\n        this.submitting = false\n      }\n    },\n    cancelReply () {\n      this.messageForm.parent_id = null\n      this.replyTarget = ''\n      this.replyPlaceholder = '写下你的想法...'\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这条留言吗？', '提示', {\n          confirmButtonText: '确定',\n          cancelButtonText: '取消',\n          type: 'warning'\n        })\n        await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.currentPage = 1\n        this.fetchMessages()\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败')\n        }\n      }\n    },\n    formatDate (dateStr) {\n      if (!dateStr || dateStr === 'undefined' || dateStr === 'null') return '未知'\n      const date = new Date(dateStr)\n      if (isNaN(date.getTime())) return '无效日期'\n      return `${date.getFullYear()}-${date.getMonth() + 1}-${date.getDate()} ${date.getHours().toString().padStart(2, '0')}:${date.getMinutes().toString().padStart(2, '0')}`\n    },\n    handleSizeChange (val) {\n      this.pageSize = val\n      this.currentPage = 1\n      this.fetchMessages()\n    },\n    handleCurrentChange (val) {\n      this.currentPage = val\n      this.fetchMessages()\n    },\n    handleLogout () {\n      localStorage.removeItem('token')\n      localStorage.removeItem('user')\n      this.$router.push('/')\n      location.reload()\n    }\n  }\n}\n</script>\n\n<style scoped src=\"../assets/styles/views/MessageBoard.css\"></style>\n"],"mappings":"AAiNA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;QACAC,QAAA;QACAC,OAAA;QACAC,MAAA;QACAC,SAAA;MACA;MACAC,SAAA;QACAH,OAAA;MACA;MACAI,UAAA;MACAC,WAAA,EAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;MACAC,WAAA;MACAC,gBAAA;MACAC,gBAAA;MACA;MACAC,WAAA;MACAC,QAAA;MACAC,aAAA;MACA;MACAC,WAAA;MACAC,aAAA;MACAC,SAAA,GACA;QAAAC,EAAA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,EAAA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,EAAA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,EAAA;QAAAC,KAAA;QAAAC,KAAA;MAAA,GACA;QAAAF,EAAA;QAAAC,KAAA;QAAAC,KAAA;MAAA;IAEA;EACA;EACAC,QAAA;IACAC,WAAA;MACA,SAAAf,YAAA,CAAAC,OAAA;IACA;IACAe,QAAA;MACA,YAAAnB,WAAA,CAAAoB,IAAA;IACA;IACAC,eAAA;MACA,UAAA7B,QAAA,KAAA8B,KAAA,CAAAC,OAAA,MAAA/B,QAAA;QACA;MACA;MACA,MAAAgC,KAAA,QAAAhC,QAAA,CAAAiC,MAAA,CAAAC,CAAA,KAAAA,CAAA,CAAA7B,SAAA;MACA,OAAA2B,KAAA,CAAAG,GAAA,CAAAC,IAAA;QACA,GAAAA,IAAA;QACAC,OAAA,OAAArC,QAAA,CAAAiC,MAAA,CAAAC,CAAA,IAAAA,CAAA,CAAA7B,SAAA,KAAA+B,IAAA,CAAAd,EAAA,EAAAgB,IAAA,EAAAC,CAAA,EAAAC,CAAA,SAAAC,IAAA,CAAAF,CAAA,CAAAG,UAAA,QAAAD,IAAA,CAAAD,CAAA,CAAAE,UAAA;MACA;IACA;EACA