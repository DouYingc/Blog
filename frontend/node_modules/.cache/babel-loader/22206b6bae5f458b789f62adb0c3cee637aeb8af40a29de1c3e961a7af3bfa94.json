{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'SearchBox',\n  data() {\n    return {\n      searchKeyword: '',\n      searchedKeyword: '',\n      searchDialogVisible: false,\n      searchResults: [],\n      searchTotal: 0,\n      searchPage: 1,\n      searchPageSize: 10,\n      hotKeywords: []\n    };\n  },\n  created() {\n    this.fetchHotKeywords();\n  },\n  methods: {\n    // 获取搜索建议\n    async fetchSuggestions(queryString, cb) {\n      if (queryString.length < 2) {\n        cb([]);\n        return;\n      }\n      try {\n        const response = await axios.get(`http://localhost:3000/api/search/suggestions?keyword=${queryString}`);\n        const suggestions = [...response.data.articles.map(a => ({\n          ...a,\n          value: a.title\n        })), ...response.data.tags.map(t => ({\n          ...t,\n          value: t.name\n        }))];\n        cb(suggestions);\n      } catch (error) {\n        cb([]);\n      }\n    },\n    // 选择建议项\n    handleSelect(item) {\n      if (item.type === 'article') {\n        this.$router.push(`/article/${item.id}`);\n      } else if (item.type === 'tag') {\n        this.$router.push(`/?tag_id=${item.id}`);\n      }\n      this.searchKeyword = '';\n    },\n    // 执行搜索\n    async handleSearch() {\n      if (!this.searchKeyword.trim()) {\n        this.$message.warning('请输入搜索关键词');\n        return;\n      }\n      this.searchPage = 1;\n      this.searchedKeyword = this.searchKeyword;\n      await this.performSearch();\n      this.searchDialogVisible = true;\n    },\n    // 执行搜索请求\n    async performSearch() {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/search/articles`, {\n          params: {\n            keyword: this.searchedKeyword,\n            page: this.searchPage,\n            limit: this.searchPageSize\n          }\n        });\n        this.searchResults = response.data.articles;\n        this.searchTotal = response.data.total;\n      } catch (error) {\n        this.$message.error('搜索失败');\n        console.error(error);\n      }\n    },\n    // 分页切换\n    handlePageChange(page) {\n      this.searchPage = page;\n      this.performSearch();\n    },\n    // 跳转到文章详情\n    goToArticle(id) {\n      this.searchDialogVisible = false;\n      this.searchKeyword = '';\n      this.$router.push(`/article/${id}`);\n    },\n    // 获取热门搜索词\n    async fetchHotKeywords() {\n      try {\n        const response = await axios.get('http://localhost:3000/api/search/hot-keywords');\n        this.hotKeywords = response.data;\n      } catch (error) {\n        console.error('获取热门搜索失败', error);\n      }\n    },\n    // 格式化日期\n    formatDate(dateStr) {\n      if (!dateStr) return '';\n      const date = new Date(dateStr);\n      return date.toLocaleDateString();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","searchKeyword","searchedKeyword","searchDialogVisible","searchResults","searchTotal","searchPage","searchPageSize","hotKeywords","created","fetchHotKeywords","methods","fetchSuggestions","queryString","cb","length","response","get","suggestions","articles","map","a","value","title","tags","t","error","handleSelect","item","type","$router","push","id","handleSearch","trim","$message","warning","performSearch","params","keyword","page","limit","total","console","handlePageChange","goToArticle","formatDate","dateStr","date","Date","toLocaleDateString"],"sources":["src/components/SearchBox.vue"],"sourcesContent":["<template>\n  <div class=\"search-box\">\n    <div class=\"search-input-wrapper\">\n      <el-autocomplete v-model=\"searchKeyword\" :fetch-suggestions=\"fetchSuggestions\" placeholder=\"搜索文章...\"\n        :trigger-on-focus=\"false\" @select=\"handleSelect\" @keyup.enter.native=\"handleSearch\" class=\"search-input\"\n        prefix-icon=\"el-icon-search\" clearable>\n        <template slot-scope=\"{ item }\">\n          <div class=\"suggestion-item\">\n            <i :class=\"item.type === 'article'\n              ? 'el-icon-document'\n              : 'el-icon-price-tag'\n              \"></i>\n            <span class=\"suggestion-text\">{{ item.title || item.name }}</span>\n          </div>\n        </template>\n      </el-autocomplete>\n\n      <el-button type=\"primary\" icon=\"el-icon-search\" @click=\"handleSearch\" class=\"search-button\">搜索</el-button>\n    </div>\n\n    <!-- 热门搜索词 -->\n    <div class=\"hot-keywords\" v-if=\"hotKeywords.length > 0\">\n      <span class=\"hot-label\">热门搜索：</span>\n      <el-tag v-for=\"word in hotKeywords\" :key=\"word\" size=\"mini\" class=\"hot-tag\" @click=\"\n        searchKeyword = word\n      handleSearch()\n        \">\n        {{ word }}\n      </el-tag>\n    </div>\n\n    <!-- 搜索结果对话框 -->\n    <el-dialog title=\"搜索结果\" :visible.sync=\"searchDialogVisible\" width=\"70%\" class=\"search-result-dialog\" :z-index=\"2000\"\n      :append-to-body=\"true\">\n      <div v-if=\"searchResults.length > 0\">\n        <div class=\"search-stats\">\n          找到 {{ searchTotal }} 条关于 \"{{ searchedKeyword }}\" 的结果\n        </div>\n\n        <div class=\"search-results\">\n          <div v-for=\"article in searchResults\" :key=\"article.id\" class=\"search-result-item\"\n            @click=\"goToArticle(article.id)\">\n            <h4 class=\"result-title\" v-html=\"article.title_highlight || article.title\"></h4>\n            <p class=\"result-summary\" v-html=\"article.summary_highlight\"></p>\n            <div class=\"result-meta\">\n              <span><i class=\"el-icon-user\"></i>\n                {{ article.User ? article.User.username : '未知' }}</span>\n              <span><i class=\"el-icon-date\"></i>\n                {{ formatDate(article.created_at) }}</span>\n              <span v-if=\"article.Category\"><i class=\"el-icon-folder\"></i>\n                {{ article.Category.name }}</span>\n              <span><i class=\"el-icon-view\"></i> {{ article.views }}</span>\n            </div>\n          </div>\n        </div>\n\n        <el-pagination v-if=\"searchTotal > searchPageSize\" layout=\"prev, pager, next\" :total=\"searchTotal\"\n          :page-size=\"searchPageSize\" :current-page=\"searchPage\" @current-change=\"handlePageChange\"\n          style=\"text-align: center; margin-top: 20px\"></el-pagination>\n      </div>\n\n      <el-empty v-else description=\"未找到相关文章\"></el-empty>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'SearchBox',\n  data () {\n    return {\n      searchKeyword: '',\n      searchedKeyword: '',\n      searchDialogVisible: false,\n      searchResults: [],\n      searchTotal: 0,\n      searchPage: 1,\n      searchPageSize: 10,\n      hotKeywords: []\n    }\n  },\n  created () {\n    this.fetchHotKeywords()\n  },\n  methods: {\n    // 获取搜索建议\n    async fetchSuggestions (queryString, cb) {\n      if (queryString.length < 2) {\n        cb([])\n        return\n      }\n\n      try {\n        const response = await axios.get(`http://localhost:3000/api/search/suggestions?keyword=${queryString}`)\n        const suggestions = [\n          ...response.data.articles.map(a => ({ ...a, value: a.title })),\n          ...response.data.tags.map(t => ({ ...t, value: t.name }))\n        ]\n        cb(suggestions)\n      } catch (error) {\n        cb([])\n      }\n    },\n\n    // 选择建议项\n    handleSelect (item) {\n      if (item.type === 'article') {\n        this.$router.push(`/article/${item.id}`)\n      } else if (item.type === 'tag') {\n        this.$router.push(`/?tag_id=${item.id}`)\n      }\n      this.searchKeyword = ''\n    },\n\n    // 执行搜索\n    async handleSearch () {\n      if (!this.searchKeyword.trim()) {\n        this.$message.warning('请输入搜索关键词')\n        return\n      }\n\n      this.searchPage = 1\n      this.searchedKeyword = this.searchKeyword\n      await this.performSearch()\n      this.searchDialogVisible = true\n    },\n\n    // 执行搜索请求\n    async performSearch () {\n      try {\n        const response = await axios.get(`http://localhost:3000/api/search/articles`, {\n          params: {\n            keyword: this.searchedKeyword,\n            page: this.searchPage,\n            limit: this.searchPageSize\n          }\n        })\n\n        this.searchResults = response.data.articles\n        this.searchTotal = response.data.total\n      } catch (error) {\n        this.$message.error('搜索失败')\n        console.error(error)\n      }\n    },\n\n    // 分页切换\n    handlePageChange (page) {\n      this.searchPage = page\n      this.performSearch()\n    },\n\n    // 跳转到文章详情\n    goToArticle (id) {\n      this.searchDialogVisible = false\n      this.searchKeyword = ''\n      this.$router.push(`/article/${id}`)\n    },\n\n    // 获取热门搜索词\n    async fetchHotKeywords () {\n      try {\n        const response = await axios.get('http://localhost:3000/api/search/hot-keywords')\n        this.hotKeywords = response.data\n      } catch (error) {\n        console.error('获取热门搜索失败', error)\n      }\n    },\n\n    // 格式化日期\n    formatDate (dateStr) {\n      if (!dateStr) return ''\n      const date = new Date(dateStr)\n      return date.toLocaleDateString()\n    }\n  }\n}\n</script>\n\n<style scoped>\n.search-box {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  width: 100%;\n  margin-top: ;\n  padding: 16px 0 8px 0;\n}\n\n.search-input-wrapper {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  width: 100%;\n}\n\n.search-input {\n  flex: 1;\n  min-width: 0;\n}\n\n.search-button {\n  white-space: nowrap;\n  padding: 0 16px;\n  height: 36px;\n  font-size: 14px;\n}\n\n.suggestion-item {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 5px 0;\n}\n\n.suggestion-item i {\n  color: #909399;\n}\n\n.hot-keywords {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 6px;\n  padding: 4px 0;\n  overflow: hidden;\n}\n\n.hot-label {\n  font-size: 11px;\n  color: #909399;\n  flex-shrink: 0;\n  margin-right: 4px;\n}\n\n.hot-tag {\n  cursor: pointer;\n  flex-shrink: 0;\n  font-size: 11px;\n  padding: 2px 6px;\n}\n\n.hot-tag:hover {\n  background-color: #409eff;\n  color: white;\n}\n\n.search-stats {\n  color: #909399;\n  font-size: 14px;\n  margin-bottom: 15px;\n  padding-bottom: 10px;\n  border-bottom: 1px solid #ebeef5;\n}\n\n.search-result-item {\n  padding: 15px;\n  border-bottom: 1px solid #ebeef5;\n  cursor: pointer;\n  transition: background-color 0.2s;\n}\n\n.search-result-item:hover {\n  background-color: #f5f7fa;\n}\n\n.result-title {\n  margin: 0 0 8px 0;\n  color: #409eff;\n  font-size: 16px;\n}\n\n.result-title :deep(mark) {\n  background-color: #ffeb3b;\n  color: #333;\n  padding: 0 2px;\n}\n\n.result-summary {\n  margin: 0 0 10px 0;\n  color: #606266;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.result-summary :deep(mark) {\n  background-color: #ffeb3b;\n  color: #333;\n  padding: 0 2px;\n}\n\n.result-meta {\n  display: flex;\n  gap: 15px;\n  font-size: 12px;\n  color: #909399;\n}\n\n.result-meta span {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n</style>\n\n<style>\n/* 确保搜索结果对话框的遮罩层正常显示 */\n.search-result-dialog {\n  z-index: 2000 !important;\n}\n\n/* 修复对话框遮罩层 */\n.el-dialog__wrapper {\n  z-index: 1999 !important;\n}\n</style>\n"],"mappings":"AAmEA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,aAAA;MACAC,eAAA;MACAC,mBAAA;MACAC,aAAA;MACAC,WAAA;MACAC,UAAA;MACAC,cAAA;MACAC,WAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA;IACA,MAAAC,iBAAAC,WAAA,EAAAC,EAAA;MACA,IAAAD,WAAA,CAAAE,MAAA;QACAD,EAAA;QACA;MACA;MAEA;QACA,MAAAE,QAAA,SAAAlB,KAAA,CAAAmB,GAAA,yDAAAJ,WAAA;QACA,MAAAK,WAAA,IACA,GAAAF,QAAA,CAAAhB,IAAA,CAAAmB,QAAA,CAAAC,GAAA,CAAAC,CAAA;UAAA,GAAAA,CAAA;UAAAC,KAAA,EAAAD,CAAA,CAAAE;QAAA,KACA,GAAAP,QAAA,CAAAhB,IAAA,CAAAwB,IAAA,CAAAJ,GAAA,CAAAK,CAAA;UAAA,GAAAA,CAAA;UAAAH,KAAA,EAAAG,CAAA,CAAA1B;QAAA,IACA;QACAe,EAAA,CAAAI,WAAA;MACA,SAAAQ,KAAA;QACAZ,EAAA;MACA;IACA;IAEA;IACAa,aAAAC,IAAA;MACA,IAAAA,IAAA,CAAAC,IAAA;QACA,KAAAC,OAAA,CAAAC,IAAA,aAAAH,IAAA,CAAAI,EAAA;MACA,WAAAJ,IAAA,CAAAC,IAAA;QACA,KAAAC,OAAA,CAAAC,IAAA,aAAAH,IAAA,CAAAI,EAAA;MACA;MACA,KAAA/B,aAAA;IACA;IAEA;IACA,MAAAgC,aAAA;MACA,UAAAhC,aAAA,CAAAiC,IAAA;QACA,KAAAC,QAAA,CAAAC,OAAA;QACA;MACA;MAEA,KAAA9B,UAAA;MACA,KAAAJ,eAAA,QAAAD,aAAA;MACA,WAAAoC,aAAA;MACA,KAAAlC,mBAAA;IACA;IAEA;IACA,MAAAkC,cAAA;MACA;QACA,MAAArB,QAAA,SAAAlB,KAAA,CAAAmB,GAAA;UACAqB,MAAA;YACAC,OAAA,OAAArC,eAAA;YACAsC,IAAA,OAAAlC,UAAA;YACAmC,KAAA,OAAAlC;UACA;QACA;QAEA,KAAAH,aAAA,GAAAY,QAAA,CAAAhB,IAAA,CAAAmB,QAAA;QACA,KAAAd,WAAA,GAAAW,QAAA,CAAAhB,IAAA,CAAA0C,KAAA;MACA,SAAAhB,KAAA;QACA,KAAAS,QAAA,CAAAT,KAAA;QACAiB,OAAA,CAAAjB,KAAA,CAAAA,KAAA;MACA;IACA;IAEA;IACAkB,iBAAAJ,IAAA;MACA,KAAAlC,UAAA,GAAAkC,IAAA;MACA,KAAAH,aAAA;IACA;IAEA;IACAQ,YAAAb,EAAA;MACA,KAAA7B,mBAAA;MACA,KAAAF,aAAA;MACA,KAAA6B,OAAA,CAAAC,IAAA,aAAAC,EAAA;IACA;IAEA;IACA,MAAAtB,iBAAA;MACA;QACA,MAAAM,QAAA,SAAAlB,KAAA,CAAAmB,GAAA;QACA,KAAAT,WAAA,GAAAQ,QAAA,CAAAhB,IAAA;MACA,SAAA0B,KAAA;QACAiB,OAAA,CAAAjB,KAAA,aAAAA,KAAA;MACA;IACA;IAEA;IACAoB,WAAAC,OAAA;MACA,KAAAA,OAAA;MACA,MAAAC,IAAA,OAAAC,IAAA,CAAAF,OAAA;MACA,OAAAC,IAAA,CAAAE,kBAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}