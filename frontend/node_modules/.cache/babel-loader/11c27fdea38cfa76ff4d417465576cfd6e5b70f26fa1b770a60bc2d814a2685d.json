{"ast":null,"code":"import axios from '../axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'CollectionDetail',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      collection: {\n        title: '',\n        description: '',\n        cover: '',\n        CollectionUser: {\n          id: '',\n          username: ''\n        },\n        CollectionArticles: [],\n        created_at: ''\n      },\n      loading: false\n    };\n  },\n  created() {\n    window.scrollTo(0, 0);\n    this.fetchCollectionDetail();\n  },\n  methods: {\n    async fetchCollectionDetail() {\n      this.loading = true;\n      try {\n        const response = await axios.get(`/collections/${this.$route.params.id}`);\n        this.collection = response.data;\n      } catch (error) {\n        console.error('获取合集详情失败', error);\n        this.$message.error('获取合集详情失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    viewDetail(id) {\n      this.$router.push(`/article/${id}`);\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleDateString('zh-CN');\n    },\n    getDefaultCover() {\n      const covers = ['https://img.icons8.com/fluency/96/000000/blog.png', 'https://img.icons8.com/color/96/000000/blog.png', 'https://img.icons8.com/color/96/000000/book.png', 'https://img.icons8.com/fluency/96/000000/book.png', 'https://img.icons8.com/color/96/000000/book-open.png'];\n      return covers[Math.floor(Math.random() * covers.length)];\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","collection","title","description","cover","CollectionUser","id","username","CollectionArticles","created_at","loading","created","window","scrollTo","fetchCollectionDetail","methods","response","get","$route","params","error","console","$message","viewDetail","$router","push","formatDate","dateString","date","Date","toLocaleDateString","getDefaultCover","covers","Math","floor","random","length"],"sources":["src/views/CollectionDetail.vue"],"sourcesContent":["<template>\n  <div class=\"collection-detail\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\">\n        <div class=\"collection-header\" v-loading=\"loading\">\n          <div class=\"collection-banner\">\n            <img :src=\"collection.cover || getDefaultCover()\" alt=\"合集封面\">\n          </div>\n          <div class=\"collection-info\">\n            <h1>{{ collection.title }}</h1>\n            <p class=\"collection-description\" v-if=\"collection.description\">\n              {{ collection.description }}\n            </p>\n            <div class=\"collection-meta\">\n              <span class=\"collection-author\" @click=\"$router.push(`/user/profile/${collection.CollectionUser.id}`)\">\n                <i class=\"el-icon-user\"></i> {{ collection.CollectionUser.username }}\n              </span>\n              <span class=\"collection-articles\">\n                <i class=\"el-icon-document\"></i> {{ collection.CollectionArticles.length }} 篇文章\n              </span>\n              <span class=\"collection-date\">\n                <i class=\"el-icon-date\"></i> {{ formatDate(collection.created_at) }}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        <div class=\"articles-list\">\n          <h2 class=\"section-title\">文章列表</h2>\n          <el-card v-for=\"(article, index) in collection.CollectionArticles\" :key=\"article.id\" class=\"article-card\">\n            <div class=\"article-item\">\n              <div class=\"article-number\">{{ index + 1 }}</div>\n              <div class=\"article-cover\" @click=\"viewDetail(article.id)\">\n                <img :src=\"article.cover || getDefaultCover()\" alt=\"封面\">\n              </div>\n\n              <div class=\"article-content\">\n                <div class=\"article-header\">\n                  <span class=\"article-title\" @click=\"viewDetail(article.id)\">{{ article.title }}</span>\n                </div>\n                <div class=\"article-summary\">{{ article.summary }}</div>\n                <div class=\"article-footer\">\n                  <span class=\"article-info\">\n                    <i class=\"el-icon-date\"></i> {{ formatDate(article.created_at) }}\n                  </span>\n                  <span class=\"article-info\">\n                    <i class=\"el-icon-view\"></i> 阅读: {{ article.views }}\n                  </span>\n                  <span class=\"article-info\">\n                    <i class=\"el-icon-caret-top\"></i> 点赞: {{ article.likes_count || 0 }}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </el-card>\n\n          <div v-if=\"collection.CollectionArticles.length === 0\" class=\"empty-state\">\n            <el-empty description=\"合集中暂无文章\" />\n          </div>\n        </div>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'CollectionDetail',\n  components: { NavBar },\n  data () {\n    return {\n      collection: {\n        title: '',\n        description: '',\n        cover: '',\n        CollectionUser: { id: '', username: '' },\n        CollectionArticles: [],\n        created_at: ''\n      },\n      loading: false\n    }\n  },\n  created () {\n    window.scrollTo(0, 0)\n    this.fetchCollectionDetail()\n  },\n  methods: {\n    async fetchCollectionDetail () {\n      this.loading = true\n      try {\n        const response = await axios.get(`/collections/${this.$route.params.id}`)\n        this.collection = response.data\n      } catch (error) {\n        console.error('获取合集详情失败', error)\n        this.$message.error('获取合集详情失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    viewDetail (id) {\n      this.$router.push(`/article/${id}`)\n    },\n    formatDate (dateString) {\n      const date = new Date(dateString)\n      return date.toLocaleDateString('zh-CN')\n    },\n    getDefaultCover () {\n      const covers = [\n        'https://img.icons8.com/fluency/96/000000/blog.png',\n        'https://img.icons8.com/color/96/000000/blog.png',\n        'https://img.icons8.com/color/96/000000/book.png',\n        'https://img.icons8.com/fluency/96/000000/book.png',\n        'https://img.icons8.com/color/96/000000/book-open.png'\n      ]\n      return covers[Math.floor(Math.random() * covers.length)]\n    }\n  }\n}\n</script>\n\n<style scoped>\n.collection-detail {\n  min-height: 100vh;\n  background-color: #f8fafc;\n}\n\n.main {\n  max-width: 1200px;\n  margin: 80px auto 20px;\n  padding: 0 20px;\n}\n\n.collection-header {\n  background: #fff;\n  border-radius: 16px;\n  overflow: hidden;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\n  margin-bottom: 32px;\n}\n\n.collection-banner {\n  width: 100%;\n  height: 300px;\n  overflow: hidden;\n}\n\n.collection-banner img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.collection-info {\n  padding: 32px;\n}\n\n.collection-info h1 {\n  font-size: 32px;\n  font-weight: 700;\n  color: #1f2937;\n  margin: 0 0 16px 0;\n}\n\n.collection-description {\n  font-size: 16px;\n  color: #6b7280;\n  line-height: 1.7;\n  margin: 0 0 20px 0;\n}\n\n.collection-meta {\n  display: flex;\n  gap: 24px;\n  font-size: 14px;\n  color: #9ca3af;\n  align-items: center;\n}\n\n.collection-author {\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.collection-author:hover {\n  color: #409eff;\n}\n\n.collection-meta i {\n  margin-right: 5px;\n}\n\n.articles-list {\n  background: #fff;\n  border-radius: 16px;\n  padding: 32px;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\n}\n\n.section-title {\n  font-size: 24px;\n  font-weight: 600;\n  color: #1f2937;\n  margin: 0 0 24px 0;\n}\n\n.article-card {\n  border-radius: 12px;\n  border: 1px solid #f0f0f0;\n  margin-bottom: 16px;\n  transition: all 0.3s ease;\n}\n\n.article-card:hover {\n  border-color: #409eff;\n  box-shadow: 0 4px 12px rgba(64, 158, 255, 0.1);\n}\n\n.article-item {\n  display: flex;\n  gap: 20px;\n  align-items: stretch;\n}\n\n.article-number {\n  width: 40px;\n  height: 40px;\n  background-color: #ecf5ff;\n  color: #409eff;\n  border-radius: 8px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-weight: 600;\n  flex-shrink: 0;\n  margin-top: 8px;\n}\n\n.article-cover {\n  width: 200px;\n  height: 120px;\n  flex-shrink: 0;\n  cursor: pointer;\n  overflow: hidden;\n  border-radius: 8px;\n}\n\n.article-cover img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.3s ease;\n}\n\n.article-cover:hover img {\n  transform: scale(1.05);\n}\n\n.article-content {\n  flex: 1;\n  min-width: 0;\n}\n\n.article-header {\n  margin-bottom: 8px;\n}\n\n.article-title {\n  font-size: 18px;\n  font-weight: 600;\n  cursor: pointer;\n  color: #1f2937;\n  line-height: 1.4;\n}\n\n.article-title:hover {\n  color: #409eff;\n}\n\n.article-summary {\n  margin: 8px 0 12px 0;\n  color: #6b7280;\n  line-height: 1.6;\n  font-size: 14px;\n  display: -webkit-box;\n  -webkit-line-clamp: 2;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.article-footer {\n  display: flex;\n  gap: 20px;\n  color: #9ca3af;\n  font-size: 13px;\n}\n\n.article-info i {\n  margin-right: 4px;\n}\n\n.empty-state {\n  padding: 60px 0;\n  text-align: center;\n}\n</style>\n"],"mappings":"AAoEA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,UAAA;QACAC,KAAA;QACAC,WAAA;QACAC,KAAA;QACAC,cAAA;UAAAC,EAAA;UAAAC,QAAA;QAAA;QACAC,kBAAA;QACAC,UAAA;MACA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,MAAA,CAAAC,QAAA;IACA,KAAAC,qBAAA;EACA;EACAC,OAAA;IACA,MAAAD,sBAAA;MACA,KAAAJ,OAAA;MACA;QACA,MAAAM,QAAA,SAAApB,KAAA,CAAAqB,GAAA,sBAAAC,MAAA,CAAAC,MAAA,CAAAb,EAAA;QACA,KAAAL,UAAA,GAAAe,QAAA,CAAAhB,IAAA;MACA,SAAAoB,KAAA;QACAC,OAAA,CAAAD,KAAA,aAAAA,KAAA;QACA,KAAAE,QA