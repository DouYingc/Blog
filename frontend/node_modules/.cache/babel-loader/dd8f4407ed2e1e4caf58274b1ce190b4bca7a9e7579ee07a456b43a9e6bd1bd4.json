{"ast":null,"code":"import axios from '../axios';\nimport NavBar from '@/components/NavBar.vue';\nexport default {\n  name: 'Collections',\n  components: {\n    NavBar\n  },\n  data() {\n    return {\n      collections: [],\n      total: 0,\n      pageSize: 12,\n      currentPage: 1,\n      loading: false\n    };\n  },\n  created() {\n    window.scrollTo(0, 0);\n    this.fetchCollections();\n  },\n  methods: {\n    async fetchCollections() {\n      this.loading = true;\n      try {\n        const response = await axios.get('/collections', {\n          params: {\n            page: this.currentPage,\n            limit: this.pageSize\n          }\n        });\n        this.collections = response.data.collections;\n        this.total = response.data.pagination.total;\n      } catch (error) {\n        console.error('获取合集列表失败', error);\n        this.collections = [];\n      } finally {\n        this.loading = false;\n      }\n    },\n    handlePageChange(page) {\n      this.currentPage = page;\n      this.fetchCollections();\n    },\n    viewCollection(id) {\n      this.$router.push(`/collections/${id}`);\n    },\n    formatDate(dateString) {\n      const date = new Date(dateString);\n      return date.toLocaleDateString('zh-CN');\n    },\n    getDefaultCover() {\n      const covers = ['https://img.icons8.com/fluency/96/000000/blog.png', 'https://img.icons8.com/color/96/000000/blog.png', 'https://img.icons8.com/color/96/000000/book.png', 'https://img.icons8.com/fluency/96/000000/book.png', 'https://img.icons8.com/color/96/000000/book-open.png'];\n      return covers[Math.floor(Math.random() * covers.length)];\n    }\n  }\n};","map":{"version":3,"names":["axios","NavBar","name","components","data","collections","total","pageSize","currentPage","loading","created","window","scrollTo","fetchCollections","methods","response","get","params","page","limit","pagination","error","console","handlePageChange","viewCollection","id","$router","push","formatDate","dateString","date","Date","toLocaleDateString","getDefaultCover","covers","Math","floor","random","length"],"sources":["src/views/Collections.vue"],"sourcesContent":["<template>\n  <div class=\"collections\">\n    <el-container direction=\"vertical\">\n      <nav-bar></nav-bar>\n\n      <el-main class=\"main\">\n        <div class=\"collections-header\">\n          <h1>文章合集</h1>\n          <p class=\"collections-subtitle\">将多篇相关文章组织成系列，便于阅读和管理</p>\n        </div>\n\n        <div class=\"collections-grid\">\n          <el-card v-for=\"collection in collections\" :key=\"collection.id\" class=\"collection-card\"\n            @click=\"viewCollection(collection.id)\">\n            <div class=\"collection-cover\">\n              <img :src=\"collection.cover || getDefaultCover()\" alt=\"合集封面\">\n            </div>\n            <div class=\"collection-content\">\n              <h3 class=\"collection-title\">{{ collection.title }}</h3>\n              <p class=\"collection-description\" v-if=\"collection.description\">\n                {{ collection.description }}\n              </p>\n              <div class=\"collection-meta\">\n                <span class=\"collection-author\" @click.stop=\"$router.push(`/user/profile/${collection.User.id}`)\">\n                  <i class=\"el-icon-user\"></i> {{ collection.User.username }}\n                </span>\n                <span class=\"collection-articles\">\n                  <i class=\"el-icon-document\"></i> {{ collection.CollectionArticles.length }} 篇文章\n                </span>\n                <span class=\"collection-date\">\n                  <i class=\"el-icon-date\"></i> {{ formatDate(collection.created_at) }}\n                </span>\n              </div>\n            </div>\n          </el-card>\n        </div>\n\n        <el-pagination layout=\"prev, pager, next\" :total=\"total\" :page-size=\"pageSize\"\n          @current-change=\"handlePageChange\" style=\"text-align: center; margin-top: 40px\">\n        </el-pagination>\n      </el-main>\n    </el-container>\n  </div>\n</template>\n\n<script>\nimport axios from '../axios'\nimport NavBar from '@/components/NavBar.vue'\n\nexport default {\n  name: 'Collections',\n  components: { NavBar },\n  data () {\n    return {\n      collections: [],\n      total: 0,\n      pageSize: 12,\n      currentPage: 1,\n      loading: false\n    }\n  },\n  created () {\n    window.scrollTo(0, 0)\n    this.fetchCollections()\n  },\n  methods: {\n    async fetchCollections () {\n      this.loading = true\n      try {\n        const response = await axios.get('/collections', {\n          params: {\n            page: this.currentPage,\n            limit: this.pageSize\n          }\n        })\n        this.collections = response.data.collections\n        this.total = response.data.pagination.total\n      } catch (error) {\n        console.error('获取合集列表失败', error)\n        this.collections = []\n      } finally {\n        this.loading = false\n      }\n    },\n    handlePageChange (page) {\n      this.currentPage = page\n      this.fetchCollections()\n    },\n    viewCollection (id) {\n      this.$router.push(`/collections/${id}`)\n    },\n    formatDate (dateString) {\n      const date = new Date(dateString)\n      return date.toLocaleDateString('zh-CN')\n    },\n    getDefaultCover () {\n      const covers = [\n        'https://img.icons8.com/fluency/96/000000/blog.png',\n        'https://img.icons8.com/color/96/000000/blog.png',\n        'https://img.icons8.com/color/96/000000/book.png',\n        'https://img.icons8.com/fluency/96/000000/book.png',\n        'https://img.icons8.com/color/96/000000/book-open.png'\n      ]\n      return covers[Math.floor(Math.random() * covers.length)]\n    }\n  }\n}\n</script>\n\n<style scoped>\n.collections {\n  min-height: 100vh;\n  background-color: #f8fafc;\n}\n\n.main {\n  max-width: 1200px;\n  margin: 80px auto 20px;\n  padding: 0 20px;\n}\n\n.collections-header {\n  text-align: center;\n  margin-bottom: 40px;\n}\n\n.collections-header h1 {\n  font-size: 32px;\n  font-weight: 700;\n  color: #1f2937;\n  margin-bottom: 8px;\n}\n\n.collections-subtitle {\n  font-size: 16px;\n  color: #6b7280;\n  margin: 0;\n}\n\n.collections-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(350px, 1fr));\n  gap: 24px;\n}\n\n.collection-card {\n  border-radius: 16px;\n  border: none;\n  overflow: hidden;\n  box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);\n  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);\n  cursor: pointer;\n  background: #fff;\n}\n\n.collection-card:hover {\n  transform: translateY(-6px);\n  box-shadow: 0 16px 32px rgba(0, 0, 0, 0.12), 0 8px 16px rgba(0, 0, 0, 0.08);\n}\n\n.collection-cover {\n  width: 100%;\n  height: 200px;\n  overflow: hidden;\n}\n\n.collection-cover img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);\n}\n\n.collection-card:hover .collection-cover img {\n  transform: scale(1.08);\n}\n\n.collection-content {\n  padding: 20px;\n}\n\n.collection-title {\n  font-size: 20px;\n  font-weight: 600;\n  color: #1f2937;\n  margin: 0 0 12px 0;\n  line-height: 1.3;\n}\n\n.collection-description {\n  font-size: 14px;\n  color: #6b7280;\n  line-height: 1.6;\n  margin: 0 0 16px 0;\n  display: -webkit-box;\n  -webkit-line-clamp: 3;\n  -webkit-box-orient: vertical;\n  overflow: hidden;\n}\n\n.collection-meta {\n  display: flex;\n  gap: 16px;\n  font-size: 14px;\n  color: #9ca3af;\n  align-items: center;\n  flex-wrap: wrap;\n}\n\n.collection-author {\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.collection-author:hover {\n  color: #409eff;\n}\n\n.collection-meta i {\n  margin-right: 4px;\n}\n</style>\n"],"mappings":"AA8CA,OAAAA,KAAA;AACA,OAAAC,MAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF;EAAA;EACAG,KAAA;IACA;MACAC,WAAA;MACAC,KAAA;MACAC,QAAA;MACAC,WAAA;MACAC,OAAA;IACA;EACA;EACAC,QAAA;IACAC,MAAA,CAAAC,QAAA;IACA,KAAAC,gBAAA;EACA;EACAC,OAAA;IACA,MAAAD,iBAAA;MACA,KAAAJ,OAAA;MACA;QACA,MAAAM,QAAA,SAAAf,KAAA,