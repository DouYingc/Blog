{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'MessageList',\n  data() {\n    return {\n      messages: [],\n      loading: false,\n      searchKeyword: '',\n      currentPage: 1,\n      pageSize: 10,\n      totalMessages: 0\n    };\n  },\n  created() {\n    this.fetchMessages();\n  },\n  methods: {\n    async fetchMessages() {\n      this.loading = true;\n      try {\n        const url = `http://localhost:3000/api/messages?page=${this.currentPage}&limit=${this.pageSize}${this.searchKeyword ? `&keyword=${this.searchKeyword}` : ''}`;\n        const response = await axios.get(url, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.messages = response.data.rows;\n        this.totalMessages = response.data.count;\n      } catch (error) {\n        this.$message.error('获取留言失败');\n      } finally {\n        this.loading = false;\n      }\n    },\n    async handleDelete(id) {\n      this.$confirm('确定要删除这条留言吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n            headers: {\n              Authorization: `Bearer ${localStorage.getItem('token')}`\n            }\n          });\n          this.$message.success('删除成功');\n          this.fetchMessages();\n        } catch (error) {\n          this.$message.error('删除失败');\n        }\n      }).catch(() => {\n        // 用户取消删除\n      });\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.currentPage = 1;\n      this.fetchMessages();\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n      this.fetchMessages();\n    },\n    handleSearch() {\n      this.currentPage = 1;\n      this.fetchMessages();\n    },\n    formatDate(dateStr) {\n      return new Date(dateStr).toLocaleString();\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","messages","loading","searchKeyword","currentPage","pageSize","totalMessages","created","fetchMessages","methods","url","response","get","headers","Authorization","localStorage","getItem","rows","count","error","$message","handleDelete","id","$confirm","confirmButtonText","cancelButtonText","type","then","delete","success","catch","handleSizeChange","val","handleCurrentChange","handleSearch","formatDate","dateStr","Date","toLocaleString"],"sources":["src/views/admin/MessageList.vue"],"sourcesContent":["<template><div class=\"message-list\"><el-card shadow=\"never\" class=\"page-header\"><div class=\"page-title\">留言管理</div><div class=\"page-description\">管理社区留言板的所有留言</div></el-card><el-card shadow=\"never\"><div class=\"filter-section\"><el-input placeholder=\"搜索留言内容\" v-model=\"searchKeyword\" clearable style=\"width: 300px;\" @input=\"handleSearch\"></el-input></div><el-table :data=\"messages\" style=\"width: 100%\" v-loading=\"loading\"><el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column><el-table-column prop=\"nickname\" label=\"昵称\" width=\"120\"></el-table-column><el-table-column prop=\"content\" label=\"内容\" show-overflow-tooltip></el-table-column><el-table-column prop=\"created_at\" label=\"发布时间\" width=\"180\"><template slot-scope=\"scope\">{{ formatDate(scope.row.created_at) }}</template></el-table-column><el-table-column label=\"操作\" width=\"150\" align=\"center\"><template slot-scope=\"scope\"><el-button size=\"mini\" type=\"danger\" icon=\"el-icon-delete\" @click=\"handleDelete(scope.row.id)\">删除</el-button></template></el-table-column></el-table><div class=\"pagination-container\"><el-pagination\n          @size-change=\"handleSizeChange\"\n          @current-change=\"handleCurrentChange\"\n          :current-page=\"currentPage\"\n          :page-sizes=\"[5, 10, 20]\"\n          :page-size=\"pageSize\"\n          layout=\"total, sizes, prev, pager, next\"\n          :total=\"totalMessages\">></el-pagination></div></el-card></div></template><script>import axios from 'axios'\n\nexport default {\n  name: 'MessageList',\n  data () {\n    return {\n      messages: [],\n      loading: false,\n      searchKeyword: '',\n      currentPage: 1,\n      pageSize: 10,\n      totalMessages: 0\n    }\n  },\n  created () {\n    this.fetchMessages()\n  },\n  methods: {\n    async fetchMessages () {\n      this.loading = true\n      try {\n        const url = `http://localhost:3000/api/messages?page=${this.currentPage}&limit=${this.pageSize}${this.searchKeyword ? `&keyword=${this.searchKeyword}` : ''}`\n        const response = await axios.get(url, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.messages = response.data.rows\n        this.totalMessages = response.data.count\n      } catch (error) {\n        this.$message.error('获取留言失败')\n      } finally {\n        this.loading = false\n      }\n    },\n    async handleDelete (id) {\n      this.$confirm('确定要删除这条留言吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await axios.delete(`http://localhost:3000/api/messages/${id}`, {\n            headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n          })\n          this.$message.success('删除成功')\n          this.fetchMessages()\n        } catch (error) {\n          this.$message.error('删除失败')\n        }\n      }).catch(() => {\n        // 用户取消删除\n      })\n    },\n    handleSizeChange (val) {\n      this.pageSize = val\n      this.currentPage = 1\n      this.fetchMessages()\n    },\n    handleCurrentChange (val) {\n      this.currentPage = val\n      this.fetchMessages()\n    },\n    handleSearch () {\n      this.currentPage = 1\n      this.fetchMessages()\n    },\n    formatDate (dateStr) {\n      return new Date(dateStr).toLocaleString()\n    }\n  }\n}\n</script><style scoped>.message-list {\n  padding: 20px;\n}\n\n.page-header {\n  margin-bottom: 20px;\n}\n\n.page-title {\n  font-size: 24px;\n  font-weight: 600;\n  color: #1e293b;\n  margin-bottom: 8px;\n}\n\n.page-description {\n  font-size: 14px;\n  color: #64748b;\n}\n\n.filter-section {\n  margin-bottom: 20px;\n}\n\n.pagination-container {\n  margin-top: 20px;\n  text-align: right;\n}\n</style>"],"mappings":"AAOA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,OAAA;MACAC,aAAA;MACAC,WAAA;MACAC,QAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,aAAA;EACA;EACAC,OAAA;IACA,MAAAD,cAAA;MACA,KAAAN,OAAA;MACA;QACA,MAAAQ,GAAA,mDAAAN,WAAA,eAAAC,QAAA,QAAAF,aAAA,oBAAAA,aAAA;QACA,MAAAQ,QAAA,SAAAb,KAAA,CAAAc,GAAA,CAAAF,GAAA;UACAG,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAf,QAAA,GAAAU,QAAA,CAAAX,IAAA,CAAAiB,IAAA;QACA,KAAAX,aAAA,GAAAK,QAAA,CAAAX,IAAA,CAAAkB,KAAA;MACA,SAAAC,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;QACA,KAAAjB,OAAA;MACA;IACA;IACA,MAAAmB,aAAAC,EAAA;MACA,KAAAC,QAAA;QACAC,iBAAA;QACAC,gBAAA;QACAC,IAAA;MACA,GAAAC,IAAA;QACA;UACA,MAAA7B,KAAA,CAAA8B,MAAA,uCAAAN,EAAA;YACAT,OAAA;cAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;YAAA;UACA;UACA,KAAAI,QAAA,CAAAS,OAAA;UACA,KAAArB,aAAA;QACA,SAAAW,KAAA;UACA,KAAAC,QAAA,CAAAD,KAAA;QACA;MACA,GAAAW,KAAA;QACA;MAAA,CACA;IACA;IACAC,iBAAAC,GAAA;MACA,KAAA3B,QAAA,GAAA2B,GAAA;MACA,KAAA5B,WAAA;MACA,KAAAI,aAAA;IACA;IACAyB,oBAAAD,GAAA;MACA,KAAA5B,WAAA,GAAA4B,GAAA;MACA,KAAAxB,aAAA;IACA;IACA0B,aAAA;MACA,KAAA9B,WAAA;MACA,KAAAI,aAAA;IACA;IACA2B,WAAAC,OAAA;MACA,WAAAC,IAAA,CAAAD,OAAA,EAAAE,cAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}