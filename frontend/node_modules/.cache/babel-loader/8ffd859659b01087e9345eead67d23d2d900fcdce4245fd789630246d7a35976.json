{"ast":null,"code":"import axios from '../../axios';\nexport default {\n  name: 'UserList',\n  data() {\n    return {\n      userList: [],\n      searchQuery: '',\n      roleFilter: '',\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      selectedUsers: []\n    };\n  },\n  mounted() {\n    this.fetchUsers();\n  },\n  methods: {\n    async fetchUsers() {\n      try {\n        const response = await axios.get('/users/active', {\n          params: {\n            page: this.currentPage,\n            size: this.pageSize,\n            search: this.searchQuery,\n            role: this.roleFilter\n          }\n        });\n        this.userList = response.data;\n        this.total = response.data.length;\n      } catch (error) {\n        this.$message.error('获取用户列表失败');\n      }\n    },\n    handleSearch() {\n      this.currentPage = 1;\n      this.fetchUsers();\n    },\n    handleSizeChange(val) {\n      this.pageSize = val;\n      this.currentPage = 1;\n      this.fetchUsers();\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val;\n      this.fetchUsers();\n    },\n    handleSelectionChange(selection) {\n      this.selectedUsers = selection;\n    },\n    formatDate(dateString) {\n      if (!dateString) return '';\n      return new Date(dateString).toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      });\n    },\n    viewProfile(user) {\n      this.$router.push(`/user/${user.id}`);\n    },\n    async changeRole(user) {\n      try {\n        const newRole = user.role === 'admin' ? 'visitor' : 'admin';\n        await axios.put(`/users/${user.id}/role`, {\n          role: newRole\n        });\n        this.$message.success('角色修改成功');\n        this.fetchUsers();\n      } catch (error) {\n        this.$message.error('角色修改失败');\n      }\n    },\n    async deleteUser(user) {\n      this.$confirm('确定要删除该用户吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await axios.delete(`/users/${user.id}`);\n          this.$message.success('用户删除成功');\n          this.fetchUsers();\n        } catch (error) {\n          this.$message.error('用户删除失败');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","userList","searchQuery","roleFilter","currentPage","pageSize","total","selectedUsers","mounted","fetchUsers","methods","response","get","params","page","size","search","role","length","error","$message","handleSearch","handleSizeChange","val","handleCurrentChange","handleSelectionChange","selection","formatDate","dateString","Date","toLocaleString","year","month","day","hour","minute","viewProfile","user","$router","push","id","changeRole","newRole","put","success","deleteUser","$confirm","confirmButtonText","cancelButtonText","type","then","delete"],"sources":["src/views/admin/UserList.vue"],"sourcesContent":["<template>\n  <div class=\"user-list\">\n    <h2>用户管理</h2>\n    \n    <el-card>\n      <div class=\"filter-bar\">\n        <el-input\n          v-model=\"searchQuery\"\n          placeholder=\"搜索用户名\"\n          class=\"search-input\"\n          clearable\n        >\n          <el-button slot=\"append\" icon=\"el-icon-search\" @click=\"handleSearch\"></el-button>\n        </el-input>\n        \n        <el-select v-model=\"roleFilter\" placeholder=\"筛选角色\" clearable>\n          <el-option label=\"管理员\" value=\"admin\"></el-option>\n          <el-option label=\"访客\" value=\"visitor\"></el-option>\n        </el-select>\n      </div>\n\n      <el-table\n        :data=\"userList\"\n        border\n        stripe\n        style=\"width: 100%\"\n        @selection-change=\"handleSelectionChange\"\n      >\n        <el-table-column type=\"selection\" width=\"55\"></el-table-column>\n        <el-table-column prop=\"id\" label=\"ID\" width=\"80\"></el-table-column>\n        <el-table-column prop=\"username\" label=\"用户名\" min-width=\"120\"></el-table-column>\n        <el-table-column label=\"头像\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-avatar :size=\"40\" :src=\"scope.row.avatar\">\n              {{ scope.row.username.charAt(0) }}\n            </el-avatar>\n          </template>\n        </el-table-column>\n        <el-table-column label=\"角色\" width=\"100\">\n          <template slot-scope=\"scope\">\n            <el-tag :type=\"scope.row.role === 'admin' ? 'danger' : 'success'\">\n              {{ scope.row.role === 'admin' ? '管理员' : '访客' }}\n            </el-tag>\n          </template>\n        </el-table-column>\n        <el-table-column prop=\"articles_count\" label=\"文章数\" width=\"90\"></el-table-column>\n        <el-table-column prop=\"comments_count\" label=\"评论数\" width=\"90\"></el-table-column>\n        <el-table-column prop=\"total_views\" label=\"阅读量\" width=\"90\"></el-table-column>\n        <el-table-column prop=\"total_likes\" label=\"点赞数\" width=\"90\"></el-table-column>\n        <el-table-column prop=\"created_at\" label=\"注册时间\" min-width=\"180\">\n          <template slot-scope=\"scope\">\n            {{ formatDate(scope.row.created_at) }}\n          </template>\n        </el-table-column>\n        <el-table-column label=\"操作\" width=\"180\">\n          <template slot-scope=\"scope\">\n            <el-button\n              type=\"text\"\n              :disabled=\"scope.row.role === 'admin'\"\n              @click=\"changeRole(scope.row)\"\n            >\n              {{ scope.row.role === 'admin' ? '管理员' : '设为管理员' }}\n            </el-button>\n            <el-button\n              type=\"text\"\n              @click=\"viewProfile(scope.row)\"\n            >\n              查看\n            </el-button>\n            <el-button\n              type=\"text\"\n              :disabled=\"scope.row.role === 'admin'\"\n              @click=\"deleteUser(scope.row)\"\n            >\n              删除\n            </el-button>\n          </template>\n        </el-table-column>\n      </el-table>\n\n      <div class=\"pagination\">\n        <el-pagination\n          @size-change=\"handleSizeChange\"\n          @current-change=\"handleCurrentChange\"\n          :current-page=\"currentPage\"\n          :page-sizes=\"[10, 20, 50]\"\n          :page-size=\"pageSize\"\n          layout=\"total, sizes, prev, pager, next, jumper\"\n          :total=\"total\"\n        >\n        </el-pagination>\n      </div>\n    </el-card>\n  </div>\n</template>\n\n<script>\nimport axios from '../../axios'\n\nexport default {\n  name: 'UserList',\n  data() {\n    return {\n      userList: [],\n      searchQuery: '',\n      roleFilter: '',\n      currentPage: 1,\n      pageSize: 10,\n      total: 0,\n      selectedUsers: []\n    }\n  },\n  mounted() {\n    this.fetchUsers()\n  },\n  methods: {\n    async fetchUsers() {\n      try {\n        const response = await axios.get('/users/active', {\n          params: {\n            page: this.currentPage,\n            size: this.pageSize,\n            search: this.searchQuery,\n            role: this.roleFilter\n          }\n        })\n        this.userList = response.data\n        this.total = response.data.length\n      } catch (error) {\n        this.$message.error('获取用户列表失败')\n      }\n    },\n    handleSearch() {\n      this.currentPage = 1\n      this.fetchUsers()\n    },\n    handleSizeChange(val) {\n      this.pageSize = val\n      this.currentPage = 1\n      this.fetchUsers()\n    },\n    handleCurrentChange(val) {\n      this.currentPage = val\n      this.fetchUsers()\n    },\n    handleSelectionChange(selection) {\n      this.selectedUsers = selection\n    },\n    formatDate(dateString) {\n      if (!dateString) return ''\n      return new Date(dateString).toLocaleString('zh-CN', {\n        year: 'numeric',\n        month: '2-digit',\n        day: '2-digit',\n        hour: '2-digit',\n        minute: '2-digit'\n      })\n    },\n    viewProfile(user) {\n      this.$router.push(`/user/${user.id}`)\n    },\n    async changeRole(user) {\n      try {\n        const newRole = user.role === 'admin' ? 'visitor' : 'admin'\n        await axios.put(`/users/${user.id}/role`, { role: newRole })\n        this.$message.success('角色修改成功')\n        this.fetchUsers()\n      } catch (error) {\n        this.$message.error('角色修改失败')\n      }\n    },\n    async deleteUser(user) {\n      this.$confirm('确定要删除该用户吗？', '提示', {\n        confirmButtonText: '确定',\n        cancelButtonText: '取消',\n        type: 'warning'\n      }).then(async () => {\n        try {\n          await axios.delete(`/users/${user.id}`)\n          this.$message.success('用户删除成功')\n          this.fetchUsers()\n        } catch (error) {\n          this.$message.error('用户删除失败')\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n.user-list {\n  padding: 20px;\n}\n\n.user-list h2 {\n  margin-bottom: 20px;\n  color: #333;\n}\n\n.filter-bar {\n  display: flex;\n  gap: 15px;\n  margin-bottom: 20px;\n  align-items: center;\n}\n\n.search-input {\n  width: 300px;\n}\n\n.pagination {\n  margin-top: 20px;\n  text-align: right;\n}\n</style>"],"mappings":"AAiGA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,QAAA;MACAC,WAAA;MACAC,UAAA;MACAC,WAAA;MACAC,QAAA;MACAC,KAAA;MACAC,aAAA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,UAAA;EACA;EACAC,OAAA;IACA,MAAAD,WAAA;MACA;QACA,MAAAE,QAAA,SAAAb,KAAA,CAAAc,GAAA;UACAC,MAAA;YACAC,IAAA,OAAAV,WAAA;YACAW,IAAA,OAAAV,QAAA;YACAW,MAAA,OAAAd,WAAA;YACAe,IAAA,OAAAd;UACA;QACA;QACA,KAAAF,QAAA,GAAAU,QAAA,CAAAX,IAAA;QACA,KAAAM,KAAA,GAAAK,QAAA,CAAAX,IAAA,CAAAkB,MAAA;MACA,SAAAC,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,aAAA;MACA,KAAAjB,WAAA;MACA,KAAAK,UAAA;IACA;IACAa,iBAAAC,GAAA;MACA,KAAAlB,QAAA,GAAAkB,GAAA;MACA,KAAAnB,WAAA;MACA,KAAAK,UAAA;IACA;IACAe,oBAAAD,GAAA;MACA,KAAAnB,WAAA,GAAAmB,GAAA;MACA,KAAAd,UAAA;IACA;IACAgB,sBAAAC,SAAA;MACA,KAAAnB,aAAA,GAAAmB,SAAA;IACA;IACAC,WAAAC,UAAA;MACA,KAAAA,UAAA;MACA,WAAAC,IAAA,CAAAD,UAAA,EAAAE