{"ast":null,"code":"import axios from 'axios';\nexport default {\n  name: 'CategoryList',\n  data() {\n    return {\n      categories: [],\n      dialogVisible: false,\n      dialogTitle: '添加分类',\n      form: {\n        id: null,\n        name: '',\n        description: ''\n      }\n    };\n  },\n  created() {\n    this.fetchCategories();\n  },\n  methods: {\n    async fetchCategories() {\n      try {\n        const response = await axios.get('/categories');\n        this.categories = response.data;\n      } catch (error) {\n        this.$message.error('获取分类列表失败');\n      }\n    },\n    handleAdd() {\n      this.dialogTitle = '添加分类';\n      this.form = {\n        id: null,\n        name: '',\n        description: ''\n      };\n      this.dialogVisible = true;\n    },\n    handleEdit(row) {\n      this.dialogTitle = '编辑分类';\n      this.form = {\n        ...row\n      };\n      this.dialogVisible = true;\n    },\n    async submitForm() {\n      if (!this.form.name) {\n        this.$message.warning('分类名称不能为空');\n        return;\n      }\n      try {\n        const config = {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        };\n        if (this.form.id) {\n          await axios.put(`/categories/${this.form.id}`, this.form, config);\n          this.$message.success('更新成功');\n        } else {\n          await axios.post('/categories', this.form, config);\n          this.$message.success('添加成功');\n        }\n        this.dialogVisible = false;\n        this.fetchCategories();\n      } catch (error) {\n        this.$message.error('操作失败');\n      }\n    },\n    async handleDelete(id) {\n      try {\n        await this.$confirm('确定要删除这个分类吗？', '警告', {\n          type: 'warning'\n        });\n        await axios.delete(`/categories/${id}`, {\n          headers: {\n            Authorization: `Bearer ${localStorage.getItem('token')}`\n          }\n        });\n        this.$message.success('删除成功');\n        this.fetchCategories();\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败');\n        }\n      }\n    }\n  }\n};","map":{"version":3,"names":["axios","name","data","categories","dialogVisible","dialogTitle","form","id","description","created","fetchCategories","methods","response","get","error","$message","handleAdd","handleEdit","row","submitForm","warning","config","headers","Authorization","localStorage","getItem","put","success","post","handleDelete","$confirm","type","delete"],"sources":["src/views/admin/CategoryList.vue"],"sourcesContent":["<template>\n  <div class=\"category-list\">\n    <div class=\"toolbar\">\n      <el-button type=\"primary\" icon=\"el-icon-plus\" @click=\"handleAdd\">添加分类</el-button>\n    </div>\n    <el-table :data=\"categories\" style=\"width: 100%\" stripe border>\n      <el-table-column prop=\"id\" label=\"ID\" width=\"80\" align=\"center\"></el-table-column>\n      <el-table-column prop=\"name\" label=\"分类名称\" width=\"200\"></el-table-column>\n      <el-table-column prop=\"description\" label=\"描述\"></el-table-column>\n      <el-table-column label=\"操作\" width=\"200\" align=\"center\">\n        <template slot-scope=\"scope\">\n          <el-button size=\"mini\" type=\"primary\" icon=\"el-icon-edit\" @click=\"handleEdit(scope.row)\">编辑</el-button>\n          <el-button size=\"mini\" type=\"danger\" icon=\"el-icon-delete\" @click=\"handleDelete(scope.row.id)\">删除</el-button>\n        </template>\n      </el-table-column>\n    </el-table>\n\n    <!-- 添加/编辑对话框 -->\n    <el-dialog :title=\"dialogTitle\" :visible.sync=\"dialogVisible\" width=\"400px\">\n      <el-form :model=\"form\" label-width=\"80px\">\n        <el-form-item label=\"分类名称\">\n          <el-input v-model=\"form.name\" placeholder=\"请输入分类名称\"></el-input>\n        </el-form-item>\n        <el-form-item label=\"分类描述\">\n          <el-input type=\"textarea\" v-model=\"form.description\" placeholder=\"请输入分类描述\"></el-input>\n        </el-form-item>\n      </el-form>\n      <div slot=\"footer\" class=\"dialog-footer\">\n        <el-button @click=\"dialogVisible = false\">取 消</el-button>\n        <el-button type=\"primary\" @click=\"submitForm\">确 定</el-button>\n      </div>\n    </el-dialog>\n  </div>\n</template>\n\n<script>\nimport axios from 'axios'\n\nexport default {\n  name: 'CategoryList',\n  data () {\n    return {\n      categories: [],\n      dialogVisible: false,\n      dialogTitle: '添加分类',\n      form: {\n        id: null,\n        name: '',\n        description: ''\n      }\n    }\n  },\n  created () {\n    this.fetchCategories()\n  },\n  methods: {\n    async fetchCategories () {\n      try {\n        const response = await axios.get('/categories')\n        this.categories = response.data\n      } catch (error) {\n        this.$message.error('获取分类列表失败')\n      }\n    },\n    handleAdd () {\n      this.dialogTitle = '添加分类'\n      this.form = { id: null, name: '', description: '' }\n      this.dialogVisible = true\n    },\n    handleEdit (row) {\n      this.dialogTitle = '编辑分类'\n      this.form = { ...row }\n      this.dialogVisible = true\n    },\n    async submitForm () {\n      if (!this.form.name) {\n        this.$message.warning('分类名称不能为空')\n        return\n      }\n      try {\n        const config = {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        }\n        if (this.form.id) {\n          await axios.put(`/categories/${this.form.id}`, this.form, config)\n          this.$message.success('更新成功')\n        } else {\n          await axios.post('/categories', this.form, config)\n          this.$message.success('添加成功')\n        }\n        this.dialogVisible = false\n        this.fetchCategories()\n      } catch (error) {\n        this.$message.error('操作失败')\n      }\n    },\n    async handleDelete (id) {\n      try {\n        await this.$confirm('确定要删除这个分类吗？', '警告', { type: 'warning' })\n        await axios.delete(`/categories/${id}`, {\n          headers: { Authorization: `Bearer ${localStorage.getItem('token')}` }\n        })\n        this.$message.success('删除成功')\n        this.fetchCategories()\n      } catch (error) {\n        if (error !== 'cancel') {\n          this.$message.error('删除失败')\n        }\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.toolbar {\n  margin-bottom: 20px;\n}\n</style>\n"],"mappings":"AAoCA,OAAAA,KAAA;AAEA;EACAC,IAAA;EACAC,KAAA;IACA;MACAC,UAAA;MACAC,aAAA;MACAC,WAAA;MACAC,IAAA;QACAC,EAAA;QACAN,IAAA;QACAO,WAAA;MACA;IACA;EACA;EACAC,QAAA;IACA,KAAAC,eAAA;EACA;EACAC,OAAA;IACA,MAAAD,gBAAA;MACA;QACA,MAAAE,QAAA,SAAAZ,KAAA,CAAAa,GAAA;QACA,KAAAV,UAAA,GAAAS,QAAA,CAAAV,IAAA;MACA,SAAAY,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACAE,UAAA;MACA,KAAAX,WAAA;MACA,KAAAC,IAAA;QAAAC,EAAA;QAAAN,IAAA;QAAAO,WAAA;MAAA;MACA,KAAAJ,aAAA;IACA;IACAa,WAAAC,GAAA;MACA,KAAAb,WAAA;MACA,KAAAC,IAAA;QAAA,GAAAY;MAAA;MACA,KAAAd,aAAA;IACA;IACA,MAAAe,WAAA;MACA,UAAAb,IAAA,CAAAL,IAAA;QACA,KAAAc,QAAA,CAAAK,OAAA;QACA;MACA;MACA;QACA,MAAAC,MAAA;UACAC,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,SAAAnB,IAAA,CAAAC,EAAA;UACA,MAAAP,KAAA,CAAA0B,GAAA,qBAAApB,IAAA,CAAAC,EAAA,SAAAD,IAAA,EAAAe,MAAA;UACA,KAAAN,QAAA,CAAAY,OAAA;QACA;UACA,MAAA3B,KAAA,CAAA4B,IAAA,qBAAAtB,IAAA,EAAAe,MAAA;UACA,KAAAN,QAAA,CAAAY,OAAA;QACA;QACA,KAAAvB,aAAA;QACA,KAAAM,eAAA;MACA,SAAAI,KAAA;QACA,KAAAC,QAAA,CAAAD,KAAA;MACA;IACA;IACA,MAAAe,aAAAtB,EAAA;MACA;QACA,WAAAuB,QAAA;UAAAC,IAAA;QAAA;QACA,MAAA/B,KAAA,CAAAgC,MAAA,gBAAAzB,EAAA;UACAe,OAAA;YAAAC,aAAA,YAAAC,YAAA,CAAAC,OAAA;UAAA;QACA;QACA,KAAAV,QAAA,CAAAY,OAAA;QACA,KAAAjB,eAAA;MACA,SAAAI,KAAA;QACA,IAAAA,KAAA;UACA,KAAAC,QAAA,CAAAD,KAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}